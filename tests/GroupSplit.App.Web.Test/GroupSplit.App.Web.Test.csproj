<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>GroupSplit.App.Web.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The realm the app has to agree with about how long a remembered session lasts.
         Copied in rather than read out of the checkout so the assertion runs the same
         way from a test binary as it does from here. See RememberMeTest. -->
    <Content Include="..\..\src\GroupSplit.AppHost\Assets\keycloak\realms.json"
             Link="Authentication\realms.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Exercise the platform-independent native session without an Android runtime. -->
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeSession.cs" Link="Native/NativeSession.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeOptions.cs" Link="Native/NativeOptions.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeLinkRouter.cs" Link="Native/NativeLinkRouter.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/INativeBrowser.cs" Link="Native/INativeBrowser.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/INativeTokenStore.cs" Link="Native/INativeTokenStore.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeJsonContext.cs" Link="Native/NativeJsonContext.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeBrowser.cs" Link="Native/NativeBrowser.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeTokenStore.cs" Link="Native/NativeTokenStore.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/ClientOptionsSetter.cs" Link="Native/ClientOptionsSetter.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeServiceExtensions.cs" Link="Native/NativeServiceExtensions.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/AuthDelegatingHandler.cs" Link="Native/AuthDelegatingHandler.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/AuthService.cs" Link="Native/AuthService.cs" />
    <Compile Include="../../src/GroupSplit.App/GroupSplit.App/Services/NativeBankLinkLauncher.cs" Link="Native/NativeBankLinkLauncher.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.110" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <!-- Collects coverage under Microsoft.Testing.Platform. Filters live in
         tests/coverage.config, which every run passes on the command line. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <!-- The trx reporter is not built into Microsoft.Testing.Platform; without this
         extension the test app rejects the CI report option with MTP exit code 5.
         Version tracks the MTP that xunit.v3 brings in. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupSplit.App\GroupSplit.App.Web\GroupSplit.App.Web.csproj" />
  </ItemGroup>

</Project>
