<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GroupSplit.App.Web.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The realm the app has to agree with about how long a remembered session lasts.
         Copied in rather than read out of the checkout so the assertion runs the same
         way from a test binary as it does from here. See RememberMeTest. -->
    <Content Include="..\..\src\GroupSplit.AppHost\Assets\keycloak\realms.json"
             Link="Authentication\realms.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Collects coverage under Microsoft.Testing.Platform. Filters live in
         tests/coverage.config, which every run passes on the command line. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- The trx reporter is not built into Microsoft.Testing.Platform; without this
         extension the test app rejects the CI report option with MTP exit code 5.
         Version tracks the MTP that xunit.v3 brings in. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupSplit.App\GroupSplit.App.Web\GroupSplit.App.Web.csproj" />
  </ItemGroup>

</Project>
