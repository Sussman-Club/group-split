<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GroupSplit.AppHost.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!--
    This template uses native xUnit.net command line options when using 'dotnet run' and
    VSTest by default when using 'dotnet test'. For more information on how to enable support
    for Microsoft Testing Platform, please visit:
      https://xunit.net/docs/getting-started/v3/microsoft-testing-platform
    -->
    <!--
    xUnit1069 wants every test carrying a Timeout to reference
    TestContext.Current.CancellationToken, so the timeout can abort the work rather than only
    fail the test afterwards. Neither kind of test here can satisfy it as written:
    - the database and realm tests do pass the token on, through a Ct property, and the
      analyzer only counts a reference in the test method itself;
    - Playwright's API takes no CancellationToken anywhere, so the browser tests have nothing
      to hand it to. Their Timeout is the outer backstop, and each Playwright call carries a
      timeout of its own, which is what actually stops a stalled operation.
    -->
    <NoWarn>$(NoWarn);xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shell script the app ships, so CountUpTest drives that file rather than a
         copy of it kept in step by hand. -->
    <Content Include="..\..\src\GroupSplit.App\GroupSplit.App.Shared\wwwroot\gs.js"
             Link="gs.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" />
    <!-- Collects coverage under Microsoft.Testing.Platform. Filters live in
         tests/coverage.config, which every run passes on the command line. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- The trx reporter is not built into Microsoft.Testing.Platform; without this
         extension the test app rejects the CI report option with MTP exit code 5.
         Version tracks the MTP that xunit.v3 brings in. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupSplit.AppHost\GroupSplit.AppHost.csproj" />
    <ProjectReference Include="..\..\src\GroupSplit.Data.PostgreSQL\GroupSplit.Data.PostgreSQL.csproj" />
    <!-- The domain services, so the queries they build can be run against the real
         provider. The unit suite runs them on the in-memory provider, which evaluates
         whatever it cannot translate instead of refusing, so a query that Npgsql rejects
         passes there and 500s in production. -->
    <ProjectReference Include="..\..\src\GroupSplit.API\GroupSplit.API.csproj" />
  </ItemGroup>

</Project>
