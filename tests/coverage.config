<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <!--
    Shared code-coverage settings for every test project. Passed on the command line
    with the coverage-settings option; nothing picks this file up implicitly.

    Careful with comments in here: a double hyphen is illegal inside an XML comment,
    so writing a CLI switch out in full makes the file unparseable, and the only
    symptom is the whole run reporting "Zero tests ran" with MTP exit code 5.

    The filters exist because an unfiltered run is not a number anyone can act on:
    the API assembly alone carries ~1,800 lines of source-generated OpenAPI and
    validation code, four times the hand-written code beside it, which sits
    permanently at 0% and drags the reported figure wherever the generators go.
  -->
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>GroupSplit\..*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <!-- The tests themselves, and the EF migration bundle, which is generated
             from the model and verified by running it, not by unit tests. -->
        <ModulePath>GroupSplit\..*\.Test\.dll$</ModulePath>
        <ModulePath>GroupSplit\.Data\.PostgreSQL\.Migrations\.dll$</ModulePath>
        <!--
          The Blazor component library. It has no component tests of any kind, so its
          ~1,260 lines sit at 0% and would be four fifths of what the gate measures.

          It is excluded because it is unmeasured, not because it is covered, and the
          distinction matters: it entered the report at all only when a contract test
          started loading one serializer helper out of it, which dropped the reported
          figure by 25 points overnight without a line of production code changing. A
          floor that moves on which assemblies happen to get loaded is not a ratchet.
          Component tests, and taking this line back out, are tracked in
          docs/qa/test-quality-and-coverage.md.
        -->
        <ModulePath>GroupSplit\.App\.Shared\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>

    <Sources>
      <Exclude>
        <!-- Source generators emit into obj/, so this is what drops the OpenAPI and
             validation interceptors, the Razor-generated component classes and
             AssemblyInfo. Compiler-generated members of hand-written types (async
             state machines, lambdas, records) carry the real source path and stay. -->
        <Source>.*\obj\.*</Source>
      </Exclude>
    </Sources>

    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>

    <!-- The AppHost tests drive real child processes; without this their coverage
         would be whatever happens to run inside the test host itself. -->
    <CollectFromChildProcesses>True</CollectFromChildProcesses>
  </CodeCoverage>
</Configuration>
