<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>GroupSplit.Seeder.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Collects coverage under Microsoft.Testing.Platform. Filters live in
         tests/coverage.config, which every run passes on the command line. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- The trx reporter is not built into Microsoft.Testing.Platform; without this
         extension the test app rejects the CI report option with MTP exit code 5.
         Version tracks the MTP that xunit.v3 brings in. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <!-- A provider, only so the change tracker works: the seeder tests add entities and
         read back what was added, and DbContext.Set<T>() refuses without one. Nothing
         here saves. Matches the provider and version GroupSplit.API.Test uses. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GroupSplit.Seeder\GroupSplit.Seeder.csproj" />
    <ProjectReference Include="..\..\src\GroupSplit.RealmWorker\GroupSplit.RealmWorker.csproj" />
  </ItemGroup>

</Project>
