# The style the code is already written in, so an editor keeps to it. Nothing here
# reformats a file, and nothing here is enforced by the build: the C# preferences are
# suggestions an IDE shows, at most. Line endings are left to git (core.autocrlf and
# .gitattributes), which already stores every text file with LF.
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,razor,css,js,py,props,targets}]
indent_size = 4

# The project files are split between four spaces (src) and two (tests), so the size is
# whatever the file already uses.
[*.csproj]
indent_style = space

[*.{json,yml,yaml,slnx,sh}]
indent_size = 2

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout: braces on their own line, file-scoped namespaces, usings outside them with
# System first.
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true

# var wherever the type is visible or does not matter, which is nearly everywhere.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# No this., and the language's names for its own types.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Private instance fields are _camelCase; constants and static fields are PascalCase.
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = suggestion
dotnet_naming_rule.static_fields_are_pascal_case.symbols = static_fields
dotnet_naming_rule.static_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_fields_are_pascal_case.severity = suggestion
dotnet_naming_rule.private_fields_are_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscored.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscored.severity = suggestion

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
