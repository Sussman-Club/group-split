<Project>

    <!-- Every package version in the repository, once. A project names the package and
         this file says which version: two projects that disagree about a version cannot be
         written down, which is how the API and its clients ended up reading and writing
         JSON Patch with different builds of the same library (#337).

         The Aspire AppHost SDK is versioned on the Sdk attribute of GroupSplit.AppHost.csproj
         instead, where MSBuild needs it; CI reads the Aspire CLI version from there. The
         MAUI head takes Microsoft.Maui.* from the installed workload, through a
         VersionOverride of $(MauiVersion) on its own references. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Aspire. Some integrations only ship as previews; those stay on the preview that
         matches the 13.6.0 SDK. -->
    <ItemGroup>
        <PackageVersion Include="Aspire.Hosting.Browsers" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="13.6.0" />
        <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.0" />
        <PackageVersion Include="Aspire.Hosting.Dotnet" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.Hosting.Maui" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.Hosting.OpenAI" Version="13.6.0" />
        <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
        <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.0" />
        <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.0" />
        <PackageVersion Include="Aspire.Keycloak.Authentication" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.0" />
        <PackageVersion Include="Aspire.OpenAI" Version="13.6.0-preview.1.26479.8" />
        <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.0" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Keycloak.Extensions" Version="13.6.0-preview.1.261001-0243" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" Version="13.6.0" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Redis.Extensions" Version="13.6.0" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.RustFs" Version="13.6.0" />
        <PackageVersion Include="Scalar.Aspire" Version="0.11.29" />
    </ItemGroup>

    <!-- ASP.NET Core, EF Core and Microsoft.Extensions: the 10.0 servicing release, and the
         libraries that version on their own (resilience, service discovery, testing). -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
        <!-- The API's only. The clients write patches with GroupSplit.Shared.PatchDocument:
             every GA build of this declares a FrameworkReference on Microsoft.AspNetCore.App,
             which the WebAssembly client cannot satisfy and the CLI should not need. -->
        <PackageVersion Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.12" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.9.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <!-- OpenTelemetry. -->
    <ItemGroup>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AWS" Version="1.19.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.14.0-beta.2" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    </ItemGroup>

    <!-- Everything else the apps and the CLI ship with, and the build tools. -->
    <ItemGroup>
        <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.1" />
        <PackageVersion Include="AWSSDK.S3" Version="4.0.104.1" />
        <PackageVersion Include="Cronos" Version="0.13.0" />
        <PackageVersion Include="Duende.AccessTokenManagement.OpenIdConnect" Version="4.2.0" />
        <PackageVersion Include="Duende.IdentityModel" Version="8.1.0" />
        <PackageVersion Include="Going.Plaid" Version="6.68.0" />
        <PackageVersion Include="MinVer" Version="8.0.0" />
        <PackageVersion Include="MudBlazor" Version="9.9.0" />
        <PackageVersion Include="NSwag.ApiDescription.Client" Version="14.7.1" />
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
        <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

    <!-- Tests. -->
    <ItemGroup>
        <PackageVersion Include="bunit" Version="2.9.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="Microsoft.Playwright.Xunit.v3" Version="1.62.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

</Project>
