@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentLabel Typo="Typography.H4">GroupSplit</FluentLabel>
            <FluentSpacer />
            <FluentAnchor Href="https://learn.microsoft.com/aspnet/core/" Target="_blank">About</FluentAnchor>
        </FluentStack>
    </FluentHeader>

    <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="height: calc(100vh - 48px);">
        <NavMenu />

        <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="padding: 1rem; overflow-y: auto;">
            @Body
        </FluentStack>
    </FluentStack>
</FluentLayout>