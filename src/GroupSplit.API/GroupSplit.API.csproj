<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
        <PackageReference Include="Aspire.Keycloak.Authentication" Version="17.0.0-preview.1.26567.5" />
        <PackageReference Include="Aspire.OpenAI" Version="17.0.0-preview.1.26567.5" />
        <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="17.0.0" />
        <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.1" />
        <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
        <PackageReference Include="Going.Plaid" Version="6.68.0" />
        <PackageReference Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The filters, sort maps and DTO projections that back the endpoints are internal;
             the tests exercise them directly rather than only through HTTP. -->
        <InternalsVisibleTo Include="GroupSplit.API.Test" />
        <InternalsVisibleTo Include="GroupSplit.AppHost.Test" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GroupSplit.Data.PostgreSQL\GroupSplit.Data.PostgreSQL.csproj" />
        <ProjectReference Include="..\GroupSplit.Jobs\GroupSplit.Jobs.csproj" />
        <ProjectReference Include="..\GroupSplit.Keycloak\GroupSplit.Keycloak.csproj" />
        <ProjectReference Include="..\GroupSplit.ServiceDefaults\GroupSplit.ServiceDefaults.csproj" />
        <ProjectReference Include="..\GroupSplit.Shared\GroupSplit.Shared.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <OpenApiDocumentsDirectory>./obj/Generated</OpenApiDocumentsDirectory>
    </PropertyGroup>
</Project>
