<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Keycloak.Authentication" Version="13.5.3-preview.1.26425.3" />
        <PackageReference Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- The filters, sort maps and DTO projections that back the endpoints are internal;
             the tests exercise them directly rather than only through HTTP. -->
        <InternalsVisibleTo Include="GroupSplit.API.Test" />
        <!-- And to the Aspire suite, which runs the same projections and sort maps against
             a real Postgres: the in-memory provider the unit tests use cannot tell a query
             that translates from one that does not. -->
        <InternalsVisibleTo Include="GroupSplit.AppHost.Test" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GroupSplit.Data.PostgreSQL\GroupSplit.Data.PostgreSQL.csproj" />
        <ProjectReference Include="..\GroupSplit.ServiceDefaults\GroupSplit.ServiceDefaults.csproj" />
        <ProjectReference Include="..\GroupSplit.Shared\GroupSplit.Shared.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <OpenApiDocumentsDirectory>./obj/Generated</OpenApiDocumentsDirectory>
    </PropertyGroup>
</Project>
