{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Telemetry": {
    "SuppressRoutineDatabaseTraces": true,
    "TraceSampleRatio": 0.1
  },
  "Aspire": {
    "Npgsql": {
      "EntityFrameworkCore": {
        "PostgreSQL": {
          "DisableTracing": true
        }
      }
    }
  }
}
