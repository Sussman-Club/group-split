<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Android is the supported native head. Other heads require an explicit opt-in and their workloads. -->
    <AndroidOnly Condition="'$(AndroidOnly)' == ''">true</AndroidOnly>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(AndroidOnly)' == 'true'">net10.0-android</TargetFrameworks>

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>GroupSplit.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <MauiVersion>10.0.110</MauiVersion>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <NativeWebUrl Condition="'$(NativeWebUrl)' == ''">https://groupsplit.sussman.win/</NativeWebUrl>
    <NativeApiUrl Condition="'$(NativeApiUrl)' == ''">https://groupsplit.sussman.win/native/api/</NativeApiUrl>
    <NativeAuthority Condition="'$(NativeAuthority)' == ''">https://groupsplit.sussman.win/idp/realms/group-split</NativeAuthority>
    <AndroidCleartext>false</AndroidCleartext>
    <AndroidCleartext Condition="'$(Configuration)' == 'Debug'">true</AndroidCleartext>
    <AndroidManifestPlaceholders>$(AndroidManifestPlaceholders);androidCleartext=$(AndroidCleartext)</AndroidManifestPlaceholders>

    <!-- Display name -->
    <ApplicationTitle>Group Split</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>club.sussman.groupsplit</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">
    <AndroidPackageFormats>aab</AndroidPackageFormats>
    <!-- Android bundles include multiple Android RIDs; do not infer the desktop host RID from trimming. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NativeApiUrl" Value="$(NativeApiUrl)" />
    <AssemblyMetadata Include="NativeAuthority" Value="$(NativeAuthority)" />
    <AssemblyMetadata Include="NativeWebUrl" Value="$(NativeWebUrl)" />
  </ItemGroup>

  <Target Name="ValidateNativeConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NativeApiUrl)' == '' Or '$(NativeAuthority)' == ''"
           Text="Set NativeApiUrl and NativeAuthority (the full Keycloak realm URL) for this native build." />
  </Target>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.6" Color="#F5F0E6" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F5F0E6" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.0.0" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GroupSplit.App.Shared\GroupSplit.App.Shared.csproj" />
  </ItemGroup>

</Project>
