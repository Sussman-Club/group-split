@using Microsoft.AspNetCore.Components
@using GroupSplit.App.Shared
@using GroupSplit.App.Services
@inject NativeLinkRouter Links
@inject NavigationManager Nav
@inject GroupSplit.App.Shared.Services.Users.IUserLogin UserLogin
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable

<Routes />

@code {
    protected override void OnInitialized()
    {
        Links.Changed += OnLink;
        UserLogin.OnLoginChanged += OnLogin;
    }
    private void OnLogin(GroupSplit.Shared.UserInfo? user)
    {
        if (user is not null) _ = RefreshPush(user.Id);
    }
    private async Task RefreshPush(Guid userId)
    {
        try
        {
            if (Services.GetService<GroupSplit.App.Shared.Services.IPushNotifications>() is { } push)
                await push.RefreshAsync(userId);
        }
        catch (Exception) { /* Retry on the next resume or sign-in. */ }
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) Navigate();
        return Task.CompletedTask;
    }
    // Views can overlap while Android recreates an activity. Deliver the route to each
    // listener instead of letting an old view consume it ahead of the visible one.
    private void OnLink(string route) => _ = InvokeAsync(() => Nav.NavigateTo(route));
    private void Navigate()
    {
        if (Links.Take() is { } route) Nav.NavigateTo(route);
    }
    public void Dispose()
    {
        Links.Changed -= OnLink;
        UserLogin.OnLoginChanged -= OnLogin;
    }
}
