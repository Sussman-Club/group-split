@page "/Error"
@using System.Diagnostics

<PageTitle>@Loc["Something went wrong"]</PageTitle>

<h1 class="text-danger">@Loc["Something went wrong"]</h1>
<p>@Loc["We couldn't complete your request. Please try again."]</p>
<a href="/">@Loc["Back to home"]</a>

@if (ShowRequestId)
{
    <p>
        <strong>@Loc["Reference"]:</strong> <code>@RequestId</code>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
