<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    @* GroupSplit.App.Web has no scoped Razor CSS bundle; the shared app.css below is the
       stylesheet entrypoint for this host. *@
    <link rel="stylesheet" href="@Assets["_content/GroupSplit.App.Shared/app.css"]"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Manrope:wght@400..800&display=swap" rel="stylesheet"/>
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet"/>
    <script src="_content/GroupSplit.App.Shared/gs.js"></script>
    @* The page's one inline script, so it carries the nonce the response's policy names.
       See SecurityHeadersExtensions. *@
    <ImportMap nonce="@SecurityHeadersExtensions.CspNonce(HttpContext)"/>
    <link rel="icon" type="image/svg+xml" href="_content/GroupSplit.App.Shared/favicon.svg"/>
    <HeadOutlet @rendermode="RenderModeConfig.Current"/>
</head>

<body>
<Routes @rendermode="RenderModeConfig.Current"/>
<GroupSplit.App.Web.Components.Layout.ReconnectModal />
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is null) return;
        // Written before SSR starts the response. The browser and WASM bootstrap use
        // exactly the culture chosen by request localization, including account overrides.
        HttpContext.Response.Cookies.Append(
            Microsoft.AspNetCore.Localization.CookieRequestCultureProvider.DefaultCookieName,
            Microsoft.AspNetCore.Localization.CookieRequestCultureProvider.MakeCookieValue(
                new Microsoft.AspNetCore.Localization.RequestCulture(
                    System.Globalization.CultureInfo.CurrentCulture,
                    System.Globalization.CultureInfo.CurrentUICulture)),
            new CookieOptions { Path = "/", SameSite = SameSiteMode.Lax,
                Secure = HttpContext.Request.IsHttps, MaxAge = TimeSpan.FromDays(365) });
    }
}
