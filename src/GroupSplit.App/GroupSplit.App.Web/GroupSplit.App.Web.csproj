<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0e766784-9914-4481-8993-8188692ff53b</UserSecretsId>
    <!-- GroupSplit.App.Shared references the API for build ordering only, but project content
         still flows, so the API's appsettings land here alongside our own and publish fails
         with NETSDK1152. This project's own files take precedence, so ours are what ship. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Keycloak.Authentication" Version="13.5.3-preview.1.26425.3" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.3" />
    <!-- User access token management for the OIDC handler, which ships SaveTokens and no
         way to keep what it saved current. Apache-2.0, and distinct from Duende.BFF, which
         is under Duende's own licence and would replace this app's whole BFF. -->
    <PackageReference Include="Duende.AccessTokenManagement.OpenIdConnect" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.9.0" />
    <ProjectReference Include="..\..\GroupSplit.ServiceDefaults\GroupSplit.ServiceDefaults.csproj" />
    <ProjectReference Include="..\GroupSplit.App.Shared\GroupSplit.App.Shared.csproj" />
    <ProjectReference Include="..\GroupSplit.App.Web.Client\GroupSplit.App.Web.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServerSideTokenStore and the wiring around it are internal, and the tests reach
         them directly rather than through a sign-in that would need a live Keycloak. -->
    <InternalsVisibleTo Include="GroupSplit.App.Web.Test" />
  </ItemGroup>

</Project>