@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.Shared
@inject NavigationManager Nav
@inject IInboxStateService Inbox
@implements IDisposable

@* One sliding pill marks the active item; each link only changes colour.
   The pill's slot is driven by the active index so the same markup lays out
   vertically in the sidebar and horizontally in the mobile tab bar. *@
<nav class="gs-nav" aria-label="Primary" style="--gs-pill-top: @(ActiveIndex * ItemPitch)px; --gs-pill-index: @ActiveIndex; --gs-pill-count: @Items.Count">
    <span class="gs-nav-pill @(ActiveIndex < 0 ? "is-hidden" : "")"></span>
    @foreach (var item in Items)
    {
        <NavLink class="gs-nav-item" href="@item.Href" Match="@item.Match" title="@item.Text">
            <MudIcon Icon="@item.Icon" />
            <span class="gs-nav-text">@item.Text</span>
            @if (item.ShowsInboxCount && Inbox.NewCount > 0)
            {
                @* Absolutely positioned, so it cannot change the item's height and put the
                   sliding pill out of step with the items it slides between. *@
                <span class="gs-nav-badge" aria-label="@Inbox.NewCount waiting">@Badge(Inbox.NewCount)</span>
            }
        </NavLink>
    }
</nav>

@code {
    private const int ItemPitch = 50; // 46px item + 4px gap, see .gs-nav in app.css

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private static readonly List<MenuItem> SignedIn =
    [
        new() { Href = "/", Text = "Home", Icon = Icons.Material.Rounded.SpaceDashboard, Match = NavLinkMatch.All },
        new() { Href = "/groups", Text = "Groups", Icon = Icons.Material.Rounded.Groups },
        new() { Href = "/transactions", Text = "Expenses", Icon = Icons.Material.Rounded.ReceiptLong },
        new() { Href = "/inbox", Text = "Inbox", Icon = Icons.Material.Rounded.Inbox, ShowsInboxCount = true },
        new() { Href = "/account", Text = "Account", Icon = Icons.Material.Rounded.AccountCircle }
    ];

    // Everything else needs a session, and a link that only bounces to the
    // sign-in page is not worth showing.
    private static readonly List<MenuItem> SignedOut =
    [
        new() { Href = "/", Text = "Home", Icon = Icons.Material.Rounded.SpaceDashboard, Match = NavLinkMatch.All },
        new() { Href = "/login", Text = "Sign in", Icon = Icons.Material.Rounded.Login }
    ];

    private List<MenuItem> Items => UserInfo is null ? SignedOut : SignedIn;

    private int ActiveIndex { get; set; } = -1;

    /// <summary>Two digits at most, so a long number cannot stretch the item.</summary>
    private static string Badge(int count) => count > 99 ? "99+" : count.ToString();

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Inbox.OnChanged += OnInboxChanged;
    }

    protected override void OnParametersSet() => Resolve();

    private void OnInboxChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Resolve();
        InvokeAsync(StateHasChanged);
    }

    private void Resolve()
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

        ActiveIndex = Items.FindIndex(item => item.Match == NavLinkMatch.All
            ? string.Equals(path, item.Href, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Inbox.OnChanged -= OnInboxChanged;
    }
}
