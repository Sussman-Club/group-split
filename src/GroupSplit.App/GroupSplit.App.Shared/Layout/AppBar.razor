@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@inject IAuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

<header class="gs-topbar">
    <a class="gs-brand gs-topbar-brand" href="/" aria-label="Home">
        <BrandMark Size="28" />
    </a>
    <h2 class="gs-topbar-title">@Title</h2>
    <span class="gs-topbar-spacer"></span>

    <ThemeModeMenu />

    @if (UserInfo is not null)
    {
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense>
            <ActivatorContent>
                <button type="button" class="gs-user-btn" aria-label="Account menu">
                    <span class="name">@UserInfo.FirstName</span>
                    <Avatar Name="@UserInfo.FullName" Size="sm" />
                </button>
            </ActivatorContent>
            <ChildContent>
                <div style="padding: 10px 16px 6px; min-width: 200px">
                    <div style="font-weight: 700; font-size: .875rem">@UserInfo.FullName</div>
                    <div class="gs-muted" style="font-size: .75rem">@UserInfo.Email</div>
                </div>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Rounded.AccountCircle" Label="Account" Href="/account" />
                <MudMenuItem Icon="@Icons.Material.Rounded.Logout" Label="Sign out" OnClick="TryLogout" />
            </ChildContent>
        </MudMenu>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill" Href="/login">Sign in</MudButton>
    }
</header>

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private string Title => ("/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/')) switch
    {
        "/" => "Home",
        "/groups" => "Groups",
        "/transactions" => "Expenses",
        "/account" => "Account",
        _ => "Group Split"
    };

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    // Logout is a full-page navigation to the BFF, which ends the Keycloak
    // session and lands back on "/".
    private Task TryLogout() => AuthService.Logout();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
