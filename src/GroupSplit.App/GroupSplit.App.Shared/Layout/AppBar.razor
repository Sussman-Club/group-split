@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Users
@using GroupSplit.Shared
@inject IAuthService AuthService
@inject MudTheme Theme
@inject IUserLogin UserLogin

<MudAppBar Elevation="1" Dense>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-grow-1">
        @if (ToggleDrawer.HasDelegate)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@ToggleDrawer" />
        }
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Inherit" />
        <MudText Typo="Typo.h6" Class="font-weight-bold">Group Split</MudText>
    </MudStack>
    <MudSpacer />
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <ThemeModeMenu />
        @if (UserInfo is not null)
        {
            <MudMenu Dense AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudStack Style="height: var(--mud-appbar-height)" Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.body2" Class="font-weight-medium d-none d-sm-flex">@UserInfo.FullName</MudText>
                        <MudAvatar Style="@Theme.PaletteLight.PrimaryContrastText.BackgroundColorStyle" Size="Size.Small">
                            @Initials
                        </MudAvatar>
                    </MudStack>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle" Label="Account" Href="/account" />
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" Label="Sign out" OnClick="TryLogout" />
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudButton Color="Color.Inherit" Href="/login">Sign in</MudButton>
            <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Href="/signup">Create account</MudButton>
        }
    </MudStack>
</MudAppBar>

@code {
    [Parameter] public EventCallback ToggleDrawer { get; set; }

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private string Initials => string.Concat(
        (UserInfo?.FullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]));

    // Logout is a full-page navigation to the BFF, which ends the Keycloak
    // session and lands back on "/".
    private Task TryLogout(MouseEventArgs args) => AuthService.Logout();
}