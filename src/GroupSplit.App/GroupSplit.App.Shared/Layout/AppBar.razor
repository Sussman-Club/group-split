@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@inject IAuthService AuthService
@inject AppLinks AppLinks

<header class="gs-topbar">
    <a class="gs-brand gs-topbar-brand" href="/" aria-label="@Loc["Home"]">
        <BrandMark Size="28" />
    </a>
    <span class="gs-topbar-spacer"></span>

    @if (!AppLinks.IsNative)
    {
        <MudIconButton Class="gs-android-only" Icon="@Icons.Material.Rounded.Download" Href="/android"
                       title="@Loc["Get the Android app"]" aria-label="@Loc["Get the Android app"]" />
    }

    @if (UserInfo is not null)
    {
        <a class="gs-topbar-help" href="/help" aria-label="@Loc["Help & feedback"]">
            <MudIcon Icon="@Icons.Material.Rounded.HelpOutline" Size="Size.Small" />
            <span class="gs-topbar-help-full">@Loc["Help & feedback"]</span>
            <span class="gs-topbar-help-short" aria-hidden="true">@Loc["Help"]</span>
        </a>
    }

    <ThemeModeMenu />

    @if (UserInfo is { } user)
    {
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense>
            @* Custom activator content owns its own activation: MudBlazor wires the
               click only for the default button, and hands anything else the menu's
               context to call instead. Without this the menu opens from the keyboard
               -- the wrapper still handles that -- and does nothing on a click. *@
            <ActivatorContent>
                <button type="button"
                        class="gs-user-btn"
                        aria-label="@Loc["Account menu"]"
                        @onclick="@context.ToggleAsync">
                    <span class="name">@user.FirstName</span>
                    <Avatar Name="@user.FullName" Size="sm" />
                </button>
            </ActivatorContent>
            <ChildContent>
                <div style="padding: 10px 16px 6px; min-width: 200px">
                    <div style="font-weight: 700; font-size: .875rem">@user.FullName</div>
                    <div class="gs-muted" style="font-size: .75rem">@user.Email</div>
                </div>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Rounded.Settings" Label="@Loc["Settings"]" Href="/settings" />
                <MudMenuItem Icon="@Icons.Material.Rounded.Logout" Label="@Loc["Sign out"]" OnClick="TryLogout" />
            </ChildContent>
        </MudMenu>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill" Href="/login">@Loc["Sign in"]</MudButton>
    }
</header>

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    // Logout is a form POST to the BFF, a full page load, which ends the
    // Keycloak session and lands back on "/".
    private Task TryLogout() => AuthService.Logout();

}
