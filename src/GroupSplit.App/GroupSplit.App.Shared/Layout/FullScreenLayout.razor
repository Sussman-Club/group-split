@using GroupSplit.App.Shared.Components
@inherits LayoutComponentBase

@* Minimal layout for standalone pages like Login. Includes Mud providers so Mud components work without MainLayout. *@
<AppThemeProvider />

<div class="gs-auth-backdrop">
    <div style="display: flex; justify-content: flex-end; padding: 20px 24px">
        <ThemeModeMenu />
    </div>
    <div style="flex: 1; display: flex; flex-direction: column; padding: 0 20px 48px">
        @Body
    </div>
</div>
