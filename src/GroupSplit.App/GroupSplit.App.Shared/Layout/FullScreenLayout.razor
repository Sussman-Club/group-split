@inherits LayoutComponentBase
@inject MudTheme Theme

@* Minimal layout for standalone pages like Login. Includes Mud providers so Mud components work without MainLayout. *@
<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="gs-auth-backdrop">
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column flex-1 py-8" Style="min-height: 100dvh">
        @Body
    </MudContainer>
</MudLayout>
