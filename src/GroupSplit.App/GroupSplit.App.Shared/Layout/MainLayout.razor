@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LocalClock Clock
@implements IDisposable

<AppThemeProvider />

<div class="gs-shell @(_rail ? "is-rail" : "")">
    <aside class="gs-sidebar">
        <a class="gs-brand" href="/">
            <BrandMark />
            <span class="gs-brand-name">@Loc["Group Split"]<small>@Loc["Shared expenses"]</small></span>
        </a>

        <NavMenu />

        <div class="gs-sidebar-foot">
            @if (UserInfo is not null)
            {
                <a class="gs-nav-item gs-sidebar-user" href="/settings" title="@UserInfo.FullName">
                    <Avatar Name="@UserInfo.FullName" Size="sm" />
                    <span class="gs-nav-text gs-sidebar-user-text" style="min-width: 0; line-height: 1.2">
                        <span style="display:block; font-size: .875rem; overflow: hidden; text-overflow: ellipsis">@UserInfo.FullName</span>
                        <span class="gs-muted" style="display:block; font-size: .75rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis">@UserInfo.Email</span>
                    </span>
                </a>
            }
            <button type="button" class="gs-sidebar-toggle" @onclick="ToggleRail" aria-label="@(_rail ? Loc["Expand sidebar"].Value : Loc["Collapse sidebar"].Value)">
                <MudIcon Icon="@Icons.Material.Rounded.KeyboardDoubleArrowLeft" />
                <span>@Loc["Collapse"]</span>
            </button>
        </div>
    </aside>

    <div class="gs-main">
        <AppBar />
        <main class="gs-content">
            <AndroidUpdateNotice />
            <div class="gs-page" @key="(_path, Clock.Offset)">
                @* The last resort, for bugs. Rejected requests never reach it: the API's
                   refusals are read by ApiErrorPresenter and shown as messages, so what
                   lands here is an exception nothing expected. Re-keyed with the page, so
                   a navigation starts clean.

                   Keyed on the clock's offset too. On the server the browser's offset
                   arrives after the page's first render, and redrawing this layout does not
                   redraw a page whose parameters did not change: it kept the days it drew
                   with the server's offset, and the spans it had read with it (#434). A new
                   key builds the page again, so it draws and reads with the person's. *@
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <div class="gs-card gs-empty" style="padding: 64px 24px">
                            <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" />
                            <h3>@Loc["Something went wrong"]</h3>
                            <span>@Loc["This page hit a problem it could not recover from. The details have been logged."]</span>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4" OnClick="Recover">@Loc["Try again"]</MudButton>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </main>
    </div>

    <div class="gs-tabbar">
        <NavMenu />
    </div>
</div>

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private bool _rail;
    private string _path = "";
    private ErrorBoundary? _errorBoundary;

    private void Recover() => _errorBoundary?.Recover();

    protected override void OnInitialized()
    {
        _path = PathOf(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    // Re-keying the page wrapper on every navigation replays the entrance
    // animation, which is what makes route changes feel like transitions.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _path = PathOf(e.Location);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The address without its query string or fragment: the part that says which page.
    /// </summary>
    /// <remarks>
    /// The key used to be the whole address, and a page that keeps a filter in its query
    /// string -- the You page's view, the ledger's kind -- was torn down and built again
    /// every time that filter moved. The date range and the search box went with it, and
    /// the instance that had asked the server for the new figures was disposed before they
    /// arrived. A change of query is the same page answering a different question, not a
    /// navigation.
    /// </remarks>
    private static string PathOf(string uri)
    {
        var cut = uri.IndexOfAny(['?', '#']);

        return cut < 0 ? uri : uri[..cut];
    }

    // The collapse works before the runtime arrives (gs.js), so pick up
    // whatever the user did in the meantime rather than snapping it back.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var rail = await JS.InvokeAsync<bool>("gs.rail");
            if (rail != _rail)
            {
                _rail = rail;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
        }

        // On WebAssembly the clock already asked the browser synchronously; on the server
        // this is the first chance to. A changed offset means every date on screen was
        // drawn a zone off, so the page is built again: see the key on .gs-page.
        if (await Clock.InitializeAsync())
            StateHasChanged();
    }

    private async Task ToggleRail()
    {
        _rail = !_rail;
        try
        {
            await JS.InvokeVoidAsync("gs.setRail", _rail);
        }
        catch (JSException)
        {
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
