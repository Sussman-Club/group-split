@using GroupSplit.App.Shared.Extensions
@inherits LayoutComponentBase
@inject MudTheme Theme

@* Required *@
<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <AppBar ToggleDrawer="ToggleDrawer" />
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Mini" Elevation="2"
                ClipMode="DrawerClipMode.Always">
        <NavMenu Mini="!_drawerOpen" />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
