@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ICategoriesClient CategoriesClient
@inject ITransactionCommands Transactions
@inject ApiErrorPresenter Errors
@inject LocalClock Clock

@*
    Recording an expense, on one screen.

    It was two steps over eight fields of equal weight, with the amount third -- under a
    description almost nobody fills -- and the split behind a Next. Three of those fields are
    things somebody types and the rest are things they pick, and the picked ones already have
    an answer before anybody arrives: the group they are standing in, the category they used
    last, themselves, today. So the typed ones are fields and the picked ones are chips
    carrying their defaults, and the division is on the same screen as the amount that
    decides it. The common expense is two numbers and a button.

    The one field kept in full that was not before is the note. It is optional and it is
    always on screen: it is what somebody reaches for when an expense needs explaining -- a
    birthday cake inside the weekly shop -- and a field you have to go looking for may as
    well not be there.
*@

<MudDialog>
    <TitleContent>
        <div class="gs-dialog-head">
            <div style="min-width: 0">
                @* The group says itself once. Opened from inside one it is a fact and lives
                   here; opened from the expenses page it is a decision and is the first
                   chip instead. *@
                @if (GroupFixed)
                {
                    <div class="gs-eyebrow">@Where</div>
                }

                <h2 class="gs-dialog-title">@MudDialog.Title</h2>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <div class="gs-stack" style="gap: 16px">

                @* First, and a size up from everything else. It is why the dialog is open. *@
                <MudNumericField @bind-Value="_model.Amount"
                                 @bind-Value:after="OnMoneyChangedAsync"
                                 For="@(() => _model.Amount)"
                                 Label="How much?"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 HideSpinButtons="true"
                                 Format="N2"
                                 Class="gs-amount"/>

                <MudTextField @bind-Value="_model.Name"
                              For="@(() => _model.Name)"
                              Label="What was it?"
                              Variant="Variant.Outlined"
                              Immediate="true"/>

                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="Note"
                              Placeholder="Anything worth remembering about it"
                              HelperText="Optional"
                              Variant="Variant.Outlined"
                              Lines="2"
                              Immediate="true"/>

                <div class="gs-chip-row">
                    @if (!GroupFixed)
                    {
                        <ExpenseChip Label="group" Lead="in" Value="@Where" Set="true"
                                     Open="@(_open == Picker.Group)"
                                     OnClick="@(() => Toggle(Picker.Group))"/>
                    }

                    @if (IsShared)
                    {
                        <ExpenseChip Label="category" Lead="for" Value="@CategoryName"
                                     Set="@(_model.CategoryId is not null)"
                                     Open="@(_open == Picker.Category)"
                                     OnClick="@(() => Toggle(Picker.Category))"/>

                        @if (!DisablePayingUserSelection)
                        {
                            <ExpenseChip Label="payer" Lead="paid by" Value="@PayerName" Set="true"
                                         Open="@(_open == Picker.Payer)"
                                         OnClick="@(() => Toggle(Picker.Payer))"/>
                        }
                    }

                    <ExpenseChip Label="when" Value="@WhenSpent" Set="true"
                                 Open="@(_open == Picker.When)"
                                 OnClick="@(() => Toggle(Picker.When))"/>

                    <ExpenseChip Label="where" Value="@_merchantName"
                                 Set="@(_model.MerchantId is not null)"
                                 Open="@(_open == Picker.Where)"
                                 OnClick="@(() => Toggle(Picker.Where))"/>
                </div>

                @* The picker opens under the row rather than over it. A chip is a summary
                   and its control is the same control it always was -- a select, a date
                   picker, the merchant search -- shown in place, so nothing about choosing
                   is new except where it appears. *@
                @if (_open is not Picker.None)
                {
                    <div class="gs-picker">
                        @switch (_open)
                        {
                            case Picker.Group:
                                <MudSelect T="Guid?" Label="Group"
                                           Variant="Variant.Outlined"
                                           @bind-Value="_groupId"
                                           @bind-Value:after="OnGroupChangedAsync">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Personal (just you)</MudSelectItem>
                                    @foreach (var group in _groups)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)group.Id)">@group.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                break;

                            case Picker.Category:
                                <MudSelect T="Guid?" Label="Category"
                                           Variant="Variant.Outlined"
                                           Clearable="true"
                                           @bind-Value="_model.CategoryId"
                                           @bind-Value:after="OnMoneyChangedAsync">
                                    @foreach (var category in _categories)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">
                                            @category.Name <span class="gs-muted">· @Divides(category)</span>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                                break;

                            case Picker.Payer:
                                <MudSelect T="Guid?" Label="Paid by"
                                           Variant="Variant.Outlined"
                                           Disabled="@(!_members.Any())"
                                           @bind-Value="_model.PaidByUserId"
                                           @bind-Value:after="OnMoneyChangedAsync">
                                    @foreach (var member in _members)
                                    {
                                        <MudSelectItem T="Guid?" Value="@member.Id">@member.Label()</MudSelectItem>
                                    }
                                </MudSelect>
                                break;

                            case Picker.When:
                                @* Stacked below 600px: two pickers sharing a phone-width
                                   dialog clip both their values. *@
                                <MudStack Row="true" Spacing="4" Class="gs-field-pair">
                                    <MudDatePicker @bind-Date="_selectedDate" Label="Date"
                                                   Variant="Variant.Outlined"/>
                                    <MudTimePicker @bind-Time="_selectedTime" Label="Time"
                                                   Variant="Variant.Outlined" AmPm="true"/>
                                </MudStack>
                                break;

                            case Picker.Where:
                                @* No preview after this one: a merchant is where the money
                                   went, not who owes it. *@
                                <MerchantPicker Value="@_model.MerchantId"
                                                ValueChanged="@OnMerchantChanged"/>
                                break;
                        }
                    </div>
                }

                @if (IsShared)
                {
                    <div style="border-top: 1px solid var(--gs-line); padding-top: 14px">
                        @* One component and one list of people: editable when the person is
                           stating the division, read-only when the API worked it out. *@
                        <SplitEditor Members="@_members"
                                     Amount="@_model.Amount"
                                     PayerId="@_model.PaidByUserId"
                                     Value="@_model.Splits"
                                     ValueChanged="@OnSplitsChangedAsync"
                                     Preview="@_preview"
                                     PreviewError="@_previewError"/>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        A personal expense is not shared with anybody, so there is nothing to divide.
                    </MudAlert>
                }
            </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @* Cancel is always the first thing here and is never disabled: the way out of a
           dialog must not depend on anything inside it being in a good state. *@
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>

        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   OnClick="@Submit">
            Add expense
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Hides "paid by": the expenses page records what the caller paid.</summary>
    [Parameter] public bool DisablePayingUserSelection { get; set; }

    /// <summary>The group to open on, or null for a personal expense.</summary>
    [Parameter] public Guid? SelectedGroupId { get; set; }

    /// <summary>Which chip's picker is showing. One at a time; the row stays a row.</summary>
    private enum Picker { None, Group, Category, Payer, When, Where }

    private Picker _open = Picker.None;

    /// <summary>
    /// The group actually chosen, which starts as <see cref="SelectedGroupId"/> and then
    /// belongs to the dialog.
    /// </summary>
    /// <remarks>
    /// A field rather than the parameter itself, because a parameter is the caller's value:
    /// binding the select straight to it meant that any re-render supplying parameters
    /// again put the original group back underneath whoever had just picked another one.
    /// </remarks>
    private Guid? _groupId;

    private MudForm _form = null!;

    private readonly CreateTransactionRequest _model = new()
    {
        DateTime = DateTimeOffset.UtcNow
    };

    // Set on initialisation from the clock, not here from DateTime.Now: under WebAssembly
    // that came back as UTC while the offset attached to it below was the browser's, and
    // an expense recorded at 12:38 in New York was stored eight hours ahead.
    private DateTime? _selectedDate;
    private TimeSpan? _selectedTime;

    private IReadOnlyList<GroupResponse> _groups = [];
    private IReadOnlyList<CategoryResponse> _categories = [];
    private IReadOnlyList<UserInfo> _members = [];

    private SplitPreviewResponse? _preview;
    private string? _previewError;

    /// <summary>What the merchant chip shows, once one has been picked.</summary>
    private string? _merchantName;

    /// <summary>
    /// Whether the group was settled by where this was opened from, in which case it is
    /// stated in the heading and not offered as a choice.
    /// </summary>
    private bool GroupFixed => SelectedGroupId is not null;

    private bool IsShared => _groupId is not null;

    /// <summary>How an expense filed here divides, in the few words a dropdown has room for.</summary>
    private static string Divides(CategoryResponse category) =>
        category.DefaultSplitRuleName is { Length: > 0 } rule ? rule : "even split";

    private string Where => _groupId is null
        ? "Personal"
        : _groups.FirstOrDefault(group => group.Id == _groupId)?.Name ?? "";

    private string CategoryName =>
        _categories.FirstOrDefault(category => category.Id == _model.CategoryId)?.Name ?? "category";

    private string PayerName =>
        _members.FirstOrDefault(member => member.Id == _model.PaidByUserId)?.Label() ?? "somebody";

    /// <summary>
    /// The day, as a person would say it. Today and yesterday by name, because that is what
    /// almost every expense is and a date is a worse way of saying it.
    /// </summary>
    private string WhenSpent
    {
        get
        {
            var day = _selectedDate ?? Clock.Today;

            var since = (Clock.Today - day.Date).Days;

            return since switch
            {
                0 => "today",
                1 => "yesterday",
                _ when day.Year == Clock.Today.Year => day.ToString("d MMM"),
                _ => day.ToString("d MMM yyyy")
            };
        }
    }

    private Task Toggle(Picker picker)
    {
        _open = _open == picker ? Picker.None : picker;
        return Task.CompletedTask;
    }

    // A dialog that cannot load what it offers has nothing to offer, so it closes; the
    // presenter has already said why.
    protected override async Task OnInitializedAsync()
    {
        _groupId = SelectedGroupId;

        var now = Clock.Now;
        _selectedDate = now.Date;
        _selectedTime = now.TimeOfDay;

        var loaded = await Errors.TryAsync(async () =>
        {
            _groups = [.. await GroupsClient.GetGroupsAsync()];
            await LoadGroupDetailsAsync();
        }, "Could not load your groups.");

        if (!loaded)
        {
            MudDialog.Cancel();
            return;
        }

        StateHasChanged();

        // The division is on this screen now, so it is asked for as soon as there is a
        // group to divide between rather than on the way into a second step.
        await RefreshPreviewAsync();
    }

    private async Task OnGroupChangedAsync()
    {
        await Errors.TryAsync(LoadGroupDetailsAsync, "Could not load the group.");
        StateHasChanged();

        await RefreshPreviewAsync();
    }

    private async Task LoadGroupDetailsAsync()
    {
        // A stated division names people, and the people just changed. Kept, it would
        // either name somebody who is not in this group -- which the API refuses -- or
        // quietly leave the new group's members out of their own expense.
        _model.Splits = null;
        _model.CategoryId = null;
        _preview = null;

        if (_groupId is not { } groupId)
        {
            _categories = [];
            _members = [];
            return;
        }

        _categories = [.. await CategoriesClient.GetCategoriesAsync(groupId)];
        _members = [.. await GroupsClient.GetGroupMembersAsync(groupId)];
    }

    /// <summary>
    /// Anything that changes what the division comes to: the amount, the category, the
    /// payer.
    /// </summary>
    /// <remarks>
    /// The amount is bound on change rather than on every keystroke, which is what makes
    /// this affordable: a preview is a round trip, and one per digit of "104.09" would be
    /// six of them racing each other.
    /// </remarks>
    private Task OnMoneyChangedAsync() => RefreshPreviewAsync();

    private void OnMerchantChanged(Guid? merchantId)
    {
        _model.MerchantId = merchantId;

        // Closes on the way out: the merchant is the one chip whose picker is a search, so
        // leaving it open after a choice keeps a list of nothing on screen.
        _open = merchantId is null ? _open : Picker.None;
    }

    private async Task OnSplitsChangedAsync(IReadOnlyList<SplitInput>? splits)
    {
        _model.Splits = splits;
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Asks the API what this would come to. The same call the save makes, so what is shown
    /// is what will be stored -- including the refusal, which arrives here while there is
    /// still a field on screen to fix it in.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        if (_groupId is null)
        {
            _preview = null;
            _previewError = null;
            return;
        }

        _preview = null;
        _previewError = null;
        StateHasChanged();

        var preview = await Transactions.PreviewAsync(Request());

        _preview = preview;
        _previewError = preview is null
            ? "These shares do not add up yet, so there is nothing to show."
            : null;

        StateHasChanged();
    }

    /// <summary>
    /// The day and time as picked, made into the instant they mean and sent as UTC. The
    /// clock owns the offset; nothing here asks .NET where the person is.
    /// </summary>
    private void ApplyDate() =>
        _model.DateTime = Clock.At(_selectedDate ?? Clock.Today, _selectedTime ?? TimeSpan.Zero);

    /// <summary>
    /// The request as it stands. <c>GroupId</c> is set from the chip rather than inferred
    /// from the category: null is a personal expense now, and it is the answer for a group
    /// with no categories too, so the two have to be told apart here.
    /// </summary>
    private CreateTransactionRequest Request()
    {
        _model.GroupId = _groupId;
        return _model;
    }

    /// <summary>
    /// Validated here rather than on the way into a second step, because there is no second
    /// step: this is the only place between typing and saving.
    /// </summary>
    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        ApplyDate();
        MudDialog.Close(DialogResult.Ok(Request()));
    }

    private void Cancel() => MudDialog.Cancel();
}
