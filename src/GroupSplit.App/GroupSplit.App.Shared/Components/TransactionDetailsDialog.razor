@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Errors
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@namespace GroupSplit.App.Shared.Components
@inject ITransactionsClient TransactionsClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h5" Class="font-weight-bold">
                Transaction Details
            </MudText>
            <MudStack Row="true">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@EditTransaction"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@DeleteTransaction"/>
            </MudStack>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (details == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        }
        else
        {
            <MudStack Spacing="4">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@details.Name</MudText>
                    @if (!string.IsNullOrEmpty(details.Description))
                    {
                        <MudText Typo="Typo.body2">@details.Description</MudText>
                    }
                </MudStack>

                <MudDivider/>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body1">Total Amount</MudText>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@details.Amount.ToMoney()</MudText>
                </MudStack>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body1">Date</MudText>
                    <MudText Typo="Typo.body1">@details.DateTime.ToString("g")</MudText>
                </MudStack>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body1">Category</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@details.Category</MudChip>
                </MudStack>

                @* Only where a row knows it, which is an expense filed from a bank. The
                   logo is beside the name here rather than badged onto anything: there is
                   room, and this is the one view where "where" is a fact in its own right
                   instead of a hint on a list row. *@
                @if (!string.IsNullOrWhiteSpace(details.MerchantName))
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body1">Where</MudText>
                        <div class="gs-inline" style="gap: 8px">
                            @if (!string.IsNullOrWhiteSpace(details.MerchantLogoUrl))
                            {
                                <img class="gs-mark-inline" src="@details.MerchantLogoUrl"
                                     alt="" width="20" height="20" loading="lazy" />
                            }
                            <MudText Typo="Typo.body1" Class="font-weight-medium">@details.MerchantName</MudText>
                        </div>
                    </MudStack>
                }

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body1">Paid By</MudText>
                    <MudText Typo="Typo.body1" Class="font-weight-medium">@details.PaidByUserName</MudText>
                </MudStack>

                <MudDivider/>

                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Split Breakdown</MudText>
                <MudStack Spacing="2">
                    @foreach (var split in details.Splits)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">@split.UserName</MudText>
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@split.Amount.ToMoney()</MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close" Color="Color.Secondary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid TransactionId { get; set; }

    private TransactionDetailsResponse? details;

    // Failures go through the presenter, which names the reason the API gave; a dialog
    // that cannot load its subject has nothing to show, so it closes.
    protected override async Task OnInitializedAsync()
    {
        var loaded = await Errors.TryAsync(
            async () => details = await TransactionsClient.GetTransactionAsync(TransactionId),
            "Could not load the expense.");

        if (!loaded) MudDialog.Cancel();
    }

    private void Close() => MudDialog.Close();

    // This dialog opens from lists on more than one page, so it writes through the client
    // and announces the change; every page state that shows the expense re-reads itself.
    // The dialog closes first: the person made their change, the lists catch up behind it.

    private async Task EditTransaction()
    {
        var parameters = new DialogParameters<UpdateTransactionDialog>
        {
            { x => x.Original, details }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<UpdateTransactionDialog>("Edit Transaction", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<JsonPatchDocument<UpdateTransactionRequest>>();

        if (request is null) return;

        var updated = await Errors.TryAsync(
            () => TransactionsClient.UpdateTransactionAsync(TransactionId, request),
            "Could not update the expense.");

        if (updated)
        {
            Snackbar.Add("Transaction updated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            await Changes.NotifyTransactionsChangedAsync();
        }
    }

    private async Task DeleteTransaction()
    {
        var boolResult = await DialogService.ShowMessageBoxAsync(
            "Delete Transaction",
            "Are you sure you want to delete this transaction?",
            yesText: "Delete", cancelText: "Cancel");

        if (boolResult is not true) return;

        var deleted = await Errors.TryAsync(
            () => TransactionsClient.DeleteTransactionAsync(TransactionId),
            "Could not delete the expense.");

        if (deleted)
        {
            Snackbar.Add("Transaction deleted.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            await Changes.NotifyTransactionsChangedAsync();
        }
    }
}
