@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Users
@using GroupSplit.App.Shared.Services.Commands
@namespace GroupSplit.App.Shared.Components
@inject ITransactionsClient TransactionsClient
@inject IReceiptCommands Receipts
@inject ApiErrorPresenter Errors
@inject IUserLogin UserLogin
@inject LocalClock Clock

@*
    One expense, and how it was divided. Reading only.

    Redesigned around what somebody opens it to find out. It was headed "Transaction
    Details" -- a title naming the screen rather than its subject -- with the expense's own
    name demoted to the first line of the body, the amount as one of five identical
    label/value rows, and a raw "9/8/2026 9:45 PM" in a product that writes dates as
    "8 Sep 2026" everywhere else.

    The subject is the title now: the mark it carries in every list, the group it belongs
    to, and its name. Then the money, which is the reason anybody is here -- the total and,
    beside it, what it actually cost the person reading. That second figure was on no screen
    at all for a single expense, though a group's ledger has had the column for months.
    Then the facts, then the division.

    No edit and no delete. They were two icons under the heading, which put a destructive
    action in the corner of a dialog somebody opened to look something up, and they made the
    header carry three things at once. Both live on the rows instead -- the You page's grid
    and a group's ledger both have them -- so this dialog does one thing.
*@

<MudDialog>
    <TitleContent>
        @* The subject, not the screen. Until it loads there is no subject, so the heading
           says what kind of thing is coming rather than sitting empty. *@
        <div class="gs-dialog-head">
            @if (details is { } loaded)
            {
                <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap; min-width: 0">
                    <MerchantMark PaidByUserName="@loaded.PaidByUserName"
                                  MerchantName="@loaded.MerchantName"
                                  MerchantLogoUrl="@loaded.MerchantLogoUrl" />
                    <div style="min-width: 0">
                        <div class="gs-eyebrow">@(loaded.GroupName ?? "Personal")</div>
                        <h2 class="gs-dialog-title">@loaded.Name</h2>
                    </div>
                </div>
            }
            else
            {
                <h2 class="gs-dialog-title">Expense</h2>
            }
        </div>
    </TitleContent>

    <DialogContent>
        @if (details is null)
        {
            <div class="gs-empty" style="padding: 32px">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <div class="gs-stack" style="gap: 20px">
                @if (!string.IsNullOrWhiteSpace(details.Description))
                {
                    <p class="gs-muted" style="margin: 0; font-size: .875rem">@details.Description</p>
                }

                @*
                    The money, and both of the numbers there are.

                    The total used to be one row among five. What it cost the reader was
                    nowhere: a group's ledger carries a "your share" column, and this -- the
                    one screen about a single expense -- did not.
                *@
                <div class="gs-figures">
                    <div class="gs-figure">
                        <span class="gs-eyebrow">Total</span>
                        <span class="gs-figure-value gs-num">@details.Amount.ToMoney()</span>
                    </div>

                    @if (MyShare is { } mine)
                    {
                        <div class="gs-figure">
                            <span class="gs-eyebrow">@(PaidByMe ? "Your share" : "You owe")</span>
                            <span class="gs-figure-value gs-num is-quiet">@mine.ToMoney()</span>
                            @* Which of the two it is changes what the figure means: your
                               share of your own expense is money you already have. *@
                            <span class="gs-figure-note">
                                @(PaidByMe
                                    ? "you fronted the rest"
                                    : $"{details.PaidByUserName} paid")
                            </span>
                        </div>
                    }
                </div>

                <dl class="gs-kv">
                    <div class="gs-kv-row">
                        <dt>When</dt>
                        @* The app's date, not the machine's: "9/8/2026 9:45 PM" is ambiguous
                           between two continents and matches nothing else in the product. *@
                        <dd>@Clock.Local(details.DateTime).ToString("d MMM yyyy, HH:mm")</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(details.MerchantName))
                    {
                        <div class="gs-kv-row">
                            <dt>Where</dt>
                            <dd class="gs-inline" style="gap: 8px; justify-content: flex-end">
                                @if (!string.IsNullOrWhiteSpace(details.MerchantLogoUrl))
                                {
                                    <img class="gs-mark-inline" src="@details.MerchantLogoUrl"
                                         alt="" width="20" height="20" loading="lazy" />
                                }
                                <span>@details.MerchantName</span>
                            </dd>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(details.Category))
                    {
                        <div class="gs-kv-row">
                            <dt>Category</dt>
                            <dd><span class="gs-tag">@details.Category</span></dd>
                        </div>
                    }

                    <div class="gs-kv-row">
                        <dt>Paid by</dt>
                        <dd class="gs-kv-tagged">
                            <span>@(PaidByMe ? "You" : details.PaidByUserName)</span>
                            @* An invitee can front money for the group before they accept,
                               so the name here is not always a member's. *@
                            @if (details.PaidByIsPendingInvitee)
                            {
                                <span class="gs-tag">invited</span>
                            }
                        </dd>
                    </div>
                </dl>

                @if (details.Splits.Count > 0)
                {
                    <div>
                        <div class="gs-card-title" style="margin-bottom: 10px">
                            <h3 style="margin: 0; font-size: 1rem">@SplitHeadline</h3>
                            @* Said in a word rather than left to be worked out by comparing
                               a column of near-identical figures. *@
                            @if (IsEven)
                            {
                                <span class="gs-tag neutral">evenly</span>
                            }
                        </div>

                        @* A row per person and nothing else. There was a bar under each one
                           drawing the share as a proportion, and it earned nothing: an
                           evenly split expense -- which is most of them -- drew a column of
                           identical full-width bars that read as rules between the rows
                           rather than as data. A mark that distinguishes nothing from its
                           neighbours is furniture. *@
                        <div class="gs-splits">
                            @foreach (var split in details.Splits)
                            {
                                <div class="gs-split @(split.UserId == Me ? "is-me" : "")">
                                    <Avatar Name="@split.UserName" Size="sm" />
                                    <span class="gs-split-who">
                                        <span>@(split.UserId == Me ? "You" : split.UserName)</span>
                                        @if (split.IsPendingInvitee)
                                        {
                                            <span class="gs-tag">invited</span>
                                        }
                                    </span>
                                    <span class="gs-split-amount gs-num">@split.Amount.ToMoney()</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @*
                    The bill, for the expenses that have one.

                    Below the split rather than above it, and that ordering is the whole
                    point: the shares are what somebody owes and the bill is why. Anyone
                    opening this is here for the figure first; the lines answer the next
                    question, which is why mine is the big one.

                    Absent entirely when there is no receipt, which is nearly every expense.
                    An empty heading on hundreds of ordinary expenses would be furniture
                    explaining a feature they do not use.
                *@
                @if (receipt is { Items.Count: > 0 } bill)
                {
                    <div>
                        <div class="gs-card-title" style="margin-bottom: 10px">
                            <h3 style="margin: 0; font-size: 1rem">On the bill</h3>
                            @if (bill.UnclaimedItemCount > 0)
                            {
                                @* The one state worth flagging: a line nobody has claimed
                                   means the expense cannot be divided by this bill yet, so
                                   the shares above came from somewhere else. *@
                                <span class="gs-tag">@bill.UnclaimedItemCount unclaimed</span>
                            }
                        </div>

                        <div class="gs-splits">
                            @foreach (var item in bill.Items)
                            {
                                <div class="gs-split">
                                    <span class="gs-split-who" style="flex-direction: column; align-items: flex-start; gap: 2px">
                                        <span>
                                            @item.Name
                                            @if (item.Quantity != 1)
                                            {
                                                <span class="gs-muted">&times;@item.Quantity</span>
                                            }
                                        </span>
                                        @* How the line divides. The three states have to be
                                           told apart or a shared line reads as one somebody
                                           forgot: both name nobody, and only one of them is
                                           stopping the bill being divided. *@
                                        <span class="gs-muted" style="font-size: .75rem">
                                            @Divided(item)
                                        </span>
                                    </span>
                                    <span class="gs-split-amount gs-num">@item.TotalPrice.ToMoney()</span>
                                </div>
                            }
                        </div>

                        @*
                            The figures at the bottom of the paper. Tax and tip appear only
                            when there are any: a supermarket receipt has neither, and two
                            rows of 0.00 say nothing.
                        *@
                        <dl class="gs-kv" style="margin-top: 10px">
                            <div class="gs-kv-row">
                                <dt>Items</dt>
                                <dd class="gs-num">@bill.Subtotal.ToMoney()</dd>
                            </div>

                            @if (bill.Tax != 0)
                            {
                                <div class="gs-kv-row">
                                    <dt>Tax</dt>
                                    <dd class="gs-num">@bill.Tax.ToMoney()</dd>
                                </div>
                            }

                            @if (bill.Tip != 0)
                            {
                                <div class="gs-kv-row">
                                    <dt>Tip</dt>
                                    <dd class="gs-num">@bill.Tip.ToMoney()</dd>
                                </div>
                            }
                        </dl>

                        @if (bill.Tax != 0 || bill.Tip != 0)
                        {
                            @* Said once, here, because it is the part people expect to be
                               wrong: the extras follow what each person had rather than
                               being divided by the number of people at the table. *@
                            <p class="gs-muted" style="margin: 8px 0 0; font-size: .75rem">
                                Tax and tip are shared out in proportion to what each person had.
                            </p>
                        }
                    </div>
                }
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Class="gs-btn-quiet" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid TransactionId { get; set; }

    private TransactionDetailsResponse? details;
    private ReceiptResponse? receipt;

    /// <summary>
    /// Who is reading, so the dialog can say "You" and single their share out.
    /// </summary>
    /// <remarks>
    /// Injected rather than cascaded. The <c>UserInfo</c> cascade wraps the router, and a
    /// dialog renders where <c>MudDialogProvider</c> sits rather than where it was asked
    /// for -- so relying on tree position here would work until somebody moved the
    /// provider. This reads the same source the cascade itself reads.
    /// </remarks>
    private Guid? Me => UserLogin.User?.Id;

    private bool PaidByMe => details is { } loaded && Me is { } me && loaded.PaidByUserId == me;

    /// <summary>
    /// The reader's own share, when they have one -- they may not be in the split at all.
    /// </summary>
    private decimal? MyShare =>
        Me is { } me
            ? details?.Splits.FirstOrDefault(split => split.UserId == me)?.Amount
            : null;

    /// <summary>
    /// How one line divides, in a caption under its name.
    /// </summary>
    /// <remarks>
    /// "Shared" and "not claimed yet" both have an empty claim list and mean opposite things:
    /// one is a line the table agreed on, the other is the reason the bill cannot be divided.
    /// Reading them the same way would make the unclaimed warning above look like a bug.
    /// </remarks>
    private string Divided(ReceiptItemResponse item) => item.Split switch
    {
        ReceiptItemSplit.Evenly => "shared by everyone",
        _ when item.Claims.Count == 0 => "not claimed yet",
        _ => Who(item)
    };

    /// <summary>
    /// Who had one line, by name.
    /// </summary>
    /// <remarks>
    /// Names come from the expense's own splits rather than from a second request: anybody
    /// who claimed a line owes something, so they are in that list by construction. The id
    /// is the fallback for the case that should not arise, shortened because a full guid in
    /// a caption is noise.
    /// <para>
    /// A weight is shown only when it is not one. Two names side by side is a line two
    /// people shared; a weight against one of them says they had more of it, and printing
    /// it against every ordinary claim would bury that in punctuation.
    /// </para>
    /// </remarks>
    private string Who(ReceiptItemResponse item) =>
        string.Join(", ", item.Claims.Select(claim =>
        {
            var name = claim.UserId == Me
                ? "You"
                : details?.Splits.FirstOrDefault(split => split.UserId == claim.UserId)?.UserName
                  ?? claim.UserId.ToString()[..8];

            return claim.Weight == 1 ? name : $"{name} x{claim.Weight}";
        }));

    private string SplitHeadline => details is { Splits.Count: var count } && count > 0
        ? $"Split between {count} {(count == 1 ? "person" : "people")}"
        : "Split";

    /// <summary>
    /// Whether every share is the same to the penny, which is worth saying in one word
    /// rather than leaving somebody to compare a column of identical figures.
    /// </summary>
    private bool IsEven =>
        details is { Splits.Count: > 1 } loaded
        && loaded.Splits.Select(split => split.Amount).Distinct().Count() == 1;

    // Failures go through the presenter, which names the reason the API gave; a dialog
    // that cannot load its subject has nothing to show, so it closes.
    protected override async Task OnInitializedAsync()
    {
        var loaded = await Errors.TryAsync(
            async () => details = await TransactionsClient.GetTransactionAsync(TransactionId),
            "Could not load the expense.");

        if (!loaded)
        {
            MudDialog.Cancel();
            return;
        }

        // After the expense and never in parallel with it: most expenses have no bill, and
        // this returns null for that as readily as for a failure -- so there is nothing to
        // race and nothing to report. A dialog that showed its subject is not worth
        // interrupting over a section that simply will not appear.
        receipt = await Receipts.GetAsync(TransactionId);

        // The title has to be told separately, and this is not belt and braces.
        //
        // TitleContent is hoisted out of this component and rendered in the dialog
        // provider's own tree, so it does not re-render when this component's state
        // changes -- it keeps whatever it drew the first time. The heading is the expense's
        // name now rather than a fixed "Transaction Details", so the first draw is the
        // placeholder and without this the dialog stays headed "Expense" over a body full
        // of the thing it is refusing to name.
        MudDialog.StateHasChanged();
    }

    private void Close() => MudDialog.Close();
}
