@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Users
@using GroupSplit.App.Shared.Services.Commands
@namespace GroupSplit.App.Shared.Components
@inject ITransactionsClient TransactionsClient
@inject IGroupsClient GroupsClient
@inject ApiErrorPresenter Errors
@inject IUserLogin UserLogin
@inject LocalClock Clock
@inject IReceiptCommands Receipts
@inject IReceiptAttachmentCommands ReceiptAttachments
@inject IDialogService DialogService

@*
    One expense, and how it was divided. Reading only.

    Redesigned around what somebody opens it to find out. It was headed "Transaction
    Details" -- a title naming the screen rather than its subject -- with the expense's own
    name demoted to the first line of the body, the amount as one of five identical
    label/value rows, and a raw "9/8/2026 9:45 PM" in a product that writes dates as
    "8 Sep 2026" everywhere else.

    The subject is the title now: the mark it carries in every list, the group it belongs
    to, and its name. Then the money, which is the reason anybody is here -- the total and,
    beside it, what it actually cost the person reading. That second figure was on no screen
    at all for a single expense, though a group's ledger has had the column for months.
    Then the facts, then the division.

    No editing or deleting the expense itself. Those were two icons under the heading, which
    put a destructive action in the corner of a dialog somebody opened to look something up,
    and they made the header carry three things at once. Both live on the rows instead -- the
    You page's grid and a group's ledger both have them. The original receipt file is kept
    here, beside the itemised bill it came from.
*@

<MudDialog Class="gs-sheet gs-transaction-dialog gs-expandable-expense">
    <TitleContent>
        @* The subject, not the screen. Until it loads there is no subject, so the heading
           says what kind of thing is coming rather than sitting empty. *@
        <div class="gs-dialog-head">
            @if (details is { } loaded)
            {
                <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap; min-width: 0">
                    <MerchantMark PaidByUserName="@loaded.PaidByUserName"
                                  MerchantName="@loaded.MerchantName"
                                  MerchantLogoUrl="@loaded.MerchantLogoUrl" />
                    <div style="min-width: 0">
                        <div class="gs-eyebrow">@(loaded.GroupName ?? "Personal")</div>
                        <h2 class="gs-dialog-title">@Title(loaded)</h2>
                    </div>
                </div>
            }
            else
            {
                <h2 class="gs-dialog-title">Expense</h2>
            }
        </div>
    </TitleContent>

    <DialogContent>
        <ReceiptReadLock IsLocked="@(_transcribingAttachmentId is not null)">
        @if (details is null)
        {
            <div class="gs-dialog-loading" role="status" aria-label="Loading transaction">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <div class="gs-stack" style="gap: 20px">
                @if (!string.IsNullOrWhiteSpace(details.Description))
                {
                    <p class="gs-muted" style="margin: 0; font-size: .875rem">@details.Description</p>
                }

                @*
                    The money, and both of the numbers there are.

                    The total used to be one row among five. What it cost the reader was
                    nowhere: a group's ledger carries a "your share" column, and this -- the
                    one screen about a single expense -- did not.
                *@
                <div class="gs-figures">
                    <div class="gs-figure">
                        <span class="gs-eyebrow">Total</span>
                        <span class="gs-figure-value gs-num">@details.Amount.ToMoney(details.Currency)</span>
                    </div>

                    @* A settlement has no share: its one split is the person paid, for the
                       whole of it, and "you owe" over that would be the wrong way round. *@
                    @if (!IsSettlement && MyShare is { } mine)
                    {
                        <div class="gs-figure">
                            <span class="gs-eyebrow">Your share</span>
                            <span class="gs-figure-value gs-num is-quiet">@mine.ToMoney(details.Currency)</span>

                        </div>
                    }
                </div>

                @if (!IsSettlement)
                {
                    <div class="gs-chip-row" aria-label="Expense details">
                        <ExpenseChip ReadOnly="true" Set="true" Label="when"
                                     Value="@Clock.Stamp(details.DateTime, "d MMM yyyy", "HH:mm")" />
                        <ExpenseChip ReadOnly="true" Set="true" Label="where" Lead="at"
                                     Value="@(details.MerchantName ?? "not specified")">
                            <Mark>
                                @if (HasUsableMerchantLogo)
                                {
                                    <img class="gs-mark-inline" src="@details.MerchantLogoUrl" alt=""
                                         width="20" height="20" loading="lazy" @onerror="HandleMerchantLogoError" />
                                }
                                else if (!string.IsNullOrWhiteSpace(details.MerchantName))
                                {
                                    <span class="gs-mark-inline-fallback @details.MerchantName.AvatarTone()" aria-hidden="true">
                                        @details.MerchantName.Initials()
                                    </span>
                                }
                            </Mark>
                        </ExpenseChip>
                        <ExpenseChip ReadOnly="true" Set="true" Label="category" Lead="for"
                                     Value="@(string.IsNullOrWhiteSpace(details.Category) ? "uncategorized" : details.Category)" />
                        <ExpenseChip ReadOnly="true" Set="true" Label="payer" Lead="paid by"
                                     Value="@($"{(PaidByMe ? "You" : details.PaidByUserName)}{(details.PaidByIsGuest ? " (guest)" : "")}")" />
                    </div>
                }
                else
                {
                <details class="gs-expense-disclosure">
                    <summary>Transaction details <span>Payer, category, merchant &amp; date</span></summary>
                    <div class="gs-expense-disclosure-body">
                <dl class="gs-kv">
                    <div class="gs-kv-row">
                        <dt>When</dt>
                        @* The app's date, not the machine's: "9/8/2026 9:45 PM" is ambiguous
                           between two continents and matches nothing else in the product. A
                           bank row is a date with no time, and shows the bank's day alone. *@
                        <dd>@Clock.Stamp(details.DateTime, "d MMM yyyy", "HH:mm")</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(details.MerchantName))
                    {
                        <div class="gs-kv-row">
                            <dt>Where</dt>
                            <dd class="gs-inline" style="gap: 8px; justify-content: flex-end">
                                @if (HasUsableMerchantLogo)
                                {
                                    <img class="gs-mark-inline" src="@details.MerchantLogoUrl"
                                         alt="" width="20" height="20" loading="lazy"
                                         @onerror="HandleMerchantLogoError" />
                                }
                                else
                                {
                                    <span class="gs-mark-inline-fallback @details.MerchantName.AvatarTone()"
                                          title="@details.MerchantName" aria-hidden="true">
                                        @details.MerchantName.Initials()
                                    </span>
                                }
                                <span>@details.MerchantName</span>
                            </dd>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(details.Category))
                    {
                        <div class="gs-kv-row">
                            <dt>Category</dt>
                            <dd><span class="gs-tag">@details.Category</span></dd>
                        </div>
                    }

                    <div class="gs-kv-row">
                        <dt>Paid by</dt>
                        <dd class="gs-kv-tagged">
                            <span>@(PaidByMe ? "You" : details.PaidByUserName)</span>
                            @* A guest can front money for the group like anybody else,
                               so the name here is not always a member's. *@
                            @if (details.PaidByIsGuest)
                            {
                                <span class="gs-tag">guest</span>
                            }
                        </dd>
                    </div>

                    @if (IsSettlement)
                    {
                        <div class="gs-kv-row">
                            <dt>Paid to</dt>
                            <dd>@(details.PaidToUserId == Me ? "You" : details.PaidToUserName)</dd>
                        </div>
                    }

                    @* The period and, beside it, whether it is still square -- the one-word
                       answer to what somebody opened this for. *@
                    @if (details.Coverage is { } coverage)
                    {
                        <div class="gs-kv-row">
                            <dt>Covers</dt>
                            <dd class="gs-kv-tagged">
                                <span>@Period(coverage)</span>
                                @if (coverage.StillOwed > 0)
                                {
                                    <span class="gs-tag clay">open</span>
                                }
                                else
                                {
                                    <span class="gs-tag">square</span>
                                }
                            </dd>
                        </div>
                    }
                </dl>
                    </div>
                </details>
                }

                @*
                    What a settlement made through a day covers, as things stand now -- worked
                    out when it is read, never stored. An expense dated inside the period and
                    added after it was settled is the case this is for: the period is no longer
                    square, and saying so here is the only place anybody would find out. The
                    period itself is on the row above, so this says what happened and who owes
                    whom rather than repeating the dates.
                *@
                @if (details.Coverage is { } period)
                {
                    @if (period.StillOwed > 0)
                    {
                        <div class="gs-notice is-warn" role="status">
                            <MudIcon Icon="@Icons.Material.Outlined.Warning" />
                            <div class="gs-notice-body">
                                <strong>No longer fully settled</strong>
                                <span>Something dated in this period was added or changed since. @StillOwedSentence(details, period)</span>
                            </div>
                        </div>
                    }

                    @* Newest few, then the rest on request. With no earlier settlement between
                       the two of them the period runs back to the group's first expense, and
                       a phone's worth of rows under a dialog's facts buries them. *@
                    <section aria-label="Expenses in the period">
                        <div class="gs-period-head">
                            <h3>Expenses in the period</h3>
                            @if (_periodExpenseCount > 0)
                            {
                                <span class="gs-period-count">@_periodExpenseCount</span>
                            }
                        </div>

                        @if (_periodExpenses is null)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        }
                        else if (_periodExpenses.Count == 0)
                        {
                            <p class="gs-muted" style="margin: 0; font-size: .875rem">
                                No expenses are dated in it.
                            </p>
                        }
                        else
                        {
                            <div class="gs-period-list">
                                @foreach (var expense in _showAllPeriod ? _periodExpenses : _periodExpenses.Take(PeriodPreview))
                                {
                                    <div class="gs-period-row">
                                        <div class="gs-period-what">
                                            <span class="gs-period-name">@expense.Name</span>
                                            <span class="gs-period-meta">
                                                @Clock.Day(expense.DateTime).ToString("d MMM yyyy") · @(expense.PaidByUserId == Me ? "you" : expense.PaidByUserName) paid
                                            </span>
                                        </div>
                                        <span class="gs-period-amount">@expense.Amount.ToMoney()</span>
                                    </div>
                                }
                            </div>

                            @if (_periodExpenses.Count > PeriodPreview)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="gs-btn-quiet mt-1"
                                           aria-expanded="@(_showAllPeriod ? "true" : "false")"
                                           OnClick="@(() => _showAllPeriod = !_showAllPeriod)">
                                    @(_showAllPeriod ? "Show fewer" : $"Show all {_periodExpenses.Count}")
                                </MudButton>
                            }

                            @if (_showAllPeriod && _periodExpenseCount > _periodExpenses.Count)
                            {
                                <p class="gs-muted" style="margin: 4px 0 0; font-size: .8125rem">
                                    And @(_periodExpenseCount - _periodExpenses.Count) older, on the group's Expenses tab.
                                </p>
                            }
                        }
                    </section>
                }

                @if (!IsSettlement && details.Splits.Count > 0)
                {
                    <div>
                        <div class="gs-card-title" style="margin-bottom: 10px">
                            <h3 style="margin: 0; font-size: 1rem">@SplitHeadline</h3>
                        </div>

                        @* A row per person and nothing else. There was a bar under each one
                           drawing the share as a proportion, and it earned nothing: an
                           evenly split expense -- which is most of them -- drew a column of
                           identical full-width bars that read as rules between the rows
                           rather than as data. A mark that distinguishes nothing from its
                           neighbours is furniture. *@
                        <div class="gs-splits">
                            @foreach (var split in details.Splits)
                            {
                                <div class="gs-split @(split.UserId == Me ? "is-me" : "")">
                                    <Avatar Name="@split.UserName" Size="sm" />
                                    <span class="gs-split-who">
                                        <span>@(split.UserId == Me ? "You" : split.UserName)</span>
                                        @if (split.IsGuest)
                                        {
                                            <span class="gs-tag">guest</span>
                                        }
                                    </span>
                                    <span class="gs-split-amount gs-num">@split.Amount.ToMoney(details.Currency)</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (details.Kind == ActivityKind.Expense)
                {
                    <ReceiptSection TransactionId="@TransactionId"
                                    Title="@(details.MerchantName ?? details.Name)"
                                    Where="@Clock.Day(details.DateTime).ToString("d MMM yyyy")"
                                    Receipt="@receipt"
                                    Attachments="@_attachments"
                                    IsUploading="@_uploading"
                                    TranscribingAttachmentId="@_transcribingAttachmentId"
                                     UploadRequested="UploadAttachment"
                                     TranscribeRequested="TranscribeAttachmentAsync"
                                     DeleteRequested="DeleteAttachmentAsync"
                                     EditRequested="EditReceiptAsync" />
                }
            </div>
        }
        </ReceiptReadLock>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Class="gs-btn-quiet" Disabled="@(_transcribingAttachmentId is not null)" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid TransactionId { get; set; }

    private TransactionDetailsResponse? details;
    private ReceiptResponse? receipt;
    private IReadOnlyList<ReceiptAttachmentResponse> _attachments = [];
    private bool _uploading;
    private Guid? _transcribingAttachmentId;
    private string? _failedMerchantLogoUrl;

    private bool HasUsableMerchantLogo => details?.MerchantLogoUrl is { } logo
        && MerchantLogos.IsAllowed(logo)
        && logo != _failedMerchantLogoUrl;

    private void HandleMerchantLogoError() => _failedMerchantLogoUrl = details?.MerchantLogoUrl;

    /// <summary>
    /// Who is reading, so the dialog can say "You" and single their share out.
    /// </summary>
    /// <remarks>
    /// Injected rather than cascaded. The <c>UserInfo</c> cascade wraps the router, and a
    /// dialog renders where <c>MudDialogProvider</c> sits rather than where it was asked
    /// for -- so relying on tree position here would work until somebody moved the
    /// provider. This reads the same source the cascade itself reads.
    /// </remarks>
    private Guid? Me => UserLogin.User?.Id;

    private bool PaidByMe => details is { } loaded && Me is { } me && loaded.PaidByUserId == me;

    /// <summary>
    /// The reader's own share, when they have one -- they may not be in the split at all.
    /// </summary>
    private decimal? MyShare =>
        Me is { } me
            ? details?.Splits.FirstOrDefault(split => split.UserId == me)?.Amount
            : null;

    private string SplitHeadline => details is { Splits.Count: var count } && count > 0
        ? $"Split between {count} {(count == 1 ? "person" : "people")}"
        : "Split";

    private bool IsSettlement => details is { Kind: ActivityKind.Transfer };

    /// <summary>The most of a period's expenses listed here; the rest are counted.</summary>
    private const int PeriodListLimit = 50;

    private IReadOnlyList<TransactionResponse>? _periodExpenses;
    private int _periodExpenseCount;

    /// <summary>
    /// What the dialog is about: the expense's name, or for a settlement who paid whom --
    /// every settlement is called "Settlement", which names nothing.
    /// </summary>
    private string Title(TransactionDetailsResponse loaded) => loaded.Kind is ActivityKind.Transfer
        ? $"{(loaded.PaidByUserId == Me ? "You" : loaded.PaidByUserName)} paid {(loaded.PaidToUserId == Me ? "you" : loaded.PaidToUserName)}"
        : loaded.Name;

    /// <summary>How many of a period's expenses show before "Show all".</summary>
    private const int PeriodPreview = 5;

    private bool _showAllPeriod;

    private static string Period(SettlementCoverage coverage) => coverage.From is { } from
        ? $"{from:d MMM} – {coverage.Through:d MMM yyyy}"
        : $"Up to {coverage.Through:d MMM yyyy}";

    /// <summary>Who still owes whom for the period, named from where the reader sits.</summary>
    private string StillOwedSentence(TransactionDetailsResponse loaded, SettlementCoverage coverage) =>
        (loaded.PaidByUserId == Me, loaded.PaidToUserId == Me) switch
        {
            (true, _) => $"You still owe {loaded.PaidToUserName} {coverage.StillOwed.ToMoney()}.",
            (_, true) => $"{loaded.PaidByUserName} still owes you {coverage.StillOwed.ToMoney()}.",
            _ => $"{loaded.PaidByUserName} still owes {loaded.PaidToUserName} {coverage.StillOwed.ToMoney()}."
        };

    /// <summary>
    /// The group's expenses dated in a settlement's period, through the same listing and the
    /// same day bounds the Expenses page's date filter uses, so the two agree about which
    /// day an expense falls on.
    /// </summary>
    private async Task LoadPeriodExpensesAsync(TransactionDetailsResponse loaded)
    {
        if (loaded is not { Coverage: { } coverage, GroupId: { } groupId })
            return;

        var (from, to) = new DateFilter(DateFilterPreset.Custom,
                coverage.From?.ToDateTime(TimeOnly.MinValue),
                coverage.Through.ToDateTime(TimeOnly.MinValue))
            .Bounds(Clock.Offset, Clock.Today);

        PagedResponseOfTransactionResponse? page = null;

        await Errors.TryAsync(async () =>
                page = await GroupsClient.GetGroupTransactionsAsync(groupId, from, to,
                    page: 1, pageSize: PeriodListLimit),
            "Could not load the expenses in that period.");

        _periodExpenses = page?.Items ?? [];
        _periodExpenseCount = page?.TotalCount ?? 0;
    }

    // Failures go through the presenter, which names the reason the API gave; a dialog
    // that cannot load its subject has nothing to show, so it closes.
    protected override async Task OnInitializedAsync()
    {
        // Both at once, because both only ever needed the id this dialog was opened with:
        // read one after the other, each answer grew the dialog under the reader's hand.
        var bill = Receipts.GetAsync(TransactionId);
        // The reader's offset, which says when a settlement's period ends on their calendar --
        // as the date filter ends a day, so the period listed below is the one covered.
        var loaded = await Errors.TryAsync(
            async () => details = await TransactionsClient.GetTransactionAsync(TransactionId,
                Clock.CutoffOffsetMinutes),
            "Could not load the expense.");

        if (!loaded)
        {
            MudDialog.Cancel();
            return;
        }

        _failedMerchantLogoUrl = null;

        // Null for most expenses, which have no bill, and null for a failure once the snackbar
        // has said so: either way the strip simply does not appear.
        receipt = await bill;
        if (details is { Kind: ActivityKind.Expense })
        {
            _attachments = await ReceiptAttachments.GetAsync(TransactionId);
        }

        // The title has to be told separately:
        // TitleContent is hoisted into the dialog provider's own tree, so it does not
        // re-render when this component's state changes. Without it the dialog stays headed
        // "Expense" over a body full of the thing it is refusing to name. Both go together
        // here so the heading and the figures under it appear in the same frame.
        MudDialog.StateHasChanged();

        if (details is { Coverage: not null } settled)
            await LoadPeriodExpensesAsync(settled);
    }

    private async Task UploadAttachment(InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0) return;

        _uploading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var uploaded = await ReceiptAttachments.UploadAsync(TransactionId, args.File);
            if (uploaded is not null)
            {
                _attachments = _attachments.Append(uploaded)
                    .OrderByDescending(attachment => attachment.UploadedAt)
                    .ToList();
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task TranscribeAttachmentAsync(ReceiptAttachmentResponse attachment)
    {
        if (_transcribingAttachmentId is not null)
            return;
        _transcribingAttachmentId = attachment.Id;
        try
        {
            var transcription = await ReceiptAttachments.TranscribeAsync(TransactionId, attachment.Id);
            if (transcription is null || details is not { } expenseDetails)
                return;

            var dialog = await DialogService.ShowAsync<ReceiptDraftDialog>("Review receipt", new DialogParameters<ReceiptDraftDialog>
            {
                { x => x.TransactionId, TransactionId },
                { x => x.ExpenseAmount, expenseDetails.Amount },
                { x => x.Currency, expenseDetails.Currency },
                { x => x.Transcription, transcription }
            }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: ReceiptResponse saved })
            {
                receipt = saved;
                _attachments = await ReceiptAttachments.GetAsync(TransactionId);
                await RefreshDetailsAsync();
            }
        }
        finally
        {
            _transcribingAttachmentId = null;
        }
    }

    private async Task EditReceiptAsync(ReceiptResponse bill)
    {
        if (!bill.CanEdit || details is not { } expenseDetails)
            return;

        var dialog = await DialogService.ShowAsync<ReceiptDraftDialog>(
            "Edit itemized receipt", new DialogParameters<ReceiptDraftDialog>
            {
                { x => x.TransactionId, TransactionId },
                { x => x.ExpenseAmount, expenseDetails.Amount },
                { x => x.Currency, expenseDetails.Currency },
                { x => x.Receipt, bill }
            }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ReceiptResponse saved })
        {
            receipt = saved;
            await RefreshDetailsAsync();
        }
    }

    /// <summary>
    /// Receipt edits can also update the stored ledger shares. Refresh the read-only figures
    /// in this dialog so the amount somebody owes changes in the same interaction.
    /// </summary>
    private async Task RefreshDetailsAsync()
    {
        TransactionDetailsResponse? refreshed = null;
        if (await Errors.TryAsync(async () =>
                refreshed = await TransactionsClient.GetTransactionAsync(TransactionId,
                    Clock.CutoffOffsetMinutes),
            "Could not refresh the expense after saving the receipt.")
            && refreshed is not null)
        {
            details = refreshed;
            _failedMerchantLogoUrl = null;
        }
    }

    private async Task DeleteAttachmentAsync(ReceiptAttachmentResponse attachment)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"Remove \"{attachment.FileName}\" from this expense? The itemized receipt will stay available if it has already been saved." },
            { x => x.ButtonText, "Remove" },
            { x => x.Color, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(
            "Remove receipt", parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (!await dialog.ConfirmedAsync())
            return;

        if (await ReceiptAttachments.DeleteAsync(TransactionId, attachment.Id))
            _attachments = _attachments.Where(existing => existing.Id != attachment.Id).ToList();
    }

    private static string FormatFileSize(long length) => length < 1024 * 1024
        ? $"{Math.Max(1, length / 1024)} KB"
        : $"{length / 1024d / 1024d:0.0} MB";

    private void Close()
    {
        if (_transcribingAttachmentId is null)
            MudDialog.Close();
    }
}
