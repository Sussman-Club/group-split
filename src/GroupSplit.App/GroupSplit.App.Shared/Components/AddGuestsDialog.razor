@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@*
    Adding people to a group, by name, as guests.

    It used to ask for email addresses, and that limited a group to people whose address
    somebody happened to have -- which is not how most people know the friend they went on
    the trip with. Then it asked for names and minted each one a link, which was still an
    invitation: the dialog said "Invite", the tab listed them as "waiting", and most of them
    were never going to answer, because most people a group splits with never want an
    account. Now a name is the whole of it. They are a guest the moment this closes, the
    members record everything for them, and a link is a separate thing a member can send
    later, from the People tab, to the few who want to take their place themselves.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @MudDialog.Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="gs-muted" Style="padding-bottom: 8px">
            Name whoever is sharing the costs. They join as guests: you can record expenses,
            shares and repayments for them right away. Nobody gets a link unless you send one.
        </MudText>

        <MudForm @ref="@_form">
            <MudStack Row AlignItems="AlignItems.Center">
                @* The same bound the API and the columns behind it hold, so somebody is
                   stopped at the keyboard rather than at Add. *@
                <MudTextField @bind-Value="_currentInput"
                              Label="Name"
                              Variant="Variant.Outlined"
                              MaxLength="InviteToGroupRequest.NameLength"
                              OnKeyDown="@HandleKeyDown"
                              Immediate
                              Placeholder="Type a name…"/>
                <MudIconButton Icon="@Icons.Material.Rounded.Add" OnClick="@AddNameToList"
                               aria-label="Add this person"
                               Color="Color.Primary"/>
            </MudStack>
        </MudForm>

        <MudChipSet T="string" Style="padding-top: 5px;">
            @* Who is already here, guests included, so nobody is named twice by accident. *@
            @foreach (var person in CurrentUsers)
            {
                <MudChip T="UserInfo" Value=person Variant="Variant.Filled" Color="Color.Primary">
                    @person.Label()
                </MudChip>
            }
            @foreach (var name in _model.Names)
            {
                <MudChip T="string" Value=name CloseIcon="@Icons.Material.Rounded.Close"
                         OnClose="@CloseChip" Variant="Variant.Outlined" Color="Color.Primary">
                    @name
                </MudChip>
            }
        </MudChipSet>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   Disabled="@(_model.Names.Count == 0)" OnClick="@Submit">
            Add
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;

    [Parameter]
    public UserInfo[] CurrentUsers
    {
        get => field ?? [];
        set;
    }

    private string _currentInput = string.Empty;

    /// <summary>
    /// What the dialog hands back. No links, ever, from here: <see cref="AddGuestsRequest.IssueLinks"/>
    /// stays false, because sending somebody a link is a decision about that one person and
    /// belongs on their row, not a tick box beside a list of names.
    /// </summary>
    private readonly AddGuestsRequest _model = new() { IssueLinks = false };

    /// <summary>
    /// Adds the typed name to the list. Duplicates within this dialog are dropped, because
    /// pressing Enter twice is not two people -- but two people really can share a name, so
    /// nothing stops somebody adding a second Dani later.
    /// </summary>
    private void AddNameToList()
    {
        var name = _currentInput.Trim();

        if (name.Length == 0)
            return;

        if (_model.Names.Any(existing => string.Equals(existing, name, StringComparison.OrdinalIgnoreCase)))
            return;

        _model.Names.Add(name);

        _currentInput = string.Empty;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddNameToList();
    }

    private Task Submit()
    {
        // Whatever is still in the box counts: somebody typing one name and pressing the
        // button has not "forgotten" to press Enter first.
        AddNameToList();

        MudDialog.Close(DialogResult.Ok(_model));
        return Task.CompletedTask;
    }

    private void CloseChip(MudChip<string> chip)
    {
        if (chip.Value is not null)
            _model.Names.Remove(chip.Value);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
