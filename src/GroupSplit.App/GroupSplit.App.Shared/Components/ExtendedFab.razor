@namespace GroupSplit.App.Shared.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

<button type="button"
        @ref="_button"
        class="gs-fab @(AlwaysExtended ? "is-extended" : "")"
        aria-label="@AriaLabel"
        @onclick="OnClick">
    <MudIcon Icon="@Icon" />
    <span>@(Label ?? Loc["Add"])</span>
</button>

@code {
    private ElementReference _button;
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/GroupSplit.App.Shared/js/floating-expense.js");
        // Navigation can remove this component while its module is downloading.
        if (_disposed)
        {
            if (module is not null) await module.DisposeAsync();
            return;
        }
        _module = module;
        if (_module is not null)
            await _module.InvokeVoidAsync("observe", _button);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("disconnect", _button);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    [Parameter] public string? Label { get; set; }
    [Parameter] public bool AlwaysExtended { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Rounded.Add;

    private string AriaLabel => Label ?? Loc["Add"];
}
