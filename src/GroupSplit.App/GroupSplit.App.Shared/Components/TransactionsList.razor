@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IDialogService DialogService

<div class="gs-list">
    @if (Transactions.Count == 0)
    {
        <div class="gs-empty">
            <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" />
            <h3>Nothing recorded yet</h3>
            <span>Add the first expense and it will show up here.</span>
        </div>
    }
    else
    {
        var i = 0;
        foreach (var transaction in Transactions.Take(Limit))
        {
            var t = transaction;
            <a class="gs-row gs-reveal" style="--i: @(i++)" role="button" tabindex="0"
               @onclick="() => ViewExpenseDetails(t)"
               @onkeydown="@(e => e.Key is "Enter" or " " ? ViewExpenseDetails(t) : Task.CompletedTask)">
                <Avatar Name="@t.PaidByUserName" />
                <div style="min-width: 0">
                    <div class="title">
                        <span>@t.Name</span>
                        @if (!string.IsNullOrWhiteSpace(t.Category))
                        {
                            <span class="gs-tag">@t.Category</span>
                        }
                    </div>
                    <div class="meta">Paid by @t.PaidByUserName</div>
                </div>
                <div>
                    <div class="gs-money">@t.Amount.ToString("C")</div>
                    <span class="when">@Relative(t.DateTime)</span>
                </div>
            </a>
        }
    }
</div>

@code {
    [Parameter] public ICollection<TransactionResponse> Transactions { get; set; } = [];

    /// <summary>How many rows to show; the rest are on the Expenses page.</summary>
    [Parameter] public int Limit { get; set; } = int.MaxValue;

    private static string Relative(DateTimeOffset when)
    {
        var local = when.LocalDateTime;
        var days = (DateTime.Today - local.Date).Days;

        return days switch
        {
            0 => "Today",
            1 => "Yesterday",
            < 7 => local.ToString("dddd"),
            _ when local.Year == DateTime.Today.Year => local.ToString("d MMM"),
            _ => local.ToString("d MMM yyyy")
        };
    }

    private async Task ViewExpenseDetails(TransactionResponse transaction)
    {
        var parameters = new DialogParameters<TransactionDetailsDialog>
        {
            { x => x.TransactionId, transaction.Id }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<TransactionDetailsDialog>("Transaction Details", parameters, options);
    }
}
