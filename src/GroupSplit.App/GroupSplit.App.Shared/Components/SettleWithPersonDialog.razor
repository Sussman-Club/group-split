@using GroupSplit.Shared
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Errors
@namespace GroupSplit.App.Shared.Components
@inject IUsersClient UsersClient
@inject ApiErrorPresenter Errors
@inject LocalClock Clock

@*
    Recording one payment between two people, wherever the debt between them lives.

    The same dialog as SettleDialog, one level up: that one settles inside a group, because
    a balance belongs to a group. This one takes the person and the amount and lets the API
    write the per-group transfers behind it -- which is the whole point, and is why the
    groups are listed here rather than asked about. Somebody handing over money should not
    have to do the bookkeeping.
*@

@* gs-sheet: the full screen on a phone, with the actions held at the bottom. Every
   dialog that records money wears it -- filing a row and settling up end in the
   same press as adding an expense, and a save button below a scroll is the same
   nuisance whichever dialog it is in. *@
<MudDialog Class="gs-sheet">
    <TitleContent>
        <MudText Typo="Typo.h5">@Loc["Settle with {0}", Person.UserName].Value</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="3">

                <MudText Typo="Typo.subtitle2">@Standing</MudText>

                @* A guest cannot sign in to say they paid or were paid, so whatever is
                   recorded here is the reader's word for both of them. Said under the
                   figure, because it is about who does the recording and not about how
                   much. *@
                @if (Person.IsGuest && Person.Groups.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="gs-muted">@Loc["{0} is a {1}, so you are recording this for them.", Person.UserName, ParticipantCopy.GuestIn(Person.Groups[0].GroupName)].Value</MudText>
                }

                @* Where the figure comes from, so the arithmetic is checkable here rather
                   than by opening two groups. Shown whenever the debt spans more than one,
                   because that is exactly the case the person has never been able to see. *@
                @if (Shown.Groups.Count > 1)
                {
                    <div class="gs-settle-breakdown">
                        @foreach (var part in Shown.Groups)
                        {
                            <div class="gs-settle-breakdown-row">
                                <span>@part.GroupName</span>
                                <Money Value="part.Amount" />
                            </div>
                        }
                    </div>
                    <MudText Typo="Typo.caption">@Loc["One payment, {0} groups. Recording it writes a transfer in each, largest first — a balance belongs to a group and cannot be cleared from outside one.", Shown.Groups.Count].Value</MudText>
                }

                <DecimalField @bind-Value="_model.Amount"
                              For="@(() => _model.Amount)"
                              Label="@(YouPaid ? Loc["Amount you paid"].Value : Loc["Amount they paid"].Value)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                              AdornmentColor="Color.Primary"
                              HideSpinButtons="true"
                              Validation="@(new Func<decimal, IEnumerable<string>>(ValidateAmount))" />

                <MudText Typo="Typo.caption">@Remaining</MudText>

                @* A month at a time, as in SettleDialog: what activity dated up to the day
                   left owing between the two of them, after the repayments made for it.
                   It changes the figure and the groups it lands in, so both are read again. *@
                @if (_choosingPeriod)
                {
                    <MudDatePicker Date="_through" DateChanged="@ThroughChanged"
                                   Label="@Loc["Only activity up to"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   MaxDate="@Clock.Today"
                                   Disabled="@_readingPeriod"
                                   HelperText="@PeriodHelp" />
                }
                else
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="align-self-start"
                               StartIcon="@Icons.Material.Outlined.EventAvailable"
                               OnClick="@(() => _choosingPeriod = true)">
                        Settle only up to a day…
                    </MudButton>
                }

                <MudDatePicker Date="_date" DateChanged="@DateChanged"
                               Label="@Loc["When"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               HelperText="@Loc["Defaults to now."]" />

                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="@Loc["Note"]"
                              Variant="Variant.Outlined"
                              Placeholder="@Loc["Cash, bank transfer, a reference…"]" />

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="@Submit"
                   Disabled="@(_readingPeriod || Shown.Amount <= 0)">
            @(YouPaid ? Loc["I paid them"].Value : Loc["They paid me"].Value)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public PersonSettlement Person { get; set; } = null!;

    /// <summary>
    /// Which way the money went. The caller knows: the dialog opens from under "you pay"
    /// or from under "you are owed", and those are the two answers.
    /// </summary>
    [Parameter] public SettlementDirection Direction { get; set; } = SettlementDirection.TheyPaidYou;

    private MudForm _form = null!;
    private SettleWithPersonRequest _model = new();
    private DateTime? _date;

    private bool _choosingPeriod;
    private bool _readingPeriod;
    private DateTime? _through;

    /// <summary>
    /// The person as the plan through the picked day sees them, while one is picked: the
    /// figure and the groups behind it are both that period's.
    /// </summary>
    private PersonSettlement? _forPeriod;

    private PersonSettlement Shown => _forPeriod ?? Person;

    private bool YouPaid => Direction is SettlementDirection.YouPaidThem;

    private string Standing => (_through, YouPaid) switch
    {
        ({ } day, true) => Loc["For activity up to {0:d MMM}, you owe {1} {2}", day, Person.UserName, Shown.Amount.ToMoney()].Value,
        ({ } day, false) => Loc["For activity up to {0:d MMM}, {1} owes you {2}", day, Person.UserName, Shown.Amount.ToMoney()].Value,
        (null, true) => Loc["You owe {0} {1}", Person.UserName, Person.Amount.ToMoney()].Value,
        (null, false) => Loc["{0} owes you {1}", Person.UserName, Person.Amount.ToMoney()].Value
    };

    private string PeriodHelp => _through is { } day && Shown.Amount <= 0
        ? Loc["Nothing is outstanding between you for activity up to {0:d MMM}.", day].Value
        : Loc["Repayments for later count only as far as they pay it down. Clear it to settle everything."].Value;

    protected override void OnInitialized()
    {
        _model = new SettleWithPersonRequest
        {
            UserId = Person.UserId,
            Amount = Person.Amount,
            Direction = Direction
        };
    }

    /// <summary>
    /// Midnight UTC of the day picked, the way a bank row's date is stored -- see the same
    /// note on SettleDialog.
    /// </summary>
    private void DateChanged(DateTime? date)
    {
        _date = date;

        _model.Date = date is { } chosen ? TransactionDay.Stored(chosen) : null;
    }

    /// <summary>
    /// The amount is editable, as in the per-group dialog, and the screen never suggests
    /// paying part of it. Partial payments are how balances rot.
    /// </summary>
    /// <summary>
    /// Reads the cross-group plan through the day on this viewer's calendar, and takes this
    /// person's line from it -- an empty one when the period left nothing between them.
    /// </summary>
    private async Task ThroughChanged(DateTime? through)
    {
        _through = through;

        if (through is not { } day)
        {
            _forPeriod = null;
            _model.Through = null;
            _model.UtcOffset = null;
            _model.Amount = Person.Amount;
            return;
        }

        var cutoff = DateOnly.FromDateTime(day);
        var offset = Clock.CutoffOffsetMinutes;
        _readingPeriod = true;

        try
        {
            SettlementPlanResponse? plan = null;

            var read = await Errors.TryAsync(async () =>
                    plan = await UsersClient.GetSettlementPlanAsync(cutoff, offset),
                Loc["Could not read what that period left owing."].Value);

            if (!read || plan is null)
            {
                _through = null;
                return;
            }

            var side = YouPaid ? plan.YouPay : plan.OwedToYou;

            _forPeriod = side.FirstOrDefault(entry => entry.UserId == Person.UserId)
                         ?? Person with { Amount = 0m, Groups = [] };
            _model.Through = cutoff;
            _model.UtcOffset = offset;
            _model.Amount = _forPeriod.Amount;
        }
        finally
        {
            _readingPeriod = false;
        }
    }

    /// <summary>
    /// What is left after this payment, or how far past the figure it goes -- which is
    /// allowed, as in SettleDialog. The excess lands on the largest group.
    /// </summary>
    private string Remaining => (Shown.Amount - _model.Amount) switch
    {
        >= 0 and var left => Loc["Remaining after this: {0}", left.ToMoney()].Value,
        var over => _through is null
            ? Loc["{0} more than is outstanding. It stays in the balance between you.", (-over).ToMoney()]
            : Loc["{0} more than that period left owing. It stays in the balance between you.", (-over).ToMoney()]
    };

    private IEnumerable<string> ValidateAmount(decimal amount)
    {
        if (amount <= 0)
            yield return Loc["Amount must be greater than 0."].Value;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
