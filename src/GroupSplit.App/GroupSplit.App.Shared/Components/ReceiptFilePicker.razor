@using Microsoft.AspNetCore.Components.Forms
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IServiceProvider Services

<div class="gs-file-picker">
    @* Keep the input mounted after selection. Blazor's IBrowserFile reads from the
       browser input element, so removing it before the separate Read step invalidates
       the file handle. The input is visually hidden; the label provides the UI. *@
    <InputFile id="@_inputId"
               OnChange="FileChanged"
               accept="@Accept"
               disabled="@IsBusy"
               class="gs-file-picker-input"
               aria-label="@Loc["Receipt file"]" />
    <div class="gs-file-picker-dropzone" hidden="@IsAttached">
        <label for="@_inputId" class="gs-file-picker-main-action">
            <span class="gs-file-picker-mark" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" />
            </span>
            <span class="gs-file-picker-copy">
                <span class="gs-file-picker-title">@(Title ?? Loc["Attach the original receipt"])</span>
                <span class="gs-file-picker-subtitle">@(Description ?? Loc["Keep the file now. Read it when you are ready."])</span>
                <span class="gs-file-picker-formats">@Loc["JPG, PNG, WebP or PDF · up to 10 MB"]</span>
            </span>
            <span class="gs-file-picker-action">@Loc["Browse"]</span>
        </label>
        @if (Camera is not null)
        {
            <button type="button" class="gs-file-picker-camera-action" disabled="@(IsBusy || _capturing)" @onclick="CaptureAsync">
                <MudIcon Icon="@Icons.Material.Rounded.PhotoCamera" Size="Size.Small" />
                <span>@Loc["Scan receipt"]</span>
            </button>
        }
        else
        {
            <label class="gs-file-picker-camera-action">
                <MudIcon Icon="@Icons.Material.Rounded.PhotoCamera" Size="Size.Small" />
                <span>@Loc["Scan receipt"]</span>
                @* A direct tap on the input preserves the browser's camera activation.
                   Keep it mounted after selection so its file handle remains readable. *@
                <InputFile OnChange="FileChanged" accept="image/*" capture="environment"
                           disabled="@IsBusy" class="gs-file-picker-camera-input"
                           aria-label="@Loc["Scan receipt with camera"]" />
            </label>
        }
    </div>
    @if (IsAttached)
    {
        <div class="gs-file-picker-attached">
            <span class="gs-file-picker-mark is-success" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Rounded.Check" />
            </span>
            <span class="gs-file-picker-copy">
                <span class="gs-file-picker-title">@(FileName ?? Loc["Receipt attached"].Value)</span>
                <span class="gs-file-picker-subtitle">@(AttachedDescription ?? Loc["Receipt attached"])</span>
            </span>
            <div class="gs-file-picker-actions">
                <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           Class="gs-btn-pill gs-file-picker-replace" Disabled="@IsBusy">
                    @Loc["Change file"]
                    @* A direct native input tap also works in phone browsers. Keep both
                       inputs mounted so replacing one never invalidates the other handle. *@
                    <InputFile OnChange="FileChanged" accept="@Accept" disabled="@IsBusy"
                               class="gs-file-picker-replace-input" aria-label="@Loc["Change receipt file"]" />
                </MudButton>
            @if (ReadRequested.HasDelegate)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           ButtonType="ButtonType.Button"
                           Class="gs-btn-pill gs-file-picker-read"
                           Disabled="@IsBusy"
                           OnClick="RequestReadAsync">
                    @(HasTranscript ? Loc["Read again"].Value : Loc["Read receipt"].Value)
                </MudButton>
            }
            </div>
        </div>
    }

    @if (IsBusy)
    {
        <div class="gs-file-picker-status" role="status">
            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
            <span>@(BusyText ?? Loc["Working on receipt…"])</span>
        </div>
    }

    @if (HasTranscript && !IsBusy)
    {
        <div class="gs-file-picker-transcript" role="status">
            <MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" />
            <span>@Loc["Receipt checked · {0} item(s) ready to use.", TranscriptItemCount].Value</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@Error</MudAlert>
    }
    @if (_cameraError is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_cameraError</MudAlert>
    }
</div>

@code {
    private readonly string _inputId = $"receipt-picker-{Guid.NewGuid():N}";
    private GroupSplit.App.Shared.Services.IReceiptCamera? Camera =>
        Services.GetService(typeof(GroupSplit.App.Shared.Services.IReceiptCamera)) as GroupSplit.App.Shared.Services.IReceiptCamera;
    private bool _capturing;
    private string? _cameraError;

    private async Task CaptureAsync()
    {
        if (IsBusy || _capturing || Camera is not { } camera)
            return;
        _capturing = true;
        _cameraError = null;
        try
        {
            var file = await camera.CaptureAsync();
            if (file is not null)
                await FileChanged.InvokeAsync(new InputFileChangeEventArgs([file]));
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _cameraError = Loc["Could not take a receipt photo. Check camera permission in your phone settings, or use Browse to attach a photo."].Value;
        }
        finally
        {
            _capturing = false;
        }
    }

    [Parameter] public EventCallback<InputFileChangeEventArgs> FileChanged { get; set; }
    [Parameter] public EventCallback ReadRequested { get; set; }
    [Parameter] public string Accept { get; set; } = ReceiptFileTypes.Accept;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? FileName { get; set; }
    [Parameter] public bool IsAttached { get; set; }
    [Parameter] public string? AttachedDescription { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? BusyText { get; set; }
    [Parameter] public bool HasTranscript { get; set; }
    [Parameter] public int TranscriptItemCount { get; set; }
    [Parameter] public string? Error { get; set; }

    private Task RequestReadAsync() => ReadRequested.InvokeAsync();
}
