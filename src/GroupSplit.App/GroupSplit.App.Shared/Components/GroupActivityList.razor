@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes
@inject LocalClock Clock
@implements IDisposable

@*
    Everything that has happened in a group, in order: what it spent and who has paid whom.

    The only listing that shows transfers. Every other one reads the expenses and cannot
    see them, which is what stopped a settlement turning up as a negative expense in the
    grid and in every total -- but a balance moving with nothing to explain it is its own
    kind of wrong, and "Omar paid you 40" is the row somebody comes here for.
*@

<div class="gs-card gs-card-pad">
    <div class="gs-card-title">
        <h2>Activity</h2>
        @if (_page is { TotalCount: > 0 } loaded)
        {
            <span class="gs-tag neutral">@loaded.TotalCount entr@(loaded.TotalCount == 1 ? "y" : "ies")</span>
        }
    </div>

    @if (_page is null)
    {
        <div class="gs-empty" style="padding: 24px"><span>Loading…</span></div>
    }
    else if (_page.Items.Count == 0)
    {
        <div class="gs-empty" style="padding: 32px">
            <MudIcon Icon="@Icons.Material.Rounded.History" />
            <h3>Nothing has happened yet</h3>
            <span>Expenses and settlements will appear here as they are recorded.</span>
        </div>
    }
    else
    {
        <div class="gs-list">
            @{ var i = 0; }
            @foreach (var entry in _page.Items)
            {
                <div class="gs-row gs-reveal" style="--i: @(i++); cursor: default">
                    <span class="gs-row-icon">
                        <MudIcon Icon="@(entry.Kind is ActivityKind.Transfer
                                           ? Icons.Material.Rounded.Handshake
                                           : Icons.Material.Rounded.ReceiptLong)" />
                    </span>
                    <div style="min-width: 0">
                        <div class="title">
                            <span>@Headline(entry)</span>
                            @if (entry.Kind is ActivityKind.Transfer)
                            {
                                <span class="gs-tag neutral">Settlement</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(entry.Category))
                            {
                                <span class="gs-tag">@entry.Category</span>
                            }
                        </div>
                        <div class="meta">@Detail(entry)</div>
                    </div>
                    <div>
                        <div><Money Value="entry.Amount" /></div>
                        <span class="when">@Clock.Local(entry.DateTime).ToString("d MMM yyyy")</span>
                    </div>
                </div>
            }
        </div>

        @if (_page.TotalCount > _page.Items.Count)
        {
            <div style="display: flex; justify-content: center; padding-top: 12px">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           Disabled="@_loading"
                           OnClick="@ShowMoreAsync">Show more</MudButton>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid GroupId { get; set; }

    /// <summary>How many entries to show at a time. A history is read, not paged through.</summary>
    [Parameter] public int PageSize { get; set; } = 15;

    private PagedResponse<GroupActivityResponse>? _page;
    private int _shown;
    private bool _loading;
    private Guid _loadedFor;

    private static string Headline(GroupActivityResponse entry) =>
        entry.Kind is ActivityKind.Transfer
            ? $"{entry.PaidByUserName} paid {entry.PaidToUserName}"
            : entry.Name;

    private static string Detail(GroupActivityResponse entry) =>
        entry.Kind is ActivityKind.Transfer
            ? "Settling up"
            : $"Paid by {entry.PaidByUserName}";

    protected override void OnInitialized() => Changes.TransactionsChanged += ReloadAsync;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == GroupId) return;

        _loadedFor = GroupId;
        _shown = PageSize;
        _page = null;

        await LoadAsync();
    }

    private Task ShowMoreAsync()
    {
        _shown += PageSize;
        return LoadAsync();
    }

    // One page that grows, rather than a pager: the entries mean the most read in order,
    // and a page two that hides page one breaks the reading.
    private async Task LoadAsync()
    {
        _loading = true;

        await Errors.TryAsync(async () =>
                _page = await GroupsClient.GetGroupActivityAsync(
                    _loadedFor, page: 1, pageSize: _shown),
            "Could not load this group's activity.");

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task ReloadAsync() => _loadedFor == Guid.Empty ? Task.CompletedTask : LoadAsync();

    public void Dispose() => Changes.TransactionsChanged -= ReloadAsync;
}
