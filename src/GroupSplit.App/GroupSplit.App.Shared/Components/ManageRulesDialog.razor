@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Errors
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ICategoriesClient CategoriesClient
@inject ISplitRulesClient SplitRulesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ApiErrorPresenter Errors

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">
            Manage categories
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
            }

            <MudTable Items="_categories">
                <HeaderContent>
                    <MudTh>Category</MudTh>
                    <MudTh>Split</MudTh>
                    <MudTh class="text-right">Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@(context.DefaultSplitRuleName ?? "Even split")</MudTd>
                    <MudTd Class="text-right">
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="@(async () => await OpenEditRuleDialog(context))"/>
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(async () => await OpenDeleteRuleDialog(context))"/>
                        </MudStack>

                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4">
                        No categories yet. Expenses without one are split evenly.
                    </MudText>
                </NoRecordsContent>
            </MudTable>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Add"
                       Class="align-self-end"
                       OnClick="@OpenCreateRuleDialog">
                Create category
            </MudButton>

        </MudStack>
    </DialogContent>
</MudDialog>


@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid GroupId { get; set; }

    // Always replaced, never edited in place: the table looks again when the reference changes.
    private ICollection<CategoryResponse> _categories = [];

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Run(
            async () => _categories = await CategoriesClient.GetCategoriesAsync(GroupId),
            "Could not load the categories.");

        if (!loaded) MudDialog.Cancel();

        StateHasChanged();
    }

    /// <summary>
    /// A refusal stays in the dialog, inline, so the list and the buttons remain usable and
    /// the person can correct course without reopening it. Only a lost session leaves the
    /// dialog, because only signing in again can fix that.
    /// </summary>
    private async Task<bool> Run(Func<Task> action, string context)
    {
        var error = await Errors.CaptureAsync(action);

        if (error is null)
        {
            _error = null;
            return true;
        }

        if (error.Kind == ApiErrorKind.Unauthenticated || error.Message.Length == 0)
        {
            await Errors.ShowAsync(error);
            return false;
        }

        _error = $"{context} {error.Message}";
        StateHasChanged();
        return false;
    }

    private async Task OpenCreateRuleDialog()
    {
        var parameters = new DialogParameters<CreateRuleDialog>
        {
            { x => x.GroupId, GroupId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<CreateRuleDialog>("Create category", parameters, options);
        var model = await dialog.GetReturnValueAsync<RuleEditorForm.RuleEditorModel>();

        if (model is not null)
            await CreateCategory(model);
    }

    /// <summary>
    /// Two writes, because they are two things: the division the group keeps, and the label
    /// that points at it. The form asks for them as one because that is how a group thinks
    /// of them, and the rule is named after the category that introduced it -- until
    /// somebody notices two categories divide alike and points them at one rule.
    /// </summary>
    private async Task CreateCategory(RuleEditorForm.RuleEditorModel model)
    {
        var created = await Run(async () =>
        {
            var rule = await SplitRulesClient.CreateSplitRuleAsync(new CreateSplitRuleRequest
            {
                GroupId = GroupId,
                Name = model.Category,
                Definition = model.Version
            });

            var category = await CategoriesClient.CreateCategoryAsync(new CreateCategoryRequest
            {
                GroupId = GroupId,
                Name = model.Category,
                DefaultSplitRuleId = rule.Id
            });

            _categories = [.._categories, category];
        }, "Could not create the category.");

        if (!created) return;

        Snackbar.Add("Category created.", Severity.Success);
        StateHasChanged();
    }

    private async Task OpenEditRuleDialog(CategoryResponse category)
    {
        // A category with no rule of its own is edited as an even split, which is what it
        // already does.
        SplitRuleDto definition = new EvenSplitRuleDto();

        if (category.DefaultSplitRuleId is { } ruleId)
        {
            var loaded = await Run(
                async () => definition = (await SplitRulesClient.GetSplitRuleAsync(ruleId)).Definition,
                "Could not load the split.");

            if (!loaded) return;
        }

        var original = new RuleEditorForm.RuleEditorModel
        {
            Category = category.Name,
            Version = definition
        };

        var parameters = new DialogParameters<EditRuleDialog>
        {
            { x => x.GroupId, GroupId },
            { x => x.OriginalModel, original }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<EditRuleDialog>("Edit category", parameters, options);
        var edited = await dialog.GetReturnValueAsync<RuleEditorForm.RuleEditorModel>();

        if (edited is not null)
            await UpdateCategory(category, edited);
    }

    private async Task UpdateCategory(CategoryResponse category, RuleEditorForm.RuleEditorModel model)
    {
        var updated = await Run(async () =>
        {
            var ruleId = category.DefaultSplitRuleId;

            if (ruleId is { } existing)
            {
                await SplitRulesClient.UpdateSplitRuleAsync(existing, new UpdateSplitRuleRequest
                {
                    Name = model.Category,
                    Definition = model.Version
                });
            }
            else
            {
                // It divided evenly by having no rule; now it has one to name.
                ruleId = (await SplitRulesClient.CreateSplitRuleAsync(new CreateSplitRuleRequest
                {
                    GroupId = GroupId,
                    Name = model.Category,
                    Definition = model.Version
                })).Id;
            }

            var response = await CategoriesClient.UpdateCategoryAsync(category.Id, new UpdateCategoryRequest
            {
                Name = model.Category,
                DefaultSplitRuleId = ruleId
            });

            var list = _categories.ToList();
            var index = list.FindIndex(x => x.Id == category.Id);

            if (index != -1)
            {
                list[index] = response;
                _categories = list;
            }
        }, "Could not update the category.");

        if (!updated) return;

        Snackbar.Add("Category updated.", Severity.Success);
        StateHasChanged();
    }

    private async Task OpenDeleteRuleDialog(CategoryResponse category)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the category '{category.Name}'?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete category", parameters);
        var confirmed = await dialog.ConfirmedAsync();

        if (confirmed)
            await DeleteCategory(category);
    }

    private async Task DeleteCategory(CategoryResponse category)
    {
        var deleted = await Run(async () =>
        {
            await CategoriesClient.DeleteCategoryAsync(category.Id);
            _categories = _categories.Where(c => c.Id != category.Id).ToList();
        }, "Could not delete the category.");

        if (!deleted) return;

        Snackbar.Add("Category deleted.", Severity.Success);
        StateHasChanged();
    }
}
