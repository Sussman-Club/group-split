@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Errors
@namespace GroupSplit.App.Shared.Components
@inject IReceiptsClient Client
@inject IDialogService Dialogs
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
<MudButton OnClick="Open" Disabled="_busy">Choose receipt from inbox</MudButton>
@code {
    [Parameter] public Guid ExpenseId { get; set; }
    [Parameter] public EventCallback Attached { get; set; }
    private bool _busy;
    private async Task Open()
    {
        var dialog = await Dialogs.ShowAsync<ReceiptInboxPickerDialog>("Choose private receipt");
        if (await dialog.Result is { Canceled: false, Data: ReceiptInboxResponse receipt })
        {
            _busy = true;
            try
            {
                if (await Errors.TryAsync(async () => await Client.FileReceiptInboxAsync(receipt.Id, new() { ExpenseId = ExpenseId }), "Could not attach receipt."))
                { await Attached.InvokeAsync(); Nav.NavigateTo(Nav.Uri, forceLoad: true); }
            }
            finally { _busy = false; }
        }
    }
}
