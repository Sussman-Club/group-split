@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

<MudDialog>
    <DialogContent>
        <p class="gs-muted" style="margin-top: 0">@Loc["{0} · Select a category to filter the ledger.", Period].Value</p>
        <div class="gs-category-breakdown">
            @foreach (var bucket in Spending.OtherCurrencies.Prepend(new CategoryCurrencySpendingResponse(Spending.Currency, Spending.Categories)))
            {
                <h3>@bucket.Currency</h3>
                @foreach (var category in bucket.Categories)
                {
                <button type="button" class="gs-category-row" @onclick="@(() => Select(category))">
                    <span class="gs-category-detail">
                        <strong>@category.Name</strong>
                        <span class="gs-muted">@category.Count expense@(category.Count == 1 ? "" : "s")</span>
                        <span class="gs-category-bar" aria-hidden="true">
                            <span style="width: @Width(category.Total, bucket.Categories)"></span>
                        </span>
                    </span>
                    <span class="gs-right">
                        <Money Value="category.Total" Currency="@bucket.Currency" />
                        @if (!Personal)
                        {
                            <span class="gs-muted gs-category-share">@Loc["Copy.Lower.your_share_{0}", category.Share.ToMoney(bucket.Currency)].Value</span>
                        }
                    </span>
                </button>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@Loc["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public CategorySpendingSummaryResponse Spending { get; set; } = null!;
    [Parameter] public bool Personal { get; set; }
    [Parameter] public string Period { get; set; } = "";

    private void Select(CategorySpendingResponse category) => MudDialog.Close(DialogResult.Ok(category));

    private string Width(decimal amount, IReadOnlyList<CategorySpendingResponse> categories)
    {
        var total = categories.Sum(category => category.Total);
        var percent = total == 0 ? 0 : Math.Clamp(amount * 100m / total, 0m, 100m);
        return percent.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture) + "%";
    }
}
