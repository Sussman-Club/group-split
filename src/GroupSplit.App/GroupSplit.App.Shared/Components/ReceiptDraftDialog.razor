@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Commands
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@using System.ComponentModel.DataAnnotations
@namespace GroupSplit.App.Shared.Components
@inject IReceiptCommands Receipts

<MudDialog Class="gs-sheet">
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @DialogTitle
        </MudText>
    </TitleContent>

    <DialogContent>
        <div class="gs-stack" style="gap: 16px">
            <MudAlert Severity="Severity.Info" Dense="true">
                @if (IsEditing)
                {
                    <text>Correct the itemized receipt. Changes are saved to this expense.</text>
                }
                else if (IsDraftReview)
                {
                    <text>Check the extracted values before adding the expense. OCR can misread a price or miss a line;
                        after this, choose the group and how the expense is split.</text>
                }
                else
                {
                    <text>Check the extracted values before saving them to this expense. OCR can misread a price or miss a line.</text>
                }
            </MudAlert>

            @if (!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_validationError</MudAlert>
            }

            <div class="gs-receipt-fields">
                <MudTextField @bind-Value="_merchantName" Label="Merchant" Variant="Variant.Outlined" />
                <MudDatePicker @bind-Date="_purchaseDate" Label="Purchase date" Variant="Variant.Outlined" />
                <DecimalField @bind-Value="_subtotal" Label="Items subtotal" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
                <DecimalField @bind-Value="_tax" Label="Tax" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
                <DecimalField @bind-Value="_tip" Label="Tip" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
                <DecimalField @bind-Value="_total" Label="Total paid" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_sourceValues))
            {
                <details class="gs-muted" style="font-size: .8rem">
                    <summary>View extracted source values</summary>
                    <pre style="white-space: pre-wrap; overflow-wrap: anywhere">@_sourceValues</pre>
                </details>
            }

            <div class="gs-muted" style="font-size: .85rem">
                @if (ExpenseAmount is { } expenseAmount)
                {
                    <span>Recorded expense amount: <strong>@expenseAmount.ToMoney(Currency)</strong></span>
                }
                else
                {
                    <span>This receipt will fill the expense details in the previous sheet.</span>
                }
            </div>

            @if (ExpenseAmount is { } expectedAmount && _total != expectedAmount)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The receipt total is @(_total < expectedAmount ? "short" : "over") by
                    @Math.Abs(expectedAmount - _total).ToMoney(Currency). It must match the expense amount.
                    Adjust the receipt figures before @PrimaryActionHint.
                    @PrimaryActionText is disabled until the totals match.
                </MudAlert>
            }

            @if (FigureError is { } figureError)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@figureError</MudAlert>
            }
            @if (CalculatedTaxes.Sum() < _tax && _items.Any(item => item.TaxRate is null && item.IsTaxable != false && item.TotalPrice > 0))
            {
                <MudText Typo="Typo.caption">Mark any tax-exempt items below first, then spread the unassigned tax across the remaining items by price.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" ButtonType="ButtonType.Button" OnClick="DistributeTax">
                    Distribute tax
                </MudButton>
            }

            <div class="gs-inline" style="justify-content: space-between; align-items: center">
                <div>
                    <h3 style="margin: 0; font-size: 1rem">Items</h3>
                    <span class="gs-muted" style="font-size: .8rem">Include coupons as negative lines and free items as zero lines.</span>
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add"
                           OnClick="AddItem">Add item</MudButton>
            </div>

            @for (var index = 0; index < _items.Count; index++)
            {
                var item = _items[index];
                var itemNameError = GetItemNameError(item);
                <div class="gs-stack" @key="item.Key" style="gap: 8px; padding: 12px; border: 1px solid var(--gs-line); border-radius: 8px">
                    <div class="gs-inline" style="justify-content: space-between; gap: 8px">
                        <MudTextField @bind-Value="item.Name" Label="Item" Variant="Variant.Outlined" Immediate="true"
                                      MaxLength="ReceiptItemInput.NameLength" Counter="ReceiptItemInput.NameLength"
                                      Validation="@(new Func<string, IEnumerable<string>>(ValidateItemName))"
                                      Error="@(itemNameError is not null)" ErrorText="@itemNameError"
                                      style="flex: 1" />
                        <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Color="Color.Default"
                                       aria-label="Remove item" OnClick="@(() => RemoveItem(item))" />
                    </div>
                    <div class="gs-receipt-fields">
                        <DecimalField @bind-Value="item.Quantity" Label="Quantity" Variant="Variant.Outlined"
                                      Places="3" HideSpinButtons="true" />
                        <DecimalField @bind-Value="item.UnitPrice" Label="Unit price" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
                        <DecimalField @bind-Value="item.TotalPrice" Label="Line total" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
                        <div class="gs-stack" style="gap: 4px">
                            <DecimalField @key="(item.Key, item.TaxRate is not null || item.IsTaxable == false ? CalculatedTaxes[_items.IndexOf(item)] : (decimal?)null)"
                                          Value="@CalculatedTaxes[_items.IndexOf(item)]"
                                          TextUpdateSuppression="false"
                                          ValueChanged="@((decimal value) => item.TaxAmount = value)"
                                          ReadOnly="@(item.TaxRate is not null || item.IsTaxable == false)"
                                          Label="Line tax" Variant="Variant.Outlined"
                                          Adornment="Adornment.Start" AdornmentText="@Currency" HideSpinButtons="true" />
                            @if (CalculatedTaxes[_items.IndexOf(item)] != item.TaxAmount)
                            {
                                <MudText Typo="Typo.caption">Calculated from the rate and receipt total, including rounding.</MudText>
                            }
                        </div>
                        @if (item.IsTaxable != false)
                        {
                            <DecimalField @bind-Value="item.TaxRate" Label="Tax rate" Variant="Variant.Outlined"
                                          Adornment="Adornment.End" AdornmentText="%" Places="4" HideSpinButtons="true" />
                        }
                        <MudSelect T="bool?" @bind-Value="item.IsTaxable" Label="Tax status" Variant="Variant.Outlined">
                            <MudSelectItem T="bool?" Value="@((bool?)null)">Not identified</MudSelectItem>
                            <MudSelectItem T="bool?" Value="@((bool?)true)">Taxable</MudSelectItem>
                            <MudSelectItem T="bool?" Value="@((bool?)false)">Tax-exempt</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_saving" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   Disabled="@(_saving || HasInvalidItemName || FigureError is not null || (ExpenseAmount is { } expectedAmount && _total != expectedAmount))"
                   OnClick="SaveAsync">
            @(_saving ? "Saving…" : PrimaryActionText)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? TransactionId { get; set; }
    [Parameter] public decimal? ExpenseAmount { get; set; }
    [Parameter] public string Currency { get; set; } = "USD";
    /// <summary>The newly transcribed bill, when this dialog is reviewing OCR output.</summary>
    [Parameter] public ReceiptTranscriptionResponse? Transcription { get; set; }

    /// <summary>The already saved bill, when this dialog is correcting an itemized receipt.</summary>
    [Parameter] public ReceiptResponse? Receipt { get; set; }

    private decimal _subtotal;
    private decimal _tax;
    private decimal _tip;
    private decimal _total;
    private string? _merchantName;
    private DateTime? _purchaseDate;
    private string? _sourceValues;
    private List<EditableLine> _items = [];
    private bool _saving;
    private string? _validationError;
    private string? _loadedSource;

    private bool HasInvalidItemName => _items.Any(item => ValidateItemName(item.Name).Any());
    private decimal[] CalculatedTaxes => ReceiptTaxes.Calculate(_tax, _items.Select(item =>
        new ReceiptTaxLine(item.TotalPrice, item.TaxAmount, item.TaxRate, item.IsTaxable)).ToArray());
    private void DistributeTax()
    {
        var taxes = ReceiptTaxes.Calculate(_tax, _items.Select(item =>
            new ReceiptTaxLine(item.TotalPrice, item.TaxAmount, item.TaxRate, item.IsTaxable)).ToArray(), allocateUnidentified: true);
        for (var index = 0; index < _items.Count; index++)
            _items[index].TaxAmount = taxes[index];
    }
    private string? FigureError
    {
        get
        {
            if (_items.Any(item => item.IsTaxable == false && item.TaxRate is > 0))
                return "A tax-exempt item cannot have a positive tax rate.";
            if (_subtotal + _tax + _tip != _total)
                return "Subtotal, tax, and tip must add up to the total.";
            if (_items.Sum(item => item.TotalPrice) != _subtotal)
                return "Line totals must add up to the subtotal.";
            if (CalculatedTaxes.Sum() != _tax)
                return "Line tax must add up to the receipt tax.";
            return null;
        }
    }
    private bool IsEditing => Receipt is not null;
    private bool IsDraftReview => TransactionId is null;
    private string DialogTitle => IsEditing ? "Edit itemized receipt" : IsDraftReview ? "Check receipt" : "Review receipt";
    private string PrimaryActionText => IsDraftReview ? "Use this receipt" : "Save receipt";
    private string PrimaryActionHint => IsDraftReview ? "using this receipt" : "saving";

    protected override void OnParametersSet()
    {
        var source = Receipt is { } saved
            ? (Key: $"receipt:{saved.Id}", Subtotal: saved.Subtotal, Tax: saved.Tax,
                Tip: saved.Tip, Total: saved.Total,
                MerchantName: saved.MerchantName, PurchaseDate: saved.PurchaseDate,
                SourceValues: saved.SourceValues,
                Items: saved.Items.Select(item => new EditableLine(item)).ToList())
            : Transcription is { } draft
                ? (Key: $"transcription:{draft.AttachmentId}", Subtotal: draft.Receipt.Subtotal,
                    Tax: draft.Receipt.Tax, Tip: draft.Receipt.Tip, Total: draft.Receipt.Total,
                    MerchantName: draft.Receipt.MerchantName, PurchaseDate: draft.Receipt.PurchaseDate,
                    SourceValues: draft.Receipt.SourceValues,
                    Items: draft.Receipt.Items.Select(item => new EditableLine(item)).ToList())
                : throw new InvalidOperationException("A receipt draft or saved receipt is required.");

        if (_loadedSource == source.Key)
            return;

        _loadedSource = source.Key;
        _subtotal = source.Subtotal;
        _tax = source.Tax;
        _tip = source.Tip;
        _total = source.Total;
        _merchantName = source.MerchantName;
        _purchaseDate = source.PurchaseDate?.ToDateTime(TimeOnly.MinValue);
        _sourceValues = source.SourceValues;
        _items = source.Items;
    }

    private void AddItem() => _items.Add(new EditableLine());

    private void RemoveItem(EditableLine item) => _items = _items.Where(candidate => candidate != item).ToList();

    private async Task SaveAsync()
    {
        if (_items.Count == 0)
        {
            _validationError = "Add at least one named item before saving.";
            return;
        }

        if (HasInvalidItemName)
        {
            _validationError = "Correct the highlighted item names before saving.";
            return;
        }

        if (FigureError is { } figureError)
        {
            _validationError = figureError;
            return;
        }

        // A bill attached to an existing expense must agree with its recorded amount. A
        // draft has no expense yet, so it is allowed to become the amount the caller records.
        if (ExpenseAmount is { } expectedAmount && _total != expectedAmount)
            return;

        _validationError = null;
        _saving = true;
        try
        {
            var taxes = CalculatedTaxes;
            for (var index = 0; index < _items.Count; index++)
                _items[index].TaxAmount = taxes[index];
            var request = new SaveReceiptRequest
            {
                Subtotal = _subtotal,
                Tax = _tax,
                Tip = _tip,
                Total = _total,
                MerchantName = _merchantName,
                PurchaseDate = _purchaseDate is { } date ? DateOnly.FromDateTime(date) : null,
                SourceValues = _sourceValues,
                Items = _items.Select(item => new ReceiptItemInput
                {
                    Id = item.Id,
                    Name = item.Name.Trim(),
                    NormalizedName = item.NormalizedName,
                    // An existing line's empty string is an explicit clear; null means a new
                    // line has no source text to preserve.
                    Description = item.Id is not null || !string.IsNullOrWhiteSpace(item.Description)
                        ? item.Description.Trim()
                        : null,
                    Quantity = item.Quantity,
                    UnitPrice = item.UnitPrice,
                    TotalPrice = item.TotalPrice,
                    TaxAmount = item.TaxAmount,
                    TaxRate = item.TaxRate,
                    IsTaxable = item.IsTaxable,
                    SplitRuleVersionId = item.SplitRuleVersionId
                }).ToArray()
            };

            if (TransactionId is { } transactionId)
            {
                var saved = IsTextOnlyEdit()
                    ? await SaveTextOnlyEditAsync(transactionId, request)
                    : await Receipts.SaveAsync(transactionId, request);
                if (saved is not null)
                    MudDialog.Close(DialogResult.Ok(saved));
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(request));
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private bool IsTextOnlyEdit()
    {
        if (Receipt is not { } original || TransactionId is null
            || _subtotal != original.Subtotal || _tax != original.Tax
            || _tip != original.Tip || _total != original.Total
            || _items.Count != original.Items.Count
            || !string.Equals(_merchantName?.Trim(), original.MerchantName, StringComparison.Ordinal)
            || (_purchaseDate is { } date ? DateOnly.FromDateTime(date) : null) != original.PurchaseDate)
            return false;

        return _items.All(item => item.Id is { } id
            && original.Items.FirstOrDefault(candidate => candidate.Id == id) is { } source
            && item.UnitPrice == source.UnitPrice
            && item.Quantity == source.Quantity
            && item.TotalPrice == source.TotalPrice
            && item.TaxAmount == source.TaxAmount
            && item.TaxRate == source.TaxRate
            && item.IsTaxable == source.IsTaxable
            && item.SplitRuleVersionId == source.SplitRuleVersionId);
    }

    /// <summary>
    /// Patches the changed text on one existing line. When more than one line changed, the
    /// whole-receipt save keeps that multi-line edit atomic.
    /// </summary>
    private async Task<ReceiptResponse?> SaveTextOnlyEditAsync(
        Guid transactionId,
        SaveReceiptRequest request)
    {
        var changed = ChangedTextItems();
        if (changed.Count == 0)
            return Receipt;

        if (changed.Count > 1)
            return await Receipts.SaveAsync(transactionId, request);

        return await PatchLineTextAsync(transactionId, changed[0]);
    }

    private IReadOnlyList<EditableLine> ChangedTextItems()
    {
        var original = Receipt!;

        return _items.Where(item =>
        {
            var source = original.Items.Single(candidate => candidate.Id == item.Id);
            var name = item.Name.Trim();
            var description = string.IsNullOrWhiteSpace(item.Description) ? null : item.Description.Trim();
            return !string.Equals(name, source.Name, StringComparison.Ordinal)
                || !string.Equals(description, source.Description, StringComparison.Ordinal);
        }).ToList();
    }

    private async Task<ReceiptResponse?> PatchLineTextAsync(Guid transactionId, EditableLine item)
    {
        var source = Receipt!.Items.Single(candidate => candidate.Id == item.Id);
        var patch = new JsonPatchDocument<ReceiptItemPatch>();
        var name = item.Name.Trim();
        if (!string.Equals(name, source.Name, StringComparison.Ordinal))
            patch.Replace(line => line.Name, name);

        var description = string.IsNullOrWhiteSpace(item.Description) ? null : item.Description.Trim();
        if (!string.Equals(description, source.Description, StringComparison.Ordinal))
            patch.Replace(line => line.Description, description);

        return await Receipts.PatchItemAsync(transactionId, item.Id!.Value, patch);
    }

    private void Cancel() => MudDialog.Cancel();

    private static string? GetItemNameError(EditableLine item) =>
        ValidateItemName(item.Name).FirstOrDefault();

    private static IEnumerable<string> ValidateItemName(string name)
    {
        var item = new ReceiptItemInput { Name = name };
        var validationResults = new List<ValidationResult>();

        Validator.TryValidateProperty(
            item.Name,
            new ValidationContext(item) { MemberName = nameof(ReceiptItemInput.Name) },
            validationResults);

        return validationResults
            .Select(result => result.ErrorMessage)
            .OfType<string>();
    }

    private sealed class EditableLine
    {
        public EditableLine()
        {
        }

        public EditableLine(ReceiptItemInput item)
        {
            Id = item.Id;
            Name = item.Name;
            NormalizedName = item.NormalizedName ?? NormalizeName(item.Name);
            Description = item.Description ?? string.Empty;
            UnitPrice = item.UnitPrice;
            Quantity = item.Quantity;
            TotalPrice = item.TotalPrice;
            TaxAmount = item.TaxAmount;
            TaxRate = item.TaxRate;
            IsTaxable = item.IsTaxable;
            SplitRuleVersionId = item.SplitRuleVersionId;
        }

        public EditableLine(ReceiptItemResponse item)
        {
            Id = item.Id;
            Name = item.Name;
            NormalizedName = string.IsNullOrWhiteSpace(item.NormalizedName)
                ? NormalizeName(item.Name)
                : item.NormalizedName;
            Description = item.Description ?? string.Empty;
            UnitPrice = item.UnitPrice;
            Quantity = item.Quantity;
            TotalPrice = item.TotalPrice;
            TaxAmount = item.TaxAmount;
            TaxRate = item.TaxRate;
            IsTaxable = item.IsTaxable;
            SplitRuleVersionId = item.SplitRuleVersionId;
        }

        public Guid Key { get; } = Guid.NewGuid();
        public Guid? Id { get; }
        private string _name = string.Empty;
        public string Name
        {
            get => _name;
            set
            {
                _name = value;
                NormalizedName = NormalizeName(value);
            }
        }
        public string NormalizedName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal UnitPrice { get; set; }
        public decimal Quantity { get; set; } = 1m;
        public decimal TotalPrice { get; set; }
        public decimal TaxAmount { get; set; }
        public decimal? TaxRate { get; set; }
        private bool? _isTaxable;
        public bool? IsTaxable
        {
            get => _isTaxable;
            set
            {
                _isTaxable = value;
                if (value == false)
                    TaxRate = null;
            }
        }
        public Guid? SplitRuleVersionId { get; set; }

        private static string NormalizeName(string? name) => name?.Trim().ToLowerInvariant() ?? string.Empty;
    }

}
