@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@*
    One person, one payment, and the groups it comes from.

    The line is per person and not per group, which is the whole change: owing the same
    friend in two groups is one payment to one person, and today it is two settlements in
    two dialogs on two pages. The groups are named underneath so the arithmetic stays
    checkable -- the reduction is a convenience, not a black box.
*@

<div class="gs-settle-row">
    <Avatar Name="@Person.UserName" />
    <div style="min-width: 0">
        <div class="who">@Person.UserName</div>
        <div class="meta">@Breakdown</div>
    </div>
    <Money Value="Person.Amount" Animate />
    <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text" OnClick="@OnRecord">
        @(YouPaid ? "I paid them" : "They paid me")
    </MudButton>
    @if (!YouPaid)
    {
        <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text" OnClick="@OnRequest">
            Request payment
        </MudButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public PersonSettlement Person { get; set; } = null!;

    /// <summary>Which side of the plan this line is on, which is what the button says.</summary>
    [Parameter] public SettlementDirection Direction { get; set; } = SettlementDirection.TheyPaidYou;

    [Parameter] public EventCallback OnRecord { get; set; }
    [Parameter] public EventCallback OnRequest { get; set; }

    private bool YouPaid => Direction is SettlementDirection.YouPaidThem;

    /// <summary>
    /// Where the figure comes from. One group renders as just its name -- the amount would
    /// be the total repeated beside itself -- and two or more carry their own amounts,
    /// because that is the case somebody has to be able to check.
    /// </summary>
    /// <remarks>
    /// A guest is always the one-group case: a guest belongs to exactly one group, and the
    /// same real person a guest in two groups is two lines here. Their line says "guest in"
    /// that group, because that is what makes the button beside it the reader's to press --
    /// nobody on the other end can.
    /// </remarks>
    private string Breakdown => Person switch
    {
        { IsGuest: true, Groups.Count: > 0 } => ParticipantCopy.GuestIn(Person.Groups[0].GroupName),
        { Groups.Count: 1 } => Person.Groups[0].GroupName,
        _ => string.Join(" · ", Person.Groups.Select(part =>
            $"{part.Amount.ToMoney()} in {part.GroupName}"))
    };
}
