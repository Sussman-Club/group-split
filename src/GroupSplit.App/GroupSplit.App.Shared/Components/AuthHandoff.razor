@using GroupSplit.App.Shared.Services

@*
    Branded hand-off to the Keycloak-hosted sign-in page.

    Credentials are never collected here. Keycloak owns the forms, which is what
    keeps SSO, MFA, password policy and brute-force protection working; this
    component only explains where the user is going and gets them there.

    The one thing it does collect is "Keep me signed in", and that is why the
    hand-off waits for a click rather than redirecting by itself: Keycloak has a
    checkbox of its own but keeps the answer, so an app federated to it cannot
    find out which was chosen, and the answer has to be given on this side of the
    redirect or not at all.
*@

<div style="flex: 1; display: flex; align-items: center; justify-content: center">
    <div class="gs-auth-card" style="width: 100%; max-width: 26rem; padding: 40px 32px 32px">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center">

            <BrandMark Class="gs-auth-mark" Size="64" />

            <div>
                <div class="gs-eyebrow" style="color: var(--gs-teal)">Group Split</div>
                <h1 style="margin: 8px 0 6px; font-size: 1.75rem; font-weight: 800">@Title</h1>
                <p class="gs-muted" style="margin: 0; font-size: .9375rem">@Subtitle</p>
            </div>

            @* The spinner wins once they have clicked: by then the message has been read
               and what they need is the sign that something is happening. *@
            @if (_redirecting)
            {
                <div class="gs-inline gs-muted" style="font-size: .875rem; padding: 4px 0">
                    <MudProgressCircular Color="Color.Primary" Indeterminate Size="Size.Small" />
                    <span>Taking you to the secure sign-in page…</span>
                </div>
            }
            else if (Error is not null)
            {
                <MudAlert Severity="@(_notice ? Severity.Info : Severity.Error)" Variant="Variant.Outlined" Dense Class="w-100">
                    @Error
                </MudAlert>
            }

            <RememberMeChoice @bind-Value="_remember" Disabled="_redirecting" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth
                       Size="Size.Large"
                       Class="gs-btn-pill"
                       EndIcon="@Icons.Material.Rounded.ArrowForward"
                       Disabled="_redirecting"
                       OnClick="GoAsync">
                @ActionLabel
            </MudButton>

            <p class="gs-muted" style="margin: 4px 0 0; font-size: .75rem">
                Sign-in is handled by our identity provider, so your password never touches this app.
            </p>
        </div>
    </div>
</div>

@code {
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Subtitle { get; set; } = "";
    [Parameter, EditorRequired] public string ActionLabel { get; set; } = "";
    [Parameter] public string? ReturnUrl { get; set; }

    private bool _redirecting;
    private bool _remember;
    private bool _notice;
    private string? Error { get; set; }

    protected override void OnInitialized()
    {
        // A code, resolved here. The query string is whatever the address bar says, and
        // rendering its text verbatim would let anybody put their own sentence in a red
        // box on the app's own sign-in page. See HandoffReason.
        var reason = ReadQueryValue("reason");

        Error = HandoffReason.Message(reason);
        _notice = HandoffReason.IsNotice(reason);
    }

    private async Task GoAsync()
    {
        // The hand-off is a full page load that does not come back, so a second click
        // before the browser has left would start a second one.
        if (_redirecting)
        {
            return;
        }

        _redirecting = true;

        try
        {
            await AuthService.Login(ReturnUrl ?? ReadQueryValue("returnUrl"), _remember);
        }
        catch (OperationCanceledException)
        {
            _redirecting = false;
            Error = "Sign-in was cancelled. You can try again.";
            _notice = true;
        }
        catch (HttpRequestException)
        {
            _redirecting = false;
            Error = "The sign-in server could not be reached. Check your connection and try again.";
            _notice = false;
        }
        catch (InvalidOperationException)
        {
            _redirecting = false;
            Error = "Sign-in could not be completed. Please try again.";
            _notice = false;
        }
    }

    private string? ReadQueryValue(string key)
    {
        var query = new Uri(Nav.Uri).Query;

        return string.IsNullOrEmpty(query)
            ? null
            : (from pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
               let separator = pair.IndexOf('=')
               where separator > 0 && Uri.UnescapeDataString(pair[..separator]) == key
               select Uri.UnescapeDataString(pair[(separator + 1)..])
               into value
               select string.IsNullOrWhiteSpace(value)
                   ? null
                   : value).FirstOrDefault();
    }

}
