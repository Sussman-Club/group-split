@using GroupSplit.App.Shared.Services
@implements IDisposable
@inject ThemePreference Preference
@inject IJSRuntime JS

<MudThemeProvider @ref="_provider"
                  Theme="Theme"
                  IsDarkMode="Preference.IsDark"
                  ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    [Inject] private MudTheme Theme { get; set; } = default!;

    private MudThemeProvider? _provider;

    protected override void OnInitialized() => Preference.Changed += OnChanged;

    public void Dispose() => Preference.Changed -= OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // localStorage is unavailable during prerender, so the stored choice can
        // only be restored once there is a browser to ask.
        if (!firstRender || _provider is null)
        {
            return;
        }

        // Both answers are read before either is applied. Applying them one at a
        // time resolved to dark in between for a dark-desktop user who had chosen
        // Light, for as long as the second interop call took -- long enough to
        // paint -- and let the write-back below race the read it came from.
        var systemIsDark = await _provider.GetSystemDarkModeAsync();
        var storedMode = ThemePreference.Parse(await ReadStoredModeAsync());

        Preference.Hydrate(storedMode, systemIsDark);

        await _provider.WatchSystemDarkModeAsync(isDark =>
        {
            Preference.SetSystemIsDark(isDark);
            return Task.CompletedTask;
        });

        await ApplyDocumentThemeAsync();
        await JS.InvokeVoidAsync("gs.ready");
        StateHasChanged();
    }

    private async Task<string?> ReadStoredModeAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", ThemePreference.StorageKey);
        }
        catch (JSException)
        {
            // Storage can be blocked outright; the system default is a fine answer.
            return null;
        }
    }

    // Mud only swaps its own CSS variables; the custom chrome keys off a
    // data-theme attribute on <html>, which gs.js also stamps before boot.
    private Task ApplyDocumentThemeAsync() => JS.InvokeVoidAsync("gs.setTheme", Preference.IsDark).AsTask();

    private async void OnChanged(ThemeChangeOrigin origin)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
            await ApplyDocumentThemeAsync();

            // Only a choice is worth storing. Writing back what the browser just
            // told us at best repeats the read, and at worst -- as it did during
            // hydration -- races it, leaving "System" where the person's own
            // choice had been.
            if (origin is ThemeChangeOrigin.Choice)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", ThemePreference.StorageKey, Preference.Mode.ToString());
            }
        }
        catch (Exception exception) when (exception is JSException or ObjectDisposedException or TaskCanceledException or InvalidOperationException)
        {
            // Nothing can observe a throw from async void, and none of these are
            // worth tearing the circuit down for: the theme is already applied.
        }
    }
}
