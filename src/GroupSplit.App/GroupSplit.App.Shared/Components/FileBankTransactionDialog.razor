@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ICategoriesClient CategoriesClient
@inject ITransactionCommands Transactions
@inject ApiErrorPresenter Errors
@inject LocalClock Clock
@implements IDisposable

@*
    Turning one imported row into an expense, on the one screen recording any other expense
    takes.

    Into a group or into the person's own, which the request has always allowed and this
    screen did not: it offered groups only, so a card payment that was nobody's business but
    the payer's could be ignored or filed as somebody's share, and nothing else.

    It was two steps -- what it is, then how it is divided -- which is the shape the create
    dialog itself was rescued from: the division was the thing people wanted to see while
    choosing a category, and it sat behind a Next. Filing a row has less to decide than
    recording one from scratch, not more, so there was never enough here to fill two screens.

    What the bank said is shown and not asked for. The amount, the date and the currency are
    facts, not fields -- correcting the bank is editing the expense afterwards, and the row
    goes on saying what the bank said. Everything below them is the person's.
*@

@* gs-sheet: the full screen on a phone, with the actions held at the bottom. Every
   dialog that records money wears it -- filing a row and settling up end in the
   same press as adding an expense, and a save button below a scroll is the same
   nuisance whichever dialog it is in. *@
<MudDialog Class="gs-sheet">
    <TitleContent>
        <div class="gs-dialog-head">
            <div style="min-width: 0">
                <h2 class="gs-dialog-title">@MudDialog.Title</h2>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="gs-stack" style="gap: 16px">
            @* What the bank sent, in the same summary card the expense dialog uses for its
               own figures. It stands where the amount field stands there, because it is
               that -- the amount -- and the only difference is that nobody may type it. *@
            <div class="gs-card gs-card-pad" style="padding: 14px 16px">
                <div class="gs-inline" style="justify-content: space-between">
                    <div>
                        <div class="gs-eyebrow">@Row.Title</div>
                        <div class="gs-muted" style="font-size: .8125rem">@Where</div>
                    </div>
                    <Money Value="@Row.Amount" Currency="@Row.Currency" Class="gs-money" />
                </div>
            </div>

            @* Near the top, because it is the reason to stop. Nothing is decided by showing
               it: the person either goes on, and files a second expense on purpose, or
               attaches the row to the one that is already there. *@
            @if (Match is { } match)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    <div class="gs-stack" style="gap: 8px">
                        <span>
                            You may already have recorded this:
                            <strong>@match.Name</strong>,
                            <Money Value="@match.Amount" Currency="@match.Currency" />
                            in @match.Where on @Clock.Local(match.DateTime).ToString("d").
                        </span>
                        <div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       Class="gs-btn-pill" OnClick="@(() => Attach(match))">
                                That is the same payment
                            </MudButton>
                        </div>
                    </div>
                </MudAlert>
            }

            @* Worded as the create dialog words them. They were "Name" and "Description",
               which is what the fields are called in the request rather than what they are
               asking for, and the same two boxes on the other screen ask better. *@
            <MudTextField @bind-Value="_name"
                          Label="What was it?"
                          Variant="Variant.Outlined"
                          Immediate="true"/>

            <MudTextField @bind-Value="_description"
                          Label="Note"
                          Placeholder="Anything worth remembering about it"
                          HelperText="Optional"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Immediate="true"/>

            @* The same row the create and edit dialogs use. Only two of the five chips: the
               amount, the day and the shop are the bank's account of what happened and not
               open to an opinion here. *@
            <ExpenseDecisions Groups="@(_groups.Select(g => new ExpenseDecisions.GroupChoice(g.Id, g.Name)).ToList())"
                              GroupId="@_groupId"
                              GroupChosen="@_chosen"
                              GroupIdChanged="@OnGroupPickedAsync"
                              GroupName="@GroupName"
                              ShowCategory="@IsShared"
                              Categories="@(_categories.Select(c => new ExpenseDecisions.CategoryChoice(c.Id, c.Name, c.DefaultSplitRuleName)).ToList())"
                              CategoryId="@_categoryId"
                              CategoryIdChanged="@OnCategoryPickedAsync"
                              CategoryHint="@CategoryHint"
                              ShowPayer="false"
                              ShowWhen="false"
                              ShowWhere="false"/>

            @if (IsShared || !_chosen)
            {
                <div style="border-top: 1px solid var(--gs-line); padding-top: 14px">
                    @* One component and one list of people, as the create and edit dialogs
                       have: editable when the division is being stated, read-only when the
                       API worked it out. There used to be an "Everyone's share" block under
                       this one, so stating a division drew every member twice. *@
                    <SplitEditor Members="@_members"
                                 Amount="@Row.Amount"
                                 PayerId="@null"
                                 Value="@_splits"
                                 ValueChanged="@OnSplitsChangedAsync"
                                 Preview="@_preview"
                                 PreviewError="@_previewError"
                                 Awaiting="@_awaiting"/>
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    A personal expense is not shared with anybody, so there is nothing to divide.
                </MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>

        @* Gated on having answered, not on the answer: null is "Personal", which is a
           destination like any other, so it cannot also stand for "not yet said". *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill"
                   Disabled="@(!_chosen)" OnClick="Submit">Add expense</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// What the dialog answers with: one of the two things a person can decide.
    /// </summary>
    /// <param name="Request">
    /// File it as a new expense, and where it is going for the snackbar. Null when the
    /// answer was that it is a payment already recorded.
    /// </param>
    /// <param name="AttachTo">
    /// The expense this row is the same money as. Set only when the person said so, and
    /// then nothing new is recorded: the row is attached to that one.
    /// </param>
    public sealed record Answer(FileBankTransactionRequest? Request, string Destination, Guid? AttachTo = null);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public BankTransactionResponse Row { get; set; } = null!;

    private IReadOnlyList<GroupResponse> _groups = [];
    private IReadOnlyList<CategoryResponse> _categories = [];
    private IReadOnlyList<UserInfo> _members = [];

    private Guid? _groupId;

    /// <summary>
    /// Whether the person has said where this goes.
    /// </summary>
    /// <remarks>
    /// Held apart from <see cref="_groupId"/> because null is an answer here -- Personal --
    /// and not the absence of one. The dialog opens on neither: a row the bank imported
    /// belongs wherever the person says, and guessing "Personal" would file somebody's
    /// share of the rent as their own money on a mis-tap.
    /// </remarks>
    private bool _chosen;

    private Guid? _categoryId;
    private string _name = string.Empty;
    private string? _description;
    private IReadOnlyList<SplitInput>? _splits;

    private SplitPreviewResponse? _preview;
    private string? _previewError;

    /// <summary>
    /// What the division is waiting on, where it is waiting on the person rather than the
    /// API. Nothing can be divided until there is a group to divide it among.
    /// </summary>
    private string? _awaiting = "Pick a group to see how it divides.";

    /// <summary>Where the snackbar says it went.</summary>
    private string Destination =>
        _groups.FirstOrDefault(group => group.Id == _groupId)?.Name ?? "your personal expenses";

    /// <summary>
    /// The ask in flight, so a later one wins.
    /// </summary>
    /// <remarks>
    /// It did not need this while the preview was fetched once, on the way to a second
    /// step. On one screen the group and the category are both live, and picking them in
    /// quick succession asks twice -- answered in the order the server gets round to them,
    /// which is not necessarily the order they were asked.
    /// </remarks>
    private CancellationTokenSource? _previewing;

    public void Dispose() => _previewing?.Cancel();

    /// <summary>
    /// The row's own provenance, under its title in the summary card: which account, when
    /// the money was actually spent, and how it was paid where the bank said.
    /// </summary>
    private string Where
    {
        get
        {
            var parts = new[] { Row.AccountName, Row.SpentOn.ToShortDateString(), Row.Context }
                .Where(part => !string.IsNullOrWhiteSpace(part));

            return string.Join(" · ", parts);
        }
    }

    /// <summary>Whether it is going somewhere with other people in it.</summary>
    private bool IsShared => _groupId is not null;

    /// <summary>What the group chip says, including before anything has been said.</summary>
    private string GroupName =>
        _groups.FirstOrDefault(group => group.Id == _groupId)?.Name
        ?? (_chosen ? "Personal" : "Pick a group");

    private async Task OnGroupPickedAsync(Guid? id)
    {
        _groupId = id;
        _chosen = true;

        await OnGroupChangedAsync();
    }

    private async Task OnCategoryPickedAsync(Guid? id)
    {
        _categoryId = id;

        // Which is the whole reason this is on one screen: the category is how it divides,
        // and the shares are right there to say so.
        await RefreshPreviewAsync();
    }

    private string CategoryHint => !IsShared
        ? "Pick a group first."
        : Row.CategoryLabel is { Length: > 0 } label
            ? $"Your bank called this \"{label}\"."
            : "A category with a split rule divides the expense for you.";

    protected override async Task OnInitializedAsync()
    {
        _name = Row.Title;

        var loaded = await Errors.TryAsync(async () =>
        {
            _groups = [.. await GroupsClient.GetGroupsAsync()];
        }, "Could not load your groups.");

        if (!loaded)
            MudDialog.Cancel();
    }

    private async Task OnGroupChangedAsync()
    {
        // A stated division names people, and the people just changed.
        _splits = null;
        _categoryId = null;
        _categories = [];
        _members = [];

        if (_groupId is not { } groupId)
        {
            _preview = null;

            await RefreshPreviewAsync();
            return;
        }

        await Errors.TryAsync(async () =>
        {
            _categories = [.. await CategoriesClient.GetCategoriesAsync(groupId)];
            _members = [.. await GroupsClient.GetGroupMembersAsync(groupId)];
        }, "Could not load the group.");

        // The bank's own category, matched against what this group already uses. Only a
        // suggestion, and only when a name happens to line up: whatever is selected when
        // the button is pressed is what gets sent.
        _categoryId = Suggested()?.Id;

        await RefreshPreviewAsync();
    }

    private async Task OnSplitsChangedAsync(IReadOnlyList<SplitInput>? splits)
    {
        _splits = splits;

        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Asks the API what this would come to, with the row's own amount and date, so what is
    /// shown is what filing will store -- including the refusal, which arrives while there
    /// is still a field on screen to fix it in.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        // Only while nothing has been said. Personal has an answer -- there is nobody to
        // divide it among -- and the panel says so in its own words instead.
        _awaiting = _chosen ? null : "Pick a group to see how it divides.";

        if (!_chosen || !IsShared)
        {
            _preview = null;
            _previewError = null;
            StateHasChanged();
            return;
        }

        // What is on screen stays there while the new answer is out, as in the other two
        // dialogs: blanking it first took the share list away by its own height and put it
        // back a few tens of milliseconds later, which on a chip is a flinch per pick.
        _previewing?.Cancel();
        _previewing = new CancellationTokenSource();
        var asked = _previewing.Token;

        var preview = await Transactions.PreviewAsync(new CreateTransactionRequest
        {
            GroupId = _groupId,
            CategoryId = _categoryId,
            Splits = _splits,
            Name = string.IsNullOrWhiteSpace(_name) ? Row.Title : _name,
            Description = _description,
            Amount = Row.Amount,
            DateTime = Row.SpentOn.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc)
        }, asked);

        // A newer ask started while this one was out, or the dialog has gone.
        if (asked.IsCancellationRequested)
            return;

        _preview = preview;
        _previewError = preview is null
            ? "No division to show yet."
            : null;

        StateHasChanged();
    }

    /// <summary>
    /// The group's category whose name reads like the bank's label. Deliberately plain: a
    /// synonym table would be a thing to maintain and would still be wrong for somebody,
    /// and the selection is right there to change.
    /// </summary>
    private CategoryResponse? Suggested()
    {
        if (Row.CategoryLabel is not { Length: > 0 } label)
            return null;

        return _categories.FirstOrDefault(category =>
                   string.Equals(category.Name, label, StringComparison.OrdinalIgnoreCase))
               ?? _categories.FirstOrDefault(category =>
                   label.Contains(category.Name, StringComparison.OrdinalIgnoreCase)
                   || category.Name.Contains(label, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// The closest expense this row could already be, or null when there is nothing to
    /// raise. Read from the row rather than asked for again: the listing that opened this
    /// dialog already carries it.
    /// </summary>
    private ExpenseMatchResponse? Match => Row.PossibleDuplicates.Count > 0 ? Row.PossibleDuplicates[0] : null;

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// The other answer: this is the expense, so attach the row to it and record nothing.
    /// </summary>
    private void Attach(ExpenseMatchResponse match) =>
        MudDialog.Close(DialogResult.Ok(new Answer(null, match.Where, match.TransactionId)));

    private void Submit()
    {
        if (!_chosen)
            return;

        var request = new FileBankTransactionRequest
        {
            GroupId = _groupId,
            CategoryId = _categoryId,
            Splits = _splits,
            Name = string.IsNullOrWhiteSpace(_name) ? null : _name,
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
            // The suggestion was on screen throughout, so pressing this is the person
            // saying they really did pay twice. Without it the API refuses, which is what
            // stops a duplicate reaching the ledger through a client that never asked.
            FileAnyway = Match is not null
        };

        MudDialog.Close(DialogResult.Ok(new Answer(request, Destination)));
    }
}
