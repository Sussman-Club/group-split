@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Transactions
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ITransactionsClient TransactionsClient
@inject ICategoriesClient CategoriesClient
@inject GroupSplit.App.Shared.Services.Commands.ISplitRuleCommands SplitRules
@inject IReceiptCommands Receipts
@inject ITransactionCommands Transactions
@inject ApiErrorPresenter Errors
@inject LocalClock Clock
@inject IMerchantCommands Merchants
@inject GroupSplit.App.Shared.Services.Users.IUserLogin Login
@implements IDisposable

@*
    Editing an expense, on the one screen the create dialog uses.

    It was one long form with the split at the bottom, which is the shape the create dialog
    was taken apart for: the division is the decision the app exists for and it was the last
    thing on a screen people scrolled past. The two now match field for field, so somebody
    who has recorded an expense already knows where everything is.

    The one real difference is underneath. An edit is divided again by the version of the
    rule the expense was *written under*, not by whatever the rule says today -- so the
    preview here asks a different endpoint from the create dialog's, and says so when the
    rule has moved on since.
*@

@* gs-sheet is what makes this the full screen on a phone, with the actions held
   at the bottom. It rides the dialog rather than every DialogOptions that opens
   one, which is both fewer places to forget and the right owner: how this looks
   on a small screen is the dialog's business, not its caller's. *@
<MudDialog Class="gs-sheet">
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">@MudDialog.Title</MudText>
    </TitleContent>

    <DialogContent>
        @if (_failed)
        {
            <div class="gs-empty" style="padding: 24px">
                <MudIcon Icon="@Icons.Material.Outlined.CloudOff"/>
                <h3>Could not open this</h3>
                <span>This expense and its group did not load, so there is nothing here to edit yet.</span>
            </div>
        }

        <MudForm @ref="_form" Model="@_model" Class="@(_failed ? "d-none" : "")">
            <div class="gs-stack" style="gap: 16px">

                @* First, and a size up: what an edit is usually about is this figure, and
                   what it does to everybody's share is directly underneath. *@
                <MudNumericField @bind-Value="_model.Amount"
                                 @bind-Value:after="OnMoneyChangedAsync"
                                 For="@(() => _model.Amount)"
                                 Label="How much?"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 HideSpinButtons="true"
                                 Format="N2"
                                 Class="gs-amount"/>

                <MudTextField @bind-Value="_model.Name"
                              For="@(() => _model.Name)"
                              Label="What was it?"
                              Variant="Variant.Outlined"
                              Immediate="true"/>

                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="Note"
                              Placeholder="Anything worth remembering about it"
                              HelperText="Optional"
                              Variant="Variant.Outlined"
                              Lines="2"
                              Immediate="true"/>

                @* The group is a chip here and not the heading, unlike the create dialog:
                   this is the one screen where it can genuinely move. A personal expense is
                   shared by giving it a group, a shared one taken back by choosing Personal,
                   and the category, payer and shares all belong to whichever it says. *@
                <ExpenseDecisions @ref="_decisions"
                                  Groups="@(_groups.Select(g => new ExpenseDecisions.GroupChoice(g.Id, g.Name)).ToList())"
                                  GroupId="@_model.GroupId"
                                  GroupIdChanged="@OnGroupPickedAsync"
                                  GroupName="@Where"
                                  ShowCategory="@IsShared"
                                  Categories="@(_categories.Select(c => new ExpenseDecisions.CategoryChoice(c.CategoryId, c.Name, c.Splits)).ToList())"
                                  CategoryId="@_model.CategoryId"
                                  CategoryIdChanged="@OnCategoryPickedAsync"
                                  ShowPayer="@IsShared"
                                  Members="@_members"
                                  PayerId="@_model.PaidByUserId"
                                  PayerIdChanged="@OnPayerPickedAsync"
                                  Date="@_selectedDate"
                                  DateChanged="@OnDatePickedAsync"
                                  Time="@_selectedTime"
                                  TimeChanged="@OnTimePickedAsync"
                                  WhenSpent="@WhenSpent"
                                  MerchantId="@_model.MerchantId"
                                  MerchantIdChanged="@OnMerchantChangedAsync"
                                  MerchantName="@_merchantName"
                                  MerchantLogoUrl="@_merchantLogo"/>

                @if (_model.GroupId != Original.GroupId)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @(_model.GroupId is null
                            ? "This will become your own expense: no category, nothing owed by anybody."
                            : "This will be divided among the members of the group you picked.")
                    </MudAlert>
                }

                @if (!IsShared)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        A personal expense is not shared with anybody, so there is nothing to divide.
                    </MudAlert>
                }
                else
                {
                    <div style="border-top: 1px solid var(--gs-line); padding-top: 14px">
                        @* The bill is one of the answers in here, not a card above it: an
                           expense divides by its receipt the same way it divides by any other
                           rule, and this is the one place the screen asks how it divides. *@
                        <SplitEditor Members="@_members"
                                     Amount="@_model.Amount"
                                     PayerId="@_model.PaidByUserId"
                                     Stored="@_storedSplits"
                                     Before="@_storedSplits"
                                     Value="@_model.Splits"
                                     ValueChanged="@OnSplitsChangedAsync"
                                     MemberRules="@_memberRules"
                                     SplitRuleId="@_model.SplitRuleId"
                                     SplitRuleIdChanged="@OnSplitRuleChangedAsync"
                                     ShowByBill="true"
                                     Bill="@_receipt"
                                     BillRuleId="@_billRuleId"
                                     TransactionId="@Original.Id"
                                     GroupId="@_model.GroupId"
                                     BillChanged="@OnBillChangedAsync"
                                     Preview="@_preview"
                                     PreviewError="@_previewError"
                                     Awaiting="@_awaiting"/>
                    </div>
                }
            </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>

        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   Disabled="@_failed"
                   OnClick="Submit">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The row the edit was opened from.</summary>
    [Parameter] public TransactionResponse Original { get; set; } = null!;

    /// <summary>The expense's itemised bill, where it has one. Null for nearly every expense.</summary>
    private ReceiptResponse? _receipt;

    /// <summary>
    /// The group's "divide it by the bill" rule.
    /// </summary>
    /// <remarks>
    /// Read off the listing with the rest of the group and not looked up again. A group is
    /// given exactly one and cannot write a second, so there is nothing to choose between;
    /// null means a group from before that rule was provisioned, and the option is offered
    /// but not enabled.
    /// </remarks>
    private Guid? _billRuleId;

    /// <summary>
    /// A line of the bill was pointed at a different rule.
    /// </summary>
    /// <remarks>
    /// The change is already stored -- which rule a line divides by is a fact about the
    /// receipt, and the component writes it as it is picked. What is left is the consequence:
    /// if this expense divides by that bill, the shares it comes to have just moved, so the
    /// preview is asked again. Nothing about the expense itself is saved here.
    /// </remarks>
    private async Task OnBillChangedAsync(ReceiptResponse bill)
    {
        _receipt = bill;

        if (_model.SplitRuleId == _billRuleId)
            await RefreshPreviewAsync();
        else
            StateHasChanged();
    }

    private MudForm _form = null!;

    /// <summary>Which chip's picker is showing. One at a time; the row stays a row.</summary>
    /// <summary>
    /// The chip row, held so that a group move can close whatever picker is open over the
    /// members and categories it is about to retire.
    /// </summary>
    private ExpenseDecisions? _decisions;

    /// <summary>Whether the expense will belong to a group after this edit.</summary>
    private bool IsShared => _model.GroupId is not null;

    private UpdateTransactionRequest _model = new();

    private ICollection<GroupResponse> _groups = [];
    private ICollection<CategoryInfo> _categories = [];
    private IReadOnlyList<UserInfo> _members = [];

    /// <inheritdoc cref="CreateTransactionDialog.MemberRulesOf"/>
    private IReadOnlyList<SplitRuleResponse> _memberRules = [];

    private DateTime? _selectedDate;
    private TimeSpan? _selectedTime;

    private SplitPreviewResponse? _preview;
    private string? _previewError;

    /// <summary>
    /// What the edit still lacks before there is anything to divide, or null once it can
    /// be asked about. See the create dialog's field of the same name.
    /// </summary>
    private string? _awaiting;

    /// <summary>Whether the read this dialog opens on failed. See the create dialog's.</summary>
    private bool _failed;
    /// <summary>
    /// The ask in flight, so a late answer cannot paint over a newer one.
    /// </summary>
    /// <remarks>
    /// Every one of these is a round trip and several can be in the air at once -- the
    /// per-member share fields are immediate, so typing "45.50" asks five times. They were
    /// painted in the order they came back rather than the order they were asked, so an
    /// early answer landing late redrew the division for a payer or an amount that had
    /// already been changed, and Save then wrote something the screen had stopped showing.
    /// Cancelled on the way out too: the continuation of a dropped dialog has nothing left
    /// to render into.
    /// </remarks>
    private CancellationTokenSource? _previewing;

    public void Dispose() => _previewing?.Cancel();


    /// <summary>
    /// What the expense was filed under and where it was spent when this opened, backfilled
    /// from the detail read when the listing row did not carry them.
    /// </summary>
    /// <remarks>
    /// Held here rather than written back onto <see cref="Original"/>, which is the caller's
    /// own grid row: filling those in meant cancelling an edit left a category on a row in
    /// the expenses list that nobody had saved, and the same object was then handed to the
    /// update call as the "before" of the patch.
    /// </remarks>
    /// <summary>
    /// The rule the expense named for itself when the dialog opened, so the patch below can
    /// tell a pick from the state it started in.
    /// </summary>
    private Guid? _openedSplitRuleId;

    private Guid? _openedCategoryId;

    private Guid? _openedMerchantId;

    /// <summary>
    /// What the expense is divided into today, which is where the editor starts from when
    /// somebody takes the division over. The grid hands this dialog a listing row, which
    /// carries no shares, so they are read rather than passed in -- one path whichever
    /// list the edit was opened from.
    /// </summary>
    private IReadOnlyList<SplitInput> _storedSplits = [];

    /// <summary>
    /// Whether the person has asked for the division to be worked out again, which is what
    /// choosing "Automatically" means on an expense that already has shares.
    /// </summary>
    /// <remarks>
    /// Tracked rather than read off <c>_model.Splits</c>, because "no shares stated" is two
    /// different answers here and only one of them is an instruction. Opening the dialog and
    /// changing a name states none, and the save must leave the division alone -- that is
    /// the whole of what 47c6904 fixed, and sending an explicit re-divide on every edit
    /// would be the same bulk re-division through another door. Touching the toggle is the
    /// other answer, and the only one that sends <c>/splits</c> as null.
    /// </remarks>
    private bool _redivide;

    /// <summary>
    /// What <c>_model.Splits</c> held when the dialog opened: the expense's own shares when
    /// nothing divided them, and null when a rule did.
    /// </summary>
    /// <remarks>
    /// Kept so that putting the category back where it was puts the division back too. The
    /// pick clears the stated shares, and without this the clearing outlived the pick --
    /// somebody who picked Rent and changed their mind lost the shares they had typed.
    /// </remarks>
    private IReadOnlyList<SplitInput>? _openedWith;

    private string Where => _model.GroupId is null
        ? "Personal"
        : _groups.FirstOrDefault(group => group.Id == _model.GroupId)?.Name ?? "";

    private string CategoryName =>
        _categories.FirstOrDefault(category => category.CategoryId == _model.CategoryId)?.Name ?? "category";

    private string PayerName =>
        _members.FirstOrDefault(member => member.Id == _model.PaidByUserId)?.Label() ?? "somebody";

    /// <summary>
    /// What the merchant chip shows.
    /// </summary>
    /// <remarks>
    /// Held rather than derived, because an id is all the picker answers with and a chip
    /// has to say a name. It is read off the expense on the way in and resolved again after
    /// a pick -- the same round trip the picker itself makes, which is why it is cheap.
    /// </remarks>
    private string? _merchantName;

    private string MerchantName => _merchantName ?? "where";

    /// <summary>The mark for that merchant, when it has one.</summary>
    private string? _merchantLogo;

    /// <summary>
    /// Records the pick and resolves the name the chip will show.
    /// </summary>
    /// <remarks>
    /// No preview: a merchant is where the money went, not who owes it. The picker closes
    /// on a choice because its control is a search, and a list of nothing left open under
    /// the row reads as an unfinished gesture.
    /// </remarks>
    private async Task OnMerchantChangedAsync(Guid? merchantId)
    {
        _model.MerchantId = merchantId;

        if (merchantId is null)
        {
            _merchantName = null;
            _merchantLogo = null;
            return;
        }

        var merchant = await Merchants.GetAsync(merchantId.Value);

        _merchantName = merchant?.Name;
        _merchantLogo = merchant?.LogoUrl;

        StateHasChanged();
    }

    /// <summary>
    /// The day, as a person would say it. Today and yesterday by name, because a date is a
    /// worse way of saying either.
    /// </summary>
    private string WhenSpent
    {
        get
        {
            var day = _selectedDate ?? Clock.Today;

            return (Clock.Today - day.Date).Days switch
            {
                0 => "today",
                1 => "yesterday",
                _ when day.Year == Clock.Today.Year => day.ToString("d MMM"),
                _ => day.ToString("d MMM yyyy")
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _openedCategoryId = Original.CategoryId;
        _openedMerchantId = Original.MerchantId;

        _model = new UpdateTransactionRequest
        {
            Name = Original.Name,
            Description = Original.Description,
            Amount = Original.Amount,
            DateTime = Original.DateTime,
            GroupId = Original.GroupId,
            CategoryId = _openedCategoryId,
            MerchantId = _openedMerchantId,
            PaidByUserId = Original.PaidByUserId
        };

        // In the person's zone. Reading .Date off the stored value gives the wall clock of
        // whatever offset it arrived with -- UTC -- and re-saving that at the local offset
        // moved the expense by the zone difference on every edit.
        var shown = Clock.Local(Original.DateTime);
        _selectedDate = shown.Date;
        _selectedTime = shown.TimeOfDay;

        // Without the group's categories and members there is nothing to edit against, so
        // a failed load closes the dialog once the presenter has said why.
        var loaded = await Errors.TryAsync(async () =>
        {
            _groups = await GroupsClient.GetGroupsAsync();

            await LoadGroupAsync(Original.GroupId);

            var details = await TransactionsClient.GetTransactionAsync(Original.Id);

            // The listing row carries no merchant id and, opened from some lists, no
            // category either. The detail read has both, and is the same read the splits
            // come from.
            if (_openedCategoryId is null && details.CategoryId is not null)
            {
                _openedCategoryId = details.CategoryId;
                _model.CategoryId = details.CategoryId;
            }

            if (_openedMerchantId is null && details.MerchantId is not null)
            {
                _openedMerchantId = details.MerchantId;
                _model.MerchantId = details.MerchantId;
            }

            // Only the detail read has it, and it is what opens the split control on "all
            // for Ana" rather than on "automatically" -- the same reason the stored shares
            // are read below.
            _openedSplitRuleId = details.SplitRuleId;
            _model.SplitRuleId = details.SplitRuleId;

            // The name for the chip, from whichever read has it. Neither always does -- a
            // row opened from some listings carries the id alone -- and a chip that showed
            // an id would be useless, so the last resort is to go and ask. Only then: this
            // is one round trip to put one word on one chip.
            _merchantName = details.MerchantName ?? Original.MerchantName;
            _merchantLogo = details.MerchantLogoUrl ?? Original.MerchantLogoUrl;

            if (_merchantName is null && _model.MerchantId is { } merchantId)
            {
                var merchant = await Merchants.GetAsync(merchantId);

                _merchantName = merchant?.Name;
                _merchantLogo ??= merchant?.LogoUrl;
            }

            // A category that has since been deleted still names what this expense was
            // filed under, so it stays in the list rather than silently reading as none.
            if (_model.CategoryId is { } filed && _categories.All(row => row.CategoryId != filed))
                _categories.Add(new CategoryInfo(filed, Original.Category ?? details.Category ?? "(removed)", null));

            _storedSplits = [.. details.Splits.Select(split =>
                new SplitInput { UserId = split.UserId, Amount = split.Amount })];

            // Which side the split control opens on, and it is a question only the API can
            // answer: the amounts alone do not say who decided them. A rule version means a
            // rule divided it, so "Automatically" is the truth and the caption naming that
            // rule is too. No version means the shares are the expense's own -- typed by
            // hand, or divided evenly under no rule -- and the control opens on them, where
            // before it claimed every expense had been divided automatically and wrote
            // "Divided evenly" over shares somebody had set 70/30.
            //
            // The even case is shown as "By hand" too, because the model does not record the
            // difference and the amounts are what will be kept either way. Choosing
            // "Automatically" is how the division is asked for again, and that is exactly
            // what it does.
            if (details.SplitRuleVersionId is null && details.GroupId is not null && _storedSplits.Count > 0)
                _model.Splits = _storedSplits;

            _openedWith = _model.Splits;
        }, "Could not load the group.");

        if (!loaded)
        {
            // Said here rather than closed, for the reason the create dialog gives: a
            // cancel left MudBlazor's title and buttons on screen with nothing between
            // them, and the snackbar carrying the reason had already gone.
            _failed = true;
            StateHasChanged();
            return;
        }

        StateHasChanged();

        // Started here and awaited below: the bill and the preview need nothing from each
        // other, and one after the other is two waits where the dialog is already on screen.
        var bill = Receipts.GetAsync(Original.Id);

        // The division is on this screen, so it is asked for on the way in rather than on
        // the way into a second step that no longer exists.
        await RefreshPreviewAsync();

        // Null for nearly every expense, which has no bill, and null for a failure just the
        // same: there is nothing to report either way, and "By its bill" stays disabled.
        // The option is drawn either way -- see SplitEditor.ShowByBill -- so this arriving
        // late enables a button rather than adding one.
        _receipt = await bill;
        StateHasChanged();
    }

    /// <summary>The categories and members of one group, or none for personal.</summary>
    private async Task LoadGroupAsync(Guid? groupId)
    {
        if (groupId is { } id)
        {
            // At once rather than one after another: none of the three reads what the others
            // write, and in sequence each one lands as its own re-render on a dialog that is
            // already on screen.
            var categories = CategoriesClient.GetCategoriesAsAsyncEnumerable(id)
                .Select(category => new CategoryInfo(category.Id, category.Name, category.DefaultSplitRuleName))
                .ToListAsync()
                .AsTask();

            var members = GroupsClient.GetGroupMembersAsync(id);
            var rules = SplitRules.ForGroupAsync(id);

            await Task.WhenAll(categories, members, rules);

            _categories = await categories;
            _members = [.. await members];

            var listed = await rules;

            _memberRules = CreateTransactionDialog.MemberRulesOf(listed);
            // Off the same listing as the member rules, and for the same reason: the split
            // control offers "By its bill" and has to name the rule that means, without
            // reading the definition of every rule the group holds.
            _billRuleId = listed?.FirstOrDefault(rule => rule.DividesByBill)?.Id;
        }
        else
        {
            _categories = [];
            _members = [];
            _memberRules = [];
            _billRuleId = null;
        }
    }

    /// <summary>
    /// A different group is a different set of people and labels. The category and the
    /// stated shares are dropped because they belonged to the old one; the payer is kept
    /// when they are in the new group and otherwise becomes the caller, which is the only
    /// payer a personal expense can have and the likeliest for a shared one.
    /// </summary>
    /// <remarks>
    /// The place survives a move, unlike everything else here: where the money was spent is
    /// a fact about the spending and not about who is sharing it.
    /// </remarks>
    private async Task OnGroupChangedAsync()
    {
        var loaded = await Errors.TryAsync(() => LoadGroupAsync(_model.GroupId), "Could not load the group.");

        if (!loaded)
            return;

        // Whatever was open was about the group this expense is leaving: the categories it
        // kept and the members who could have paid. Both lists are now somebody else's.
        _decisions?.Close();

        _model.CategoryId = null;
        _model.Splits = null;
        // Belongs to the group this is leaving, and the API refuses one from anywhere else.
        _model.SplitRuleId = null;
        _storedSplits = [];

        // Nothing to put back: the shares it opened with name the old group's members, and
        // the endpoint drops them on a move.
        _openedWith = null;
        _preview = null;

        // Not an ask to divide it again: a move does that on its own, because the shares
        // name the old group's members and the endpoint drops them. The toggle returns to
        // "Automatically" because there is nothing left to show on the other side of it.
        _redivide = false;

        if (_members.All(user => user.Id != _model.PaidByUserId) && Login.User is { } me)
            _model.PaidByUserId = me.Id;

        StateHasChanged();

        // The new group's members divide it now, and nothing on screen says how until this
        // is asked again: clearing the preview above without replacing it left "Working it
        // out..." standing for as long as the dialog was open.
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Filing it somewhere else divides it the way the new category says.
    /// </summary>
    /// <remarks>
    /// The alternative is the one the issue behind this was raised about: a category picker
    /// that changes a label and nothing else, so somebody moves an expense from Rent to
    /// Groceries, sees Groceries' rule named on the row, and keeps Rent's two-to-one
    /// division for ever. Asking to re-divide is what makes the pick mean what it says.
    /// <para>
    /// It is not final. Step two still offers "By hand", pre-filled with what the expense
    /// currently holds, so overriding afterwards costs one click -- which is the other half
    /// of what was asked for.
    /// </para>
    /// <para>
    /// Somewhere else, though, and not merely "the picker fired". Every other field in
    /// <c>CreatePatch</c> is sent only when it ended up different and this one has to
    /// be too, because the operation it sends is the one that moves money: picking Rent,
    /// changing your mind and picking Food again used to leave the ask latched on, so the
    /// save discarded hand-typed shares and re-divided an expense for a net edit of
    /// nothing. Clearing the field with the X and re-picking did the same.
    /// </para>
    /// </remarks>
    private async Task OnCategoryChanged()
    {
        _redivide = _model.CategoryId != _openedCategoryId;

        // Back where it started means back to what it opened holding, so that undoing the
        // pick undoes the whole of it rather than leaving step two on "Automatically" over
        // shares the save is about to keep.
        _model.Splits = _redivide ? null : _openedWith;

        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Anything that changes what the division comes to: the amount, the payer.
    /// </summary>
    /// <remarks>
    /// The amount is bound on change rather than on every keystroke, which is what makes
    /// this affordable now that the division is on the same screen: a preview is a round
    /// trip, and one per digit would be several racing each other.
    /// </remarks>
    private Task OnMoneyChangedAsync() => RefreshPreviewAsync();

    /// <summary>
    /// What each pick costs. The row reports the choice; what it means to an expense that
    /// already exists is this dialog's business, and it is not the same for any two of them.
    /// </summary>
    private async Task OnGroupPickedAsync(Guid? id)
    {
        _model.GroupId = id;

        await OnGroupChangedAsync();
    }

    private async Task OnCategoryPickedAsync(Guid? id)
    {
        _model.CategoryId = id;

        await OnCategoryChanged();
    }

    private async Task OnPayerPickedAsync(Guid? id)
    {
        // The row offers a nullable id because the create dialog opens with nobody chosen.
        // An expense that exists was paid by somebody, and the picker is not clearable, so
        // null here is not an answer -- it is the absence of one, and nothing to record.
        if (id is not { } payer)
            return;

        _model.PaidByUserId = payer;

        await OnMoneyChangedAsync();
    }

    private async Task OnDatePickedAsync(DateTime? date)
    {
        _selectedDate = date;

        await RefreshPreviewAsync();
    }

    private async Task OnTimePickedAsync(TimeSpan? time)
    {
        _selectedTime = time;

        await RefreshPreviewAsync();
    }

    /// <summary>
    /// The editor's answer, which arrives only when somebody has acted on it: amounts they
    /// are typing, or null for the moment they choose "Automatically".
    /// </summary>
    /// <remarks>
    /// That null is the one thing the dialog cannot infer, and the reason <c>_redivide</c>
    /// exists: it means "work it out again", while the null the model starts with means
    /// "say nothing", and the API reads those as opposite instructions.
    /// </remarks>
    private async Task OnSplitsChangedAsync(IReadOnlyList<SplitInput>? splits)
    {
        _model.Splits = splits;
        _redivide = splits is null;
        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Names a rule for this expense, or stops naming one.
    /// </summary>
    /// <remarks>
    /// Always an ask to divide it again, which is the difference from picking a category:
    /// there, putting it back where it was puts the stored shares back, because filing is
    /// not a statement about the money. Choosing who owes the whole of it is, and the shares
    /// it has answer a question that has just changed.
    /// </remarks>
    private async Task OnSplitRuleChangedAsync(Guid? splitRuleId)
    {
        _model.SplitRuleId = splitRuleId;
        _model.Splits = null;
        _redivide = true;

        await RefreshPreviewAsync();
    }

    /// <summary>
    /// Asks the API what this edit would come to. The endpoint the edit uses, not the one
    /// the create dialog uses: this one divides by the version of the rule the expense was
    /// written under, which is what the save will do.
    /// </summary>
    private async Task RefreshPreviewAsync()
    {
        // Before the ask, not on the way out: which version of a rule divides an expense
        // depends on the day it was spent, so a preview built from an unapplied date
        // answers about a different day than the one the save will store.
        ApplyDate();

        _awaiting = _model.Amount == 0m ? "Enter an amount to see how it divides." : null;

        if (!IsShared || _awaiting is not null)
        {
            _preview = null;
            _previewError = null;
            StateHasChanged();
            return;
        }

        // What is on screen stays there while the new answer is out. It was blanked first
        // and rendered, which took the share list away by its own height and put it back a
        // few tens of milliseconds later -- a flinch on every pick, worst on the chips,
        // whose picker closes in the same frame, so the dialog jumped twice for one choice.
        // The figures standing are this same expense with one field moved: a better
        // stand-in for the next figures than a gap is, and they are replaced, not trusted.
        _previewing?.Cancel();
        _previewing = new CancellationTokenSource();
        var asked = _previewing.Token;

        var preview = await Transactions.PreviewUpdateAsync(Original.Id, _model, _redivide, asked);

        // A newer ask started while this one was out, or the dialog has gone.
        if (asked.IsCancellationRequested)
            return;

        _preview = preview;
        // Deliberately not a diagnosis. Null is also a refused payer or a dropped
        // connection, and those now say so themselves in a snackbar; asserting arithmetic
        // over the top of them told people their numbers were wrong while the numbers on
        // screen visibly summed correctly.
        _previewError = preview is null
            ? "No division to show yet."
            : null;

        StateHasChanged();
    }

    private void ApplyDate() =>
        _model.DateTime = Clock.At(_selectedDate ?? Clock.Today, _selectedTime ?? TimeSpan.Zero);

    /// <summary>
    /// Validated here, because this is the only place left between typing and saving.
    /// </summary>
    /// <remarks>
    /// The two-step version validated on the way into step two, and collapsing the steps
    /// took the check with it: clearing the name and pressing Save closed the dialog, the
    /// API refused the patch, and every other edit in it went with the dialog that was
    /// already gone.
    /// </remarks>
    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        ApplyDate();

        var original = new UpdateTransactionRequest
        {
            Name = Original.Name,
            Description = Original.Description,
            Amount = Original.Amount,
            DateTime = Original.DateTime,
            GroupId = Original.GroupId,
            CategoryId = _openedCategoryId,
            MerchantId = _openedMerchantId,
            SplitRuleId = _openedSplitRuleId,
            PaidByUserId = Original.PaidByUserId
        };

        MudDialog.Close(DialogResult.Ok(CreatePatch(original, _model, _redivide)));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <param name="redivide">
    /// Whether the person asked for the division to be worked out again. It cannot be read
    /// off <paramref name="updated"/>: an edit that leaves the shares alone and one that
    /// asks for new ones both arrive with none stated, and only the second is an
    /// instruction.
    /// </param>
    static JsonPatchDocument<UpdateTransactionRequest> CreatePatch(
        UpdateTransactionRequest original,
        UpdateTransactionRequest updated,
        bool redivide)
    {
        var patch = new JsonPatchDocument<UpdateTransactionRequest>();

        if (original.Name != updated.Name)
            patch.Replace(x => x.Name, updated.Name);

        if (original.Description != updated.Description)
            patch.Replace(x => x.Description, updated.Description);

        if (original.Amount != updated.Amount)
            patch.Replace(x => x.Amount, updated.Amount);

        if (original.DateTime != updated.DateTime)
            patch.Replace(x => x.DateTime, updated.DateTime);

        if (original.GroupId != updated.GroupId)
            patch.Replace(x => x.GroupId, updated.GroupId);

        if (original.CategoryId != updated.CategoryId)
            patch.Replace(x => x.CategoryId, updated.CategoryId);

        if (original.MerchantId != updated.MerchantId)
            patch.Replace(x => x.MerchantId, updated.MerchantId);

        if (original.PaidByUserId != updated.PaidByUserId)
            patch.Replace(x => x.PaidByUserId, updated.PaidByUserId);

        // Sent both ways round, unlike the shares below: naming a rule and stopping naming
        // one are both edits to how the expense divides, and neither is an instruction the
        // API has to read anything into -- it is a value, like the category.
        if (original.SplitRuleId != updated.SplitRuleId)
            patch.Replace(x => x.SplitRuleId, updated.SplitRuleId);

        // The one member that is an instruction rather than a value, and it has three
        // answers instead of two. The API reads the operations, not the applied model:
        //
        //   amounts    -- divide it exactly this way
        //   null, sent -- divide it again the way the category says
        //   nothing    -- keep the shares it has
        //
        // The last is what an untouched dialog sends, and it is the default for a reason: an
        // edit that says nothing about the money must not move any. Sending the re-divide on
        // every edit is precisely the bulk pass that moved 1,394.72 onto one member on
        // 2026-09-08, and the operation below is emitted only when somebody chose it.
        if (updated.Splits is not null)
            patch.Replace(x => x.Splits, updated.Splits);
        else if (redivide)
            patch.Replace(x => x.Splits, null);

        return patch;
    }

    /// <summary>
    /// A category as the select shows it: what it is called, and how it divides.
    /// </summary>
    /// <param name="Rule">
    /// The rule it points at, or null when it names none -- which is not a gap but an
    /// answer, and <see cref="Splits"/> says it in words.
    /// </param>
    internal record CategoryInfo(Guid CategoryId, string Name, string? Rule)
    {
        /// <summary>How an expense filed here divides, in the few words a dropdown has room for.</summary>
        public string Splits => Rule is { Length: > 0 } named ? named : "even split";
    }
}
