@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions

@*
    Recording a repayment, from either side.

    It used to sit only under "owed to you", so only the creditor could say a debt had been
    paid -- the person who had actually done the paying had no way to record it and had to
    ask the other one to. The direction is a parameter now, and the wording follows it: the
    dialog is the same, the sentence is not.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">
            Settle with @Username
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="3">

                <MudText Typo="Typo.subtitle2">@Standing</MudText>

                <MudNumericField
                    @bind-Value="_model.Amount"
                    For="@(() => _model.Amount)"
                    Label="@(YouPaid ? "Amount you paid" : "Amount they paid")"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                    AdornmentColor="Color.Primary"
                    HideSpinButtons="true"
                    Format="N2"
                    Validation="@(new Func<decimal, IEnumerable<string>>(ValidateAmount))"/>

                <MudText Typo="Typo.caption">
                    Remaining balance: @((TotalDebt - _model.Amount).ToMoney())
                </MudText>

                @* Both optional, and deliberately: recording a repayment has to stay quick.
                   The date is what lets a payment made on the 30th and typed in on the 3rd
                   land in the month it settled, instead of the month somebody got round
                   to it. *@
                <MudDatePicker Date="_date" DateChanged="@DateChanged"
                               Label="When"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               HelperText="Defaults to now."/>

                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="Note"
                              Variant="Variant.Outlined"
                              Placeholder="Cash, bank transfer, a reference…"/>

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="@Submit">
            Confirm
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Username { get; set; } = null!;
    [Parameter] public Guid UserId { get; set; }

    /// <summary>What stands between the two of them, whichever way round it is.</summary>
    [Parameter] public decimal TotalDebt { get; set; }

    /// <summary>
    /// Which way the money went. The caller knows: this dialog opens from under "owed to
    /// you" or from under "you owe", and those are the two answers.
    /// </summary>
    [Parameter] public SettlementDirection Direction { get; set; } = SettlementDirection.TheyPaidYou;

    private MudForm _form = null!;

    private SettleRequest _model = new();

    private DateTime? _date;

    private bool YouPaid => Direction is SettlementDirection.YouPaidThem;

    private string Standing => YouPaid
        ? $"You owe {Username} {TotalDebt.ToMoney()}"
        : $"{Username} owes you {TotalDebt.ToMoney()}";

    protected override void OnInitialized()
    {
        _model = new SettleRequest
        {
            UserId = UserId,
            Amount = TotalDebt,
            Direction = Direction
        };
    }

    /// <summary>
    /// Midday rather than midnight, and stated as UTC. The picker hands back a date with no
    /// time on it; midnight is the moment most likely to fall out of the day somebody meant
    /// once a zone is applied to it, and the day is all they were choosing.
    /// </summary>
    private void DateChanged(DateTime? date)
    {
        _date = date;

        _model.Date = date is { } chosen
            ? new DateTimeOffset(chosen.Date.AddHours(12), TimeSpan.Zero)
            : null;
    }

    IEnumerable<string> ValidateAmount(decimal amount)
    {
       if (amount > TotalDebt)
            yield return $"Amount cannot exceed the total debt ({TotalDebt.ToMoney()})";
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
