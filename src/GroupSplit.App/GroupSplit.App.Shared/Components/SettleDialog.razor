@using GroupSplit.Shared
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Errors
@inject IGroupsClient GroupsClient
@inject ApiErrorPresenter Errors
@inject LocalClock Clock

@*
    Recording a repayment, from either side.

    It used to sit only under "owed to you", so only the creditor could say a debt had been
    paid -- the person who had actually done the paying had no way to record it and had to
    ask the other one to. The direction is a parameter now, and the wording follows it: the
    dialog is the same, the sentence is not.
*@

@* gs-sheet: the full screen on a phone, with the actions held at the bottom. Every
   dialog that records money wears it -- filing a row and settling up end in the
   same press as adding an expense, and a save button below a scroll is the same
   nuisance whichever dialog it is in. *@
<MudDialog Class="gs-sheet">
    <TitleContent>
        <MudText Typo="Typo.h5">@Loc["Settle with {0}", Username].Value</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="3">

                <MudText Typo="Typo.subtitle2">@Standing</MudText>

                <DecimalField
                    @bind-Value="_model.Amount"
                    For="@(() => _model.Amount)"
                    Label="@(YouPaid ? Loc["Amount you paid"].Value : Loc["Amount they paid"].Value)"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                    AdornmentColor="Color.Primary"
                    HideSpinButtons="true"
                    Validation="@(new Func<decimal, IEnumerable<string>>(ValidateAmount))"/>

                <MudText Typo="Typo.caption">@Remaining</MudText>

                @* A month at a time, for groups that settle that way: what activity dated up
                   to the day left owing, after the repayments made for it -- so a payment
                   made since for that month is never asked for again. Tucked away, because
                   settling the whole of it is still what most people want. *@
                @if (_choosingPeriod)
                {
                    <MudDatePicker Date="_through" DateChanged="@ThroughChanged"
                                   Label="@Loc["Only activity up to"]"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   MaxDate="@Clock.Today"
                                   Disabled="@_readingPeriod"
                                   HelperText="@PeriodHelp"/>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="align-self-start"
                               StartIcon="@Icons.Material.Outlined.EventAvailable"
                               OnClick="@(() => _choosingPeriod = true)">
                        Settle only up to a day…
                    </MudButton>
                }

                @* Both optional, and deliberately: recording a repayment has to stay quick.
                   The date is what lets a payment made on the 30th and typed in on the 3rd
                   land in the month it settled, instead of the month somebody got round
                   to it. *@
                <MudDatePicker Date="_date" DateChanged="@DateChanged"
                               Label="@Loc["When"]"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               HelperText="@Loc["Defaults to now."]"/>

                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="@Loc["Note"]"
                              Variant="Variant.Outlined"
                              Placeholder="@Loc["Cash, bank transfer, a reference…"]"/>

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="@Submit"
                   Disabled="@_readingPeriod">@Loc["Confirm"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Username { get; set; } = null!;
    [Parameter] public Guid UserId { get; set; }

    /// <summary>
    /// The group it is recorded in, which is where the balances through a day are read from
    /// when one is picked.
    /// </summary>
    [Parameter] public Guid GroupId { get; set; }

    /// <summary>What stands between the two of them, whichever way round it is.</summary>
    [Parameter] public decimal TotalDebt { get; set; }

    /// <summary>
    /// Which way the money went. The caller knows: this dialog opens from under "owed to
    /// you" or from under "you owe", and those are the two answers.
    /// </summary>
    [Parameter] public SettlementDirection Direction { get; set; } = SettlementDirection.TheyPaidYou;

    private MudForm _form = null!;

    private SettleRequest _model = new();

    private DateTime? _date;

    private bool _choosingPeriod;
    private bool _readingPeriod;
    private DateTime? _through;

    /// <summary>What was owed for the period picked, while one is.</summary>
    private decimal? _owedForPeriod;

    /// <summary>What this payment can settle: the period's figure when one is picked, the whole otherwise.</summary>
    private decimal Owed => _owedForPeriod ?? TotalDebt;

    private bool YouPaid => Direction is SettlementDirection.YouPaidThem;

    private string Standing => (_through, YouPaid) switch
    {
        ({ } day, true) => Loc["For activity up to {0:d MMM}, you owe {1} {2}", day, Username, Owed.ToMoney()].Value,
        ({ } day, false) => Loc["For activity up to {0:d MMM}, {1} owes you {2}", day, Username, Owed.ToMoney()].Value,
        (null, true) => Loc["You owe {0} {1}", Username, TotalDebt.ToMoney()].Value,
        (null, false) => Loc["{0} owes you {1}", Username, TotalDebt.ToMoney()].Value
    };

    private string PeriodHelp => _through is { } day && Owed <= 0
        ? Loc["Nothing is outstanding between you for activity up to {0:d MMM}.", day].Value
        : Loc["Repayments for later count only as far as they pay it down. Clear it to settle everything."].Value;

    protected override void OnInitialized()
    {
        _model = new SettleRequest
        {
            UserId = UserId,
            Amount = TotalDebt,
            Direction = Direction
        };
    }

    /// <summary>
    /// A day and no time, so stored the way a bank row's date is: midnight UTC of that day,
    /// which every screen reads back as that day, with no time, in any zone (#252). This used
    /// to be midday UTC, which showed as "12:00" -- a time nobody picked -- and is 00:00 the
    /// next day from UTC+12: a repayment dated the 31st in Auckland in summer landed on the
    /// 1st of the next month.
    /// </summary>
    private void DateChanged(DateTime? date)
    {
        _date = date;

        _model.Date = date is { } chosen ? TransactionDay.Stored(chosen) : null;
    }

    /// <summary>
    /// Reads what the period left owing between the two of them, from the group's balances
    /// through the day on this viewer's calendar.
    /// </summary>
    /// <remarks>
    /// Read here, not worked out: the balance through a day counts the repayments made for it
    /// and later ones as far as they pay it down, which is the half a client summing its own
    /// expenses would leave out. The day
    /// goes onto the request as well, so the repayment remembers what it was for.
    /// </remarks>
    private async Task ThroughChanged(DateTime? through)
    {
        _through = through;

        if (through is not { } day)
        {
            _owedForPeriod = null;
            _model.Through = null;
            _model.Amount = TotalDebt;
            return;
        }

        var cutoff = DateOnly.FromDateTime(day);
        _readingPeriod = true;

        try
        {
            UserGroupBalanceResponse? balance = null;

            var read = await Errors.TryAsync(async () =>
                    balance = await GroupsClient.GetGroupUserBalanceAsync(
                        GroupId, cutoff, Clock.CutoffOffsetMinutes),
                Loc["Could not read the balances for that period."].Value);

            if (!read || balance is null)
            {
                _through = null;
                return;
            }

            var side = YouPaid ? balance.YouOwed : balance.OwedToYou;

            _owedForPeriod = side.FirstOrDefault(debt => debt.UserId == UserId)?.Amount ?? 0m;
            _model.Through = cutoff;
            _model.Amount = _owedForPeriod.Value;
        }
        finally
        {
            _readingPeriod = false;
        }
    }

    /// <summary>
    /// What is left after this payment, or how far past the figure it goes.
    /// </summary>
    /// <remarks>
    /// Past it is allowed. The figure is a suggestion; a repayment is whatever money
    /// actually moved -- rounding up, paying ahead -- and the difference simply stays in the
    /// balance.
    /// </remarks>
    private string Remaining => (Owed - _model.Amount) switch
    {
        >= 0 and var left => _through is null
            ? Loc["Remaining balance: {0}", left.ToMoney()]
            : Loc["Remaining for that period: {0}", left.ToMoney()],
        var over => _through is null
            ? Loc["{0} more than is owed. It stays in the balance between you.", (-over).ToMoney()]
            : Loc["{0} more than that period left owing. It stays in the balance between you.", (-over).ToMoney()]
    };

    IEnumerable<string> ValidateAmount(decimal amount)
    {
        if (amount <= 0)
            yield return Loc["Amount must be greater than 0."].Value;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
