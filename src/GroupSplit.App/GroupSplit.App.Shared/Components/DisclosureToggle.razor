@namespace GroupSplit.App.Shared.Components
<button type="button" class="gs-disclosure-toggle" aria-expanded="@(Expanded ? "true" : "false")"
        aria-controls="@Controls" @onclick="OnClick">
    <span aria-hidden="true">@if (Expanded) { <text>&#9662;</text> } else { <text>&#9656;</text> }</span>
    <span>@Label</span>
</button>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public string? Controls { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
