@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IInboxStateService Inbox
@inject IBankCommands Bank
@inject IBankLinkLauncher Link
@inject IDialogService DialogService
@inject LocalClock Clock
@implements IDisposable

@*
    The banks somebody has linked. Lives on the account page because a bank belongs to a
    person and not to a group: nobody else ever sees these, or the rows they bring in.
*@

<div class="gs-card gs-card-pad gs-reveal" style="--i: @Reveal">
    <div class="gs-card-title">
        <h2>Linked banks</h2>
        @if (Connections.Count > 0)
        {
            <span class="gs-tag neutral">@Connections.Count linked</span>
        }
    </div>

    @if (Inbox.Connections is { Enabled: false })
    {
        <p class="meta">
            Bank sync is not switched on for this app, so there is nothing to link yet.
        </p>
    }
    else
    {
        @if (Connections.Count == 0)
        {
            <p class="meta">
                Link a bank and its transactions arrive in your inbox, where you can add them
                to a group or keep them to yourself.
            </p>
        }
        else
        {
            <div class="gs-list">
                @foreach (var item in Connections)
                {
                    var connection = item;
                    <div @key="connection.Id" class="gs-row gs-bank-row" style="cursor: default">
                        <Avatar Name="@connection.InstitutionName" />
                        <div class="gs-bank-copy">
                            <div class="title">
                                <span class="gs-bank-name">@connection.InstitutionName</span>
                            </div>
                            <div class="meta gs-bank-status">
                                @if (connection.NeedsAttention || connection.NeedsAttentionSoon)
                                {
                                    <span class="gs-tag">Needs attention</span>
                                }
                                <span class="gs-bank-status-detail">@Describe(connection)</span>
                            </div>
                        </div>
                        @*
                            The list is mostly for recognising a connection. Keep its three
                            repairs behind one reachable control, so they cannot squeeze the
                            bank's name out of its own row at panel widths.
                        *@
                        <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                 Disabled="@_busy" aria-label="@($"Actions for {connection.InstitutionName}")">
                            @*
                                Signing in again is offered whatever the connection's state,
                                not only when it has been flagged. A bank that is misbehaving
                                without having been marked leaves somebody with one visible
                                way out -- linking it a second time -- and that mints a whole
                                new item at the provider rather than repairing this one.
                            *@
                            @if (connection.NeedsAttention)
                            {
                                <MudMenuItem Icon="@Icons.Material.Rounded.Login"
                                             OnClick="@(() => RepairAsync(connection))">Sign in again</MudMenuItem>
                            }
                            else
                            {
                                @*
                                    Still working, so syncing is still offered. A connection
                                    that only needs attention soon -- an account nobody
                                    shared, a sign-in about to lapse -- goes on importing
                                    everything it does have, and taking "Sync now" away from
                                    it would make a warning look like a breakage.
                                *@
                                <MudMenuItem Icon="@Icons.Material.Rounded.Sync"
                                             OnClick="@(() => SyncAsync(connection))">Sync now</MudMenuItem>

                                @if (connection.NeedsAttentionSoon)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Rounded.Login"
                                                 OnClick="@(() => RepairAsync(connection))">Sign in again</MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Icon="@Icons.Material.Rounded.Login"
                                                 OnClick="@(() => RepairAsync(connection))">Sign in again</MudMenuItem>
                                }
                            }
                            <MudMenuItem Icon="@Icons.Material.Rounded.LinkOff" IconColor="Color.Error"
                                         OnClick="@(() => UnlinkAsync(connection))">Unlink</MudMenuItem>
                        </MudMenu>
                    </div>
                }
            </div>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="gs-btn-pill mt-4"
                   StartIcon="@Icons.Material.Rounded.AddLink" Disabled="@_busy"
                   OnClick="LinkAsync">
            Link a bank
        </MudButton>
    }
</div>

@code {
    /// <summary>Where this sits in the page's entrance sequence.</summary>
    [Parameter] public int Reveal { get; set; }

    private bool _busy;

    private IReadOnlyList<BankConnectionResponse> Connections =>
        Inbox.Connections?.Connections ?? [];

    protected override void OnInitialized() => Inbox.OnChanged += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The one line under the institution's name: which accounts, and where the connection
    /// stands.
    /// </summary>
    /// <remarks>
    /// An instance method because of the clock. It used to be static and read
    /// <c>LastSyncedAt.LocalDateTime</c>, which resolves against whatever zone the runtime
    /// is in -- the browser's under WebAssembly and the server's under interactive server
    /// rendering, so the same connection read "last checked" a day apart depending on which
    /// mode the deployment runs. <see cref="LocalClock"/> is the one thing that knows the
    /// person's own offset, and it answers the same in both.
    /// </remarks>
    private string Describe(BankConnectionResponse connection)
    {
        var accounts = connection.Accounts.Count == 1
            ? connection.Accounts[0].Name
            : $"{connection.Accounts.Count} accounts";

        return connection.Status switch
        {
            BankConnectionState.Revoked => $"{accounts} · access withdrawn",
            // Not only a changed password: a locked account, an agreement waiting on the
            // bank's own site, an account nobody shared. Each ends in signing in again, so
            // the compact line says so and leaves the bank to say what it wants first.
            BankConnectionState.LoginRequired => $"{accounts} · sign in required",

            // Nothing is broken in either of these, so they read as something to do rather
            // than something that has gone wrong -- and each says why it needs attention,
            // before the actions menu offers the repair.
            _ when connection.AccountsNotShared => $"{accounts} · account needs sharing",
            _ when connection.SignInExpiring => $"{accounts} · sign in expires soon",

            _ when connection.Accounts.Any(account => account.AccessRevoked) =>
                $"{accounts} · {Withdrawn(connection)} access withdrawn",

            _ => connection.LastSyncedAt is { } synced
                ? $"{accounts} · last checked {Clock.Local(synced):d}"
                : $"{accounts} · not checked yet"
        };
    }

    /// <summary>The accounts of a connection whose access was withdrawn one at a time.</summary>
    private static string Withdrawn(BankConnectionResponse connection)
    {
        var revoked = connection.Accounts.Where(account => account.AccessRevoked).ToList();

        return revoked.Count == 1 ? revoked[0].Name : $"{revoked.Count} of its accounts";
    }

    /// <summary>
    /// Link, then exchange. The token is short-lived and the browser is the only thing that
    /// may see the person's bank credentials, so the whole middle of this happens in Plaid's
    /// own frame and comes back as one public token.
    /// </summary>
    private Task LinkAsync() => RunLinkAsync(connectionId: null);

    /// <summary>
    /// The same flow in update mode, which repairs the connection somebody already has
    /// rather than adding a second copy of it.
    /// </summary>
    private Task RepairAsync(BankConnectionResponse connection) => RunLinkAsync(connection.Id);

    private async Task RunLinkAsync(Guid? connectionId)
    {
        _busy = true;

        try
        {
            var token = await Bank.CreateLinkTokenAsync(connectionId);

            if (token is null)
                return;

            // The connection travels with the token, because an OAuth institution takes
            // the browser away and the page that comes back has to know whether it was
            // linking a bank or repairing one. See Pages/BankOAuthReturn.razor.
            var publicToken = await Link.OpenAsync(token.Token, connectionId);

            // Null means they closed it, which is an ordinary way out and says nothing.
            if (publicToken is null)
                return;

            if (connectionId is null)
            {
                await Bank.LinkAsync(publicToken);
            }
            else
            {
                // Update mode returns no usable public token; the repair is the sign-in
                // itself, so refresh accounts and ask for the sync it was blocking.
                await Bank.RefreshAsync(connectionId.Value, "your bank");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SyncAsync(BankConnectionResponse connection)
    {
        _busy = true;

        try
        {
            await Bank.SyncAsync(connection.Id, connection.InstitutionName);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UnlinkAsync(BankConnectionResponse connection)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { dialog => dialog.ContentText,
                $"Unlink {connection.InstitutionName}? Transactions still waiting in your inbox go with it. "
                + "Expenses you already added stay exactly as they are." },
            { dialog => dialog.ButtonText, "Unlink" },
            { dialog => dialog.Color, Color.Error }
        };

        var reference = await DialogService.ShowAsync<ConfirmationDialog>(
            "Unlink bank", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (await reference.GetReturnValueAsync<bool>() is not true)
            return;

        _busy = true;

        try
        {
            await Bank.UnlinkAsync(connection.Id, connection.InstitutionName);
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => Inbox.OnChanged -= OnChanged;
}
