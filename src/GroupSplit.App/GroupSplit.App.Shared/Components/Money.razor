@namespace GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Extensions

@*
    Every amount goes through here so figures share one face, tabular digits
    and one sign convention. The text is the figure, rendered once and never
    written over -- so it is correct with scripting off, and there is nothing
    that could leave a stale one on screen.

    `Animate` is CSS: the class carries the animation and the key is the value,
    so a new figure is a new element and the animation plays for it. A script
    used to interpolate the digits instead, and wrote them into this element;
    see `.gs-figure` in app.css for what that cost.
*@

<span class="gs-money @Tone @Class @(Animate ? "gs-figure" : null)"
      @key="@(Animate ? Value : default(decimal?))">@Text</span>

@code {
    [Parameter, EditorRequired] public decimal Value { get; set; }

    /// <summary>Colour by sign and prefix a positive figure with "+".</summary>
    [Parameter] public bool Signed { get; set; }

    /// <summary>Show the magnitude only, for "you owe X" phrasing where the words carry the sign.</summary>
    [Parameter] public bool Absolute { get; set; }

    /// <summary>
    /// Draw attention to the figure when it appears or changes. For the few that are worth
    /// it -- a balance, a card's headline total -- not for every amount in a listing.
    /// </summary>
    [Parameter] public bool Animate { get; set; }

    /// <summary>
    /// The currency this amount is in, when it is not the app's own. Imported bank rows
    /// carry theirs, and a euro charge shown with a dollar sign is a different number
    /// rather than a formatting quibble.
    /// </summary>
    [Parameter] public string? Currency { get; set; }

    [Parameter] public string? Class { get; set; }

    private decimal Shown => Absolute ? Math.Abs(Value) : Value;

    private string Text => Signed && Shown > 0 ? "+" + Shown.ToMoney(Currency) : Shown.ToMoney(Currency);

    private string Tone => !Signed ? "" : Value > 0 ? "gs-pos" : Value < 0 ? "gs-neg" : "gs-muted";
}
