@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Commands
@namespace GroupSplit.App.Shared.Components
@inject ISplitRuleCommands Rules

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">Edit split rule</MudText>
    </TitleContent>

    <DialogContent>
        @if (_model is null)
        {
            <div class="gs-empty" style="padding: 32px">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
            </div>
        }
        else
        {
            <RuleEditorForm @ref="_form" GroupId="GroupId" Model="_model"/>

            @* Said here, where the decision is made. A person editing a division reasonably
               fears they are about to restate what everyone owed last month; they are not,
               and the sentence costs less than the support question. *@
            <div class="gs-notice mt-4">
                <MudIcon Icon="@Icons.Material.Outlined.History"/>
                <div class="gs-notice-body">
                    <strong>Changing the division starts a new version of it</strong>
                    <span>
                        Expenses already recorded keep the split they were saved with, and go
                        on naming the version that produced it.
                    </span>
                </div>
            </div>

            @* The consequence somebody cannot see from here: this rule may stand behind
               more than the category they arrived from. *@
            @if (UsedBy.Count > 1)
            {
                <div class="gs-notice is-warn mt-3">
                    <MudIcon Icon="@Icons.Material.Outlined.Warning"/>
                    <div class="gs-notice-body">
                        <strong>@UsedBy.Listed() all divide by this rule</strong>
                        <span>Editing it changes what every one of them pre-fills, from now on.</span>
                    </div>
                </div>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   Disabled="@(_model is null || _saving)" OnClick="@Submit">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid GroupId { get; set; }

    [Parameter] public Guid SplitRuleId { get; set; }

    /// <summary>
    /// The categories that divide by this rule, named. Handed in rather than read, because
    /// the screen that opens this dialog is already holding them.
    /// </summary>
    [Parameter] public IReadOnlyList<string> UsedBy { get; set; } = [];

    private RuleEditorForm.RuleEditorModel? _model;
    private RuleEditorForm _form = null!;
    private bool _saving;

    /// <summary>
    /// A copy to edit, so cancelling leaves the rule as it was on the screen behind.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var rule = await Rules.GetAsync(SplitRuleId);

        if (rule is null)
        {
            MudDialog.Cancel();
            return;
        }

        _model = new RuleEditorForm.RuleEditorModel
        {
            Name = rule.Name,
            Version = CloneVersion(rule.Definition)
        };

        StateHasChanged();
    }

    /// <summary>
    /// The division to edit, copied so nothing else on screen moves while it is edited.
    /// </summary>
    /// <remarks>
    /// The dictionaries are the reason. <see cref="RuleEditorForm"/> binds its fields
    /// straight through the indexer, so sharing an instance with the caller's list would
    /// edit the row behind the dialog as somebody typed -- and leave it edited after
    /// Cancel.
    /// </remarks>
    private static SplitRuleDto CloneVersion(SplitRuleDto source) => source switch
    {
        PercentSplitRuleDto percent => new PercentSplitRuleDto
        {
            Percentages = percent.Percentages.ToDictionary(entry => entry.Key, entry => entry.Value)
        },

        SharesSplitRuleDto shares => new SharesSplitRuleDto
        {
            Shares = shares.Shares.ToDictionary(entry => entry.Key, entry => entry.Value)
        },

        PayerSplitRuleDto => new PayerSplitRuleDto(),

        EvenSplitRuleDto even => new EvenSplitRuleDto([.. even.Among]),

        // Every kind the API can return is above. A new one reaching a client that predates
        // it should not take the dialog down with it: it opens with no type chosen, which is
        // what "say how you want this to divide" looks like.
        _ => new EvenSplitRuleDto()
    };

    private async Task Submit()
    {
        if (_model is null || _saving) return;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        _saving = true;

        // A PUT, so the whole of what the rule is to become goes over: the API adds a
        // version when the division actually moved and none when only the name did.
        var saved = await Rules.UpdateAsync(SplitRuleId, new UpdateSplitRuleRequest
        {
            Name = _model.Name,
            Definition = _model.Version
        });

        _saving = false;

        if (saved is not null)
            MudDialog.Close(DialogResult.Ok(saved));
    }


    private void Cancel() => MudDialog.Cancel();
}
