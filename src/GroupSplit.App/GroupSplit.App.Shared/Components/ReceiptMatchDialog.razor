@using GroupSplit.Shared
@inject GroupSplit.App.Shared.Services.LocalClock Clock
@inject IDialogService Dialogs

<MudDialog Class="gs-sheet">
    <TitleContent><div class="gs-dialog-head"><h2 class="gs-dialog-title">@Loc["Is this receipt for an existing expense?"]</h2></div></TitleContent>
    <DialogContent>
        <div class="gs-stack" style="gap: 16px">
            <div class="gs-match-source">
                <div class="gs-inline" style="justify-content: space-between">
                    <div><div class="gs-match-source-name">@(Row.MerchantDisplayName ?? Row.Receipt.MerchantName ?? Loc["Receipt"].Value)</div>
                        <div class="gs-muted">@Row.Receipt.PurchaseDate?.ToString("d")</div></div>
                    <Money Value="@Row.Receipt.Total" Currency="@Row.Currency" />
                </div>
            </div>
            <div class="gs-match-section">
                <h3>@Loc["Possible matches"]</h3>
                <p>@Loc["Choose an expense to attach this receipt."]</p>
                <div class="gs-list" role="radiogroup" aria-label="@Loc["Possible matches"]">
                    @foreach (var candidate in _matches)
                    {
                        <button type="button" class="gs-match-choice gs-match-choice-simple @(_selectedId == candidate.Id ? "is-selected" : null)"
                                role="radio" aria-checked="@(_selectedId == candidate.Id ? "true" : "false")"
                                @onclick="@(() => _selectedId = candidate.Id)">
                            <span class="gs-match-choice-copy"><span class="title">@candidate.Name</span>
                                <span class="meta">@(candidate.GroupName ?? Loc["Personal"].Value) · @Clock.Day(candidate.DateTime).ToString("d")@if (!string.IsNullOrWhiteSpace(candidate.PaidByUserName)) { <text> · @Loc["{0} paid", candidate.PaidByUserName]</text> }</span>
                                @if (candidate.Id == InitialId) { <span class="gs-match-recommended">@Loc["Suggested match"]</span> }</span>
                            <Money Value="@candidate.Amount" Currency="@candidate.Currency" />
                            <MudIcon Icon="@(_selectedId == candidate.Id ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.RadioButtonUnchecked)"
                                     Color="@(_selectedId == candidate.Id ? Color.Primary : Color.Default)" />
                        </button>
                    }
                </div>
                <div class="gs-match-other-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Search" OnClick="FindAnother">@Loc["Find another expense"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add" OnClick="@(() => MudDialog.Close(DialogResult.Ok(new Answer(Action.Create, null))))">@Loc["Create a new expense"]</MudButton>
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selectedId is null)" OnClick="@(() => MudDialog.Close(DialogResult.Ok(new Answer(Action.Attach, _selectedId))))">@Loc["Attach to this expense"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ReceiptInboxResponse Row { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<ReceiptExpenseCandidate> Matches { get; set; } = [];
    [Parameter] public Guid? InitialId { get; set; }
    private List<ReceiptExpenseCandidate> _matches = [];
    private Guid? _selectedId;
    public enum Action { Attach, Dismiss, Create }
    public sealed record Answer(Action Action, Guid? ExpenseId);
    protected override void OnInitialized()
    {
        _matches = [.. Matches];
        _selectedId = _matches.FirstOrDefault(match => match.Id == InitialId)?.Id;
    }
    private async Task FindAnother()
    {
        var row = new BankTransactionResponse(Guid.Empty, Row.Receipt.PurchaseDate ?? DateOnly.FromDateTime(DateTime.Today), Row.Receipt.Total, Row.Currency, "Receipt", Row.Receipt.MerchantName, null, null, null, null, null, null, null, false, InboxStatus.New, null, null, "", "");
        var dialog = await Dialogs.ShowAsync<FindExpenseDialog>(Loc["Find existing expense"].Value,
            new DialogParameters<FindExpenseDialog> { { x => x.RequireUnlinkedBank, false }, { x => x.Row, row } });
        var expense = await dialog.GetReturnValueAsync<TransactionResponse>();
        if (expense is null) return;
        if (_matches.All(x => x.Id != expense.Id))
            _matches.Insert(0, new ReceiptExpenseCandidate(expense.Id, expense.Name, expense.Amount, expense.Currency, expense.DateTime) { GroupName = expense.GroupName, PaidByUserName = expense.PaidByUserName });
        _selectedId = expense.Id;
    }
}
