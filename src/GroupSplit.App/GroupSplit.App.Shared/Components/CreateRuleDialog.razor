@using GroupSplit.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">Create Rule</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Configure how this category should be split in the group.
        </MudText>
        <RuleEditorForm
            @ref="_form"
            GroupId="GroupId"
            Model="_model"
        />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid GroupId { get; set; }

    private readonly RuleEditorForm.RuleEditorModel _model = new();
    private RuleEditorForm _form = null!;

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        var request = new CreateRuleRequest
        {
            GroupId = GroupId,
            Category = _model.Category,
            Version = _model.Version
        };

        MudDialog.Close(request);
    }

    private void Cancel() => MudDialog.Cancel();
}