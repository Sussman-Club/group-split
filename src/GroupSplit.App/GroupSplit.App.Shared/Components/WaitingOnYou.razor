@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Settling
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject ISettleStateService Settling
@inject IInboxStateService Inbox
@inject IInvitationsClient InvitationsClient
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes
@inject LocalClock Clock
@inject NavigationManager Nav
@implements IDisposable

@*
    One strip, directly under the position: everything that needs a decision, whatever
    kind it is.

    These three used to live in three different places -- a settling plan nowhere at all, a
    badge in the nav, and an invitations panel below four stat tiles -- so "is anything
    waiting on me?" was answered by looking in three places and remembering to. They are
    one list because they are one question, and they are ordered by how much they cost to
    put right: money first, then a queue, then a yes or no.
*@

@if (Items > 0)
{
    <section class="gs-card gs-card-pad gs-waiting gs-reveal" style="--i: @Reveal">
        <div class="gs-card-title">
            <h2>@Loc["Waiting on you"]</h2>
            <span class="gs-tag">@Items</span>
        </div>

        <div class="gs-list">
            @if (Plan is { } plan && (plan.YouPay.Count > 0 || plan.OwedToYou.Count > 0))
            {
                <div class="gs-row" style="cursor: default">
                    <span class="gs-row-icon"><MudIcon Icon="@Icons.Material.Rounded.Handshake" /></span>
                    <div style="min-width: 0">
                        <div class="title"><span>@SettleHeadline(plan)</span></div>
                        <div class="meta">@SettleDetail(plan)</div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Class="gs-btn-pill" Href="/settle">@Loc["Settle up"]</MudButton>
                </div>
            }

            @if (Inbox.NewCount > 0)
            {
                <div class="gs-row" style="cursor: default">
                    <span class="gs-row-icon"><MudIcon Icon="@Icons.Material.Rounded.Inbox" /></span>
                    <div style="min-width: 0">
                        <div class="title">
                            <span>@(Inbox.NewCount == 1 ? Loc["{0} bank transaction waiting", Inbox.NewCount] : Loc["{0} bank transactions waiting", Inbox.NewCount])</span>
                        </div>
                        <div class="meta">@InboxDetail</div>
                    </div>
                    @* Not gs-btn-glass: every rule of that class is scoped to .gs-hero,
                       so out here it styled nothing and "Review" rendered as bare text. *@
                    <MudButton Variant="Variant.Text" Class="gs-btn-quiet" Size="Size.Small"
                               Href="/transactions/not-filed">@Loc["Review"]</MudButton>
                </div>
            }

            @* Guests' links somebody has opened and not answered.

               It used to be every invitation sent to their address, and there are no
               addresses on a link -- so this is the ones they have opened, which the API
               writes down as it happens. Without it, opening a link and wandering off left
               it reachable only through the chat thread it arrived in.

               No Accept button, where the old row had one. Claiming takes the guest's place
               and everything recorded for them, and the page that says so is /claim -- a
               one-tap Accept out here would be agreeing to a position nobody had been
               shown. *@
            @foreach (var invitation in _invitations)
            {
                var pending = invitation;
                <div class="gs-row" style="cursor: default">
                    <span class="gs-row-icon"><MudIcon Icon="@Icons.Material.Rounded.PersonAddAlt" /></span>
                    <div style="min-width: 0">
                        <div class="title">
                            <span>
                                @(string.IsNullOrWhiteSpace(pending.InvitedByUserName)
                                    ? Loc["A link to join {0} as {1}", pending.GroupName, pending.Name].Value
                                    : Loc["{0} sent you a link to join {1} as {2}", pending.InvitedByUserName, pending.GroupName, pending.Name].Value)
                            </span>
                        </div>
                        <div class="meta">@Loc["{0} is a guest there · link sent {1:d MMM}", pending.Name, Clock.Local(pending.InvitedAt)]</div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Class="gs-btn-pill"
                               Href="@($"/claim/{pending.Token}")">@Loc["Open"]</MudButton>
                </div>
            }
        </div>
    </section>
}

@code {
    /// <summary>Where this sits in the page's entrance sequence.</summary>
    [Parameter] public int Reveal { get; set; }

    private SettlementPlanResponse? Plan => Settling.Plan;

    /// <summary>
    /// How many decisions are waiting. The settling plan counts once however many people
    /// are in it, because going to Settle is one decision and the plan is what it is for.
    /// </summary>
    private IReadOnlyList<GroupInvitationResponse> _invitations = [];

    private int Items =>
        (Plan is { } plan && (plan.YouPay.Count > 0 || plan.OwedToYou.Count > 0) ? 1 : 0)
        + (Inbox.NewCount > 0 ? 1 : 0)
        + _invitations.Count;

    /// <summary>
    /// Leads with the payments rather than the debts, because that is the smaller number
    /// and the one somebody can act on: four debts across two groups can be two payments.
    /// </summary>
    private string SettleHeadline(SettlementPlanResponse plan) => plan.YouPay.Count switch
    {
        0 => Loc["{0} owe you", People(plan.OwedToYou.Count)].Value,
        1 => Loc["One payment would clear what you owe"].Value,
        var count => Loc["{0} payments would clear everything you owe", count].Value
    };

    private string SettleDetail(SettlementPlanResponse plan)
    {
        var owing = plan.YouPay.Count == 0
            ? null
            : plan.YouPay.Count == 1
                ? Loc["{0} to {1}", plan.YouOweTotal.ToMoney(), plan.YouPay[0].UserName.Split(' ')[0]].Value
                : Loc["{0} to {1}", plan.YouOweTotal.ToMoney(), People(plan.YouPay.Count)].Value;

        var owed = plan.OwedToYou.Count == 0
            ? null
            : Loc["{0} owe you {1}", People(plan.OwedToYou.Count), plan.OwedToYouTotal.ToMoney()].Value;

        return string.Join(Loc[", and "].Value, new[] { owing, owed }.Where(part => part is not null));
    }

    private string People(int count) => count == 1 ? Loc["1 person"].Value : Loc["{0} people", count].Value;

    /// <summary>
    /// The duplicate warning is the highest-value thing the inbox says, and the easiest to
    /// lose: it belongs here as well, before anything has been filed.
    /// </summary>
    private string InboxDetail => Inbox.PossibleDuplicates switch
    {
        > 0 and var count =>
            Loc["{0} of them may already be recorded as an expense", count].Value,
        _ => Loc["Nothing counts as money until you say so"].Value
    };

    protected override void OnInitialized()
    {
        Changes.GroupsChanged += ReloadAsync;

        // From the start, like every other reader of these two: subscribing after the
        // first render missed whatever the reads below announced before it.
        Settling.OnChanged += ReRender;
        Inbox.OnChanged += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        // The plan is usually already read -- the nav badge asks for it -- and this is the
        // one screen that says the duplicate count out loud, so it is the one that asks.
        await Settling.EnsureLoadedAsync();
        await Inbox.WantDuplicateCountAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var loaded = _invitations;

        await Errors.TryAsync(async () =>
                loaded = [.. await InvitationsClient.GetMyInvitationsAsync()],
            Loc["Could not load the links you have opened."].Value);

        _invitations = loaded;
        await InvokeAsync(StateHasChanged);
    }

    private void ReRender() => InvokeAsync(StateHasChanged);



    public void Dispose()
    {
        Changes.GroupsChanged -= ReloadAsync;
        Settling.OnChanged -= ReRender;
        Inbox.OnChanged -= ReRender;
    }
}
