@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Settling
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject ISettleStateService Settling
@inject IInboxStateService Inbox
@inject DataChangeNotifier Changes
@inject NavigationManager Nav
@implements IDisposable

@*
    One strip, directly under the position: everything that needs a decision, whatever
    kind it is.

    These three used to live in three different places -- a settling plan nowhere at all, a
    badge in the nav, and an invitations panel below four stat tiles -- so "is anything
    waiting on me?" was answered by looking in three places and remembering to. They are
    one list because they are one question, and they are ordered by how much they cost to
    put right: money first, then a queue, then a yes or no.
*@

@if (Items > 0)
{
    <section class="gs-card gs-card-pad gs-waiting gs-reveal" style="--i: @Reveal">
        <div class="gs-card-title">
            <h2>Waiting on you</h2>
            <span class="gs-tag">@Items</span>
        </div>

        <div class="gs-list">
            @if (Plan is { } plan && (plan.YouPay.Count > 0 || plan.OwedToYou.Count > 0))
            {
                <div class="gs-row" style="cursor: default">
                    <span class="gs-row-icon"><MudIcon Icon="@Icons.Material.Rounded.Handshake" /></span>
                    <div style="min-width: 0">
                        <div class="title"><span>@SettleHeadline(plan)</span></div>
                        <div class="meta">@SettleDetail(plan)</div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Class="gs-btn-pill" Href="/settle">Settle up</MudButton>
                </div>
            }

            @if (Inbox.NewCount > 0)
            {
                <div class="gs-row" style="cursor: default">
                    <span class="gs-row-icon"><MudIcon Icon="@Icons.Material.Rounded.Inbox" /></span>
                    <div style="min-width: 0">
                        <div class="title">
                            <span>@Inbox.NewCount bank transaction@(Inbox.NewCount == 1 ? "" : "s") waiting</span>
                        </div>
                        <div class="meta">@InboxDetail</div>
                    </div>
                    @* Not gs-btn-glass: every rule of that class is scoped to .gs-hero,
                       so out here it styled nothing and "Review" rendered as bare text. *@
                    <MudButton Variant="Variant.Text" Class="gs-btn-quiet" Size="Size.Small"
                               Href="/inbox">Review</MudButton>
                </div>
            }

            @* Invitations used to be the third row here, and cannot be. An invitation is a
               named person and a link now, not an address, so there is no account for a
               list of them to hang from -- somebody learns of one by opening the link they
               were sent, which lands on /claim. Nothing to wait on means nothing to show. *@
        </div>
    </section>
}

@code {
    /// <summary>Where this sits in the page's entrance sequence.</summary>
    [Parameter] public int Reveal { get; set; }

    private SettlementPlanResponse? Plan => Settling.Plan;

    /// <summary>
    /// How many decisions are waiting. The settling plan counts once however many people
    /// are in it, because going to Settle is one decision and the plan is what it is for.
    /// </summary>
    private int Items =>
        (Plan is { } plan && (plan.YouPay.Count > 0 || plan.OwedToYou.Count > 0) ? 1 : 0)
        + (Inbox.NewCount > 0 ? 1 : 0);

    /// <summary>
    /// Leads with the payments rather than the debts, because that is the smaller number
    /// and the one somebody can act on: four debts across two groups can be two payments.
    /// </summary>
    private static string SettleHeadline(SettlementPlanResponse plan) => plan.YouPay.Count switch
    {
        0 => $"{People(plan.OwedToYou.Count)} owe you",
        1 => "One payment would clear what you owe",
        var count => $"{count} payments would clear everything you owe"
    };

    private static string SettleDetail(SettlementPlanResponse plan)
    {
        var owing = plan.YouPay.Count == 0
            ? null
            : plan.YouPay.Count == 1
                ? $"{plan.YouOweTotal.ToMoney()} to {plan.YouPay[0].UserName.Split(' ')[0]}"
                : $"{plan.YouOweTotal.ToMoney()} to {People(plan.YouPay.Count)}";

        var owed = plan.OwedToYou.Count == 0
            ? null
            : $"{People(plan.OwedToYou.Count)} owe you {plan.OwedToYouTotal.ToMoney()}";

        return string.Join(", and ", new[] { owing, owed }.Where(part => part is not null));
    }

    private static string People(int count) => count == 1 ? "1 person" : $"{count} people";

    /// <summary>
    /// The duplicate warning is the highest-value thing the inbox says, and the easiest to
    /// lose: it belongs here as well, before anything has been filed.
    /// </summary>
    private string InboxDetail => Inbox.PossibleDuplicates switch
    {
        > 0 and var count =>
            $"{count} of them may already be recorded as an expense",
        _ => "Nothing counts as money until you say so"
    };

    protected override void OnInitialized()
    {
        Changes.GroupsChanged += ReRenderAsync;

        // From the start, like every other reader of these two: subscribing after the
        // first render missed whatever the reads below announced before it.
        Settling.OnChanged += ReRender;
        Inbox.OnChanged += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        // The plan is usually already read -- the nav badge asks for it -- and this is the
        // one screen that says the duplicate count out loud, so it is the one that asks.
        await Settling.EnsureLoadedAsync();
        await Inbox.WantDuplicateCountAsync();
    }

    private void ReRender() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// What a change to the groups now means here: nothing to re-read, only the counts
    /// above to say again. It used to re-read the caller's invitations, which no longer
    /// exist as a list.
    /// </summary>
    private Task ReRenderAsync() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Changes.GroupsChanged -= ReRenderAsync;
        Settling.OnChanged -= ReRender;
        Inbox.OnChanged -= ReRender;
    }
}
