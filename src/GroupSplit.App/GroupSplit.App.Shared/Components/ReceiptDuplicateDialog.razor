@using GroupSplit.Shared

<MudDialog Class="gs-compare-dialog">
    <TitleContent><div class="gs-compare-heading"><h2>@Loc["Compare receipts"]</h2><p>@Loc["Check the originals and details before deciding."]</p></div></TitleContent>
    <DialogContent>
        <div class="gs-compare-grid">
            @foreach (var entry in new[] { (Row: DeleteRow, Label: Loc["Receipt to delete"].Value), (Row: KeepRow, Label: Loc["Receipt to keep"].Value) })
            {
                <ReceiptComparisonSide Label="@entry.Label" Name="@(entry.Row.MerchantDisplayName ?? entry.Row.Receipt.MerchantName ?? Loc["Receipt"].Value)"
                    Date="@entry.Row.Receipt.PurchaseDate" Total="@entry.Row.Receipt.Total" Currency="@entry.Row.Currency"
                    Detail="@(entry.Row.ExpenseName is { } expense ? Loc["Added to: {0}", expense].Value : null)"
                    ReceiptId="@entry.Row.Id" ExpenseId="@entry.Row.ExpenseId" Attachments="@entry.Row.Attachments"
                    Items="@entry.Row.Receipt.Items.Select(item => new ReceiptComparisonSide.Item(item.Name, item.TotalPrice)).ToArray()" />
            }
        </div>
        <p class="gs-compare-warning">@Loc["Deleting this receipt also deletes its original files and cannot be undone."]</p>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => Dialog.Cancel())">@Loc["Keep both"]</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => Dialog.Close(DialogResult.Ok(true)))">@Loc["Delete receipt"]</MudButton></DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public ReceiptInboxResponse DeleteRow { get; set; } = null!;
    [Parameter, EditorRequired] public ReceiptInboxResponse KeepRow { get; set; } = null!;
}
