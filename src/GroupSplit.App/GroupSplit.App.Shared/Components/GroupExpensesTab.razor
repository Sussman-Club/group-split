@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ApiErrorPresenter Errors
@inject LocalClock Clock
@inject DataChangeNotifier Changes
@implements IDisposable

@*
    Everything one group has spent, whoever paid.

    Was a page of its own behind a link from the group; it is the group's Expenses tab now.
    The other axis -- everything one person has paid, across every group -- is still its own
    page, because it is not about a group at all.
*@

<div class="gs-stack">
    <div class="gs-inline" style="justify-content: space-between; gap: 12px; flex-wrap: wrap">
        <DateRangeFilter Value="@_range" ValueChanged="OnRangeChangedAsync" />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Search by name, category or who paid"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Rounded.Search"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="OnSearchChangedAsync"
                      Clearable="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      Class="gs-search"
                      Style="min-width: min(360px, 100%)" />
    </div>

    <ExpenseFigures Summary="_summary"
                    Range="_range"
                    Searching="IsSearching"
                    Scope="by everyone"
                    CountLabel="Expenses"
                    TotalLabel="Total spent" />

    <div class="gs-reveal" style="--i: 2">
        @* No group column: every row here is the same group, so it would be the same tag
           repeated down the page. *@
        <ExpensesGrid @ref="_grid"
                      LoadPage="LoadPageAsync"
                      IsNarrowed="@IsNarrowed"
                      ShowGroup="false"
                      EmptyTitle="Nothing recorded yet"
                      EmptyDescription="Expenses anyone in this group records will show up here." />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid GroupId { get; set; }

    private string _searchString = "";
    private DateFilter _range = DateFilter.AllTime;
    private ExpensesGrid? _grid;
    private TransactionSummaryResponse? _summary;

    /// <summary>
    /// What the cards were last asked about. Both the reason not to ask again for something
    /// already on its way, and the test an answer has to pass before it is shown.
    /// </summary>
    private SummaryKey? _asked;

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchString);

    private bool IsNarrowed => IsSearching || !_range.IsAllTime;

    private string? Search => IsSearching ? _searchString.Trim() : null;

    /// <summary>
    /// Everything the figures on the cards depend on, so that two narrowings arrived at the
    /// same way compare equal and one arrived at differently does not.
    /// </summary>
    private sealed record SummaryKey(Guid Group, DateFilter Range, string? Search);

    private SummaryKey CurrentKey => new(GroupId, _range, Search);

    private async Task<PagedResponse<TransactionResponse>?> LoadPageAsync(
        TransactionQuery query, CancellationToken cancellationToken)
    {
        // The search box and the chips belong to this component, so what they say is read
        // here, as the request is made, rather than handed to the grid to hold on to.
        //
        // The generated client answers with the concrete wire type, and Task is not
        // covariant, so the page is awaited here and handed back as the base type.
        var bounds = _range.Bounds(Clock.Offset, Clock.Today);

        var page = await ReadAsync<PagedResponseOfTransactionResponse>(() =>
            GroupsClient.GetGroupTransactionsAsync(
                GroupId,
                from: bounds.From,
                to: bounds.To,
                search: Search,
                sortBy: query.SortBy,
                sortDescending: query.SortDescending,
                page: query.Page,
                pageSize: query.PageSize,
                cancellationToken: cancellationToken));

        return page;
    }

    /// <summary>
    /// Reads through the presenter, so a refusal is shown once and the caller is handed
    /// null rather than an exception the grid would have to catch.
    /// </summary>
    private async Task<T?> ReadAsync<T>(Func<Task<T>> read) where T : class
    {
        T? result = null;
        await Errors.TryAsync(async () => result = await read(), "Could not load this group's expenses.");
        return result;
    }

    private async Task OnSearchChangedAsync(string _)
    {
        // The cards describe the same narrowing the list is under, and the search box is one
        // of the two things narrowing it.
        await ReadSummaryAsync();
        await BackToFirstPageAsync();
    }

    private async Task OnRangeChangedAsync(DateFilter range)
    {
        _range = range;

        // The tile totals the same span the grid is showing, so it is read again with it.
        await ReadSummaryAsync();
        await BackToFirstPageAsync();
    }

    private Task BackToFirstPageAsync() =>
        _grid?.ReloadFromFirstPageAsync() ?? Task.CompletedTask;

    /// <summary>
    /// The figures beside the list, over the narrowing the list is under: a card totalling
    /// all time above a list showing one month is two answers to the same question, and the
    /// caption under it attributes the larger one to the month.
    /// </summary>
    /// <remarks>
    /// Asked only when the narrowing changes, and shown only if it is still the narrowing in
    /// force. The group page re-renders this tab on every announcement about the group -- it
    /// subscribes to three of them -- and each of those renders used to send a summary
    /// request of its own. Every one of them was a correct request, but the ones from before
    /// a chip was clicked asked about all time, and an answer to one of those arriving after
    /// the filtered one put the all-time figures back on the cards, where they stayed while
    /// the list underneath showed the month.
    /// </remarks>
    private async Task ReadSummaryAsync()
    {
        var key = CurrentKey;

        if (key == _asked)
            return;

        _asked = key;

        var bounds = key.Range.Bounds(Clock.Offset, Clock.Today);

        var summary = await ReadAsync<TransactionSummaryResponse>(
            () => GroupsClient.GetGroupTransactionsSummaryAsync(
                GroupId, from: bounds.From, to: bounds.To, search: key.Search));

        // Something has been asked for since. That answer is the one the cards are waiting
        // for, and this one is about a narrowing nobody is looking at any more.
        if (key == _asked)
            _summary = summary;
    }

    /// <summary>
    /// A write moves the figures without moving the narrowing, so the key cannot notice it
    /// and the cards have to be told. These are the two signals the grid under them reloads
    /// on, so the figures and the rows they describe are never refreshed by different news.
    /// </summary>
    private async Task OnDataChangedAsync()
    {
        _asked = null;

        await ReadSummaryAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        Changes.TransactionsChanged += OnDataChangedAsync;
        Changes.GroupsChanged += OnDataChangedAsync;
    }

    public void Dispose()
    {
        Changes.TransactionsChanged -= OnDataChangedAsync;
        Changes.GroupsChanged -= OnDataChangedAsync;
    }

    protected override Task OnParametersSetAsync() => ReadSummaryAsync();
}
