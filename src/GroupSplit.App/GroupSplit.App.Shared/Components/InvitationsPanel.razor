@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IInvitationsClient InvitationsClient
@inject IGroupCommands GroupCommands
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes
@inject NavigationManager Nav
@implements IDisposable

@*
    Groups that have asked for you. Shown wherever somebody would look for a group they
    have been told about and cannot find -- the home page and the groups list -- because
    until they accept, it is not in either.
*@

@if (_invitations.Count > 0)
{
    <div class="gs-card gs-card-pad gs-reveal" style="--i: @Reveal">
        <div class="gs-card-title">
            <h2>Invitations</h2>
            <span class="gs-tag">@_invitations.Count waiting</span>
        </div>

        <div class="gs-list">
            @foreach (var invitation in _invitations)
            {
                var pending = invitation;
                <div class="gs-row" style="cursor: default">
                    <Avatar Name="@pending.GroupName" />
                    <div style="min-width: 0">
                        <div class="title"><span>@pending.GroupName</span></div>
                        <div class="meta">
                            @(string.IsNullOrWhiteSpace(pending.InvitedByUserName)
                                ? "You have been asked to join"
                                : $"{pending.InvitedByUserName} asked you to join")
                        </div>
                    </div>
                    <div class="gs-inline" style="gap: 4px; flex-wrap: nowrap">
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Disabled="@(_busy == pending.Id)"
                                   OnClick="@(() => DeclineAsync(pending))">Decline</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   Class="gs-btn-pill"
                                   Disabled="@(_busy == pending.Id)"
                                   OnClick="@(() => AcceptAsync(pending))">Join</MudButton>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Where this sits in the page's entrance sequence.</summary>
    [Parameter] public int Reveal { get; set; }

    /// <summary>Whether joining should open the group that was just joined.</summary>
    [Parameter] public bool OpenOnJoin { get; set; } = true;

    private IReadOnlyList<GroupInvitationResponse> _invitations = [];
    private Guid? _busy;

    protected override void OnInitialized() => Changes.GroupsChanged += ReloadAsync;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        var loaded = _invitations;

        await Errors.TryAsync(async () =>
                loaded = [.. await InvitationsClient.GetMyInvitationsAsync()],
            "Could not load your invitations.");

        _invitations = loaded;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AcceptAsync(GroupInvitationResponse invitation)
    {
        _busy = invitation.Id;

        var joined = await GroupCommands.AcceptInvitationAsync(invitation.Id, invitation.GroupName);

        _busy = null;

        // The command announces, and this panel reloads off that announcement, so the row
        // goes on its own. Opening the group is the part it cannot do for itself.
        if (joined is not null && OpenOnJoin)
            Nav.NavigateTo($"/groups/{joined.Id}");
    }

    private async Task DeclineAsync(GroupInvitationResponse invitation)
    {
        _busy = invitation.Id;
        await GroupCommands.DeclineInvitationAsync(invitation.Id, invitation.GroupName);
        _busy = null;
    }

    public void Dispose() => Changes.GroupsChanged -= ReloadAsync;
}
