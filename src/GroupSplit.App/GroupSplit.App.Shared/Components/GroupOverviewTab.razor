@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IGroupsPageStateService GroupsService
@inject IGroupsClient GroupsClient
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes
@inject IDialogService DialogService
@inject LocalClock Clock
@implements IDisposable

@*
    Where a group stands, on the screen people actually land on.

    Three things changed here. The minimised settlement plan is on the page -- it has been
    computed on every balance read since balances existed and was rendered nowhere, which
    is a strange thing for the product to know and not say. The recent entries carry each
    reader's own share, because what the dinner cost and what it cost you are different
    numbers. And the two lists that used to sit side by side -- recent expenses and latest
    activity -- are one, for the same reason the two tabs became one ledger.
*@

<div class="gs-two-col">
    <div class="gs-stack">
        @if (Balance is { } balance)
        {
            <section class="gs-hero @HeroClass gs-reveal" style="--i: 0" aria-live="polite">
                @if (UserBalance > 0)
                {
                    <div class="gs-eyebrow">You are owed</div>
                    <Money Value="UserBalance" Animate Class="gs-hero-amount" />
                    @* Guests count: they are people the group shares costs with, and what
                       they owe is owed to somebody like anybody else's. *@
                    <div class="gs-hero-sub">by @People(balance.OwedToYou.Count()) in @GroupName</div>
                    <div class="gs-hero-list">
                        @foreach (var debt in balance.OwedToYou)
                        {
                            var owed = debt;
                            var guest = IsGuest(owed.UserId);
                            <div class="gs-hero-row">
                                <Avatar Name="@owed.UserName" Size="sm" />
                                <div class="who">@Named(owed.UserId, owed.UserName) <small>owes you</small></div>
                                <Money Value="owed.Amount" Animate />
                                @* Named for a guest. "They paid" reads as the other person
                                   telling the app, and a guest cannot: it is you saying it on
                                   their behalf, so the button says whose payment it is. *@
                                <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => OnSettle.InvokeAsync((owed, SettlementDirection.TheyPaidYou)))">
                                    @(guest ? $"{owed.UserName} paid" : "They paid")
                                </MudButton>
                            </div>
                        }
                    </div>
                }
                else if (UserBalance < 0)
                {
                    <div class="gs-eyebrow">You owe</div>
                    <Money Value="UserBalance" Absolute Animate Class="gs-hero-amount" />
                    <div class="gs-hero-sub">to @People(balance.YouOwed.Count()) in @GroupName</div>
                    <div class="gs-hero-list">
                        @* Both sides can record a repayment. The person who actually did the
                           paying had no way to say so, and had to ask the other one to. *@
                        @foreach (var debt in balance.YouOwed)
                        {
                            var owing = debt;
                            <div class="gs-hero-row">
                                <Avatar Name="@owing.UserName" Size="sm" />
                                <div class="who">@Named(owing.UserId, owing.UserName) <small>is waiting on you</small></div>
                                <Money Value="owing.Amount" Animate />
                                <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => OnSettle.InvokeAsync((owing, SettlementDirection.YouPaidThem)))">
                                    I paid
                                </MudButton>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="gs-eyebrow">Your balance</div>
                    <div class="gs-hero-amount">All settled</div>
                    <div class="gs-hero-sub">Nothing owed either way in @GroupName. Nice.</div>
                }
            </section>
        }

        @if (Plan.Count > 0)
        {
            <section class="gs-card gs-card-pad gs-reveal" style="--i: 1">
                <div class="gs-card-title">
                    <h2>@Payments(Plan.Count) clear@(Plan.Count == 1 ? "s" : "") this group</h2>
                    <span class="gs-tag neutral">the shortest way</span>
                </div>
                <div class="gs-plan-list">
                    @foreach (var payment in Plan)
                    {
                        var line = payment;
                        var yours = Involves(line);
                        <div class="gs-plan-row @(yours ? "" : "is-theirs")">
                            <Avatar Name="@line.FromUserName" Size="sm" />
                            <div style="min-width: 0">
                                <div class="who">@Payer(line) <small>@(line.FromUserId == UserId ? "pay" : "pays")</small> @Who(line.ToUserId, line.ToUserName)</div>
                                <div class="meta">@Explain(line)</div>
                            </div>
                            <Money Value="line.Amount" />
                            @if (yours)
                            {
                                <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => RecordAsync(line))">
                                    @(line.FromUserId == UserId ? "I paid them" : "They paid me")
                                </MudButton>
                            }
                            else if (BetweenGuests(line))
                            {
                                @* Two guests, so nobody on either end can sign in to say it
                                   happened. Every member records for guests, so this line is
                                   any member's to record -- named in full, because the
                                   person pressing it is on neither end of it. *@
                                <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text"
                                           aria-label="@($"Record that {line.FromUserName} paid {line.ToUserName}")"
                                           OnClick="@(() => RecordBetweenGuestsAsync(line))">
                                    @line.FromUserName paid @line.ToUserName
                                </MudButton>
                            }
                            else
                            {
                                @* Not the caller's to record. Listed because a plan that
                                   hides a step does not add up. A line between a guest and
                                   another member is that member's, the same as a line
                                   between two other members: they were there for it. *@
                                <span class="gs-muted" style="font-size: .8125rem">their call</span>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <div class="gs-card gs-card-pad gs-reveal" style="--i: 2">
            <div class="gs-card-title">
                <h2>Recent activity</h2>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           Href="@($"/groups/{GroupId}/activity")"
                           EndIcon="@Icons.Material.Rounded.ArrowForward">All activity</MudButton>
            </div>
            <GroupEntryList Entries="Recent" />
            @if (_recent is { } ledger && ledger.TotalCount > ledger.Items.Count)
            {
                <div class="gs-muted" style="font-size: .8125rem; padding: 8px 4px 0">
                    Showing the @ledger.Items.Count newest of @ledger.TotalCount.
                </div>
            }
        </div>
    </div>

    <div class="gs-stack">
        <div class="gs-card gs-card-pad gs-reveal" style="--i: 3">
            <div class="gs-card-title">
                <h2>People</h2>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           Href="@($"/groups/{GroupId}/people")"
                           EndIcon="@Icons.Material.Rounded.ArrowForward">View people</MudButton>
            </div>
            @if (Balance is { } b && b.NetBalances.Any())
            {
                var max = Math.Max(b.NetBalances.Max(m => Math.Abs(m.Balance)), 0.01m);
                var i = 0;
                <div class="gs-balances">
                    @foreach (var member in b.NetBalances.OrderByDescending(m => m.Balance))
                    {
                        var w = (double)(Math.Abs(member.Balance) / max);
                        <div class="gs-balance-row @(member.Balance < 0 ? "is-neg" : "")" style="--i: @(i++)">
                            <Avatar Name="@member.UserName" Size="sm" />
                            <div style="min-width: 0">
                                <div class="name" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
                                    @member.UserName
                                    @if (member.UserId == UserId)
                                    {
                                        <span class="gs-muted" style="font-weight: 500"> (you)</span>
                                    }
                                    @* A guest's balance is like anybody's, and they are in the
                                       plan too. The mark is so the name is not read as a
                                       member who can sign in and settle it themselves. *@
                                    @if (member.IsGuest)
                                    {
                                        @* The space is in the expression: Razor drops a literal one
                                           that only precedes code, which ran the mark into the name. *@
                                        <span class="gs-muted" style="font-weight: 500">@($" {ParticipantCopy.GuestMark}")</span>
                                    }
                                </div>
                                <div class="bar"><span style="--w: @w.ToString(System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                            </div>
                            <Money Value="member.Balance" Signed Animate />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gs-empty" style="padding: 20px">
                    <MudIcon Icon="@Icons.Material.Rounded.Balance" />
                    <span>Balances appear once there is an expense.</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>How many entries the overview shows before sending somebody to the ledger.</summary>
    private const int RecentCount = 3;

    [Parameter, EditorRequired] public Guid GroupId { get; set; }

    [Parameter, EditorRequired] public string GroupName { get; set; } = "";

    /// <summary>Who is reading, so the plan can say "you" and offer the lines they may record.</summary>
    [Parameter] public Guid? UserId { get; set; }

    /// <summary>
    /// Settling with one person, which the page owns because it owns the dialog and the
    /// write. The tab knows which line was pressed and nothing else.
    /// </summary>
    [Parameter] public EventCallback<(DebtInfo Debt, SettlementDirection Direction)> OnSettle { get; set; }

    private PagedResponse<GroupLedgerEntryResponse>? _recent;
    private Guid _loadedFor;

    /// <summary>
    /// Counts reads of the recent entries, so the answer to an older one -- a change
    /// announced while the group was still being switched to -- cannot land over a newer.
    /// </summary>
    private int _recentVersion;

    /// <summary>
    /// The balances, but only the selected group's own. The state holds one group's at a
    /// time and this tab is about one group; the two are the same group in every case but
    /// the moment between a selection and its figures landing, and in that moment the
    /// previous group's balances are the wrong thing to hang this group's name on.
    /// </summary>
    private UserGroupBalanceResponse? Balance =>
        GroupsService.SelectedGroup?.Id == GroupId ? GroupsService.Balance : null;

    private IReadOnlyList<GroupLedgerEntryResponse> Recent => _recent?.Items ?? [];

    private IReadOnlyList<SettlementPayment> Plan => Balance?.Plan ?? [];

    private decimal UserBalance =>
        Balance?.NetBalances.FirstOrDefault(member => member.UserId == UserId)?.Balance ?? 0m;

    private string HeroClass => UserBalance switch
    {
        > 0 => "",
        < 0 => "is-neg",
        _ => "is-zero"
    };

    private static string People(int count) => count == 1 ? "1 person" : $"{count} people";

    private static string Payments(int count) => count == 1 ? "One payment" : $"{Word(count)} payments";

    private static string Word(int count) => count switch
    {
        2 => "Two",
        3 => "Three",
        4 => "Four",
        5 => "Five",
        _ => count.ToString()
    };

    private bool Involves(SettlementPayment payment) =>
        payment.FromUserId == UserId || payment.ToUserId == UserId;

    private string Who(Guid userId, string name) => userId == UserId ? "you" : Named(userId, name);

    /// <summary>
    /// The start of a plan line: "You", capitalised because it opens the sentence, or the
    /// payer's name. It read "you pays Sofia" when the caller was the one paying.
    /// </summary>
    private string Payer(SettlementPayment line) =>
        line.FromUserId == UserId ? "You" : Who(line.FromUserId, line.FromUserName);

    /// <summary>
    /// Whether somebody in this group's balances is one of its guests. Read off the balances
    /// rather than carried on each debt or plan line, because those name a person and an
    /// amount and nothing else -- and the balances are the one listing here that has
    /// everybody in it.
    /// </summary>
    private bool IsGuest(Guid userId) =>
        Balance?.NetBalances.Any(member => member.UserId == userId && member.IsGuest) ?? false;

    /// <summary>A name, with the guest mark when it belongs to a guest.</summary>
    private string Named(Guid userId, string name) =>
        IsGuest(userId) ? ParticipantCopy.Guest(name) : name;

    /// <summary>
    /// A plan line with a guest on both ends: one nobody involved can record, and so one any
    /// member may.
    /// </summary>
    private bool BetweenGuests(SettlementPayment payment) =>
        IsGuest(payment.FromUserId) && IsGuest(payment.ToUserId);

    /// <summary>
    /// What this line does for the plan. Naming the person it clears is the check somebody
    /// needs: a plan whose lines do not obviously add up to the balances above it is a
    /// black box, and this one is the app's own arithmetic being shown for the first time.
    /// </summary>
    private string Explain(SettlementPayment payment)
    {
        if (BetweenGuests(payment))
            return "between two guests — any member can record it";

        if (!Involves(payment))
            return "not yours to record — shown so the plan adds up";

        var other = payment.FromUserId == UserId ? payment.ToUserName : payment.FromUserName;
        var theirBalance = Balance?.NetBalances
            .FirstOrDefault(member => member.UserId ==
                                      (payment.FromUserId == UserId ? payment.ToUserId : payment.FromUserId))
            ?.Balance ?? 0m;

        return Math.Abs(theirBalance) == payment.Amount
            ? $"clears {other} entirely"
            : $"part of what stands between you and {other}";
    }

    private Task RecordAsync(SettlementPayment payment)
    {
        var theirs = payment.FromUserId == UserId ? payment.ToUserId : payment.FromUserId;
        var name = payment.FromUserId == UserId ? payment.ToUserName : payment.FromUserName;

        var debt = new DebtInfo { UserId = theirs, UserName = name, Amount = payment.Amount };

        return OnSettle.InvokeAsync((debt,
            payment.FromUserId == UserId
                ? SettlementDirection.YouPaidThem
                : SettlementDirection.TheyPaidYou));
    }

    /// <summary>
    /// Records a line between two guests, for the amount the plan says, once somebody has
    /// said it happened.
    /// </summary>
    /// <remarks>
    /// Asked first rather than recorded on the press. The caller is on neither end, so a
    /// mis-tap writes a repayment between two other people that neither of them can see or
    /// undo -- and the question is short enough to read in the time it takes to answer.
    /// <para>
    /// Written here rather than handed to the page like the caller's own lines: those open
    /// the settle dialog, which is built around "you" on one end, and this has two names
    /// and no "you" in it. It goes through the page state service, so the write is the same
    /// command the CLI's record-repayment uses and is announced the same way.
    /// </para>
    /// </remarks>
    private async Task RecordBetweenGuestsAsync(SettlementPayment payment)
    {
        // The group the question is about, kept for the answer (#323).
        var groupId = GroupId;

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            {
                x => x.ContentText,
                $"Record that {payment.FromUserName} paid {payment.ToUserName} {payment.Amount.ToMoney()}? " +
                "Both of them are guests, so this goes in the group's ledger for them."
            },
            { x => x.ButtonText, "Record" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(
            $"{payment.FromUserName} paid {payment.ToUserName}", parameters, options);

        if (!await dialog.ConfirmedAsync())
            return;

        await GroupsService.RecordRepaymentAsync(groupId, new RecordRepaymentRequest
        {
            FromUserId = payment.FromUserId,
            ToUserId = payment.ToUserId,
            Amount = payment.Amount
        }, payment.FromUserName, payment.ToUserName);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == GroupId) return;

        _loadedFor = GroupId;
        _recent = null;

        await LoadRecentAsync();
    }

    private async Task LoadRecentAsync()
    {
        var version = ++_recentVersion;
        var groupId = _loadedFor;

        PagedResponse<GroupLedgerEntryResponse>? recent = null;

        // The ledger, three rows of it. Expenses and settlements together, because a
        // balance that moved with nothing on the page to explain it is its own kind of
        // wrong -- which is what a "recent expenses" card that hid settlements produced.
        var loaded = await Errors.TryAsync(async () =>
                recent = await GroupsClient.GetGroupActivityAsync(
                    groupId, page: 1, pageSize: RecentCount),
            "Could not load this group's recent entries.");

        // Something newer has been asked for since. That answer is the one to show.
        if (version != _recentVersion)
            return;

        if (loaded)
            _recent = recent;

        await InvokeAsync(StateHasChanged);
    }

    private Task ReloadAsync() => _loadedFor == Guid.Empty ? Task.CompletedTask : LoadRecentAsync();

    /// <summary>
    /// Redraws when the state service's figures land. The balances above are read from it
    /// rather than passed in, so the parent re-rendering is not enough: none of this tab's
    /// parameters change when they arrive, and Blazor skips a child whose parameters have
    /// not. Without this, whichever of the two reads answered first decided the page --
    /// recent entries before balances left "Balances appear once there is an expense." on a
    /// group with expenses, until something else happened to redraw it.
    /// </summary>
    private void Redraw() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Changes.TransactionsChanged += ReloadAsync;
        Changes.GroupsChanged += ReloadAsync;
        GroupsService.OnTransactionsChanged += Redraw;
        GroupsService.OnGroupSelected += Redraw;
    }

    public void Dispose()
    {
        Changes.TransactionsChanged -= ReloadAsync;
        Changes.GroupsChanged -= ReloadAsync;
        GroupsService.OnTransactionsChanged -= Redraw;
        GroupsService.OnGroupSelected -= Redraw;
    }
}
