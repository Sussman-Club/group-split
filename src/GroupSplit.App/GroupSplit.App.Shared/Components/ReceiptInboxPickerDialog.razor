@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Errors
@namespace GroupSplit.App.Shared.Components
@inject IReceiptsClient Client
@inject ApiErrorPresenter Errors
<MudDialog><DialogContent>
@if (_rows is null) { <p>Loading receipts…</p> }
else if (_rows.Count == 0) { <p>No private receipts waiting.</p> }
else { @foreach (var row in _rows) { <MudButton OnClick="@(() => Choose(row))">@(row.Receipt.MerchantName ?? "Receipt") · @row.Receipt.Total @row.Currency · @row.Receipt.PurchaseDate</MudButton> } }
</DialogContent><DialogActions><MudButton OnClick="Cancel">Cancel</MudButton></DialogActions></MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private IReadOnlyList<ReceiptInboxResponse>? _rows;
    protected override async Task OnInitializedAsync() => await Errors.TryAsync(async () => _rows = (await Client.ListReceiptInboxAsync()).ToList(), "Could not load receipts.");
    private void Choose(ReceiptInboxResponse row) => MudDialog.Close(DialogResult.Ok(row));
    private void Cancel() => MudDialog.Cancel();
}
