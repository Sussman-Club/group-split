@using GroupSplit.App.Shared.Extensions
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IDialogService DialogService
@inject LocalClock Clock

@*
    A short read of a group's ledger: expenses and settlements together, newest first.

    The compact form of the ledger's rows rather than a second list type. It replaces the
    "recent expenses" card, which hid settlements and therefore showed a balance moving with
    nothing beside it to say why.
*@

<div class="gs-list">
    @if (Entries.Count == 0)
    {
        <div class="gs-empty">
            <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" />
            <h3>@Loc["Nothing recorded yet"]</h3>
            <span>@Loc["Add the first expense and it will show up here."]</span>
        </div>
    }
    else
    {
        var i = 0;
        foreach (var entry in Entries)
        {
            var item = entry;
            var expense = item.Kind is ActivityKind.Expense;
            var opens = expense || item.CoversThrough is not null;

            <a class="gs-row gs-reveal" style="--i: @(i++)"
               role="@(opens ? "button" : null)"
               tabindex="@(opens ? 0 : -1)"
               @onclick="@(() => opens ? ViewAsync(item) : Task.CompletedTask)"
               @onkeydown="@(e => opens && e.Key is "Enter" or " " ? ViewAsync(item) : Task.CompletedTask)">
                @if (expense)
                {
                    <MerchantMark PaidByUserName="@item.PaidByUserName"
                                  MerchantName="@item.MerchantName"
                                  MerchantLogoUrl="@item.MerchantLogoUrl" />
                }
                else
                {
                    <span class="gs-row-icon transfer"><MudIcon Icon="@Icons.Material.Rounded.Handshake" /></span>
                }
                <div style="min-width: 0">
                    <div class="title">
                        <span>@Headline(item)</span>
                        @if (!expense)
                        {
                            <span class="gs-tag clay">@Loc["Settlement"]</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Category))
                        {
                            <span class="gs-tag">@item.Category</span>
                        }
                    </div>
                    <div class="meta">@Detail(item)</div>
                </div>
                <div>
                    <div><Money Value="item.Amount" /></div>
                    <span class="when">@Clock.Relative(item.DateTime)</span>
                </div>
            </a>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<GroupLedgerEntryResponse> Entries { get; set; } = [];

    private string Headline(GroupLedgerEntryResponse entry) =>
        entry.Kind is ActivityKind.Transfer
            ? Loc["{0} paid {1}", entry.PaidByUserName, entry.PaidToUserName].Value
            : entry.Name;

    /// <summary>
    /// Who paid and what it cost the reader, on an expense; the note on a settlement. The
    /// share is the number somebody owes on the row, and no listing in the app carried it.
    /// </summary>
    private string Detail(GroupLedgerEntryResponse entry)
    {
        if (entry.Kind is ActivityKind.Transfer)
            return (entry.Description is { Length: > 0 } note ? note : Loc["Settling up"].Value) + entry.CoversThrough.ThroughSuffix();

        var said = Loc["{0} paid", entry.PaidByUserName].Value;

        return entry.Share is { } share ? Loc["{0} · your share {1}", said, share.ToMoney()].Value : said;
    }

    /// <summary>
    /// Expenses, and settlements made through a day. Any other settlement has no detail worth a
    /// dialog -- who paid whom and how much is the whole of it, and all three are on the row.
    /// </summary>
    private async Task ViewAsync(GroupLedgerEntryResponse entry)
    {
        var parameters = new DialogParameters<TransactionDetailsDialog>
        {
            { x => x.TransactionId, entry.Id }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<TransactionDetailsDialog>(Loc["Transaction Details"].Value, parameters, options);
    }
}
