@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Commands
@namespace GroupSplit.App.Shared.Components
@inject IReceiptCommands Bills
@inject ISplitRuleCommands Rules
@inject IDialogService Dialogs

<MudDialog>
    <TitleContent><h2 class="gs-dialog-title">@Title</h2></TitleContent>
    <DialogContent>
        <BillSheet Receipt="Receipt" Title="Title" Where="Where" />
        @if (GroupId is not null)
        {
            <h3>Split each item</h3>
            @foreach (var item in Receipt.Items)
            {
                <MudSelect T="Guid?" Label="@item.Name" Value="item.SplitRuleVersionId"
                           ValueChanged="@(value => SetRule(item.Id, value))" Disabled="_busy" Clearable="true">
                    @if (item.SplitRuleVersionId is { } held && _rules.All(r => r.VersionId != held))
                    { <MudSelectItem T="Guid?" Value="@((Guid?)held)">@item.SplitRuleName (saved version)</MudSelectItem> }
                    @foreach (var rule in _rules)
                    { <MudSelectItem T="Guid?" Value="@((Guid?)rule.VersionId)">@rule.Name</MudSelectItem> }
                </MudSelect>
            }
            <MudButton OnClick="CreateRule" Disabled="_busy">Create a group split rule</MudButton>
            <p class="gs-muted">Each item uses its chosen rule for its price, tax, and proportional share of the tip. Saving item rules leaves the current expense shares in place until you apply the split.</p>
            <MudButton OnClick="Preview" Disabled="@(_busy || !Receipt.CanDivide)">Preview split</MudButton>
            @if (_preview is not null)
            {
                @foreach (var share in _preview.Shares)
                { <p>@share.UserId: @share.Amount.ToString("0.00")</p> }
                <MudButton OnClick="Divide" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy">Apply split</MudButton>
            }
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ReceiptResponse Receipt { get; set; } = null!;
    [Parameter] public Guid TransactionId { get; set; }
    [Parameter] public Guid? GroupId { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Where { get; set; }
    [Parameter] public string? Mark { get; set; }
    private readonly List<SplitRuleDetailsResponse> _rules = [];
    private ReceiptDivisionResponse? _preview;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadRules();
    private async Task LoadRules()
    {
        if (GroupId is not { } groupId) return;
        var rules = await Rules.ForGroupAsync(groupId);
        if (rules is null) return;
        var details = await Task.WhenAll(rules.Select(r => Rules.GetAsync(r.Id)));
        _rules.Clear();
        _rules.AddRange(details.OfType<SplitRuleDetailsResponse>().Where(r => r.Definition is not ItemizedSplitRuleDto));
    }
    private async Task SetRule(Guid itemId, Guid? versionId)
    {
        _busy = true; _preview = null;
        try { if (await Bills.SetRuleAsync(TransactionId, itemId, versionId) is { } bill) Receipt = bill; }
        finally { _busy = false; }
    }
    private async Task Preview()
    {
        _busy = true;
        try { _preview = await Bills.PreviewAsync(TransactionId); }
        finally { _busy = false; }
    }
    private async Task Divide()
    {
        _busy = true;
        try { if (await Bills.DivideAsync(TransactionId)) MudDialog.Close(DialogResult.Ok(true)); }
        finally { _busy = false; }
    }
    private async Task CreateRule()
    {
        if (GroupId is not { } groupId) return;
        var dialog = await Dialogs.ShowAsync<CreateRuleDialog>("New item split rule",
            new DialogParameters<CreateRuleDialog> { { d => d.GroupId, groupId }, { d => d.AllowItemized, false } });
        await dialog.Result;
        await LoadRules();
    }
}
