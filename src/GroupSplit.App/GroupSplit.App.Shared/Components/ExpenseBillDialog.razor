@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@*
    The bill behind an expense, on its own.

    It used to be printed inside the expense's own dialog, under the split, and on a warehouse
    run that made one dialog carrying two documents: the shares somebody came for, then forty
    lines of paper they had to scroll past to reach the Close button. A receipt is a thing you
    pick up and read, not a section of something else.

    So the expense keeps a line saying there is one, and this is where it is read -- the same
    treatment the inbox gives a bill on an imported charge, which is the same piece of paper
    at an earlier moment.

    Handed the bill rather than fetching it. The expense's dialog has already read it to know
    there is one, and a second round trip here would open a dialog onto a spinner for a
    document that is already in memory.
*@

<MudDialog>
    <TitleContent>
        <div class="gs-dialog-head">
            <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap; min-width: 0">
                <MerchantMark MerchantName="@Title" MerchantLogoUrl="@Mark" />
                <div style="min-width: 0">
                    <div class="gs-eyebrow">@Where</div>
                    <h2 class="gs-dialog-title">@Title</h2>
                </div>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <BillSheet Receipt="@Receipt" Me="@Me" PartAmount="@PartAmount"
                   Title="@Title" Where="@Where" />

        @if (Receipt.Tax != 0 || Receipt.Tip != 0)
        {
            @* Said here and nowhere else, because it is the part people expect to be wrong:
               the extras follow what each person had rather than being divided by the number
               of people at the table. *@
            <p class="gs-muted" style="margin: 10px 0 0; font-size: .75rem">
                Tax and tip are shared out in proportion to what each person had.
            </p>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Class="gs-btn-quiet"
                   OnClick="@(() => MudDialog.Close())">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public ReceiptResponse Receipt { get; set; } = null!;

    /// <summary>Where the money went, across the top of the paper.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The line under it: which day, which card.</summary>
    [Parameter] public string? Where { get; set; }

    /// <summary>The shop's logo, where there is one.</summary>
    [Parameter] public string? Mark { get; set; }

    /// <summary>The reader, so their own claims read as "You".</summary>
    [Parameter] public Guid? Me { get; set; }

    /// <summary>
    /// What the expense came to, for a bill covering more than one purchase.
    /// </summary>
    /// <remarks>
    /// The slip prints it beside the charged total. Without it a shared bill reads as a
    /// receipt that does not match the expense it was opened from.
    /// </remarks>
    [Parameter] public decimal? PartAmount { get; set; }
}
