        var dialog = await DialogService.ShowAsync<CategorySpendingDialog>(Loc["Spending by category"].Value, parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: CategorySpendingResponse category })
            await SetCategoryAsync(category.CategoryId);
    }

    /// <summary>
    /// What the two figures are of. It never mentions the kind chips, because the figures
    /// deliberately ignore them -- saying "settlements" over a count of expenses is exactly
    /// the confusion the label is there to prevent.
    /// </summary>
    private string CountedOver
    {
        get
        {
            var said = new List<string>(3)
            {
                Personal ? Loc["by you"].Value : Loc["by everyone"].Value,
                _range.IsAllTime ? Loc["Copy.Lower.all_time"].Value : _range.Label.ToLowerInvariant()
            };

            if (IsSearching)
                said.Add(Loc["matching your search"].Value);

            return string.Join(" · ", said);
        }
    }

    /// <summary>
    /// Everything the figures depend on, so two narrowings arrived at the same way compare
    /// equal and one arrived at differently does not. The kind is absent on purpose: it does
    /// not move these figures, so a chip click must not send a request for them.
    /// </summary>
    private sealed record SummaryKey(Guid Group, DateFilter Range, string? Search, Guid? CategoryId,
        bool Uncategorized, Guid? PaidBy);

    private SummaryKey CurrentKey => new(GroupId, _range, Search, _categoryId, _uncategorized, _paidBy);

    private async Task<GridData<GroupLedgerEntryResponse>> LoadPageAsync(
        GridState<GroupLedgerEntryResponse> state, CancellationToken cancellationToken)
    {
        var version = _feedVersion;
        var sort = state.SortDefinitions.FirstOrDefault();

        // Every narrowing ends up here, so this is where the URL catches up with it.
        // Android shows a chronological feed, not a sortable table. Its hidden grid
        // must not restore an ascending or non-date sort, including on later pages.
        _sort = AppLinks.IsAndroidNative || sort is null
            ? ListingQuery.DefaultSort
            : (Camel(sort.SortBy), sort.Descending);
        await WriteUrlAsync();

        var bounds = _range.Bounds(Clock.Offset, Clock.Today);

        var page = await ReadAsync(() => GroupsClient.GetGroupActivityAsync(
            GroupId,
            from: bounds.From,
            to: bounds.To,
            kind: (int?)Kind,
            search: Search,
            categoryId: _categoryId,
            uncategorized: _uncategorized ? true : null,
            paidBy: _paidBy,
            sortBy: _sort.Key,
            sortDescending: _sort.Descending,
            page: state.Page + 1,
            pageSize: state.PageSize,
            cancellationToken: cancellationToken));

        cancellationToken.ThrowIfCancellationRequested();
        if (version == _feedVersion && !_disposed)
        {
            _mobileEntries = page?.Items ?? [];
            _ledgerLoaded = page is not null;
        }
        await InvokeAsync(StateHasChanged);

        return new GridData<GroupLedgerEntryResponse>
        {
            Items = page?.Items ?? [],
            TotalItems = page?.TotalCount ?? 0
        };
    }

    private async ValueTask<ItemsProviderResult<GroupLedgerEntryResponse>> ProvideItemsAsync(ItemsProviderRequest request)
    {
        var group = GroupId;
        var bounds = _range.Bounds(Clock.Offset, Clock.Today);
        var kind = Kind;
        var search = Search;
        var category = _categoryId;
        var uncategorized = _uncategorized;
        var payer = _paidBy;
        var sort = _sort;
        var version = _feedVersion;
        ItemsProviderResult<GroupLedgerEntryResponse> result = default;
        var loaded = await Errors.TryAsync(async () =>
        {
            result = await PagedItemsProvider.GetAsync<GroupLedgerEntryResponse>(request,
                async (page, size, ct) => await GroupsClient.GetGroupActivityAsync(
                    group, from: bounds.From, to: bounds.To, kind: (int?)kind, search: search,
                    categoryId: category, uncategorized: uncategorized ? true : null, paidBy: payer,
                    sortBy: sort.Key, sortDescending: sort.Descending, page: page, pageSize: size,
                    cancellationToken: ct));
        }, Loc["Could not load this group's ledger."].Value);
        request.CancellationToken.ThrowIfCancellationRequested();
        if (_disposed || version != _feedVersion) return new ItemsProviderResult<GroupLedgerEntryResponse>([], 0);
        _virtualFailed = !loaded;
        return loaded ? result : new ItemsProviderResult<GroupLedgerEntryResponse>([], 0);
    }

    private async Task RetryVirtualAsync()
    {
        _virtualFailed = false;
        if (_virtualFeed is not null) await _virtualFeed.RefreshDataAsync();
    }

    private static string Camel(string propertyName) =>
        string.IsNullOrEmpty(propertyName)
            ? propertyName
            : char.ToLowerInvariant(propertyName[0]) + propertyName[1..];

    private async Task<T?> ReadAsync<T>(Func<Task<T>> read) where T : class
    {
        T? result = null;
        await Errors.TryAsync(async () => result = await read(), Loc["Could not load this group's ledger."].Value);
        return result;
    }

    private async Task SetKindAsync(ActivityKind? kind)
    {
        if (Kind == kind) return;

        Kind = kind;
        InvalidateFeed();

        await WriteUrlAsync();
        await BackToFirstPageAsync();
    }

    private async Task OnSearchChangedAsync(string _)
    {
        InvalidateFeed();
        await ReadSummaryAsync();
        await BackToFirstPageAsync();
    }

    private async Task ClearSearchAsync()
    {
        _searchString = "";
        await OnSearchChangedAsync("");
    }

    private async Task OnRangeChangedAsync(DateFilter range)
    {
        _range = range;
        InvalidateFeed();

        await ReadSummaryAsync();
        await BackToFirstPageAsync();
    }

    private Task ShowAllTimeAsync() => OnRangeChangedAsync(DateFilter.AllTime);

    /// <summary>Clicking the selected row clears it; every other row becomes the category filter.</summary>
    private async Task SetCategoryAsync(Guid? categoryId)
    {
        var selectingCurrent = categoryId == _categoryId && (categoryId is not null || _uncategorized);
        _categoryId = selectingCurrent ? null : categoryId;
        _uncategorized = !selectingCurrent && categoryId is null;
        InvalidateFeed();

        await ReadSummaryAsync();
        await BackToFirstPageAsync();
    }

    private async Task SetPaidByAsync(Guid? userId)
    {
        if (_paidBy == userId)
            return;

        _paidBy = userId;
        InvalidateFeed();
        await ReadSummaryAsync();
        await BackToFirstPageAsync();
    }

    private async Task LoadPayersAsync()
    {
        if (Personal || _payersFor == GroupId)
            return;

        _payersFor = GroupId;
        try
        {
            _payers = [.. (await GroupsClient.GetGroupMembersAsync(GroupId) ?? [])];
        }
        catch
        {
            // The activity itself remains useful when the picker cannot load; the server
            // still honours a payer id in a shared link.
            _payers = [];
        }
    }

    private Task BackToFirstPageAsync()
    {
        InvalidateFeed();
        if (_grid is null) return Task.CompletedTask;

        _grid.NavigateTo(MudBlazor.Page.First);
        return ReloadAsync();
    }

    private void InvalidateFeed()
    {
        ++_feedVersion;
    }

    /// <summary>
    /// Reads the rows again -- and, when a reload is already out, once more after it.
    /// </summary>
    /// <remarks>
    /// A write raises two events, and two reloads at once would race over the rows, so only
    /// one runs at a time. A request that arrives during it used to be dropped, though, and
    /// what it was asking for went with it: a kind, a search or a span chosen while the rows
    /// were loading left the old rows under the new chip, and a second delete left the row
    /// it deleted on screen, because the read under way had started before it (#323). Now it
    /// is remembered, and however many arrive, the rows are read once more with whatever is
    /// in force when the read in flight lands.
    /// </remarks>
    private Task ReloadAsync()
    {
        if (_grid is null)
            return Task.CompletedTask;

        if (_reloading is { IsCompleted: false } running)
        {
            _reloadAgain = true;
            return running;
        }

        return _reloading = ReloadUntilCurrentAsync(_grid);
    }

    private async Task ReloadUntilCurrentAsync(MudDataGrid<GroupLedgerEntryResponse> grid)
    {
        do
        {
            _reloadAgain = false;
            await InvokeAsync(() => grid.ReloadServerData());
            if (_virtualFeed is not null) await InvokeAsync(() => _virtualFeed.RefreshDataAsync());
        }
        while (_reloadAgain);
    }

    /// <summary>
    /// The two figures above the list. Both read expenses only -- the spend and the
    /// caller's part of it -- so neither moves when the kind chips do, and a settlement can
    /// never land in a spending total.
    /// </summary>
    /// <remarks>
    /// Asked only when the narrowing changes, and shown only if it is still the narrowing in
    /// force: the group page re-renders this tab on every announcement about the group, and
    /// an answer about a span nobody is looking at any more arriving last would put the
    /// wrong figures on the cards.
    /// </remarks>
    private async Task ReadSummaryAsync()
    {
        var key = CurrentKey;

        if (key == _asked || key == _inFlight)
            return;

        var version = ++_summaryVersion;
        _inFlight = key;

        try
        {
            var bounds = key.Range.Bounds(Clock.Offset, Clock.Today);

            var spending = await ReadAsync(() => GroupsClient.GetGroupTransactionsSummaryAsync(
                key.Group, from: bounds.From, to: bounds.To, paidBy: key.PaidBy,
                categoryId: key.CategoryId, uncategorized: key.Uncategorized ? true : null, search: key.Search));

            var byCategory = await ReadAsync(() => GroupsClient.GetGroupSpendingByCategoryAsync(
                key.Group, from: bounds.From, to: bounds.To, paidBy: key.PaidBy,
                categoryId: key.CategoryId, uncategorized: key.Uncategorized ? true : null, search: key.Search));

            // A failed read must not count as an answer, and an answer from an older request
            // must not overwrite the figures after a write invalidated the same question.
            if (version != _summaryVersion || key != CurrentKey || spending is null || byCategory is null)
                return;

            _spending = spending;
            _byCategory = byCategory;
            _asked = key;
        }
        finally
        {
            if (version == _summaryVersion)
            {
                _inFlight = null;
                _initializing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    /// <summary>
    /// Every expense and settlement row opens its details.
    /// </summary>
    // Every movement opens its details: compact rows can truncate either participant.
    private static bool Opens(GroupLedgerEntryResponse entry) => true;

    /// <summary>The pointer says which rows open, so the cursor is not a lie over a settlement.</summary>
    private string RowClass(GroupLedgerEntryResponse entry, int _) => Opens(entry) ? "is-openable" : "";

    /// <summary>
    /// The row is the way in. It used to be an eye in the actions column beside Edit and
    /// Delete, which made opening an entry look like one more thing to do to it rather
    /// than the thing the row is for.
    /// </summary>
    private Task OnRowClickAsync(DataGridRowClickEventArgs<GroupLedgerEntryResponse> args) =>
        Opens(args.Item) ? ViewAsync(args.Item) : Task.CompletedTask;

    /// <summary>
    /// The one expense, and how it was divided.
    /// </summary>
    /// <remarks>
    /// Read-only, so nothing is announced when it closes and the grid is left alone. The
    /// dialog reads the expense itself rather than being handed this row: a ledger row
    /// carries the caller's share and not the other members', and the whole split is most
    /// of what somebody opens this for.
    /// </remarks>
    private Task ViewAsync(GroupLedgerEntryResponse entry) => ShowExpenseAsync(entry.Id);

    /// <summary>The entry whose details are open, which the URL names so it can be linked to.</summary>
    private Guid? _expense;

    private bool _showingExpense;

    private bool _disposed;

    /// <summary>
    /// Opens an entry's details and names it in the URL until they close, so a refresh keeps
    /// it open and the address can be sent to somebody.
    /// </summary>
    private async Task ShowExpenseAsync(Guid id)
    {
        _showingExpense = true;
        _expense = id;
        await WriteUrlAsync();

        var parameters = new DialogParameters<TransactionDetailsDialog> { { x => x.TransactionId, id } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        IDialogReference dialog;

        try
        {
            dialog = await DialogService.ShowAsync<TransactionDetailsDialog>(Loc["Transaction Details"].Value, parameters, options);
        }
        catch
        {
            await ForgetExpenseAsync();
            throw;
        }

        // Not awaited: the click that opened it would stay unfinished for as long as the
        // details are open.
        _ = ForgetExpenseWhenClosedAsync(dialog);
    }

    private async Task ForgetExpenseWhenClosedAsync(IDialogReference dialog)
    {
        await dialog.Result;
        await InvokeAsync(ForgetExpenseAsync);
    }

    private async Task ForgetExpenseAsync()
    {
        _showingExpense = false;
        _expense = null;
        await WriteUrlAsync();
    }

    /// <summary>
    /// An entry named in the URL is opened once the tab is interactive: a dialog needs a live
    /// page to open on, which a prerender is not.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_expense is { } id && !_showingExpense)
            await ShowExpenseAsync(id);
    }

