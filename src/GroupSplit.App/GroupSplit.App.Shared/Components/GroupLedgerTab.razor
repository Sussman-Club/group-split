    /// <summary>
    /// Removes an entry of either kind. The wording is not the same for the two, and the
    /// difference matters: deleting an expense removes something the group spent, and
    /// deleting a settlement says a debt somebody thought was paid is outstanding again.
    /// </summary>
    private async Task DeleteAsync(GroupLedgerEntryResponse entry)
    {
        var settlement = entry.Kind is ActivityKind.Transfer;

        // Somebody on it has left the group, so the server would refuse: say why instead of
        // asking. The spared "Delete?" is one whose only outcome is that refusal.
        if (await DeleteGuard.FirstLeaverOnAsync(entry.Id, GroupId) is { } leaver)
        {
            await DialogService.ShowDepartedNoticeAsync(leaver, settlement ? Loc["Copy.Lower.settlement"].Value : Loc["Copy.Lower.expense"].Value);
            return;
        }

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, settlement
                ? Loc["Delete the settlement where {0}? Everybody's balance in this group ", Headline(entry)].Value
                  + Loc["goes back to what it was before it was recorded."].Value
                : Loc["Are you sure you want to delete \"{0}\"?", entry.Name].Value },
            { x => x.ButtonText, Loc["Delete"].Value },
            { x => x.Color, Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(
            settlement ? Loc["Delete Settlement"].Value : Loc["Delete Transaction"].Value, parameters, options);

        if (!await dialog.ConfirmedAsync())
            return;

        await Transactions.DeleteAsync(entry.Id, entry.Name, settlement ? Loc["Copy.Lower.settlement"].Value : Loc["Copy.Lower.expense"].Value);
    }

    private string Headline(GroupLedgerEntryResponse entry) =>
        entry.Kind is ActivityKind.Transfer
            ? Loc["{0} paid {1}", entry.PaidByUserName, entry.PaidToUserName].Value
            : entry.Name;

    /// <summary>
    /// A transfer's note when it has one, and who paid on an expense. The column has always
    /// been on the row and nothing ever put anything in it, so every repayment read the
    /// same: "Settling up", with no way to tell one from another.
    /// </summary>
    private string Detail(GroupLedgerEntryResponse entry) =>
        entry.Kind is ActivityKind.Transfer
            ? (entry.Description is { Length: > 0 } note ? note : Loc["Settling up"].Value) + entry.CoversThrough.ThroughSuffix()
            : Loc["{0} paid", entry.PaidByUserName].Value;

    private async Task OnDataChangedAsync()
    {
        ++_feedVersion;
        _asked = null;
        _inFlight = null;
        ++_summaryVersion;

        await ReadSummaryAsync();
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The tab's narrowing as it is spelled in the query string.</summary>
    private sealed record Query(string? Kind, string? Search, string? Range, string? From, string? To,
        string? Page, string? Size, string? Sort, string? Expense, string? Category, string? PaidBy);

    /// <summary>
    /// The query this tab last read or wrote. A parameter set that brings the same one back
    /// is the echo of its own write, and is not applied: it would overwrite whatever has been
    /// typed in the search box since.
    /// </summary>
    private Query? _settled;

    private static string? KindQuery(ActivityKind? kind) => kind switch
    {
        ActivityKind.Expense => "expense",
        ActivityKind.Transfer => "settlement",
        _ => null
    };

    private Query Asked => new(KindQuery(Kind), SearchParameter, RangeParameter, FromParameter, ToParameter,
        PageParameter, SizeParameter, SortParameter, ExpenseParameter, CategoryParameter, PaidByParameter);

    /// <summary>What is on the tab, spelled for the URL, with its opening state left out.</summary>
    private Query Current
    {
        get
        {
            var (range, from, to) = ListingQuery.FormatRange(_range, OpensOn);

            return new Query(KindQuery(Kind), Search, range, from, to,
                ListingQuery.FormatPage(_page),
                ListingQuery.FormatPageSize(_pageSize),
                ListingQuery.FormatSort(_sort),
                _expense?.ToString(), _uncategorized ? "uncategorized" : _categoryId?.ToString(), _paidBy?.ToString());
        }
    }

    private Task WriteUrlAsync()
    {
        var query = Current;

        // Gone already: an expense's details can close after the tab has been left, and the
        // host would put this tab's query on whatever page is open now.
        if (query == _settled || !QueryChanged.HasDelegate || _disposed)
            return Task.CompletedTask;

        _settled = query;

        return QueryChanged.InvokeAsync(new Dictionary<string, object?>
        {
            ["kind"] = query.Kind,
            ["q"] = query.Search,
            ["range"] = query.Range,
            ["from"] = query.From,
            ["to"] = query.To,
            ["page"] = query.Page,
            ["size"] = query.Size,
            ["sort"] = query.Sort,
            ["expense"] = query.Expense,
            ["category"] = query.Category,
            ["paidBy"] = query.PaidBy
        });
    }

    private void Apply(Query query)
    {
        _settled = query;

        _searchString = query.Search ?? "";
        _range = ListingQuery.ParseRange(query.Range, query.From, query.To, OpensOn);
        _page = ListingQuery.ParsePage(query.Page);
        _pageSize = ListingQuery.ParsePageSize(query.Size);
        _sort = AppLinks.IsAndroidNative
            ? ListingQuery.DefaultSort
            : ListingQuery.ParseSort(query.Sort, "dateTime", "name", "amount");
        _expense = Guid.TryParse(query.Expense, out var expense) ? expense : null;
        _categoryId = Guid.TryParse(query.Category, out var category) ? category : null;
        _uncategorized = string.Equals(query.Category, "uncategorized", StringComparison.OrdinalIgnoreCase);
        _paidBy = Guid.TryParse(query.PaidBy, out var paidBy) ? paidBy : null;
    }

    /// <summary>
    /// The direction a column starts sorted in: the one the URL asked for, or none. Only read
    /// when the grid starts, which is why the grid is rebuilt when a new URL arrives.
    /// </summary>
    private SortDirection Initially(string key) => _sort.Key != key
        ? SortDirection.None
        : _sort.Descending ? SortDirection.Descending : SortDirection.Ascending;

    protected override void OnInitialized()
    {
        Apply(Asked);

        Changes.TransactionsChanged += OnDataChangedAsync;
        Changes.GroupsChanged += OnDataChangedAsync;
    }

    /// <summary>
    /// A URL the tab did not write -- the Activity tab's own link back to a bare ledger, say
    /// -- replaces everything on it, and the rows are read again.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Asked != _settled)
        {
            ++_feedVersion;
            Apply(Asked);
            _gridGeneration++;
        }

        await LoadPayersAsync();
        await ReadSummaryAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        ++_feedVersion;

        Changes.TransactionsChanged -= OnDataChangedAsync;
        Changes.GroupsChanged -= OnDataChangedAsync;
    }
}
