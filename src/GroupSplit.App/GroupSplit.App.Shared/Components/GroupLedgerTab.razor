@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@using Microsoft.AspNetCore.Components.Web.Virtualization
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject ITransactionsPageStateService TransactionsService
@inject ITransactionCommands Transactions
@inject IDepartedDeleteGuard DeleteGuard
@inject IDialogService DialogService
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
@inject DataChangeNotifier Changes
@inject AppLinks AppLinks
@inject LocalClock Clock
@implements IDisposable

@*
    Everything that moved money in one group: what it spent, and who has paid whom.

    One list where there were two tabs. Expenses and Activity were the same rows with
    different filters -- one hid settlements, the other did not -- and having two of them
    made "which one was that in?" a real question while keeping the group's spend apart
    from the group's balance history.

    The reason they were split is real, and it is answered by the label rather than by the
    split: a settlement is money changing hands and not money spent, so the figure above the
    list counts expenses whatever the filter says and is called *total spent*. That label
    carries all the weight, which is why it has to say total spent and not total.

    The balance column is why this is a merge rather than a rename. You cannot show a
    balance history against a list that hides half the events that move it.
*@

<div class="gs-stack">
    @* One row: what kind, over what span, matching what. Three controls is the whole
       filter, and it was two rows and nine buttons before the span collapsed into one. *@
    <ActivityToolbar FiltersActive="@(IsSearching || _paidBy is not null)">
        <Segments>
            @* Not in a personal group: nothing is settled there, so every entry is an
               expense and the chips would all show the same rows. *@
            @if (!Personal)
            {
                <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                         PopoverClass="gs-menu" Class="gs-mobile-kind">
                    <ActivatorContent Context="menu">
                        <button type="button" class="gs-ledger-payer gs-kind-trigger" aria-haspopup="menu"
                                aria-label="@(Loc["Entry type: {0}", Kinds.First(item => item.Value == Kind).Label].Value)"
                                @onclick="@(args => menu.ToggleAsync(args))">
                            <span>@(Kinds.First(item => item.Value == Kind).Label)</span>
                            <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var (label, value) in Kinds)
                        {
                            var kind = value;
                            <MudMenuItem OnClick="@(() => SetKindAsync(kind))">
                                <span class="gs-menu-item @(Kind == kind ? "is-on" : "")">@label</span>
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
                <div class="gs-ledger-segments" role="group" aria-label="@Loc["Which entries"]">
                    @foreach (var (label, value) in Kinds)
                    {
                        var kind = value;
                        <button type="button" class="gs-chip @(Kind == kind ? "active" : "")"
                                aria-pressed="@(Kind == kind ? "true" : "false")"
                                @onclick="@(() => SetKindAsync(kind))">@label</button>
                    }
                </div>
            }

        </Segments>
        <DateFilter>
            <DateRangeFilter Value="@_range" ValueChanged="OnRangeChangedAsync" />
        </DateFilter>
        <Filters>
            @if (!Personal)
            {
                <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                         PopoverClass="gs-menu" Class="gs-payer-filter">
                    <ActivatorContent Context="menu">
                        <button type="button" class="gs-ledger-payer" aria-haspopup="menu"
                                @onclick="@(args => menu.ToggleAsync(args))">
                            <span>@Loc["Paid by {0}", _paidBy is null ? Loc["Copy.Lower.everyone"].Value : _payers.FirstOrDefault(payer => payer.Id == _paidBy)?.FullName ?? Loc["selected person"].Value]</span>
                            <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => SetPaidByAsync(null))">@Loc["Everyone"]</MudMenuItem>
                        @foreach (var payer in _payers)
                        {
                            <MudMenuItem OnClick="@(() => SetPaidByAsync(payer.Id))">@payer.FullName</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            }
        </Filters>
        <Search>
            @* "Search" and nothing more in the box; what it reaches is in the label a screen
               reader gets. A placeholder listing the columns is a spec, not a hint, and it is
               the first thing to truncate on a phone. *@
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@Loc["Search"]"
                          aria-label="@Loc["Search this group by name, note, category or either party"]"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="OnSearchChangedAsync"
                          Clearable="true"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Class="gs-search" />
        </Search>
    </ActivityToolbar>

    @if (Kind is not ActivityKind.Transfer)
    {
    <LoadView Skeleton="SkeletonLayout.Summary" Loading="@(_initializing || (_spending is null && _inFlight is not null))" Failed="@(_spending is null || _byCategory is null)" Retry="ReadSummaryAsync">
    <div class="gs-mobile-spending" aria-live="polite">
        <div class="gs-mobile-spending-head">
            <div class="gs-mobile-spending-figures">
                <span class="gs-mobile-spending-label">@Loc["Total spent"] · @(_range.IsAllTime ? Loc["All time"].Value : _range.Label)</span>
                <Money Value="Spent" Class="gs-mobile-spending-value" />
            </div>
            <span class="gs-mobile-spending-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
        </div>
        <div class="gs-mobile-spending-meta">
            <span>@(ExpenseCount == 1 ? Loc["{0} expense", ExpenseCount].Value : Loc["{0} expenses", ExpenseCount].Value)</span>
            @if (!Personal)
            {
                <span aria-hidden="true">·</span>
                <span>@Loc["Your share"] <Money Value="YourShare" /></span>
            }
        </div>
        <button type="button" class="gs-mobile-spending-details" @onclick="ShowCategoriesAsync">
            <span><MudIcon Icon="@Icons.Material.Rounded.PieChart" Size="Size.Small" />@Loc["Spending by category"]</span>
            <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" />
        </button>
    </div>

    <div class="gs-stats gs-ledger-stats">
        <div class="gs-card gs-stat gs-reveal" style="--i: 0">
            <span class="gs-stat-icon"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
            <span class="gs-eyebrow">@Loc["Expenses"]</span>
            <span class="gs-stat-value gs-num" data-gs-count="@ExpenseCount">@ExpenseCount</span>
            <span class="gs-muted" style="font-size: .8125rem">@CountedOver</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 1">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.Payments" /></span>
            @* Expenses only, whatever the chips say. This is the label that makes one tab
               safe: two figures on one screen, one counting a subset of the list beneath
               it, and the wording is all that tells them apart. *@
            <span class="gs-eyebrow">@Loc["Total spent"]</span>
            <Money Value="Spent" Animate Class="gs-stat-value" />
            @if (!Personal)
            {
                <span class="gs-muted" style="font-size: .8125rem">@Loc["Copy.Lower.your_share_{0}", YourShare.ToMoney()].Value</span>
            }
        </div>
    </div>

    <section class="gs-card gs-category-summary" aria-label="@Loc["Spending by category"]">
        <div class="gs-category-heading">
            <h3>@Loc["Spending"]</h3>
            <span class="gs-muted">@Loc["By category"]</span>
        </div>
        <span class="gs-muted gs-category-period">@Span</span>
        @if (_byCategory is { Categories.Count: > 0 } spending)
        {
            <CategorySpendingChips Spending="spending" SelectedCategoryId="_categoryId"
                                   Uncategorized="_uncategorized" Selected="SetCategoryAsync"
                                   ShowAll="ShowCategoriesAsync" />
        }
        else
        {
            <span class="gs-muted gs-category-empty">@Loc["No spending matches these filters."]</span>
        }
    </section>

    </LoadView>
    }

    <div class="gs-reveal gs-ledger-listing @(_mobileEntries.Count > 0 ? "has-entries" : "")" style="--i: 2">
        <div class="gs-mobile-ledger" aria-label="@Loc["Transactions"]">
            <Virtualize @key="_gridGeneration" @ref="_virtualFeed" ItemsProvider="ProvideItemsAsync" Context="entry" ItemSize="120" OverscanCount="3">
                <ItemContent>
                    <div class="gs-virtual-row" @key="entry.Id">
                        <div class="gs-virtual-date">@Clock.Day(entry.DateTime).ToString("d MMMM yyyy")</div>
                        <div class="gs-feed-row">
                <button type="button" class="gs-feed-entry" disabled="@(!Opens(entry))"
                        aria-label="@(Loc["Details for {0}", Headline(entry)].Value)"
                        @onclick="@(() => ViewAsync(entry))">
                    @if (entry.Kind is ActivityKind.Transfer)
                    {
                        <span class="gs-row-icon transfer"><MudIcon Icon="@Icons.Material.Rounded.SwapHoriz" /></span>
                    }
                    else
                    {
                        <MerchantMark PaidByUserName="@entry.PaidByUserName"
                                      MerchantName="@entry.MerchantName" MerchantLogoUrl="@entry.MerchantLogoUrl" />
                    }
                    <span class="gs-feed-copy">
                        <strong>@Headline(entry)</strong>
                        <span class="gs-muted">
                            @(entry.Kind is ActivityKind.Transfer ? Loc["Settlement"].Value + entry.CoversThrough.ThroughSuffix() : Detail(entry))
                            @if (Clock.TimeOf(entry.DateTime) is { } time)
                            {
                                <span> · @time.ToString("t")</span>
                            }
                        </span>
                        @if (!Personal && entry.Kind is ActivityKind.Expense && entry.Share is { } share)
                        {
                            <span class="gs-muted">@Loc["Your share {0}", share.ToMoney()].Value</span>
                        }
                    </span>
                    <Money Value="entry.Amount" Class="gs-feed-amount" />
                </button>
                <MudMenu Icon="@Icons.Material.Rounded.MoreVert"
                         aria-label="@(Loc["Actions for {0}", Headline(entry)].Value)" PopoverClass="gs-menu">
                    <MudMenuItem OnClick="@(() => EditAsync(entry))">@Loc["Edit"]</MudMenuItem>
                    <MudMenuItem OnClick="@(() => DeleteAsync(entry))">@Loc["Delete"]</MudMenuItem>
                </MudMenu>
                        </div>
                    </div>
                </ItemContent>
                <Placeholder><div class="gs-virtual-placeholder" aria-hidden="true"></div></Placeholder>
                <EmptyContent>
                    @if (_virtualFailed)
                    {
                        <div class="gs-empty" role="alert"><span>@Loc["Could not load this group's ledger."]</span><MudButton OnClick="RetryVirtualAsync">@Loc["Try again"]</MudButton></div>
                    }
                    else
                    {
                <div class="gs-empty" role="status">
                    <MudIcon Icon="@Icons.Material.Rounded.EventNote" />
                    <h3>@(IsNarrowedByHand ? Loc["Nothing matches"].Value : _range.IsAllTime ? Loc["Nothing recorded yet"].Value : Loc["Nothing recorded {0}", Span].Value)</h3>
                    <span>@EmptyBlurb</span>
                    @if (IsSearching)
                    {
                        <MudButton OnClick="ClearSearchAsync">@Loc["Clear search"]</MudButton>
                    }
                    @if (!_range.IsAllTime)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ShowAllTimeAsync">@Loc["View all time"]</MudButton>
                    }
                </div>
                    }
                </EmptyContent>
            </Virtualize>
        </div>
        @* Keyed so a URL arriving from outside rebuilds the grid on the page and sort it
           asks for: both are only read when a grid starts.

           The page size goes before the page, and the order matters: the grid takes its
           first page size by resetting to page one, which undid a page from the URL that
           had already been set. *@
        <MudDataGrid T="GroupLedgerEntryResponse"
                     @key="_gridGeneration"
                     @ref="_grid"
                     ServerData="LoadPageAsync"
                     @bind-RowsPerPage="_pageSize"
                     @bind-CurrentPage="_page"
                     SortMode="@(AppLinks.IsAndroidNative ? SortMode.None : SortMode.Single)"
                     Hover="true"
                     Bordered="false"
                     Elevation="0"
                     RowClick="@OnRowClickAsync"
                     RowClassFunc="@RowClass"
                     Class="gs-grid">
            <Columns>
                <PropertyColumn Property="x => x.DateTime" Title="@Loc["When"]" InitialDirection="@Initially("dateTime")">
                    <CellTemplate>
                        <TransactionWhen Value="@context.Item.DateTime"/>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Name" Title="@Loc["Entry"]" InitialDirection="@Initially("name")">
                    <CellTemplate>
                        <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap">
                            @* An avatar for an expense and an icon for a transfer. It is
                               what lets the merged list stay readable at a glance -- the
                               kind is visible before any of the words are. *@
                            @if (context.Item.Kind is ActivityKind.Transfer)
                            {
                                <span class="gs-row-icon transfer"><MudIcon Icon="@Icons.Material.Rounded.Handshake" /></span>
                            }
                            else
                            {
                                <MerchantMark PaidByUserName="@context.Item.PaidByUserName"
                                              MerchantName="@context.Item.MerchantName"
                                              MerchantLogoUrl="@context.Item.MerchantLogoUrl" />
                            }
                            <div style="min-width: 0">
                                @* A button, not a div, on the rows that open. The row itself
                                   opens on a click, and a click is the one thing a keyboard
                                   cannot make here: a grid row carries no tabindex, so
                                   RowClick never hears Enter and the details dialog would be
                                   reachable by pointer alone. The name is what somebody
                                   would press anyway. *@
                                @if (Opens(context.Item))
                                {
                                    <button type="button" class="gs-row-open"
                                            @onclick="@(() => ViewAsync(context.Item))"
                                            @onclick:stopPropagation="true">
                                        @Headline(context.Item)
                                    </button>
                                }
                                else
                                {
                                    <div style="font-weight: 700; font-size: .9375rem">@Headline(context.Item)</div>
                                }
                                <div class="gs-muted" style="font-size: .75rem">@Detail(context.Item)</div>
                            </div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                @* HideSmall on the three that are context rather than the point. A phone
                   turns every column into its own line, and seven lines an entry is a
                   ledger nobody scrolls: what is left is when, what, and how much. *@
                <PropertyColumn Property="x => x.Category" Title="@Loc["Category"]" Sortable="false" HideSmall="true">
                    <CellTemplate>
                        @if (context.Item.Kind is ActivityKind.Transfer)
                        {
                            <span class="gs-tag clay">@Loc["Settlement"]</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(context.Item.Category))
                        {
                            <span class="gs-tag">@context.Item.Category</span>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Amount" Title="@Loc["Copy.Sentence.Amount"]" HeaderClass="gs-right" CellClass="gs-right"
                                InitialDirection="@Initially("amount")">
                    <CellTemplate>
                        <Money Value="context.Item.Amount" Class="gs-grid-amount" />
                    </CellTemplate>
                </PropertyColumn>

                @* What the dinner cost and what it cost you are different numbers, and
                   every listing in the app used to show only the first. A transfer has no
                   share -- paying somebody back is not a cost anyone carries a part of --
                   so it renders as a dash rather than as zero. *@
                <TemplateColumn Title="@Loc["Your share"]" Sortable="false" HideSmall="true" Hidden="@Personal"
                                HeaderClass="gs-right" CellClass="gs-right">
                    <CellTemplate>
                        @if (context.Item.Share is { } share)
                        {
                            <Money Value="share" Class="gs-grid-share" />
                        }
                        else
                        {
                            <span class="gs-muted">—</span>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="@Loc["Balance"]" Sortable="false" HideSmall="true" Hidden="@Personal"
                                HeaderClass="gs-right" CellClass="gs-right">
                    <CellTemplate>
                        <Money Value="context.Item.RunningBalance" Signed Class="gs-grid-balance" />
                    </CellTemplate>
                </TemplateColumn>

                @* Editing and deleting live on the row; opening is the row itself. *@
                @* Titled, and not only for the header. On a phone the grid gives every cell
                   its own line with its label beside it, and a column with no title put two
                   unattached icons in a band of their own -- which row they belonged to was
                   anybody's guess. *@
                <TemplateColumn Title="@Loc["Actions"]" Sortable="false"
                                HeaderStyle="width: 96px" CellStyle="padding: 8px">
                    <CellTemplate>
                        <div class="gs-row-actions gs-inline" style="gap: 2px; justify-content: flex-end; flex-wrap: nowrap">
                            @* stopPropagation here and not on the container, because the row
                               underneath opens the entry: without it Edit opened the details
                               behind the editor, and with it on the container the whole
                               column -- the blank half of it included -- swallowed the click
                               that opens the row. *@
                            <span class="gs-inline" style="gap: 2px; flex-wrap: nowrap"
                                  @onclick:stopPropagation="true">
                            <MudTooltip Text="@Loc["Edit"]" ShowOnFocus="false">
                                <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                               Size="Size.Small"
                                               aria-label="@(Loc["Edit {0}", Headline(context.Item)].Value)"
                                               OnClick="@(async () => await EditAsync(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="@Loc["Delete"]" ShowOnFocus="false">
                                <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               aria-label="@(Loc["Delete {0}", Headline(context.Item)].Value)"
                                               OnClick="@(async () => await DeleteAsync(context.Item))" />
                            </MudTooltip>
                            </span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="gs-empty">
                    <MudIcon Icon="@Icons.Material.Rounded.SearchOff" />
                    @* Turns on what the reader narrowed, not on what the tab is narrowed
                       to. The opening month is the tab's own doing, so keying this on
                       IsNarrowed put "Nothing matches" over a group created a minute ago
                       -- naming a filter nobody set. *@
                    <h3>@(IsNarrowedByHand ? Loc["Nothing matches"].Value : Loc["Nothing recorded yet"].Value)</h3>
                    @* The tab opens on the group's default span, the current month for most,
                       so an empty ledger is the default state for any group that has been
                       quiet -- and "Nothing matches" over a span nobody chose reads as "this
                       group is empty", which is the exact confusion the --group fix was
                       about. Name the span. *@
                    <span>@EmptyBlurb</span>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid GroupId { get; set; }

    /// <summary>
    /// Which kind the list is narrowed to, from the URL. A filtered ledger is a place
    /// somebody can be sent to rather than a mode they have to set: it is the thing that
    /// used to be a choice of tab, and losing the ability to link to it would be a step
    /// back from the two tabs this replaces.
    /// </summary>
    [Parameter] public ActivityKind? Kind { get; set; }

    /// <summary>
    /// The tab's whole narrowing as query values, kind included, for the host page to put in
    /// the URL. One writer for the lot: two navigations in one turn would each start from a
    /// URL the other has not reached yet, and the second would undo the first.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, object?>> QueryChanged { get; set; }

    // The rest of the narrowing, read from the URL here rather than handed down: the host has
    // no use for any of it. Strings, so a value that does not parse opens the default rather
    // than throwing. The kind is the host's to read, because an old path can imply it.
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? SearchParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "range")] public string? RangeParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? FromParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? ToParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "page")] public string? PageParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "size")] public string? SizeParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "sort")] public string? SortParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "expense")] public string? ExpenseParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "category")] public string? CategoryParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "paidBy")] public string? PaidByParameter { get; set; }

    /// <summary>
    /// Whether this is the caller's personal group: nothing is settled in it and every
    /// share is theirs, so there is no kind to filter by and no share or balance worth a
    /// column.
    /// </summary>
    [Parameter] public bool Personal { get; set; }

    /// <summary>
    /// The span the group opens its Activity tab on, from its settings (#405). Picking
    /// another span here changes what this reader is looking at, not the group's default.
    /// </summary>
    [Parameter] public ActivityPeriod DefaultPeriod { get; set; } = ActivityPeriod.ThisMonth;

    private (string Label, ActivityKind? Value)[] Kinds =>
    [
        (Loc["Everything"].Value, null),
        (Loc["Expenses"].Value, ActivityKind.Expense),
        (Loc["Settlements"].Value, ActivityKind.Transfer)
    ];

    private string _searchString = "";
    private Guid? _categoryId;
    private bool _uncategorized;
    private Guid? _paidBy;
    private IReadOnlyList<UserInfo> _payers = [];
    private Guid? _payersFor;
    /// <summary>
    /// The span the tab opens on: the group's own default, which is the current month
    /// unless a member chose otherwise. A household's ledger going back three years opens
    /// on a page of the newest twenty-five either way, so all-time bought it nothing but a
    /// "total spent" over a span nobody chose; a trip that only holds the trip is better
    /// opened on all of it. The chip above the list says which span, and changing it is
    /// one tap.
    /// </summary>
    /// <remarks>
    /// Named rather than inlined because the empty state has to tell this span apart from
    /// one somebody picked -- otherwise it offers "All time" to a reader already on it.
    /// </remarks>
    private DateFilter OpensOn => DateFilter.Of(DefaultPeriod);

    private DateFilter _range = DateFilter.Of(ActivityPeriod.ThisMonth);
    private MudDataGrid<GroupLedgerEntryResponse>? _grid;
    private int _gridGeneration;
    private int _page;
    private int _pageSize = ListingQuery.DefaultPageSize;
    private (string Key, bool Descending) _sort = ListingQuery.DefaultSort;

    /// <summary>The reload under way, which a reload asked for meanwhile waits on and follows.</summary>
    private Task? _reloading;

    /// <summary>
    /// Whether something asked for the rows again while a reload was out, so it runs once
    /// more when that one lands.
    /// </summary>
    private bool _reloadAgain;

    private TransactionSummaryResponse? _spending;
    private IReadOnlyList<GroupLedgerEntryResponse> _mobileEntries = [];
    private bool _ledgerLoaded;
    private long _feedVersion;
    private Virtualize<GroupLedgerEntryResponse>? _virtualFeed;
    private bool _virtualFailed;
    private CategorySpendingSummaryResponse? _byCategory;
    private SummaryKey? _asked;
    private SummaryKey? _inFlight;
    private long _summaryVersion;
    private bool _initializing = true;

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchString);

    private bool IsNarrowed => IsSearching || !_range.IsAllTime || Kind is not null || _categoryId is not null ||
                               _uncategorized || _paidBy is not null;

    /// <summary>
    /// Whether the reader narrowed this, as opposed to the tab opening narrowed.
    /// </summary>
    /// <remarks>
    /// <see cref="IsNarrowed"/> asks whether the listing is a slice, which it is from the
    /// first frame now that the range starts at the current month. This asks whether
    /// anybody asked for the slice. The opening month does not count, and neither does all
    /// time, which is the widest the tab goes rather than a narrowing.
    /// </remarks>
    private bool IsNarrowedByHand =>
        IsSearching || Kind is not null || _categoryId is not null || _uncategorized || _paidBy is not null ||
        (!_range.IsAllTime && _range != OpensOn);

    private string? Search => IsSearching ? _searchString.Trim() : null;

    /// <summary>The span in words, for a sentence rather than a chip.</summary>
    private string Span => _range.IsAllTime ? Loc["Copy.Lower.all_time"].Value : _range.Label.ToLowerInvariant();

    /// <summary>
    /// The span to hang on the end of a clause, or nothing at all when there is no span to
    /// name. "No settlements in all time" is not a sentence anybody writes; the sentence
    /// somebody writes about that set is "No settlements".
    /// </summary>
    private string InSpan => _range.IsAllTime ? "" : Loc[" in {0}", Span].Value;

    /// <summary>
    /// What an empty ledger means. Never simply "there is nothing": this tab opens on the
    /// current month, so the commonest empty state is a quiet month in a group with years
    /// of history behind it, and saying "nothing matches" about a span nobody picked is how
    /// a populated group comes to look like an empty one.
    /// </summary>
    private string EmptyBlurb => (IsSearching, Kind) switch
    {
        // Already at the widest the tab goes, so there is no span to name and nowhere to
        // point. Offering "All time" from here was advice to do the thing they had done.
        // First, because a group can open on all time too.
        (false, null) when _range.IsAllTime =>
            Loc["Nothing recorded in this group yet. Expenses and settlements will show up here."].Value,
        // The default empty state: a quiet month in a group that may have years behind it.
        // Names the span and says how to leave it.
        (false, null) when _range == OpensOn =>
            Loc["Nothing in {0}. This group's Activity opens on {1} — pick \"All time\" for ", Span, Span].Value
            + Loc["the whole ledger."].Value,
        (false, null) => Loc["Nothing in {0}.", Span].Value,
        (false, ActivityKind.Transfer) => Loc["No settlements{0}.", InSpan].Value,
        (false, ActivityKind.Expense) => Loc["Nothing spent{0}.", InSpan].Value,
        _ => Loc["Nothing{0} matches. Try a different name, category, person or date.", InSpan].Value
    };

    private int ExpenseCount => _spending?.Count ?? 0;
    private decimal Spent => _spending?.Total ?? 0m;
    private decimal YourShare => _byCategory?.Categories.Sum(category => category.Share) ?? 0m;

    private async Task ShowCategoriesAsync()
    {
        if (_byCategory is not { } spending) return;

        var parameters = new DialogParameters<CategorySpendingDialog>
        {
            { dialog => dialog.Spending, spending },
