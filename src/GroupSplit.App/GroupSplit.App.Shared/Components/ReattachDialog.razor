@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Commands
@namespace GroupSplit.App.Shared.Components
@inject ITransactionCommands Transactions
@inject LocalClock Clock

@*
    Points a group's past expenses at the version of their rule that was in force on the day
    they were spent.

    For a back catalogue that arrived from somewhere with no notion of versions: the
    migration pointed every categorised expense at its rule's only version, so an expense
    from 2023 claims to have been divided by a ratio agreed this year. It moves no money --
    not one share is read, let alone written -- and the dry run is the whole safety of it,
    which is why it runs first and by itself.
*@

<MudDialog>
    <TitleContent>
        <div class="gs-dialog-head">
            <div style="min-width: 0">
                <div class="gs-eyebrow">@GroupName</div>
                <h2 class="gs-dialog-title">Re-point past expenses</h2>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="gs-stack" style="gap: 18px">

            <MudText Typo="Typo.body2">
                Each expense gets pointed at the version of its rule that was in force on the
                day it was spent. <strong>No amount moves</strong> — every balance in the
                group is identical afterwards.
            </MudText>

            @if (_summary is not { } summary)
            {
                <div class="gs-empty" style="padding: 32px">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                    <span>Working out what would change…</span>
                </div>
            }
            else
            {
                <div class="gs-inline" style="gap: 8px">
                    <span class="gs-tag @(_applied ? "" : "neutral")">@(_applied ? "Done" : "Dry run")</span>
                    <span class="gs-provenance-when">
                        @(_applied ? "saved" : "nothing saved yet") · @_ran.ToString("d MMM yyyy, HH:mm")
                    </span>
                </div>

                <div class="gs-figures">
                    <div class="gs-figure">
                        <span class="gs-eyebrow">Examined</span>
                        <span class="gs-figure-value gs-num">@summary.Examined</span>
                    </div>
                    <div class="gs-figure">
                        <span class="gs-eyebrow">@(_applied ? "Moved" : "Would move")</span>
                        <span class="gs-figure-value gs-num" style="color: var(--gs-teal)">@summary.Changed</span>
                    </div>
                    <div class="gs-figure">
                        <span class="gs-eyebrow">No version fits</span>
                        <span class="gs-figure-value gs-num @(summary.LeftWithoutAVersion > 0 ? "" : "is-quiet")"
                              style="@(summary.LeftWithoutAVersion > 0 ? "color: var(--gs-clay)" : "")">
                            @summary.LeftWithoutAVersion
                        </span>
                    </div>
                </div>

                @if (summary.ByRule.Count > 0)
                {
                    <div class="gs-counts">
                        <div class="gs-counts-row is-head">
                            <span class="gs-eyebrow">Rule</span>
                            <span>Seen</span>
                            <span>@(_applied ? "Moved" : "Would")</span>
                            <span>Unfit</span>
                        </div>

                        @foreach (var rule in summary.ByRule)
                        {
                            <div class="gs-counts-row" @key="rule.SplitRuleId">
                                <span class="gs-counts-what">@rule.SplitRuleName</span>
                                <span>@rule.Examined</span>
                                <span style="@(rule.Changed > 0 ? "font-weight: 700; color: var(--gs-teal)" : "")">
                                    @rule.Changed
                                </span>
                                <span style="@(rule.Uncovered > 0 ? "font-weight: 700; color: var(--gs-clay)" : "")">
                                    @rule.Uncovered
                                </span>
                            </div>
                        }

                        @* Expenses no rule could have divided. Counted in the total above,
                           so leaving them out of the table would make it look wrong. *@
                        @if (Unruled(summary) > 0)
                        {
                            <div class="gs-counts-row is-quiet">
                                <span class="gs-counts-what">No category, or a category with no rule</span>
                                <span>@Unruled(summary)</span>
                                <span>—</span>
                                <span>—</span>
                            </div>
                        }
                    </div>
                }

                @if (Uncovered(summary) is { Count: > 0 } thin)
                {
                    <div class="gs-notice is-warn">
                        <MudIcon Icon="@Icons.Material.Outlined.Warning"/>
                        <div class="gs-notice-body">
                            <strong>
                                @(thin.Sum(rule => rule.Uncovered)) expenses are older than the
                                history that has been written for their rule
                            </strong>
                            <span>
                                No version of @(thin.Select(rule => rule.SplitRuleName).ToList().Listed("or"))
                                covers their date, so they are left pointing at nothing. That
                                figure is how you find out a rule's history does not reach far
                                enough back.
                            </span>
                        </div>
                    </div>
                }
                else if (summary.Changed == 0 && !_applied)
                {
                    <div class="gs-notice">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle"/>
                        <div class="gs-notice-body">
                            <strong>Every expense already points where it should</strong>
                            <span>There is nothing to re-point.</span>
                        </div>
                    </div>
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        @if (_applied)
        {
            <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="@Close">
                Done
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Class="gs-btn-quiet" Disabled="@_busy" OnClick="@DryRunAsync">
                Run it again
            </MudButton>
            <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                       Disabled="@(_busy || _summary is null or { Changed: 0 })"
                       OnClick="@ApplyAsync">
                @ApplyLabel
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid GroupId { get; set; }

    [Parameter] public string GroupName { get; set; } = "";

    private ReattachSummaryResponse? _summary;
    private DateTimeOffset _ran;
    private bool _busy;
    private bool _applied;

    /// <summary>
    /// The dry run happens on open. It saves nothing, and it is the only thing that can
    /// answer the question somebody opened this to ask.
    /// </summary>
    protected override Task OnInitializedAsync() => DryRunAsync();

    private async Task DryRunAsync()
    {
        if (_busy) return;

        _busy = true;
        StateHasChanged();

        var summary = await Transactions.ReattachAsync(GroupId, dryRun: true);

        _busy = false;

        // Null is a failure the presenter has shown. The dialog keeps whatever it last had,
        // which is either nothing or a previous run, rather than blanking on the reader.
        if (summary is not null)
        {
            _summary = summary;
            _ran = Clock.Local(DateTimeOffset.UtcNow);
        }

        StateHasChanged();
    }

    private async Task ApplyAsync()
    {
        if (_busy || _summary is null) return;

        _busy = true;
        StateHasChanged();

        var summary = await Transactions.ReattachAsync(GroupId, dryRun: false);

        _busy = false;

        if (summary is not null)
        {
            _summary = summary;
            _ran = Clock.Local(DateTimeOffset.UtcNow);
            _applied = true;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Expenses no rule was asked about: filed under nothing, or under a category that names
    /// no rule. The API counts them in the total and not in the per-rule rows.
    /// </summary>
    private static int Unruled(ReattachSummaryResponse summary) =>
        summary.Examined - summary.ByRule.Sum(rule => rule.Examined);

    /// <summary>The rules whose written history does not reach back as far as their expenses.</summary>
    private static IReadOnlyList<ReattachedRuleSummary> Uncovered(ReattachSummaryResponse summary) =>
        [.. summary.ByRule.Where(rule => rule.Uncovered > 0)];

    /// <summary>What the button offers to do, which is only worth saying once it knows.</summary>
    private string ApplyLabel => _summary is { Changed: > 0 } summary
        ? $"Re-point {summary.Changed} {(summary.Changed == 1 ? "expense" : "expenses")}"
        : "Re-point";


    private void Close() => MudDialog.Close();
}
