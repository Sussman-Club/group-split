@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @MudDialog.Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="@form" Model="@model">
            <MudTextField
                @bind-Value="model.Name"
                For="@(() => model.Name)"
                Label="Name"
                Variant="Variant.Outlined"
                Immediate="true"
            />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>

        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" Disabled="@loading" OnClick="@Submit">
            Submit
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    MudForm form;

    private bool loading = false;

    private CreateGroupRequest model = new();

    private async Task Submit()
    {
        await form.ValidateAsync();

        if (form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(model));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}