@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @MudDialog.Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Class="gs-muted mb-3">@Loc["A group keeps shared expenses together."]</MudText>
        <MudForm @ref="@form" Model="@model">
            <MudTextField
                @bind-Value="model.Name"
                For="@(() => model.Name)"
                Label="@Loc["Name"]"
                Placeholder="@Loc["Copy.GroupNameExample"]"
                Variant="Variant.Outlined"
                Immediate="true"
            />
            <MudTextField @bind-Value="model.Description"
                          For="@(() => model.Description)"
                          Label="@Loc["Description (optional)"]"
                          HelperText="@Loc["What this group is for."]"
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="256"
                          Immediate="true" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">@Loc["Cancel"]</MudButton>

        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" Disabled="@loading" OnClick="@Submit">
            @Loc["Create a group"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    MudForm form;

    private bool loading = false;

    private CreateGroupRequest model = new();

    protected override void OnInitialized()
    {
        model.Description = Loc["Copy.DefaultHouseholdDescription"].Value;
    }

    private async Task Submit()
    {
        await form.ValidateAsync();

        if (form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(model));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
