@*
    "Keep me signed in", and the period it promises, in one place.

    Native sign-in uses this to control secure device storage. Web sign-in uses
    Keycloak's own checkbox instead.

    The number here is copy. What actually ends the session is
    RememberedSessionLifetime on the server, and the two have to say the same thing.
*@

<div style="width: 100%; text-align: start">
    <MudCheckBox T="bool"
                 Value="Value"
                 ValueChanged="ValueChanged"
                 Color="Color.Primary"
                 Dense="true"
                 Disabled="Disabled"
                 Label="@Loc["Keep me signed in"]" />
    <p class="gs-muted" style="margin: 0 0 0 32px; font-size: .75rem">@Loc["Stay signed in for up to {0} days. Uncheck for a temporary session.", Days].Value</p>
</div>

@code {
    /// <summary>Kept in step with <c>AuthenticationExtensions.RememberedSessionLifetime</c>.</summary>
    public const int Days = 30;

    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Set once the hand-off is under way, so the answer cannot change after it was sent.</summary>
    [Parameter] public bool Disabled { get; set; }
}
