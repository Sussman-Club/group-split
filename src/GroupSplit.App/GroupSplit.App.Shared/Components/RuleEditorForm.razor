@using System.ComponentModel.DataAnnotations
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Commands
@inject ISplitRuleCommands Rules
@inject IGroupsClient GroupsClient
@inject ApiErrorPresenter Errors
@inject IRemainderPolicy Remainder

<MudForm @ref="_form" Model="@Model">
    <MudStack Spacing="3">
        <MudTextField @bind-Value="Model.Name"
                      For="@(() => Model.Name)"
                      Label="@NameLabel"
                      HelperText="@NameHelp"
                      Variant="Variant.Outlined"
                      Immediate="true"/>

        <MudSelect
            T="RuleType?"
            Label="Rule Type"
            @bind-Value="_ruleType"
            @bind-Value:after="@OnRuleTypeChanged"
            Variant="Variant.Outlined"
        >
            <MudSelectItem T="RuleType?" Value="RuleType.Personal">
                Personal (payer owes full amount)
            </MudSelectItem>

            <MudSelectItem T="RuleType?" Value="RuleType.Even">
                Evenly, between everyone in the group
            </MudSelectItem>

            <MudSelectItem T="RuleType?" Value="RuleType.Percent">
                Percent split
            </MudSelectItem>

            <MudSelectItem T="RuleType?" Value="RuleType.Shares">
                Shares split
            </MudSelectItem>
        </MudSelect>

        <MudSelect T="Guid?"
                   Label="Apply settings from another rule"
                   Variant="Variant.Outlined"
                   @bind-Value="_copySourceRuleId"
                   @bind-Value:after="@OnCopySourceSelected"
                   Clearable="true"
                   Immediate="true">
            @if (_groupRules.Any())
            {
                @foreach (var r in _groupRules)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)r.Id)">@r.Name</MudSelectItem>
                }
            }
        </MudSelect>

        @if (Model.Version is PercentSplitRuleDto percent)
        {
            <MudPaper Class="pa-4" Elevation="0">
                <MudGrid>
                    @foreach (var m in _members)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="@percent.Percentages[m.Id]"
                                             Label="@m.Label()"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.End"
                                             AdornmentText="%"
                                             HideSpinButtons="true"
                                             Min="0" Max="100" Immediate="true"
                                             Class="small-num-field no-spinners"/>
                        </MudItem>
                    }
                </MudGrid>

                <MudText Typo="Typo.caption" Color="@(PercentTotal == 100 ? Color.Success : Color.Error)">
                    Total: @PercentTotal%
                </MudText>

                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" OnClick="@SplitPercentEvenly">
                        Split Evenly
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" OnClick="@ClearValues">
                        Clear All Percentages
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (Model.Version is SharesSplitRuleDto shares)
        {
            <MudPaper Class="pa-4" Elevation="0">
                <MudGrid>
                    @foreach (var m in _members)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="int"
                                             @bind-Value="@shares.Shares[m.Id]"
                                             Label="@m.Label()"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Min="0" Immediate="true"
                                             Class="small-num-field no-spinners"/>
                        </MudItem>
                    }
                </MudGrid>

                <MudText Color="@(SharesTotal > 0 ? Color.Success : Color.Error)" Typo="Typo.caption">
                    @(SharesTotal > 0 ? $"Total shares: {SharesTotal}" : "At least one member must have shares")
                </MudText>

                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" OnClick="@ClearValues">
                        Clear All Shares
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudForm>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid GroupId { get; set; }
    [Parameter] public RuleEditorModel Model { get; set; } = null!;

    /// <summary>
    /// What the name field is called. A rule has a name of its own now -- it is not the
    /// category's, because several categories may divide by one rule and renaming one of
    /// them must not rename the division behind the others.
    /// </summary>
    [Parameter] public string NameLabel { get; set; } = "Rule name";

    [Parameter] public string? NameHelp { get; set; } = "What the group calls this division, e.g. \"Household 3-way\".";

    private MudForm _form;

    private RuleType? _ruleType;
    private ICollection<UserInfo> _members = [];
    private IReadOnlyList<SplitRuleResponse> _groupRules = [];
    private Guid? _copySourceRuleId;

    // The form is meaningless without the members to split between, so a failed load
    // closes the dialog it sits in once the presenter has said why. Two reads and two
    // failures, because they fail for different reasons and each says which it was.
    protected override async Task OnInitializedAsync()
    {
        var members = await Errors.TryAsync(
            async () => _members = await GroupsClient.GetGroupMembersAsync(GroupId),
            "Could not load the group.");

        if (!members)
        {
            MudDialog.Cancel();
            return;
        }

        var rules = await Rules.ForGroupAsync(GroupId);

        if (rules is null)
        {
            MudDialog.Cancel();
            return;
        }

        _groupRules = rules;

        // Both halves are in hand now -- the rule and who is actually in the group -- and
        // one is edited against the other from here on.
        ScopeToMembers();

        OnModelVersionChange();
    }

    private void OnModelVersionChange()
    {
        _ruleType = Model.Version switch
        {
            PercentSplitRuleDto => RuleType.Percent,
            SharesSplitRuleDto => RuleType.Shares,
            PayerSplitRuleDto => RuleType.Personal,
            EvenSplitRuleDto => RuleType.Even,
            _ => _ruleType
        };

        StateHasChanged();
    }

    private decimal PercentTotal => Model.Version is PercentSplitRuleDto percentSplitRuleDto ? Math.Round(percentSplitRuleDto.Percentages.Values.Sum(), 2) : 0;
    private int SharesTotal => Model.Version is SharesSplitRuleDto sharesSplitRuleDto ? sharesSplitRuleDto.Shares.Values.Sum() : 0;

    public bool IsValid
    {
        get
        {
            if (!_form.IsValid)
                return false;

            return _ruleType switch
            {
                null => false,
                RuleType.Percent when PercentTotal != 100 => false,
                RuleType.Shares when SharesTotal <= 0 => false,
                _ => true
            };
        }
    }

    public async Task Validate()
    {
        await _form.ValidateAsync();
    }

    private async Task OnCopySourceSelected()
    {
        if (_copySourceRuleId is not { } sourceRuleId)
            return;

        var details = await Rules.GetAsync(sourceRuleId);

        if (details is null) return;

        Model.Version = details.Definition;

        // A copied division arrives from the server whole, naming whoever that rule names,
        // which need not be this membership either.
        ScopeToMembers();

        OnModelVersionChange();
    }

    private void OnRuleTypeChanged()
    {
        Model.Version = _ruleType switch
        {
            RuleType.Personal => new PayerSplitRuleDto(),

            // Naming nobody, which is what makes it keep dividing evenly when somebody
            // joins. Listing today's members instead would freeze them in, and that is the
            // shares rule one row down.
            RuleType.Even => new EvenSplitRuleDto(),

            RuleType.Percent when Model.Version is SharesSplitRuleDto shares => new PercentSplitRuleDto
            {
                Percentages = ConvertSharesToPercentages(shares)
            },

            RuleType.Percent => new PercentSplitRuleDto
            {
                Percentages = _members.ToDictionary(m => m.Id, _ => 0m)
            },

            RuleType.Shares => new SharesSplitRuleDto
            {
                Shares = _members.ToDictionary(m => m.Id, _ => 0)
            },

            _ => throw new ArgumentOutOfRangeException()
        };

        StateHasChanged();
    }

    private void SplitPercentEvenly()
    {
        if (Model.Version is not PercentSplitRuleDto percent)
            return;

        if (_members.Count == 0) throw new InvalidOperationException();

        var basePercentage = Math.Floor(10000m / _members.Count) / 100m;

        foreach (var memberId in _members.Select(x => x.Id))
        {
            percent.Percentages[memberId] = basePercentage;
        }

        // Three members are 33.33 twice and 33.34 once, and the odd cent has to land on
        // somebody. Whom is the policy's business; that it is the same somebody every time
        // is this form's, because these numbers are saved and then divide every expense the
        // rule touches.
        var remainder = 100m - (basePercentage * (_members.Count - 1));

        percent.Percentages[RemainderGoesTo(_ => 1)] = remainder;

        StateHasChanged();
    }

    /// <summary>
    /// Which member carries what the division could not split cleanly. The rule itself is
    /// <see cref="IRemainderPolicy"/>'s -- this form asks the question and does not answer it.
    /// </summary>
    private Guid RemainderGoesTo(Func<UserInfo, decimal> weight) =>
        Remainder.CarriedBy([.._members], weight);

    private void ClearValues()
    {
        switch (Model.Version)
        {
            case PercentSplitRuleDto percent:
                foreach (var memberId in _members.Select(x => x.Id))
                {
                    percent.Percentages[memberId] = 0m;
                }

                break;

            case SharesSplitRuleDto shares:
                foreach (var memberId in _members.Select(x => x.Id))
                {
                    shares.Shares[memberId] = 0;
                }

                break;

            default:
                throw new InvalidOperationException("ClearAllValues is only supported for Percent or Shares rules.");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Restates the division so that it names today's members and nobody else: an entry for
    /// somebody who has left is dropped, and a member the rule never named starts at zero.
    /// </summary>
    /// <remarks>
    /// Every figure on this form comes out of these dictionaries, and every field is
    /// rendered from <see cref="_members"/> -- so an entry for somebody who is not one is
    /// invisible and still counted. It diluted the shares-to-percent conversion, dividing
    /// three members' worth of shares between the two left and handing the shortfall to
    /// whoever the remainder landed on, and it held <see cref="PercentTotal"/> away from 100
    /// with no field on screen to correct, which the form reads as invalid and refuses to
    /// save. The other direction was worse than either: the fields bind through the
    /// dictionary indexer, so a member who joined after the rule was written threw
    /// <see cref="KeyNotFoundException"/> as the form rendered.
    /// <para>
    /// The totals stay the sum of the whole dictionary on purpose. Scoping them instead
    /// would show 100 while saving something else -- the server counts what it is sent, and
    /// refuses both a percentage rule that does not total 100 and any rule naming a
    /// non-member at all. Making the dictionary true is what makes the totals true.
    /// </para>
    /// <para>
    /// Nothing is renormalised. Dropping a departed member's 33.34 leaves the two who are
    /// left reading 33.33 and a total of 66.66, and that is the honest state of the rule:
    /// what the missing third becomes is a decision for the group, one "Split Evenly" away,
    /// not a number this form should invent on their behalf.
    /// </para>
    /// <para>
    /// The server takes a departing member out of the rules that name them, so what reaches
    /// here is a form opened against a membership that has moved since -- see
    /// <c>docs/split-rules-and-membership.md</c>.
    /// </para>
    /// </remarks>
    private void ScopeToMembers()
    {
        Model.Version = Model.Version switch
        {
            PercentSplitRuleDto percent => new PercentSplitRuleDto
            {
                Percentages = _members.ToDictionary(
                    member => member.Id,
                    member => percent.Percentages.GetValueOrDefault(member.Id, 0m))
            },

            SharesSplitRuleDto shares => new SharesSplitRuleDto
            {
                Shares = _members.ToDictionary(
                    member => member.Id,
                    member => shares.Shares.GetValueOrDefault(member.Id, 0))
            },

            // A personal rule names nobody, and a rule type not yet chosen is null: neither
            // has weights to scope.
            var unweighted => unweighted
        };
    }

    private Dictionary<Guid, decimal> ConvertSharesToPercentages(SharesSplitRuleDto shares)
    {
        if (_members.Count is 0)
            throw new InvalidOperationException();

        // Read once, over the members and only the members, so the denominator is the total
        // of the shares that get a percentage out of it. Summing the stored dictionary
        // instead put anybody the rule still named who had left into the divisor with no
        // percentage of their own, diluting everybody left. See ScopeToMembers.
        var held = _members.ToDictionary(
            member => member.Id, member => shares.Shares.GetValueOrDefault(member.Id, 0));

        var totalShares = held.Values.Sum();

        if (totalShares is 0) return held.ToDictionary(entry => entry.Key, _ => 0m);

        var percentages = held.ToDictionary(
            entry => entry.Key, entry => Math.Round(entry.Value * 100m / totalShares, 2));

        // What the rounding left over, onto the member the policy names -- weighted by the
        // shares, so it goes to the largest of them and never to a member holding none.
        // This used to go to a random member, so converting the same shares twice gave two
        // different sets of percentages.
        var diff = 100m - percentages.Values.Sum();

        if (Math.Abs(diff) <= 0.001m)
            return percentages;

        percentages[RemainderGoesTo(member => held[member.Id])] += diff;

        return percentages;
    }

    /// <summary>
    /// A split rule: a name the group gives a division, and the division itself.
    /// </summary>
    /// <remarks>
    /// It used to be a category and the division behind it, edited together and written
    /// twice, because a group says "Groceries is split four ways" and thinks of them as one
    /// thing. They are not one thing: a rule can stand behind several categories, and
    /// editing the division under Groceries then changed how Utilities divided too -- while
    /// renaming Groceries renamed the rule out from under it. Categories are pointed at
    /// rules on the group's Splits tab now, and this form edits only the rule.
    /// </remarks>
    public record RuleEditorModel
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(64, ErrorMessage = "Name must be less than 64 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required] public SplitRuleDto Version { get; set; } = null!;
    }

}