@using GroupSplit.Shared
@using GroupSplit.App.Shared.Extensions

@*
    Squaring up with everybody in a group at once.

    The dialog beside this one records a single repayment between the two of you. This one
    records all of them: the same transfers, decided the same way, written together instead
    of one dialog at a time.

    Your own position, not the group's. Every line here has you on one end of it, because
    what you paid and what you were paid are things you were there for -- money moving
    between two other members is not yours to record.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">Settle up</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">

            @if (Owed.Count == 0 && Owing.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    You are already square with everybody in this group.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">
                    @Total.ToMoney() across @Count @(Count == 1 ? "repayment" : "repayments").
                </MudText>

                <MudList T="string" Dense="true">
                    @foreach (var debt in Owing)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Rounded.ArrowUpward">
                            You pay @debt.UserName <b>@debt.Amount.ToMoney()</b>
                        </MudListItem>
                    }
                    @foreach (var credit in Owed)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Rounded.ArrowDownward">
                            @credit.UserName pays you <b>@credit.Amount.ToMoney()</b>
                        </MudListItem>
                    }
                </MudList>

                @* Both optional. Squaring up has to stay one tap, so neither can be
                   required -- but the date is what lets a month closed on the 3rd hold the
                   repayments that closed it. *@
                <MudDatePicker Date="_date" DateChanged="@DateChanged"
                               Label="When"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               HelperText="Defaults to now."/>

                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="Note"
                              Variant="Variant.Outlined"
                              Placeholder="End of September, bank transfer…"
                              HelperText="Written onto every repayment."/>
            }

        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   Disabled="@(Count == 0)"
                   OnClick="@Submit">
            Settle up
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// What the caller owes, from the balance the page is already holding.
    /// </summary>
    /// <remarks>
    /// Handed in rather than read again: the group page has these figures on screen, and a
    /// dialog that fetched its own could open showing something the page behind it
    /// contradicts. The server works the amounts out for itself when it writes, so this is
    /// only what somebody is being asked to agree to.
    /// </remarks>
    [Parameter] public IReadOnlyList<DebtInfo> Owing { get; set; } = [];

    /// <summary>What the caller is owed.</summary>
    [Parameter] public IReadOnlyList<DebtInfo> Owed { get; set; } = [];

    private SettleUpRequest _model = new();

    private DateTime? _date;

    private int Count => Owing.Count + Owed.Count;

    private decimal Total => Owing.Sum(debt => debt.Amount) + Owed.Sum(credit => credit.Amount);

    /// <summary>
    /// Midday rather than midnight, and stated as UTC. The picker hands back a date with no
    /// time on it; midnight is the moment most likely to fall out of the day somebody meant
    /// once a zone is applied to it, and the day is all they were choosing.
    /// </summary>
    private void DateChanged(DateTime? date)
    {
        _date = date;

        _model.Date = date is { } chosen
            ? new DateTimeOffset(chosen.Date.AddHours(12), TimeSpan.Zero)
            : null;
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(_model));

    private void Cancel() => MudDialog.Cancel();
}
