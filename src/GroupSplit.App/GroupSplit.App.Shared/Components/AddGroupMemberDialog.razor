@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@*
    Asking people into a group, by name.

    It used to ask for email addresses, and that limited a group to inviting people whose
    address somebody happened to have -- which is not how most people know the friend they
    went on the trip with. Naming somebody is enough: they become a person the group can
    give a share to straight away, and what reaches them is a link, shown on the Members tab
    once this closes.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @MudDialog.Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="gs-muted" Style="padding-bottom: 8px">
            Name whoever is sharing the costs. You can start splitting with them at once, and
            send each of them a link when you are ready.
        </MudText>

        <MudForm @ref="@_form">
            <MudStack Row AlignItems="AlignItems.Center">
                @* The same bound the API and the columns behind it hold, so somebody is
                   stopped at the keyboard rather than at Save. *@
                <MudTextField @bind-Value="_currentInput"
                              Label="Name"
                              Variant="Variant.Outlined"
                              MaxLength="InviteToGroupRequest.NameLength"
                              OnKeyDown="@HandleKeyDown"
                              Immediate
                              Placeholder="Type a name…"/>
                <MudIconButton Icon="@Icons.Material.Rounded.Add" OnClick="@AddNameToList"
                               aria-label="Add this person"
                               Color="Color.Primary"/>
            </MudStack>
        </MudForm>

        <MudChipSet T="string" Style="padding-top: 5px;">
            @* Who is already here, so nobody is named twice by accident. *@
            @foreach (var person in CurrentUsers)
            {
                <MudChip T="UserInfo" Value=person Variant="Variant.Filled" Color="Color.Primary">
                    @person.Label()
                </MudChip>
            }
            @foreach (var name in _model.Names)
            {
                <MudChip T="string" Value=name CloseIcon="@Icons.Material.Rounded.Close"
                         OnClose="@CloseChip" Variant="Variant.Outlined" Color="Color.Primary">
                    @name
                </MudChip>
            }
        </MudChipSet>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary"
                   Disabled="@(_model.Names.Count == 0)" OnClick="@Submit">
            Invite
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;

    [Parameter]
    public UserInfo[] CurrentUsers
    {
        get => field ?? [];
        set;
    }

    private string _currentInput = string.Empty;

    private readonly InviteToGroupRequest _model = new();

    /// <summary>
    /// Adds the typed name to the list. Duplicates within this dialog are dropped, because
    /// pressing Enter twice is not two people -- but two people really can share a name, so
    /// nothing stops somebody naming a second Dani in a later invitation.
    /// </summary>
    private void AddNameToList()
    {
        var name = _currentInput.Trim();

        if (name.Length == 0)
            return;

        if (_model.Names.Any(existing => string.Equals(existing, name, StringComparison.OrdinalIgnoreCase)))
            return;

        _model.Names.Add(name);

        _currentInput = string.Empty;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddNameToList();
    }

    private Task Submit()
    {
        // Whatever is still in the box counts: somebody typing one name and pressing the
        // button has not "forgotten" to press Enter first.
        AddNameToList();

        MudDialog.Close(DialogResult.Ok(_model));
        return Task.CompletedTask;
    }

    private void CloseChip(MudChip<string> chip)
    {
        if (chip.Value is not null)
            _model.Names.Remove(chip.Value);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
