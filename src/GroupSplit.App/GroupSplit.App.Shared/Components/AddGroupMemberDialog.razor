@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @MudDialog.Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="@_form" Model="@_model">
            <MudStack Row AlignItems="AlignItems.Center">
                <MudTextField For="@(() => _currentInput.Email)"
                              @bind-Value="_currentInput.Email"
                              Label="User Email"
                              Variant="Variant.Outlined"
                              OnKeyDown="@HandleKeyDown"
                              Immediate
                              Placeholder="Type an email..."/>
                <MudIconButton Icon="@Icons.Material.Rounded.Add" OnClick="@AddMemberToList" Color="Color.Primary"/>
            </MudStack>
        </MudForm>
        <MudChipSet T="string" Style="padding-top: 5px;">
            @foreach (var userIdentifier in CurrentUsers)
            {
                <MudChip T="UserInfo" Value=userIdentifier Variant="Variant.Filled" Color="Color.Primary">
                    @userIdentifier.Email
                </MudChip>
            }
            @foreach (var userIdentifier in _model.UserIdentifiers)
            {
                <MudChip T="UserIdentifier" Value=userIdentifier CloseIcon="@Icons.Material.Rounded.Close"
                         OnClose="@CloseChip" Variant="Variant.Outlined" Color="Color.Primary">
                    @userIdentifier.Email
                </MudChip>
            }
        </MudChipSet>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="@Submit">
            Submit
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;

    [Parameter]
    public UserInfo[] CurrentUsers
    {
        get => field ?? [];
        set;
    }

    private UserIdentifier _currentInput = new() { Email = string.Empty };

    private readonly AddMemberRequest _model = new([]);

    private async Task AddMemberToList()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        var email = _currentInput.Email.Trim();

        // Avoid duplicates (record equality already helps, but be explicit for case-insensitive)
        if (_model.UserIdentifiers.Any(u => string.Equals(u.Email, email, StringComparison.OrdinalIgnoreCase)))
            return;

        _model.UserIdentifiers.Add(new UserIdentifier { Email = email });

        // Reset input (new instance so DataAnnotations re-run cleanly)
        _currentInput = new UserIdentifier { Email = string.Empty };
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddMemberToList();
    }

    private Task Submit()
    {
        MudDialog.Close(DialogResult.Ok(_model));
        return Task.CompletedTask;
    }

    private void CloseChip(MudChip<UserIdentifier> chip)
    {
        if (chip.Value is not null)
            _model.UserIdentifiers.Remove(chip.Value);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}