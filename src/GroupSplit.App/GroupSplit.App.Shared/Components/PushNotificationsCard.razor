@using GroupSplit.App.Shared.Localization
@using Microsoft.Extensions.Localization
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@if (push is { Supported: true })
{
    <div class="gs-card gs-card-pad gs-notifications" aria-busy="@(busy ? "true" : "false")">
        <div class="gs-card-title"><h2>@Loc["Notifications"]</h2></div>
        <p class="gs-muted gs-notifications-intro">@Loc["Choose which alerts this Android device receives."]</p>
        <div class="gs-notification-options">
        @foreach (var kind in PushNotificationKinds.Settings)
        {
            <MudSwitch @key="kind" T="bool" Value="push.IsEnabled(kind)" ValueChanged="@(value => SetEnabled(kind, value))"
                       Class="gs-notification-option" LabelPlacement="Placement.Start"
                       AriaLabel="@Loc[PushNotificationKinds.Label(kind)]" Disabled="busy" Color="Color.Primary">
                <span class="gs-notification-copy">
                    <span class="gs-notification-label">@Loc[PushNotificationKinds.Label(kind)]</span>
                    <span class="gs-notification-description">@Description(kind)</span>
                </span>
            </MudSwitch>
        }
        </div>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" role="alert">@error</MudAlert>
        }
    </div>
}

@code {
    private IPushNotifications? push;
    private bool busy;
    private string? error;
    private string Description(PushNotificationKind kind) => PushNotificationKinds.Category(kind) switch
    {
        PushNotificationCategory.Expenses => Loc["New expenses and changes in your groups."].Value,
        PushNotificationCategory.Settlements => Loc["Recorded payments and requests to settle up."].Value,
        PushNotificationCategory.GuestsJoining => Loc["When a guest joins one of your groups."].Value,
        PushNotificationCategory.BankSyncIssues => Loc["When a connected bank needs your attention."].Value,
        _ => ""
    };
    protected override void OnInitialized() => push = Services.GetService<IPushNotifications>();
    private async Task SetEnabled(PushNotificationKind kind, bool value)
    {
        busy = true;
        error = null;
        try { await push!.SetEnabledAsync(kind, value); }
        catch (Exception) { error = Loc["Could not update alerts. Check your connection and allow notifications in your device settings, then try again."].Value; }
        finally { busy = false; }
    }
}
