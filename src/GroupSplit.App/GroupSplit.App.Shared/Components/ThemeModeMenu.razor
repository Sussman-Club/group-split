@using GroupSplit.App.Shared.Localization
@using Microsoft.Extensions.Localization
@using GroupSplit.App.Shared.Services
@implements IDisposable
@inject ThemePreference Preference

@* Segmented control with a thumb that slides to the chosen mode. *@
<div class="gs-seg" role="radiogroup" aria-label="@Loc["Theme"]" style="--gs-seg-i: @Array.IndexOf(Modes, Preference.Mode)">
    <span class="gs-seg-thumb" aria-hidden="true"></span>
    @foreach (var mode in Modes)
    {
        <MudTooltip Text="@Label(mode)" Delay="400" ShowOnFocus="false">
            <button type="button"
                    class="gs-seg-btn @(mode == Preference.Mode ? "active" : "")"
                    role="radio"
                    data-mode="@mode"
                    aria-checked="@(mode == Preference.Mode ? "true" : "false")"
                    aria-label="@Label(mode)"
                    @onclick="@(() => Preference.Set(mode))">
                <MudIcon Icon="@Icon(mode)" />
            </button>
        </MudTooltip>
    }
</div>

@code {
    private static readonly ThemeMode[] Modes = [ThemeMode.Light, ThemeMode.System, ThemeMode.Dark];

    protected override void OnInitialized() => Preference.Changed += OnChanged;

    public void Dispose() => Preference.Changed -= OnChanged;

    private void OnChanged(ThemeChangeOrigin origin) => InvokeAsync(StateHasChanged);

    private string Label(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => Loc["Light"].Value,
        ThemeMode.Dark => Loc["Dark"].Value,
        _ => Loc["Match system"].Value
    };

    private string Icon(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => Icons.Material.Rounded.LightMode,
        ThemeMode.Dark => Icons.Material.Rounded.DarkMode,
        _ => Icons.Material.Rounded.Contrast
    };
}
