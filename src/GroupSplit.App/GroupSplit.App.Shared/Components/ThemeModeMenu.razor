@using GroupSplit.App.Shared.Services
@implements IDisposable
@inject ThemePreference Preference

<MudTooltip Text="@($"Theme: {Label(Preference.Mode)}")">
    <MudMenu Icon="@Icon(Preference.Mode)"
             Color="Color.Inherit"
             Dense
             AriaLabel="Change theme"
             AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight">
        @foreach (var mode in Modes)
        {
            <MudMenuItem Icon="@Icon(mode)"
                         IconColor="@(mode == Preference.Mode ? Color.Primary : Color.Default)"
                         OnClick="@(() => Preference.Set(mode))">
                @Label(mode)
            </MudMenuItem>
        }
    </MudMenu>
</MudTooltip>

@code {
    private static readonly ThemeMode[] Modes = [ThemeMode.System, ThemeMode.Light, ThemeMode.Dark];

    protected override void OnInitialized() => Preference.Changed += OnChanged;

    public void Dispose() => Preference.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static string Label(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => "Light",
        ThemeMode.Dark => "Dark",
        _ => "System"
    };

    private static string Icon(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.Contrast
    };
}
