@using System.Globalization
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@*
    What you paid, and what it cost you, month by month.

    The one chart in the product, and the one place a chart is unarguable: a ledger going
    back years is not readable as a table. Two lines rather than one, because the gap
    between them is the story -- it is how much somebody is habitually fronting for other
    people and waiting to get back.

    Inline SVG rather than a charting library. It is two paths and a baseline, it has to
    follow the app's own tokens in both themes, and it has to render server-side on the
    first paint. The mark colour is a more chromatic step of the brand teal: the UI teal
    has too little chroma to read as a data mark.
*@

@if (Points.Count < 2)
{
    <div class="gs-empty" style="padding: 32px">
        <MudIcon Icon="@Icons.Material.Rounded.ShowChart" />
        <span>@(Points.Count == 0 ? "No expenses in this span." : "One month is not a trend. Widen the date range.")</span>
    </div>
}
else
{
    <div class="gs-chart">
        <svg viewBox="@($"0 0 {Width} {Height}")" role="img" preserveAspectRatio="none"
             aria-label="@Description">
            @* Four gridlines and nothing else. An axis with ticks would be furniture around
               a shape whose point is its slope. *@
            @foreach (var y in GridLines)
            {
                <line class="gs-chart-grid" x1="0" x2="@Width" y1="@F(y)" y2="@F(y)" />
            }

            <path class="gs-chart-line is-paid" d="@Path(point => point.Paid)" />
            <path class="gs-chart-line is-share" d="@Path(point => point.Share)" />

            @for (var i = 0; i < Points.Count; i++)
            {
                var point = Points[i];
                <circle class="gs-chart-dot is-paid" cx="@F(X(i))" cy="@F(Y(point.Paid))" r="3">
                    <title>@Label(point): paid @point.Paid.ToMoney(), your share @point.Share.ToMoney()</title>
                </circle>
                <circle class="gs-chart-dot is-share" cx="@F(X(i))" cy="@F(Y(point.Share))" r="3" />
            }
        </svg>

        <div class="gs-chart-months">
            @foreach (var point in Points)
            {
                <span>@Label(point)</span>
            }
        </div>

        <div class="gs-chart-legend">
            <span class="is-paid">Paid</span>
            <span class="is-share">Your share</span>
        </div>
    </div>
}

@code {
    private const int Width = 640;
    private const int Height = 180;

    /// <summary>Room above the tallest point so a peak is not clipped by the frame.</summary>
    private const double Headroom = 1.08;

    [Parameter] public IReadOnlyList<MonthlyExposureResponse> Points { get; set; } = [];

    private decimal Ceiling => Math.Max(
        Points.Count == 0 ? 0m : Points.Max(point => Math.Max(point.Paid, point.Share)),
        0.01m);

    private double X(int index) => Points.Count == 1 ? Width / 2.0 : index * (double)Width / (Points.Count - 1);

    private double Y(decimal value) => Height - (double)(value / Ceiling) * Height / Headroom;

    private IEnumerable<double> GridLines =>
        Enumerable.Range(1, 4).Select(step => step * Height / 5.0);

    private string Path(Func<MonthlyExposureResponse, decimal> read) =>
        string.Join(" ", Points.Select((point, index) =>
            $"{(index == 0 ? "M" : "L")}{F(X(index))} {F(Y(read(point)))}"));

    /// <summary>
    /// Invariant, always. A comma decimal separator in an SVG path is a coordinate
    /// separator, so a French browser would draw a different shape from an English one.
    /// </summary>
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Label(MonthlyExposureResponse point) =>
        point.Month.ToString("MMM", CultureInfo.InvariantCulture);

    /// <summary>
    /// The chart in words, for anybody not looking at it. The shape is not the point --
    /// the gap between the two figures is -- so that is what it reads out.
    /// </summary>
    private string Description
    {
        get
        {
            if (Points.Count == 0) return "No expenses in this span.";

            var paid = Points.Sum(point => point.Paid);
            var share = Points.Sum(point => point.Share);

            return $"What you paid and what your share came to, over {Points.Count} months. "
                   + $"You paid {paid.ToMoney()} and your share came to {share.ToMoney()}.";
        }
    }
}
