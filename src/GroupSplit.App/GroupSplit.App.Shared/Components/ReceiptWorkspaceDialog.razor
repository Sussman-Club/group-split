@namespace GroupSplit.App.Shared.Components
<MudDialog Class="gs-sheet gs-receipt-workspace">
    <TitleContent><h2 class="gs-dialog-title">@MudDialog.Title</h2></TitleContent>
    <DialogContent>@Content</DialogContent>
    <DialogActions><MudButton OnClick="Close">@Loc["Close"]</MudButton></DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public Action<Action>? RegisterRefresh { get; set; }
    protected override void OnInitialized() => RegisterRefresh?.Invoke(() => _ = InvokeAsync(StateHasChanged));
    private void Close() => MudDialog.Close();
}
