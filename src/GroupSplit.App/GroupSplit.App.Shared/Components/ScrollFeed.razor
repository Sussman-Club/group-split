@typeparam TItem
@using Microsoft.AspNetCore.Components.Web.Virtualization

<Virtualize TItem="TItem" @ref="_virtualize" ItemsProvider="ItemsProvider"
            ItemSize="128" OverscanCount="5" Context="item">
    <ItemContent>@ItemContent(item)</ItemContent>
    <Placeholder><div style="height:128px" aria-hidden="true"></div></Placeholder>
    <EmptyContent>@EmptyContent</EmptyContent>
</Virtualize>

@code {
    [Parameter, EditorRequired] public ItemsProviderDelegate<TItem> ItemsProvider { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<TItem> ItemContent { get; set; } = null!;
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    private Virtualize<TItem>? _virtualize;

    public async Task RefreshDataAsync()
    {
        if (_virtualize is null) return;
        await _virtualize.RefreshDataAsync();
        await InvokeAsync(StateHasChanged);
    }
}
