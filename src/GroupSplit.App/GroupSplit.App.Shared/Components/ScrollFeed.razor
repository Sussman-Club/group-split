@typeparam TItem
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@foreach (var item in _items)
{
    @ItemContent(item)
}
@if (_loading)
{
    <div role="status"><Waiting Rows="2" /></div>
}
else if (_items.Count == 0)
{
    @EmptyContent
}
@if (_items.Count < _total && !_loading)
{
    <div @ref="_sentinel" class="gs-feed-sentinel">
        <MudButton OnClick="LoadMoreAsync">@Loc["Load more"]</MudButton>
    </div>
}

@code {
    [Parameter, EditorRequired] public ItemsProviderDelegate<TItem> ItemsProvider { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<TItem> ItemContent { get; set; } = null!;
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    private readonly List<TItem> _items = [];
    private int _total;
    private bool _loading;
    private bool _disposed;
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private CancellationTokenSource _generation = new();
    private ElementReference _sentinel;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<ScrollFeed<TItem>>? _reference;

    protected override Task OnInitializedAsync() => RefreshDataAsync();

    public async Task RefreshDataAsync()
    {
        if (_disposed) return;
        _generation.Cancel();
        _generation.Dispose();
        _generation = new();
        _items.Clear();
        _total = 0;
        _loading = false;
        await LoadMoreAsync();
    }

    [JSInvokable]
    public async Task LoadMoreAsync()
    {
        if (_loading || _disposed) return;
        var token = _generation.Token;
        _loading = true;
        try
        {
            var result = await ItemsProvider(new ItemsProviderRequest(_items.Count, 50, token));
            if (token.IsCancellationRequested || _disposed) return;
            var rows = result.Items.ToArray();
            _items.AddRange(rows);
            _total = rows.Length == 0 ? _items.Count : result.TotalItemCount;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally
        {
            if (!token.IsCancellationRequested && !_disposed)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _interopGate.WaitAsync();
        try
        {
            if (_disposed || _items.Count >= _total || _loading) return;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GroupSplit.App.Shared/js/scroll-feed.js");
            if (_disposed || _module is null) return;
            await DisconnectObserverAsync();
            _reference ??= DotNetObjectReference.Create(this);
            _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _sentinel, _reference);
        }
        catch (JSDisconnectedException) { }
        finally { _interopGate.Release(); }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _generation.Cancel();
        _generation.Dispose();
        await _interopGate.WaitAsync();
        try
        {
            await DisconnectObserverAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            _module = null;
            _reference?.Dispose();
            _interopGate.Release();
        }
    }

    private async Task DisconnectObserverAsync()
    {
        var observer = _observer;
        _observer = null;
        if (observer is null) return;
        try { await observer.InvokeVoidAsync("dispose"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            try { await observer.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }
}
