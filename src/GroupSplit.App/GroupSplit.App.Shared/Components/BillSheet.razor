@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@if (Receipt.Items.Count >= 12)
{
    <MudTextField T="string" @bind-Value="_filter" Immediate="true" Placeholder="Find a line" Clearable="true" />
}
<div class="gs-slip">
    <div class="gs-slip-edge" aria-hidden="true"></div>
    <div class="gs-slip-paper">
        <h3>@Title</h3>
        <p>@Where</p>
        @foreach (var item in Receipt.Items.Where(i => string.IsNullOrWhiteSpace(_filter) || i.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        {
            <div class="gs-slip-line" @key="item.Id">
                <div><strong>@item.Name</strong> · @item.Quantity.ToString("0.###")</div>
                <div>@item.TotalPrice.ToString("0.00")</div>
                <div class="gs-muted">@(item.SplitRuleName ?? "Choose a split rule")</div>
                @if (item.TaxAmount != 0) { <div class="gs-muted">Tax @item.TaxAmount.ToString("0.00")</div> }
            </div>
        }
        <hr />
        <div>Subtotal @Receipt.Subtotal.ToString("0.00")</div>
        <div>Tax @Receipt.Tax.ToString("0.00")</div>
        <div>Tip @Receipt.Tip.ToString("0.00")</div>
        <strong>Total @Receipt.Total.ToString("0.00")</strong>
        @if (Receipt.MissingRuleItemCount > 0)
        { <p>@Receipt.MissingRuleItemCount item(s) need a split rule before this bill can be divided.</p> }
    </div>
    <div class="gs-slip-edge is-bottom" aria-hidden="true"></div>
</div>

@code {
    [Parameter, EditorRequired] public ReceiptResponse Receipt { get; set; } = null!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Where { get; set; }
    private string? _filter;
}
