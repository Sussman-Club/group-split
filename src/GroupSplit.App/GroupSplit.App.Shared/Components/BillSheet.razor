@using GroupSplit.App.Shared.Extensions
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components

@*
    The bill, drawn as the bill.

    It was a list of rows in the app's own voice, which is the right treatment for the split
    underneath an expense and the wrong one for this: a receipt is a physical object people
    have read thousands of, and every convention it uses -- the narrow column, the fixed
    pitch, the leader dots, the ruled-off totals, the letter in the margin against the lines
    tax was not charged on -- is doing work. Set as a slip, "which line is which" needs no
    explaining.

    One component for the two places a bill is read: under the expense it divided, and on the
    imported charge it was typed against before anybody filed it. They are the same piece of
    paper, and were drawn twice -- so a line said "shared by everyone" in one and nothing at
    all in the other, on the same receipt.

    Reading only. Who had what is set from the line itself, one level up.
*@

@* The tools sit on the app's surface above the paper rather than on it. A control printed on
   a receipt is a foreign object, and the slip only reads as a document while nothing on it
   could be pressed. They appear at all only where there is something to find: a bill of six
   lines is read by looking at it, and a search box over it is a control that exists to be
   ignored. *@
@if (Searchable)
{
    <div class="gs-slip-tools">
        <MudTextField T="string" @bind-Value="_filter" @bind-Value:after="StateHasChanged"
                      Immediate="true" DebounceInterval="150"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="Find a line" Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Rounded.Search"
                      aria-label="Find a line on this bill" />

        @* aria-pressed is written as a string rather than the bool it reads like: Blazor
           drops an attribute whose value is false, and an absent aria-pressed is a button
           with no state at all rather than one that is off. *@
        @if (Wanting > 0)
        {
            <MudButton Variant="@(_onlyUnclaimed ? Variant.Filled : Variant.Text)"
                       Color="@(_onlyUnclaimed ? Color.Primary : Color.Default)"
                       Size="Size.Small" Class="gs-btn-pill"
                       aria-pressed="@(_onlyUnclaimed ? "true" : "false")"
                       OnClick="@(() => _onlyUnclaimed = !_onlyUnclaimed)">
                @Wanting with nobody
            </MudButton>
        }
    </div>
}

<div class="gs-slip">
    <div class="gs-slip-edge is-top" aria-hidden="true"></div>

    <div class="gs-slip-body">
        @* Caps because a till prints caps. Not the app's eyebrow label in another guise --
           this is the merchant line off the top of the paper, and it is the one place on
           the slip that names what you are looking at. *@
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <div class="gs-slip-head">
                <span class="gs-slip-merchant">@Title</span>
                @if (!string.IsNullOrWhiteSpace(Where))
                {
                    <span class="gs-slip-where">@Where</span>
                }

                @* What a till prints at the bottom, moved to the top because on screen it is
                   the thing that says how much paper there is before you start scrolling. *@
                <span class="gs-slip-where">
                    @Receipt.Items.Count @(Receipt.Items.Count == 1 ? "item" : "items")
                </span>
            </div>

            @* Under the head and nowhere else. Without one there is nothing above it to
               divide from, and the rule lands against whatever the caller put the slip
               below -- which is where the two stacked dividers came from. *@
            <div class="gs-slip-rule" aria-hidden="true"></div>
        }

        @* The lines scroll; the head above and the totals below do not. A real slip does not
           behave this way and does not have to -- it is in your hand, and the total is one
           glance down. A forty-line bill in a dialog pushes that total well past the fold,
           which is the one figure somebody is here to check against the charge. *@
        <ul class="gs-slip-lines">
            @foreach (var row in Showing)
            {
                <li class="gs-slip-line @(row.Unclaimed && DividesByClaims ? "is-unclaimed" : "")" @key="row.Key">
                    <span class="gs-slip-item">
                        <span class="gs-slip-name">@row.Name</span>
                    </span>

                    <span class="gs-slip-leader" aria-hidden="true"></span>

                    @* The letter in the margin, which is how a real bill says the tax at the
                       bottom was not charged on this line. Only where the bill charges tax at
                       all: a column of markers on a receipt with no tax explains nothing. *@
                    <span class="gs-slip-mark">@(row.Exempt && Receipt.Tax != 0 ? "N" : "")</span>

                    <span class="gs-slip-price">@row.Total.ToMoney()</span>

                    @* How many, at what each -- the way a till prints a repeated line instead
                       of printing it again. It is also what folds identical rows into one,
                       which is the difference between reading a warehouse bill and scrolling
                       past it. *@
                    @if (row.Count != 1)
                    {
                        <span class="gs-slip-count">@Trimmed(row.Count) @@ @row.Each.ToMoney()</span>
                    }

                    <span class="gs-slip-who">@row.Who</span>
                </li>
            }

            @* The rest of the charge: counted, totalled, and not named.

               It used to be printed in full and faded, which read well and told every member
               of the flat what you had bought on your own half of the same card charge, for
               how much, and who was with you -- the parts of a split charge can be in
               different groups, and that is most of the reason to split one. A count and a
               figure answer the question the fade was there for, which is why the paper
               totals more than the expense.

               On the slip and not under it, because that is where it happened: it is a line
               of this bill, and the reader is meant to add it to the ones above and arrive
               at the total. *@
            @if (Receipt.ElsewhereItemCount > 0)
            {
                <li class="gs-slip-line is-elsewhere">
                    <span class="gs-slip-item">
                        <span class="gs-slip-name">
                            @Receipt.ElsewhereItemCount more @(Receipt.ElsewhereItemCount == 1 ? "line" : "lines") on this charge
                        </span>
                    </span>

                    <span class="gs-slip-leader" aria-hidden="true"></span>
                    <span class="gs-slip-mark"></span>
                    <span class="gs-slip-price">@Receipt.ElsewhereTotal.ToMoney()</span>

                    <span class="gs-slip-who">filed as @(Receipt.ElsewhereItemCount == 1 ? "another expense" : "other expenses")</span>
                </li>
            }
        </ul>

        @if (Showing.Count == 0)
        {
            <p class="gs-slip-none">Nothing on this bill matches.</p>
        }

        <div class="gs-slip-rule" aria-hidden="true"></div>

        @* Always the whole bill, whatever is shown above. Totals that followed a filter would
           be a receipt adding up to something the card was never charged. *@
        <dl class="gs-slip-totals">
            <div>
                <dt>Items</dt>
                <dd>@Receipt.Subtotal.ToMoney()</dd>
            </div>

            @* Tax and tip only where there are any: a supermarket receipt has neither, and
               two rows of 0.00 say nothing. *@
            @if (Receipt.Tax != 0)
            {
                <div>
                    <dt>Tax</dt>
                    <dd>@Receipt.Tax.ToMoney()</dd>
                </div>
            }

            @if (Receipt.Tip != 0)
            {
                <div>
                    <dt>Tip</dt>
                    <dd>@Receipt.Tip.ToMoney()</dd>
                </div>
            }

            <div class="is-total">
                <dt>Total</dt>
                <dd>@Receipt.Total.ToMoney()</dd>
            </div>

            @* The one figure that ties the paper to the expense it was opened from, and the
               only place the two can be seen together. Without it a shared bill reads as a
               receipt that does not match the charge -- which is what it looks like, and is
               the thing somebody would otherwise go and check.

               Given by the caller rather than added up here. What a part comes to is the
               charge cut between the parts, tax and tip and the rounding included, and that
               arithmetic is the API's; a client that re-did it would eventually disagree
               with the ledger by a cent and be believed. *@
            @if (Receipt.ElsewhereItemCount > 0 && PartAmount is { } part)
            {
                <div class="is-part">
                    <dt>This expense</dt>
                    <dd>@part.ToMoney()</dd>
                </div>
            }
        </dl>

        @* Lines against lines. It counted a sum of the folded rows' quantities against a
           count of the bill's lines, so a warehouse bill with a line of twelve read
           "Showing 15 of 6" the moment anybody typed in the box. *@
        @if (Filtered)
        {
            <p class="gs-slip-foot">
                Showing @Narrowed().Count() of @Receipt.Items.Count. The totals are the whole bill.
            </p>
        }

        @* Both legends describe marks, so both are gated on a mark being on screen rather
           than on one being somewhere on the paper: after a filter that leaves neither,
           they explain nothing. *@
        @if (Receipt.Tax != 0 && Narrowed().Any(line => !line.IsTaxable))
        {
            <p class="gs-slip-foot">N — no tax charged on this line</p>
        }

        @* Only where the answer is wanted. Claims are read by one thing -- the rule that
           divides an expense by its bill -- and on every other bill they are stored and never
           looked at, so counting the lines that have none is nagging about something nothing
           will read. *@
        @if (Wanting > 0)
        {
            @* Out of this expense's lines, not the paper's: on a split charge the others are
               another expense's to answer for, and the division only ever looks at this
               part. *@
            <p class="gs-slip-foot is-unclaimed">
                @Wanting of @Receipt.Items.Count @(Receipt.Items.Count == 1 ? "line" : "lines") @(Wanting == 1 ? "has" : "have") nobody on @(Wanting == 1 ? "it" : "them").
                This expense cannot be divided by its bill until somebody says who had @(Wanting == 1 ? "it" : "them").
            </p>
        }
    </div>

    <div class="gs-slip-edge is-bottom" aria-hidden="true"></div>
</div>

@code {
    /// <summary>
    /// How many lines a bill needs before it is worth offering tools for reading it.
    /// </summary>
    /// <remarks>
    /// A restaurant bill is read by looking at it. A warehouse receipt is not read, it is
    /// searched -- and the difference is roughly where a bill stops fitting on a screen.
    /// </remarks>
    private const int Long = 12;

    [Parameter, EditorRequired] public ReceiptResponse Receipt { get; set; } = null!;

    /// <summary>What is printed across the top of the paper: where the money went.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The line under it -- which card, which day -- where the caller knows.</summary>
    [Parameter] public string? Where { get; set; }

    /// <summary>The reader, so their own claims read as "You" rather than as their name.</summary>
    [Parameter] public Guid? Me { get; set; }

    /// <summary>
    /// What this expense's part of the bill came to, where the caller knows it.
    /// </summary>
    /// <remarks>
    /// Only ever shown on a bill covering more than one purchase, which is the only case
    /// where the paper's total is not the money the reader arrived with.
    /// </remarks>
    [Parameter] public decimal? PartAmount { get; set; }

    private string? _filter;
    private bool _onlyUnclaimed;

    private bool Searchable => Receipt.Items.Count >= Long || Wanting > 0;

    /// <summary>
    /// Whether anything reads the claims on this bill.
    /// </summary>
    /// <remarks>
    /// The itemised rule is the only thing that does. A bill under a category that divides
    /// evenly, or one on a charge nobody has filed, keeps its claims and nothing looks at
    /// them -- so a line naming nobody there is a fact about a receipt rather than a job
    /// somebody has left undone, and saying otherwise is how a screen teaches people to
    /// ignore it.
    /// </remarks>
    private bool DividesByClaims => Receipt.DividesItsExpense;

    /// <summary>How many lines still need an answer -- none, where none is wanted.</summary>
    private int Wanting => DividesByClaims ? Unclaimed : 0;

    private bool Filtered => !string.IsNullOrWhiteSpace(_filter) || _onlyUnclaimed;

    /// <summary>
    /// Lines with nobody on them.
    /// </summary>
    /// <remarks>
    /// Of this expense's part, which is all the reading carries: a line in another part of a
    /// split charge is that expense's to answer for, and the division itself follows the same
    /// rule -- it refuses a part with an unclaimed line and never looks at the others. This
    /// used to count the whole paper and tell a reader their expense could not be divided
    /// because of four lines they had no say over.
    /// </remarks>
    private int Unclaimed => Receipt.Items.Count(line => line.Claims.Count == 0);

    /// <summary>
    /// The lines being looked at: the paper, narrowed by whatever the tools are set to.
    /// </summary>
    /// <remarks>
    /// Before folding, and that is the point of it being its own thing. The footnote counts
    /// what is showing against what is on the bill, and both halves have to be counts of
    /// the same kind: it read a sum of <em>quantities</em> off the folded rows against a
    /// count of <em>lines</em>, so the shipped warehouse bill with a line of twelve says
    /// "Showing 15 of 6" as soon as anybody types in the box.
    /// </remarks>
    private IEnumerable<ReceiptItemResponse> Narrowed()
    {
        var wanted = _filter?.Trim();

        return Receipt.Items
            .Where(line => !_onlyUnclaimed || line.Claims.Count == 0)
            .Where(line => string.IsNullOrEmpty(wanted)
                           || line.Name.Contains(wanted, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>One printed row: a line, or the identical lines it stands for.</summary>
    private sealed record Row(
        string Key, string Name, decimal Count, decimal Each, decimal Total,
        bool Exempt, bool Unclaimed, string Who);

    /// <summary>
    /// What to print: the bill, narrowed to what is being looked for, with identical lines
    /// folded together.
    /// </summary>
    /// <remarks>
    /// Folded on everything that could make two lines different things -- the name, what one
    /// costs, whether tax was charged on it, and who had it. Two jackets at the same price
    /// become one row reading "2 @@ 59.99"; the same two with different people on them stay
    /// two rows, because telling those apart is the whole reason the lines are stored
    /// separately rather than as a quantity.
    /// </remarks>
    private IReadOnlyList<Row> Showing
    {
        get
        {
            return
            [
                .. Narrowed()
                    .GroupBy(line => (
                        Name: line.Name.Trim().ToLowerInvariant(),
                        line.UnitPrice,
                        line.IsTaxable,
                        // Which purchase the line is part of, so two identical items bought
                        // on one card and filed as two expenses stay two rows. Folding them
                        // would print one row that is half this expense's and half not, and
                        // no marking could then be true of it.
                        Who: Who(line)))
                    .Select(same => new Row(
                        same.First().Id.ToString(),
                        same.First().Name,
                        same.Sum(line => line.Quantity),
                        same.First().UnitPrice,
                        same.Sum(line => line.TotalPrice),
                        !same.First().IsTaxable,
                        same.First().Claims.Count == 0,
                        same.Key.Who))
            ];
        }
    }

    /// <summary>
    /// Who had one line, by name.
    /// </summary>
    /// <remarks>
    /// A weight is shown only when it is not one. Two names side by side is a line two people
    /// shared; a weight against one of them says they had more of it, and printing it against
    /// every ordinary claim would bury that in punctuation.
    /// </remarks>
    private string Who(ReceiptItemResponse line)
    {
        if (line.Claims.Count == 0)
        {
            // Said only where somebody will be asked to answer it. On a bill nothing divides
            // by, a line naming nobody is not an omission -- it is what a receipt looks like;
            // and on another part of a split charge it is somebody else's to answer.
            return DividesByClaims ? "nobody yet" : string.Empty;
        }

        return string.Join(", ", line.Claims.Select(claim =>
        {
            // The name off the claim itself. It used to be looked up in the expense's splits
            // and fall back to eight characters of a guid -- which is what every bill on an
            // imported charge got, because a charge nobody has filed has no splits to look
            // in and no group to ask.
            var name = claim.UserId == Me ? "You" : claim.UserName;

            return claim.Weight == 1 ? name : $"{name} ×{claim.Weight}";
        }));
    }

    /// <summary>
    /// A count without its trailing zeros: a bill says "2", not "2.000", and says "0.25"
    /// when that is what was weighed.
    /// </summary>
    private static string Trimmed(decimal quantity) =>
        quantity == decimal.Truncate(quantity)
            ? decimal.Truncate(quantity).ToString()
            : quantity.ToString("0.###");
}
