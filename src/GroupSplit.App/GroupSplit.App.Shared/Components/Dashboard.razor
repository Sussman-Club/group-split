@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IGroupsPageStateService GroupsService
@inject ITransactionsPageStateService TransactionsService
@inject NavigationManager Nav
@implements IDisposable

@* Signed-in home. Lives in its own component so the anonymous landing page
   never constructs the state services, which would call the API unauthenticated. *@

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">@DateTime.Today.ToString("dddd, d MMMM")</div>
        <h1>@Greeting, @UserInfo.FirstName.</h1>
        <p>Here is where everything stands across your groups.</p>
    </div>
</div>

<div class="gs-stack">
    <div class="gs-stats">
        <div class="gs-card gs-stat gs-reveal" style="--i: 0">
            <span class="gs-stat-icon"><MudIcon Icon="@Icons.Material.Rounded.Groups" /></span>
            <span class="gs-eyebrow">Groups</span>
            <span class="gs-stat-value">@ActiveGroups.Count</span>
            <span class="gs-muted" style="font-size: .8125rem">@(ArchivedCount == 0 ? "All active" : $"{ArchivedCount} archived")</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 1">
            <span class="gs-stat-icon"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
            <span class="gs-eyebrow">Expenses</span>
            <span class="gs-stat-value">@Transactions.Count</span>
            <span class="gs-muted" style="font-size: .8125rem">recorded all time</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 2">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" /></span>
            <span class="gs-eyebrow">This month</span>
            <span class="gs-stat-value gs-money">@ThisMonth.ToString("C")</span>
            <span class="gs-muted" style="font-size: .8125rem">@ThisMonthCount expense@(ThisMonthCount == 1 ? "" : "s")</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 3">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.Payments" /></span>
            <span class="gs-eyebrow">Total spent</span>
            <span class="gs-stat-value gs-money">@Total.ToString("C")</span>
            <span class="gs-muted" style="font-size: .8125rem">across every group</span>
        </div>
    </div>

    <div class="gs-two-col">
        <div class="gs-card gs-card-pad gs-reveal" style="--i: 4">
            <div class="gs-card-title">
                <h2>Your groups</h2>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="/groups"
                           EndIcon="@Icons.Material.Rounded.ArrowForward">Open</MudButton>
            </div>
            @if (ActiveGroups.Count == 0)
            {
                <div class="gs-empty">
                    <MudIcon Icon="@Icons.Material.Rounded.Groups" />
                    <h3>No groups yet</h3>
                    <span>Create one from the Groups page to start splitting.</span>
                </div>
            }
            else
            {
                <div class="gs-group-grid">
                    @{ var i = 0; }
                    @foreach (var group in ActiveGroups)
                    {
                        var g = group;
                        <button type="button" class="gs-card gs-card-hover gs-group-card gs-reveal" style="--i: @(5 + i++)"
                                @onclick="() => OpenGroup(g)">
                            <div class="gs-inline" style="justify-content: space-between">
                                <Avatar Name="@g.Name" />
                                <span class="gs-tag neutral">@g.MemberCount member@(g.MemberCount == 1 ? "" : "s")</span>
                            </div>
                            <span class="name">@g.Name</span>
                            <span class="go">View balances <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Style="width:16px;height:16px" /></span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="gs-card gs-card-pad gs-reveal" style="--i: 5">
            <div class="gs-card-title">
                <h2>Recent activity</h2>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="/transactions"
                           EndIcon="@Icons.Material.Rounded.ArrowForward">All</MudButton>
            </div>
            <TransactionsList Transactions="Recent" Limit="6" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public UserInfo UserInfo { get; set; } = null!;

    private List<GroupResponse> ActiveGroups => GroupsService.Groups.Where(g => !g.IsArchive).ToList();
    private int ArchivedCount => GroupsService.Groups.Count(g => g.IsArchive);
    private ICollection<TransactionResponse> Transactions => TransactionsService.Transactions ?? [];
    private List<TransactionResponse> Recent => Transactions.OrderByDescending(t => t.DateTime).ToList();
    private decimal Total => Transactions.Sum(t => t.Amount);
    private IEnumerable<TransactionResponse> MonthToDate => Transactions.Where(t =>
        t.DateTime.LocalDateTime.Year == DateTime.Today.Year && t.DateTime.LocalDateTime.Month == DateTime.Today.Month);
    private decimal ThisMonth => MonthToDate.Sum(t => t.Amount);
    private int ThisMonthCount => MonthToDate.Count();

    private static string Greeting => DateTime.Now.Hour switch
    {
        < 5 => "Still up",
        < 12 => "Good morning",
        < 18 => "Good afternoon",
        _ => "Good evening"
    };

    private void ReRender() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        GroupsService.OnGroupsChanged += ReRender;
        TransactionsService.OnTransactionsChanged += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(GroupsService.IsReadyTask, TransactionsService.IsReadyTask);
    }

    private void OpenGroup(GroupResponse group)
    {
        GroupsService.SelectedGroup = group;
        Nav.NavigateTo("/groups");
    }

    public void Dispose()
    {
        GroupsService.OnGroupsChanged -= ReRender;
        TransactionsService.OnTransactionsChanged -= ReRender;
    }
}
