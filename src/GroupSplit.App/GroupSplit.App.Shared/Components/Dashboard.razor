@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@namespace GroupSplit.App.Shared.Components
@inject IGroupsClient GroupsClient
@inject IUsersClient UsersClient
@inject ITransactionsClient TransactionsClient
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes
@inject NavigationManager Nav
@inject LocalClock Clock
@implements IDisposable

@*
    Signed-in home. Lives in its own component so the anonymous landing page never
    constructs the state services, which would call the API unauthenticated.

    Three changes from the page this replaces. Everything needing a decision is one strip
    directly under the position, rather than a panel below four stat tiles, a badge in the
    nav, and nothing at all. The activity feed is everybody's expenses and the settlements
    too, not only the rows where the reader was the payer, and each row carries their share.
    And the four stat tiles are one figure -- what has been spent around you this month --
    because the other three were counts nobody was asking about.
*@

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">@Clock.Today.ToString("dddd, d MMMM")</div>
        <h1>@Greeting, @UserInfo.FirstName.</h1>
        <p>Here is where everything stands across your groups.</p>
    </div>
</div>

<LoadView Skeleton="SkeletonLayout.Dashboard" Loading="_initializing" Failed="@(Position is null)" Retry="InitializeAsync">


<div class="gs-stack">
    @*
        The figure the page leads with is the position, not what the person has paid.
        "You paid $1,284 across every group" was true and answered nothing: what somebody
        opens this app to find out is whether they are up or down, and by how much. It took
        opening every group in turn and adding up by hand.
    *@
    <section class="gs-hero @PositionClass gs-reveal" style="--i: 0" aria-live="polite">
        @if (Net > 0)
        {
            <div class="gs-eyebrow">Overall, you are owed</div>
            <Money Value="Net" Animate Class="gs-hero-amount" />
        }
        else if (Net < 0)
        {
            <div class="gs-eyebrow">Overall, you owe</div>
            <Money Value="Net" Absolute Animate Class="gs-hero-amount" />
        }
        else
        {
            <div class="gs-eyebrow">Overall</div>
            <div class="gs-hero-amount">All settled</div>
        }

        <div class="gs-hero-sub">
            @if (OwedToYou > 0 && YouOwe > 0)
            {
                @($"{OwedToYou.ToMoney()} owed to you, {YouOwe.ToMoney()} owed by you. They do not cancel out -- they are different people.")
            }
            else if (OwedToYou > 0 || YouOwe > 0)
            {
                @($"Across {Owing.Count} group{(Owing.Count == 1 ? "" : "s")}.")
            }
            else
            {
                @("Nothing outstanding in any of your groups.")
            }
        </div>

        @if (Owing.Count > 0)
        {
            <div class="gs-hero-list">
                @foreach (var position in Owing.Take(4))
                {
                    var group = position;
                    <div class="gs-hero-row">
                        <Avatar Name="@group.GroupName" Size="sm" />
                        <div class="who">
                            @group.GroupName <small>@(group.Balance > 0 ? "owes you" : "you owe")</small>
                        </div>
                        <Money Value="@Math.Abs(group.Balance)" Animate />
                        <div class="gs-hero-actions">
                            <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => Open(group.GroupId))">Open</MudButton>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <WaitingOnYou Reveal="1" />

    <div class="gs-two-col">
        <div class="gs-card gs-card-pad gs-reveal" style="--i: 2">
            <div class="gs-card-title">
                <h2>Recent activity</h2>
            </div>
            @* Everybody's expenses and the settlements too, not only the rows where you
               were the payer -- and each one carries your share, because that is the
               number you owe on it. *@
            <LoadView Failed="@(_activity is null)" Retry="ReadAsync">
                <UserActivityList Entries="Recent" />
            </LoadView>
        </div>

        <div class="gs-stack">
            <div class="gs-card gs-stat gs-reveal" style="--i: 3">
                <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" /></span>
                <span class="gs-eyebrow">Shared, this month</span>
                <LoadView Failed="@(_thisMonth is null || _lastMonth is null)" Retry="ReadAsync">
                    <Money Value="ThisMonth" Currency="@_thisMonth?.Currency" Animate Class="gs-stat-value" />
                    <span class="gs-muted" style="font-size: .8125rem">@MonthSub</span>
                </LoadView>
            </div>

            <div class="gs-card gs-card-pad gs-reveal" style="--i: 4">
                <div class="gs-card-title">
                    <h2>Your groups</h2>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="/groups"
                               EndIcon="@Icons.Material.Rounded.ArrowForward">Open</MudButton>
                </div>
                <LoadView Failed="@(_homeGroups is null)" Retry="ReadAsync">
                @if (ActiveGroups.Count == 0)
                {
                    <div class="gs-empty">
                        <MudIcon Icon="@Icons.Material.Rounded.Groups" />
                        <h3>No groups yet</h3>
                        <span>Create one from the Groups page to start splitting.</span>
                    </div>
                }
                else
                {
                    <div class="gs-list">
                        @foreach (var group in ActiveGroups)
                        {
                            var g = group;
                            var balance = BalanceIn(g.Id);
                            <a class="gs-row" role="button" tabindex="0"
                               @onclick="@(() => Open(g.Id))"
                               @onkeydown="@(e => { if (e.Key is "Enter" or " ") Open(g.Id); })">
                                <Avatar Name="@g.Name" />
                                <div style="min-width: 0">
                                    <div class="title"><span>@g.Name</span></div>
                                    <div class="meta">@(g.IsPersonal ? "Just you" : $"{g.MemberCount} member{(g.MemberCount == 1 ? "" : "s")}")</div>
                                </div>
                                @* Nothing to settle in a group of one, so no balance to show. *@
                                @if (!g.IsPersonal)
                                {
                                    <div>
                                        <div><Money Value="balance" Signed /></div>
                                        <span class="when">@(balance == 0 ? "settled" : balance > 0 ? "owed to you" : "you owe")</span>
                                    </div>
                                }
                            </a>
                        }
                    </div>
                }
                </LoadView>
            </div>
        </div>
    </div>
</div>

</LoadView>

@code {
    /// <summary>How many entries the feed shows before sending somebody to the full listing.</summary>
    private const int RecentCount = 6;

    [Parameter, EditorRequired] public UserInfo UserInfo { get; set; } = null!;

    private ICollection<GroupResponse>? _homeGroups;
    private ICollection<GroupResponse> ActiveGroups => _homeGroups ?? [];

    private PagedResponse<UserActivityResponse>? _activity;
    private ExpenseShareSummaryResponse? _thisMonth;
    private ExpenseShareSummaryResponse? _lastMonth;

    /// <summary>
    /// Counts reads. A write raises two announcements and this reads on both, and nothing
    /// promises the first read's answer lands first.
    /// </summary>
    private int _version;

    private IReadOnlyList<UserActivityResponse> Recent => _activity?.Items ?? [];

    // What the groups spent around you, not what you personally paid: the figure a shared
    // ledger is actually about. Both months come from the same read so the comparison is
    // between two of the same thing.
    private decimal ThisMonth => _thisMonth?.Total ?? 0m;
    private int ThisMonthCount => _thisMonth?.Count ?? 0;

    /// <summary>
    /// The month in progress against the one before it. A figure with nothing to compare it
    /// to is a number; the same figure beside last month's is a direction.
    /// </summary>
    private string MonthSub
    {
        get
        {
            var said = $"{ThisMonthCount} expense{(ThisMonthCount == 1 ? "" : "s")}";

            return _lastMonth is { } previous
                ? $"{said} · {previous.Total.ToMoney(previous.Currency)} last month"
                : said;
        }
    }

    private UserPositionResponse? Position { get; set; }
    private decimal Net => Position?.Net ?? 0m;
    private decimal OwedToYou => Position?.OwedToYou ?? 0m;
    private decimal YouOwe => Position?.YouOwe ?? 0m;

    /// <summary>
    /// The groups where something is still outstanding, largest first. An archived group
    /// stays in this list: archiving tidies a list, it does not forgive a debt.
    /// </summary>
    private List<GroupPosition> Owing =>
        [.. (Position?.Groups ?? []).Where(position => position.Balance != 0)];

    private decimal BalanceIn(Guid groupId) =>
        Position?.Groups.FirstOrDefault(position => position.GroupId == groupId)?.Balance ?? 0m;

    private string PositionClass => Net switch
    {
        > 0 => "",
        < 0 => "is-neg",
        _ => "is-zero"
    };

    private void Open(Guid groupId) => Nav.NavigateTo($"/groups/{groupId}");

    // Greeting lives in Dashboard.razor.cs; see the note there.

    protected override void OnInitialized()
    {
        Changes.TransactionsChanged += ReadAsync;
        Changes.GroupsChanged += ReadAsync;
    }

    private bool _initializing = true;

    protected override Task OnInitializedAsync() => InitializeAsync();

    private async Task InitializeAsync()
    {
        _initializing = true;
        try
        {
            await ReadAsync();
        }
        finally { _initializing = false; }
    }

    /// <summary>
    /// Reads the position, bounded groups preview, activity feed, and monthly totals.
    /// Home never initializes the full Groups or Transactions page state services.
    /// </summary>
    private async Task ReadAsync()
    {
        var version = ++_version;

        PagedResponse<UserActivityResponse>? activity = null;
        ExpenseShareSummaryResponse? thisMonth = null;
        ExpenseShareSummaryResponse? lastMonth = null;
        UserPositionResponse? position = null;
        ICollection<GroupResponse>? homeGroups = null;

        var positionLoaded = await Errors.TryAsync(async () =>
                position = await UsersClient.GetCurrentUserPositionAsync(),
            "Could not load your balances.");
        var groupsLoaded = await Errors.TryAsync(async () =>
                homeGroups = await GroupsClient.GetGroupsAsync(page: 1, pageSize: 4, archived: false),
            "Could not load your groups.");

        var activityLoaded = await Errors.TryAsync(async () =>
                activity = await UsersClient.GetCurrentUserActivityAsync(page: 1, pageSize: RecentCount),
            "Could not load your recent activity.");

        var monthsLoaded = await Errors.TryAsync(async () =>
        {
            thisMonth = await ReadMonthAsync(DateFilterPreset.ThisMonth);
            lastMonth = await ReadMonthAsync(DateFilterPreset.LastMonth);
        }, "Could not load this month's total.");

        // A newer read is on its way; its answer is the one to show.
        if (version != _version)
            return;

        if (activityLoaded) _activity = activity;
        if (positionLoaded) Position = position;
        if (groupsLoaded) _homeGroups = homeGroups;

        if (monthsLoaded)
        {
            _thisMonth = thisMonth;
            _lastMonth = lastMonth;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// One calendar month of shared spending the caller is in. Shared only: a personal
    /// expense is not something a group spent, and this figure sits on a page about groups.
    /// The month is the date filter's, so a bank row counts in the month the bank dated it
    /// here as it does on the Expenses page (#252).
    /// </summary>
    private Task<ExpenseShareSummaryResponse> ReadMonthAsync(DateFilterPreset month)
    {
        var (from, to) = new DateFilter(month).Bounds(Clock.Offset, Clock.Today);

        return TransactionsClient.GetTransactionSharesSummaryAsync(from: from, to: to, personal: false);
    }

    public void Dispose()
    {
        Changes.TransactionsChanged -= ReadAsync;
        Changes.GroupsChanged -= ReadAsync;
    }
}
