@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Errors
@inject IGroupsClient GroupsClient
@inject ISettlement_requestsClient SettlementRequestsClient
@inject ApiErrorPresenter Errors
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject LocalClock Clock

<MudDialog Class="gs-sheet">
    <TitleContent><MudText Typo="Typo.h5">@Loc["Request payment from {0}", RecipientName].Value</MudText></TitleContent>
    <DialogContent>
        @if (_link is { } link)
        {
            <MudStack Spacing="2">
                <MudText>@Loc["Share this private link with {0}. It does not record a payment.", RecipientName].Value</MudText>
                <MudTextField Value="@link" Label="@Loc["Settlement request link"]" ReadOnly="true" Variant="Variant.Outlined" />
                <MudButton OnClick="CopyAsync">@Loc["Copy request link"]</MudButton>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="2">
                <MudText>@Loc["{0} currently owes you {1}.", RecipientName, CurrentDebt.ToMoney()].Value</MudText>
                <MudDatePicker Date="_through" DateChanged="ThroughChangedAsync" Label="@Loc["Up to a date"]"
                               Variant="Variant.Outlined" Clearable="true" MaxDate="@Clock.Today"
                               Disabled="@(_busy || _readingPeriod)"
                               HelperText="@Loc["Leave empty to request the full balance."]" />
                <DecimalField @bind-Value="_amount" Label="@Loc["Amount to request"]" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                              HideSpinButtons="true" />
                @if (_amount <= 0 || decimal.Round(_amount, 2) != _amount)
                {
                    <MudText Color="Color.Error">@Loc["Enter a positive amount with no more than two decimal places."]</MudText>
                }
                <MudText Typo="Typo.caption">@Loc["You can request a different amount, including one for an earlier period. Recording it is still a separate confirmation."]</MudText>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (_link is null)
        {
            <MudButton Variant="Variant.Text" OnClick="Cancel">@Loc["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" Disabled="@(_busy || _readingPeriod || _amount <= 0 || decimal.Round(_amount, 2) != _amount)" OnClick="CreateAsync">@Loc["Create link"]</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelRequestAsync">@Loc["Cancel request"]</MudButton>
            <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="Close">@Loc["Done"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid GroupId { get; set; }
    [Parameter] public Guid RecipientUserId { get; set; }
    [Parameter] public string RecipientName { get; set; } = "";
    [Parameter] public decimal CurrentDebt { get; set; }

    private decimal _amount;
    private string? _link;
    private bool _busy;
    private bool _readingPeriod;
    private DateTime? _through;
    private int? _periodOffset;

    protected override void OnInitialized() => _amount = CurrentDebt;

    private async Task CreateAsync()
    {
        if (_busy || _readingPeriod || _amount <= 0 || decimal.Round(_amount, 2) != _amount)
            return;
        _busy = true;
        try
        {
            SettlementRequestResponse? created = null;
            var saved = await Errors.TryAsync(async () => created = await GroupsClient.CreateGroupSettlementRequestAsync(GroupId,
                new CreateSettlementRequest
                {
                    RecipientUserId = RecipientUserId, Amount = _amount,
                    Through = _through is { } day ? DateOnly.FromDateTime(day) : null,
                    UtcOffset = _periodOffset
                }),
                Loc["Could not create the settlement request."].Value);
            if (saved && created is not null)
                _link = Navigation.ToAbsoluteUri($"/settlement-requests/{created.Token}").ToString();
        }
        finally { _busy = false; }
    }

    private void Cancel() => MudDialog.Cancel();
    private void Close() => MudDialog.Close();

    private async Task ThroughChangedAsync(DateTime? day)
    {
        if (day is null)
        {
            _through = null;
            _periodOffset = null;
            _amount = CurrentDebt;
            return;
        }
        _readingPeriod = true;
        try
        {
            var offset = Clock.CutoffOffsetMinutes;
            UserGroupBalanceResponse? balance = null;
            if (await Errors.TryAsync(async () => balance = await GroupsClient.GetGroupUserBalanceAsync(
                    GroupId, DateOnly.FromDateTime(day.Value), offset), Loc["Could not read the balance for that date."].Value) && balance is not null)
            {
                _through = day;
                _periodOffset = offset;
                _amount = balance.OwedToYou.FirstOrDefault(debt => debt.UserId == RecipientUserId)?.Amount ?? 0m;
            }
        }
        finally { _readingPeriod = false; }
    }

    private async Task CopyAsync()
    {
        var copied = false;
        try { copied = await JS.InvokeAsync<bool>("gs.copy", _link); }
        catch (JSException) { }
        Snackbar.Add(copied ? Loc["Request link copied."].Value : Loc["Select the link above and copy it by hand."].Value,
            copied ? Severity.Success : Severity.Info);
    }

    private async Task CancelRequestAsync()
    {
        if (_link is null)
            return;
        var token = _link[(_link.LastIndexOf('/') + 1)..];
        var cancelled = await Errors.TryAsync(() => SettlementRequestsClient.CancelSettlementRequestAsync(token),
            Loc["Could not cancel the settlement request."].Value);
        if (cancelled)
            MudDialog.Close();
    }
}
