@using GroupSplit.Shared
@using GroupSplit.App.Shared.Services.Transactions
@namespace GroupSplit.App.Shared.Components
@inject LocalClock Clock

@*
    Where an expense's shares came from, stated rather than guessed at.

    Quiet by default, loud when something is off. The first version of this drew a bordered
    card with an icon, two lines and a CURRENT badge over every expense in the app -- the
    same visual weight as the split list underneath it -- to report the ordinary case. A
    badge on the normal state teaches people to ignore badges, and "the version in force
    since 11 Sep 2026" is administrative register for what is usually "this is how the group
    splits the bills". The INVITED tag two rows below it is the model: it marks the one row
    that is not ordinary.

    So the common case is one line, and the border, the icon and the tag are kept for the
    three states worth interrupting somebody over -- a rule that has changed since, shares
    that are the expense's own, and a version that did not exist when the money was spent.
*@

@if (Info is { } source)
{
    @if (Plain(source))
    {
        <p class="gs-provenance-line">@Phrase(source)@Remainder()</p>
    }
    else
    {
        <div class="gs-provenance @Tone(source)">
            <MudIcon Icon="@Mark(source)"/>

            <div class="gs-provenance-body">
                <span class="gs-provenance-what">@Phrase(source)</span>
                <span class="gs-provenance-when">@When(source)</span>
            </div>

            @if (Tag(source) is { Length: > 0 } tag)
            {
                <span class="gs-tag @TagTone(source)">@tag</span>
            }

            @Action
        </div>
    }
}

@code {
    /// <summary>
    /// What divided it, already resolved. Null renders nothing: the read failed, or this is
    /// a personal expense, where there are no rules to have divided anything.
    /// </summary>
    [Parameter] public DivisionSourceInfo? Info { get; set; }

    /// <summary>
    /// When the money was spent, so a version that started afterwards can be called what it
    /// is. Without it that check is simply not made.
    /// </summary>
    [Parameter] public DateTimeOffset? On { get; set; }

    /// <summary>
    /// The shares, for the one question this screen is asked more than any other: why one
    /// person is a penny up on everybody else.
    /// </summary>
    [Parameter] public IReadOnlyList<TransactionSplitResponse>? Splits { get; set; }

    /// <summary>The right-hand slot, for a caller offering to correct what this says.</summary>
    [Parameter] public RenderFragment? Action { get; set; }

    /// <summary>
    /// Whether this is the ordinary case: a rule divided it, the rule still says the same
    /// thing, and the version was in force at the time. One line, no chrome.
    /// </summary>
    /// <remarks>
    /// An <see cref="Action"/> keeps the full strip whatever the state. The caller that
    /// passes one is offering to change what this says, and a control has to be somewhere a
    /// person can find it.
    /// </remarks>
    private bool Plain(DivisionSourceInfo source) =>
        Action is null
        && source is { Superseded: false, RuleUnknown: false }
        && (!source.ByHand || Undecidable(source))
        && !Predates(source);

    /// <summary>
    /// Whether shares the expense carries as its own leave it genuinely unknown who arrived
    /// at them -- in which case neither answer is stated.
    /// </summary>
    /// <remarks>
    /// An expense records a version or it does not, and an even division under no rule
    /// records none -- so "somebody typed these" and "nothing needed deciding" arrive here
    /// as the same absent id. Saying "evenly" over that reads the figures and guesses at
    /// who chose them, which is why this component stopped doing it. Saying "by hand"
    /// guesses at the same question in the other direction, and it is the guess that is
    /// wrong more often: an uncategorised expense is the common way to record one, the
    /// dialog that made it offered "Automatically", and the screen then told the person
    /// they had not taken it -- in a pencil, under a BY HAND tag.
    /// <para>
    /// So where nothing distinguishes the two, the strip states the one thing the response
    /// does support: no rule divided it. The two cases that <em>are</em> knowable keep
    /// their claim. A rule the expense could have used and did not is a departure somebody
    /// made; and shares that are not even cannot have fallen out of an even division,
    /// whether or not a rule was there to reach.
    /// </para>
    /// </remarks>
    private bool Undecidable(DivisionSourceInfo source) => !source.Ruled && Even();

    /// <summary>Whether the shares differ by no more than the remainder a division leaves.</summary>
    /// <remarks>
    /// The spread an even division can open up is not one cent. The splitter settles the
    /// remainder on one person rather than spreading it a cent each, so 48.50 four ways is
    /// 12.12, 12.12, 12.12, 12.14 -- two cents between the ends, from a division nobody
    /// touched. One cent was the tolerance at first and it called that expense hand-set,
    /// which is the very sentence this is here to stop. The most a remainder can come to is
    /// a cent short of the number of people, so that is the bound.
    /// </remarks>
    private bool Even()
    {
        if (Splits is not { Count: > 0 } splits) return false;

        var amounts = splits.Select(split => split.Amount).ToArray();

        return amounts.Max() - amounts.Min() <= 0.01m * (splits.Count - 1);
    }

    /// <summary>
    /// Whether the version that supposedly divided this began after the money was spent.
    /// </summary>
    /// <remarks>
    /// It cannot have, so the record is wrong -- usually a back catalogue pointed at whatever
    /// its rule said on the day of the import. This is the one fact on the screen that says
    /// so, and it is a comparison of two dates the response already carries.
    /// </remarks>
    private bool Predates(DivisionSourceInfo source) =>
        On is { } spent && source.Version is { } version && version.StartedAt > spent;

    /// <summary>What divided it, in the words somebody would use about their own money.</summary>
    private string Phrase(DivisionSourceInfo source)
    {
        if (source.ByHand)
            return Undecidable(source) ? "No rule divided this one" : "Amounts set by hand";

        if (source.Version is not { } version)
            return "Divided by a split rule";

        var named = source.RuleName is { Length: > 0 } name ? name : "a split rule";

        return version.Definition switch
        {
            PayerSplitRuleDto => $"All on whoever paid, by {named}",
            EvenSplitRuleDto { Among.Count: 0 } => $"Divided evenly by {named}",
            EvenSplitRuleDto => $"Divided evenly by {named}",
            _ => $"Divided by {named} — {version.Definition.Ratio()}"
        };
    }

    /// <summary>
    /// Who carries the odd cent, when there is one.
    /// </summary>
    /// <remarks>
    /// A division that will not go exactly into the amount leaves a penny somewhere, the app
    /// decides where deliberately, and until now every screen stayed silent about it -- so
    /// the one figure in the list that differs from its neighbours had no explanation. Only
    /// for a division that is otherwise equal: where the shares genuinely differ, the odd
    /// cent is not what anybody is asking about.
    /// </remarks>
    private string Remainder()
    {
        if (Splits is not { Count: > 1 } splits) return "";

        var amounts = splits.Select(split => split.Amount).ToArray();

        var most = amounts.Max();
        var least = amounts.Min();

        if (most - least != 0.01m) return "";

        var carrying = splits.Where(split => split.Amount == most).Select(split => split.UserName).ToArray();

        return carrying.Length switch
        {
            0 => "",
            1 => $" · the odd cent goes to {carrying[0]}",
            _ => $" · the odd cents go to {carrying.ToList().Listed()}"
        };
    }

    /// <summary>
    /// The window the version stood for, said only where it carries information.
    /// </summary>
    /// <remarks>
    /// "In force since today" is not information -- it is the day the rule was made, read as
    /// though something had changed. The dates matter when the rule has moved on since, or
    /// when they are the proof that the record is wrong.
    /// </remarks>
    private string When(DivisionSourceInfo source)
    {
        if (source.ByHand)
            return Undecidable(source)
                ? "nothing here records who arrived at the amounts"
                : "no rule divided this one";

        if (source.Version is not { } version)
        {
            return source switch
            {
                { Filed: false } => "it is filed under no category, so the rule cannot be named from here",
                { Ruled: false } => "the category it is filed under names no rule of its own",
                _ => "the category it is filed under names a different rule now"
            };
        }

        var from = Clock.Local(version.StartedAt);

        if (Predates(source) && On is { } spent)
            return $"but that division only began {Day(from)}, after this was spent on {Day(Clock.Local(spent))}";

        if (version.SupersededAt is not { } until)
            return $"unchanged since {Day(from)}";

        var to = Clock.Local(until);

        return from.Year == to.Year
            ? $"as it stood {from.ToString("d MMM")} – {Day(to)}"
            : $"as it stood {Day(from)} – {Day(to)}";
    }

    private static string Day(DateTimeOffset when) => when.ToString("d MMM yyyy");

    private string Tag(DivisionSourceInfo source) => source switch
    {
        _ when Predates(source) => "Looks wrong",
        { ByHand: true } when !Undecidable(source) => "By hand",
        { RuleUnknown: true } => "Another rule",
        { Superseded: true } => "Edited since",

        // No "Current". Almost every rule has never been edited, so almost every expense
        // would carry it -- a badge on the ordinary state, which is how a badge stops being
        // read at all.
        _ => ""
    };

    private string TagTone(DivisionSourceInfo source) =>
        Predates(source) || source.Superseded ? "clay" : "neutral";

    private string Tone(DivisionSourceInfo source) =>
        Predates(source) ? "is-wrong" : source.ByHand && !Undecidable(source) ? "is-own" : "";

    private string Mark(DivisionSourceInfo source) => source switch
    {
        _ when Predates(source) => Icons.Material.Outlined.Warning,
        { ByHand: true } when !Undecidable(source) => Icons.Material.Outlined.DriveFileRenameOutline,
        _ => Icons.Material.Outlined.AccountTree
    };
}
