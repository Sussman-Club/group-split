@page "/transactions"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject ITransactionsPageStateService TransactionsService
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>Expenses - Group Split</PageTitle>

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">Every group</div>
        <h1>Expenses</h1>
        <p>Everything you have recorded, searchable and editable in place.</p>
    </div>
    @* Searches the server, not the rows on screen: what is on screen is one page. Debounced
       so a request goes out when typing pauses rather than on every keystroke. *@
    <MudTextField @bind-Value="_searchString"
                  Placeholder="Search by name, group, category or who paid"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Rounded.Search"
                  Immediate="true"
                  DebounceInterval="300"
                  OnDebounceIntervalElapsed="OnSearchChangedAsync"
                  Clearable="true"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Class="gs-search"
                  Style="min-width: min(360px, 100%)" />
</div>

<div class="gs-stack">
    <div class="gs-stats">
        <div class="gs-card gs-stat gs-reveal" style="--i: 0">
            <span class="gs-stat-icon"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
            <span class="gs-eyebrow">Recorded</span>
            <span class="gs-stat-value gs-num" data-gs-count="@RecordedCount">@RecordedCount</span>
            <span class="gs-muted" style="font-size: .8125rem">@(IsSearching ? $"{MatchCount} match" : "showing all")</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 1">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" /></span>
            <span class="gs-eyebrow">This month</span>
            <Money Value="ThisMonth" Animate Class="gs-stat-value" />
            <span class="gs-muted" style="font-size: .8125rem">@DateTime.Today.ToString("MMMM")</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 2">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.Payments" /></span>
            <span class="gs-eyebrow">Total</span>
            <Money Value="ShownTotal" Animate Class="gs-stat-value" />
            <span class="gs-muted" style="font-size: .8125rem">@(string.IsNullOrWhiteSpace(_searchString) ? "all time" : "of the matches")</span>
        </div>
    </div>

    <div class="gs-reveal" style="--i: 3">
        <MudDataGrid T="TransactionResponse"
                     @ref="_grid"
                     ServerData="LoadPageAsync"
                     RowsPerPage="@TransactionQuery.Default.PageSize"
                     SortMode="SortMode.Single"
                     Hover="true"
                     Dense="false"
                     Bordered="false"
                     Elevation="0"
                     Class="gs-grid">
            <Columns>
                <PropertyColumn Property="x => x.DateTime" Title="When" InitialDirection="SortDirection.Descending">
                    <CellTemplate>
                        <div class="gs-num" style="font-weight: 700; font-size: .875rem">@context.Item.DateTime.LocalDateTime.ToString("d MMM yyyy")</div>
                        <div class="gs-muted gs-num" style="font-size: .75rem">@context.Item.DateTime.LocalDateTime.ToShortTimeString()</div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Name" Title="Expense">
                    <CellTemplate>
                        <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap">
                            <Avatar Name="@context.Item.PaidByUserName" Size="sm" />
                            <div style="min-width: 0">
                                <div style="font-weight: 700; font-size: .9375rem">@context.Item.Name</div>
                                <div class="gs-muted" style="font-size: .75rem">Paid by @context.Item.PaidByUserName</div>
                            </div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.GroupName" Title="Group">
                    <CellTemplate>
                        <span class="gs-tag neutral">@context.Item.GroupName</span>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Category" Title="Category">
                    <CellTemplate>
                        <span class="gs-tag">@context.Item.Category</span>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Amount" Title="Amount" HeaderClass="gs-right" CellClass="gs-right">
                    <CellTemplate>
                        <Money Value="context.Item.Amount" Class="gs-grid-amount" />
                    </CellTemplate>
                </PropertyColumn>

                <TemplateColumn Sortable="false" HeaderStyle="width: 96px" CellStyle="padding: 8px">
                    <CellTemplate>
                        <div class="gs-row-actions gs-inline" style="gap: 2px; justify-content: flex-end; flex-wrap: nowrap">
                            <MudTooltip Text="Edit">
                                <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                               Size="Size.Small"
                                               aria-label="Edit"
                                               OnClick="@(async () => await EditTransactionAsync(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete">
                                <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               aria-label="Delete"
                                               OnClick="@(async () => await DeleteTransactionAsync(context.Item))" />
                            </MudTooltip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="gs-empty">
                    <MudIcon Icon="@Icons.Material.Rounded.SearchOff" />
                    <h3>@(IsSearching ? "Nothing matches" : "No expenses yet")</h3>
                    <span>@(IsSearching ? "Try a different name, group or category." : "Record the first one with the button below.")</span>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="TransactionResponse" PageSizeOptions="@(new[] { 10, 25, 50 })" />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

<ExtendedFab Label="Add expense" OnClick="@AddTransactionAsync" />

@code {
    private string _searchString = "";
    private MudDataGrid<TransactionResponse>? _grid;

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchString);

    // The tiles read the server's figures rather than adding up the rows on screen: those
    // are one page, and a page cannot say what the whole comes to.
    private int RecordedCount => TransactionsService.Summary?.Count ?? 0;
    private int MatchCount => TransactionsService.Page?.TotalCount ?? 0;
    private decimal ThisMonth => TransactionsService.MonthSummary?.Total ?? 0m;

    private decimal ShownTotal => IsSearching
        ? TransactionsService.MatchesSummary?.Total ?? 0m
        : TransactionsService.Summary?.Total ?? 0m;

    /// <summary>
    /// What the grid asks for, translated. Its page is zero-based and its sort arrives as
    /// the column's property name, which is the sort key with a capital first letter.
    /// </summary>
    private async Task<GridData<TransactionResponse>> LoadPageAsync(
        GridState<TransactionResponse> state, CancellationToken cancellationToken)
    {
        var sort = state.SortDefinitions.FirstOrDefault();

        var query = new TransactionQuery(
            Page: state.Page + 1,
            PageSize: state.PageSize,
            SortBy: sort is null ? TransactionQuery.DefaultSortBy : Camel(sort.SortBy),
            SortDescending: sort?.Descending ?? true,
            Search: IsSearching ? _searchString.Trim() : null);

        await TransactionsService.LoadAsync(query, cancellationToken);

        var page = TransactionsService.Page;

        return new GridData<TransactionResponse>
        {
            Items = page?.Items ?? [],
            TotalItems = page?.TotalCount ?? 0
        };
    }

    private static string Camel(string propertyName) =>
        string.IsNullOrEmpty(propertyName)
            ? propertyName
            : char.ToLowerInvariant(propertyName[0]) + propertyName[1..];

    // A different search is a different question, so it starts again at the first page:
    // staying on page four of the old answer would show an empty grid over a real total.
    private async Task OnSearchChangedAsync(string _)
    {
        if (_grid is null) return;

        _grid.NavigateTo(MudBlazor.Page.First);
        await _grid.ReloadServerData();
    }

    /// <summary>
    /// A write elsewhere has already re-read the page this is showing; the grid holds its
    /// own copy of the rows, so it has to be told to ask again. That ask is answered from
    /// what the state now holds rather than by a second request.
    /// </summary>
    private async Task ReloadGridAsync()
    {
        if (_grid is null || _reloading) return;

        _reloading = true;
        try
        {
            await InvokeAsync(() => _grid.ReloadServerData());
        }
        finally
        {
            _reloading = false;
        }
    }

    private bool _reloading;

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    private void ReRender()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged() => _ = ReloadGridAsync();

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();
        TransactionsService.OnTransactionsChanged += ReRender;
        TransactionsService.OnTransactionsChanged += OnStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await TransactionsService.IsReadyTask;

        await base.OnInitializedAsync();
    }

    private async Task AddTransactionAsync()
    {
        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.DisablePayingUserSelection, true }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialogReference =
            await DialogService.ShowAsync<CreateTransactionDialog>("Create a transaction", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<CreateTransactionRequest>();

        if (request is not null)
        {
            await TransactionsService.CreateAsync(request, CancellationToken);
        }
    }

    private async Task EditTransactionAsync(TransactionResponse transaction)
    {
        var parameters = new DialogParameters<UpdateTransactionDialog>
        {
            { x => x.Original, transaction }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<UpdateTransactionDialog>("Edit Transaction", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<JsonPatchDocument<UpdateTransactionRequest>>();

        if (request is not null)
        {
            await TransactionsService.UpdateAsync(transaction, request, CancellationToken);
        }
    }

    private async Task DeleteTransactionAsync(TransactionResponse transaction)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete \"{transaction.Name}\"?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmationDialog>("Delete Transaction", parameters, options);

        var result = await dialogReference.GetReturnValueAsync<bool>();

        if (result)
        {
            await TransactionsService.DeleteAsync(transaction, CancellationToken);
        }
    }

    public async ValueTask DisposeAsync()
    {
        TransactionsService.OnTransactionsChanged -= ReRender;
        TransactionsService.OnTransactionsChanged -= OnStateChanged;
        if (_loadCts is not null) await _loadCts.CancelAsync();
    }

}
