@page "/transactions"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@inject ITransactionsPageStateService TransactionsService
@inject IDialogService DialogService
@inject LocalClock Clock
@implements IAsyncDisposable

<PageTitle>Expenses - Group Split</PageTitle>

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">Every group</div>
        <h1>Expenses</h1>
        <p>Everything you have paid for, across all your groups. To see everything a group
           has spent, open the group and follow through to its expenses.</p>
    </div>
    @* Searches the server, not the rows on screen: what is on screen is one page. Debounced
       so a request goes out when typing pauses rather than on every keystroke. *@
    <MudTextField @bind-Value="_searchString"
                  Placeholder="Search by name, group, category or who paid"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Rounded.Search"
                  Immediate="true"
                  DebounceInterval="300"
                  OnDebounceIntervalElapsed="OnSearchChangedAsync"
                  Clearable="true"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Class="gs-search"
                  Style="min-width: min(360px, 100%)" />
</div>

<div class="gs-stack">
    <div class="gs-inline" style="justify-content: space-between; gap: 12px; flex-wrap: wrap">
        <DateRangeFilter Value="@_range" ValueChanged="OnRangeChangedAsync" />

        @* Personal is the absence of a group, so it is a filter here rather than an entry
           in a group switcher. It used to be a hidden group called "Personal" that showed
           up as a chip, a card on the home page and a member count of one. *@
        <div class="gs-inline gs-range" role="group" aria-label="Which expenses">
            @foreach (var (label, value) in Scopes)
            {
                var scope = value;
                <button type="button" class="gs-chip @(_personal == scope ? "active" : "")"
                        aria-pressed="@(_personal == scope ? "true" : "false")"
                        @onclick="@(() => OnScopeChangedAsync(scope))">@label</button>
            }
        </div>
    </div>

    <div class="gs-stats">
        <div class="gs-card gs-stat gs-reveal" style="--i: 0">
            <span class="gs-stat-icon"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
            <span class="gs-eyebrow">Recorded</span>
            <span class="gs-stat-value gs-num" data-gs-count="@RecordedCount">@RecordedCount</span>
            <span class="gs-muted" style="font-size: .8125rem">@RecordedSubline</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 1">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" /></span>
            <span class="gs-eyebrow">This month</span>
            <Money Value="ThisMonth" Animate Class="gs-stat-value" />
            <span class="gs-muted" style="font-size: .8125rem">@Clock.Today.ToString("MMMM")</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 2">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.Payments" /></span>
            <span class="gs-eyebrow">Total</span>
            <Money Value="ShownTotal" Animate Class="gs-stat-value" />
            <span class="gs-muted" style="font-size: .8125rem">@TotalSubline</span>
        </div>
    </div>

    <div class="gs-reveal" style="--i: 3">
        <ExpensesGrid @ref="_grid" LoadPage="LoadPageAsync" IsNarrowed="@IsNarrowed" />
    </div>
</div>

<ExtendedFab Label="Add expense" OnClick="@AddTransactionAsync" />

@code {
    private string _searchString = "";
    private DateFilter _range = DateFilter.AllTime;
    private ExpensesGrid? _grid;

    /// <summary>Null for everything, true for your own only, false for the shared ones.</summary>
    private bool? _personal;

    private static readonly (string Label, bool? Value)[] Scopes =
    [
        ("Everything", null),
        ("Shared", false),
        ("Personal", true)
    ];

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchString);

    // Narrowed by anything -- a search, a span, or both -- and the figures beside the page
    // have to describe that narrowing rather than the whole.
    private bool IsNarrowed => IsSearching || !_range.IsAllTime || _personal is not null;

    private string RecordedSubline => IsNarrowed ? $"{MatchCount} in view" : "showing all";

    private string TotalSubline => (IsSearching, _range.IsAllTime) switch
    {
        (true, true) => "of the matches",
        (true, false) => $"matches in {_range.Label.ToLowerInvariant()}",
        (false, false) => _range.Label.ToLowerInvariant(),
        _ => _personal switch
        {
            true => "your own expenses",
            false => "shared expenses",
            _ => "all time"
        }
    };

    // The tiles read the server's figures rather than adding up the rows on screen: those
    // are one page, and a page cannot say what the whole comes to.
    private int RecordedCount => TransactionsService.Summary?.Count ?? 0;
    private int MatchCount => TransactionsService.Page?.TotalCount ?? 0;
    private decimal ThisMonth => TransactionsService.MonthSummary?.Total ?? 0m;

    private decimal ShownTotal => IsNarrowed
        ? TransactionsService.MatchesSummary?.Total ?? 0m
        : TransactionsService.Summary?.Total ?? 0m;

    // The search box and the chips are this page's, so what they say is read here, as the
    // request is made, rather than handed to the grid to hold on to. Then through the state
    // service, which answers from what it holds when the query has not changed.
    private async Task<PagedResponse<TransactionResponse>?> LoadPageAsync(
        TransactionQuery query, CancellationToken cancellationToken)
    {
        var narrowed = query with
        {
            Search = IsSearching ? _searchString.Trim() : null,
            Range = _range,
            Personal = _personal
        };

        await TransactionsService.LoadAsync(narrowed, cancellationToken);

        return TransactionsService.Page;
    }

    private Task OnSearchChangedAsync(string _) => BackToFirstPageAsync();

    private Task OnRangeChangedAsync(DateFilter range)
    {
        _range = range;
        return BackToFirstPageAsync();
    }

    private Task OnScopeChangedAsync(bool? personal)
    {
        _personal = personal;
        return BackToFirstPageAsync();
    }

    // A different span, like a different search, is a different question: page four of the
    // old answer is an empty grid under a real total.
    private Task BackToFirstPageAsync() =>
        _grid?.ReloadFromFirstPageAsync() ?? Task.CompletedTask;

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    private void ReRender() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();

        // Only the tiles here: the grid asks again on its own, off the same announcement.
        TransactionsService.OnTransactionsChanged += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        await TransactionsService.IsReadyTask;

        await base.OnInitializedAsync();
    }

    private async Task AddTransactionAsync()
    {
        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.DisablePayingUserSelection, true }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialogReference =
            await DialogService.ShowAsync<CreateTransactionDialog>("Add an expense", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<CreateTransactionRequest>();

        if (request is not null)
        {
            await TransactionsService.CreateAsync(request, CancellationToken);
        }
    }

    public async ValueTask DisposeAsync()
    {
        TransactionsService.OnTransactionsChanged -= ReRender;
        if (_loadCts is not null) await _loadCts.CancelAsync();
    }

}
