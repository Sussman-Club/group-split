@page "/transactions"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject ITransactionsPageStateService TransactionsService
@inject MudTheme Theme
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>Transactions</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudStack Spacing="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Receipt" Color="Color.Primary" Size="Size.Large"/>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Transactions</MudText>
        </MudStack>
    </MudStack>
</MudStack>


<MudTextField @bind-Value="_searchString"
              Placeholder="Search transactions..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Outlined.Search"
              IconSize="Size.Medium"
              Immediate="true"
              Style="@Theme.PaletteLight.Surface.BackgroundColorStyle"
              Variant="Variant.Outlined"
              Class="flex-grow-1 pa-6"/>

<MudDataGrid T="TransactionResponse"
             Items="@TransactionsService.Transactions"
             Filterable="true"
             FilterMode="DataGridFilterMode.Simple"
             Hover="true"
             Dense="false"
             Bordered="false"
             Class="ma-6"
             Striped="true">
    <Columns>
        <PropertyColumn Property="x => x.DateTime" Title="Date" Filterable="false">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.Item.DateTime.LocalDateTime.ToShortDateString()</MudText>
                    <MudText Typo="Typo.caption">@context.Item.DateTime.LocalDateTime.ToShortTimeString()</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Name" Title="Name" Filterable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.Name</MudText>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.GroupName" Title="Group" Filterable="true">
            <CellTemplate>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                    @context.Item.GroupName
                </MudChip>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Amount" Title="Amount" Filterable="false">
            <CellTemplate>
                <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Success">
                    @context.Item.Amount.ToString("C")
                </MudText>
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn Title="Actions" Filterable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(async () => await EditTransactionAsync(context.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(async () => await DeleteTransactionAsync(context.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
            <MudText Typo="Typo.body1" Color="Color.Secondary">No transactions found</MudText>
        </MudStack>
    </NoRecordsContent>
</MudDataGrid>

<ExtendedFab Label="Transaction" OnClick="@AddTransactionAsync"/>

@code {
    private string _searchString = "";

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    private void ReRender()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();
        TransactionsService.OnTransactionsChanged += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        await TransactionsService.IsReadyTask;

        await base.OnInitializedAsync();
    }

    private async Task AddTransactionAsync()
    {
        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.DisablePayingUserSelection, true }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialogReference =
            await DialogService.ShowAsync<CreateTransactionDialog>("Create a transaction", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<CreateTransactionRequest>();

        if (request is not null)
        {
            await TransactionsService.CreateAsync(request, CancellationToken);
        }
    }

    private async Task EditTransactionAsync(TransactionResponse transaction)
    {
        var parameters = new DialogParameters<UpdateTransactionDialog>
        {
            { x => x.Original, transaction }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<UpdateTransactionDialog>("Edit Transaction", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<JsonPatchDocument<UpdateTransactionRequest>>();

        if (request is not null)
        {
            await TransactionsService.UpdateAsync(transaction, request, CancellationToken);
        }
    }

    private async Task DeleteTransactionAsync(TransactionResponse transaction)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete \"{transaction.Name}\"?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmationDialog>("Delete Transaction", parameters, options);

        var result = await dialogReference.GetReturnValueAsync<bool>();
        
        if (result)
        {
            await TransactionsService.DeleteAsync(transaction, CancellationToken);
        }
    }

    public async ValueTask DisposeAsync()
    {
        TransactionsService.OnTransactionsChanged -= ReRender;
        if (_loadCts is not null) await _loadCts.CancelAsync();
    }

}
