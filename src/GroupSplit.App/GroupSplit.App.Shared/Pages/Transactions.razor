@page "/transactions"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject ITransactionsClient TransactionsClient
@inject IDepartedDeleteGuard DeleteGuard
@inject ITransactionsPageStateService TransactionsService
@inject IGroupsPageStateService GroupsService
@inject IInboxStateService Inbox
@inject ApiErrorPresenter Errors
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject DataChangeNotifier Changes
@inject LocalClock Clock
@implements IAsyncDisposable

@*
    You: your money across every group.

    Was /transactions, titled "Expenses", and the name is what made it read as a duplicate
    of a group's own listing -- two pages called Expenses with near-identical furniture. One
    is a group across people; the other is you across groups, and neither is a subset of the
    other. "You" states the axis and lets a group's tab own the word ledger.

    The three views are the page's title rather than a chip under it, and they are in the
    URL. A filter chip under a heading called "Expenses" is what produced the confusion in
    the first place.

    Two controls, and each one has exactly one place on the page that reports it: the view
    is the heading, the ledger is the eyebrow above it. That is not tidiness. Both used to
    speak through the same words -- a view chip called "Everything you are in" over an
    eyebrow that always read "Across every group", beside a ledger menu whose default was
    "Everything" -- so a reader could not tell which control an answer had come from, and
    the page contradicted itself outright whenever a single group was picked.

    There was a chart here, two lines and the gap between them, captioned "the gap is how
    much you are fronting". It is gone. A settlement is a transfer rather than an expense,
    so the series never held a repayment: the gap ignored every penny anybody had paid
    back, and somebody square with their flatmates still read months of being owed
    hundreds. It is not relabellable -- there is no honest caption for the difference
    between two figures that are both missing the same third one. Where somebody stands is
    the balances, which the home page and the group's own tab already answer.
*@

<PageTitle>@ViewTitle - Group Split</PageTitle>

<div class="gs-page-head">
    <div>
        @* The eyebrow follows the ledger control, because it is the one thing on the page
           that can contradict it. It read "Across every group" whatever was picked, so a
           page narrowed to a single group carried a line saying it was not. *@
        <div class="gs-eyebrow">@WhereEyebrow</div>
        <h1>@ViewTitle</h1>
        <p>@ViewBlurb</p>
    </div>
</div>

<LoadView Skeleton="SkeletonLayout.Activity" Loading="_initializing" Failed="@(_paidSummary is null || _shareSummary is null)" Retry="InitializeAsync">


@* Bank rows are part of Activity's work queue. Keep the existing expense listing intact,
   but make the next decision visible from the same destination instead of sending people
   to a separate top-level Inbox. *@
@if (Inbox.NewCount > 0)
{
    <div class="gs-card gs-card-pad" style="padding: 14px 16px; margin-bottom: 14px">
        <div class="gs-inline" style="justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap">
            <div style="min-width: 220px; flex: 1 1 360px">
                <div class="gs-inline" style="gap: 8px; margin-bottom: 4px">
                    <MudIcon Icon="@Icons.Material.Rounded.Inbox" Color="Color.Primary" Size="Size.Small" aria-hidden="true" />
                    <span style="font-weight: 700">Bank transactions to review</span>
                </div>
                <div class="gs-muted" style="font-size: .8125rem">
                    Imported bank payments waiting for you to match to an expense or record as new.
                </div>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       Class="gs-btn-pill" StartIcon="@Icons.Material.Rounded.Inbox"
                       Href="/transactions/not-filed"
                       aria-label="@NotFiledLabel">
                Review bank transactions (@Inbox.NewCount)
            </MudButton>
        </div>
    </div>
}

<div class="gs-stack">
    <ActivityToolbar FiltersActive="@(IsSearching || _where != AllLedgers)">
        <Segments>
            <div class="gs-ledger-segments gs-chipbar" role="group" aria-label="Whose money">
                @foreach (var (label, detail, value) in Views)
                {
                    var view = value;
                    <button type="button" class="gs-chip @(_view == view ? "active" : "")"
                            title="@detail"
                            aria-pressed="@(_view == view ? "true" : "false")"
                            @onclick="@(() => SetViewAsync(view))">
                        <span class="gs-chip-label">@label</span>
                        <span class="gs-chip-detail gs-sr-only">@detail</span>
                    </button>
                }
            </div>

        </Segments>
        <DateFilter>
            <DateRangeFilter Value="@_range" ValueChanged="OnRangeChangedAsync" />
        </DateFilter>
        <Filters>
            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                     Dense="true" PopoverClass="gs-menu" Class="gs-payer-filter">
                @* See the note in DateRangeFilter: a custom activator has to toggle the menu
                   itself, and one that does not is a button that does nothing. *@
                <ActivatorContent Context="menu">
                    <button type="button" class="gs-ledger-payer"
                            aria-haspopup="listbox"
                            @onclick="@(args => menu.ToggleAsync(args))"
                            aria-label="@($"Which ledger: {WhereLabel}")">
                        <MudIcon Icon="@Icons.Material.Rounded.Groups" Size="Size.Small" />
                        <span class="label">@WhereLabel</span>
                        <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    @* "All groups", not "Everything": that word was also the third view chip's,
                       where it meant something else entirely. *@
                    <MudMenuItem OnClick="@(() => SetWhereAsync(AllLedgers))">
                        <span class="gs-menu-item @(_where == AllLedgers ? "is-on" : "")">All groups</span>
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => SetWhereAsync(SharedOnly))">
                        <span class="gs-menu-item @(_where == SharedOnly ? "is-on" : "")">Shared only</span>
                    </MudMenuItem>
                    @* Personal is the absence of a group, which is why it is an entry here
                       rather than one of the groups below it. *@
                    @if (_view is not ExpenseView.YourShare)
                    {
                        <MudMenuItem OnClick="@(() => SetWhereAsync(PersonalOnly))">
                            <span class="gs-menu-item @(_where == PersonalOnly ? "is-on" : "")">Personal only</span>
                        </MudMenuItem>
                    }
                    @* The personal group is "Personal only" above, so it is not listed again. *@
                    @if (GroupsService.Groups.Any(group => !group.IsPersonal))
                    {
                        <MudDivider />
                        @foreach (var group in GroupsService.Groups.Where(group => !group.IsPersonal))
                        {
                            var id = group.Id.ToString();
                            <MudMenuItem OnClick="@(() => SetWhereAsync(id))">
                                <span class="gs-menu-item @(_where == id ? "is-on" : "")">@group.Name</span>
                            </MudMenuItem>
                        }
                    }
                </ChildContent>
            </MudMenu>

        </Filters>
        <Search>
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search"
                          aria-label="Search by name, category or who paid"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="OnSearchChangedAsync"
                          Clearable="true"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Class="gs-search" />
        </Search>
    </ActivityToolbar>

    <LoadView Loading="_figuresLoading" Skeleton="SkeletonLayout.Summary">
    <div class="gs-mobile-spending" aria-live="polite">
        <span>
            @Count expense@(Count == 1 ? "" : "s") · @TotalLabel: @Total.ToMoney(TotalCurrency)
            <span class="gs-activity-summary-detail">@TotalSub</span>
        </span>
    </div>

    <div class="gs-stats gs-ledger-stats">
        <div class="gs-card gs-stat gs-reveal" style="--i: 0">
            <span class="gs-stat-icon"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
            <span class="gs-eyebrow">@CountLabel</span>
            <span class="gs-stat-value gs-num" data-gs-count="@Count">@Count</span>
            <span class="gs-muted" style="font-size: .8125rem">@Describe()</span>
        </div>
        <div class="gs-card gs-stat gs-reveal" style="--i: 1">
            <span class="gs-stat-icon clay"><MudIcon Icon="@Icons.Material.Rounded.Payments" /></span>
            @* The labels change with the view, because the figures do. "Total paid" over a
               list of other people's expenses would be describing a set nobody asked
               about. *@
            <span class="gs-eyebrow">@TotalLabel</span>
            <Money Value="Total" Currency="@TotalCurrency" Animate Class="gs-stat-value" />
            <span class="gs-muted" style="font-size: .8125rem">@TotalSub</span>
        </div>
    </div>

    </LoadView>

    <div class="gs-reveal gs-ledger-listing" style="--i: 2">
        <ActivityFeed Items="@_mobileEntries" Date="@(entry => entry.DateTime)" Key="@(entry => entry.Id)" Loaded="@_entriesLoaded">
            <EmptyContent>
                <div class="gs-empty" role="status">
                    <MudIcon Icon="@Icons.Material.Rounded.SearchOff" />
                    <h3>@(IsNarrowedByHand ? "Nothing matches" : "Nothing here yet")</h3>
                    <span>@EmptyBlurb</span>
                </div>
            </EmptyContent>
            <ItemTemplate Context="entry">
                <button type="button" class="gs-feed-entry" aria-label="@($"Details for {entry.Name}")"
                        @onclick="@(() => ViewAsync(entry))">
                    <MerchantMark PaidByUserName="@entry.PaidByUserName" MerchantName="@entry.MerchantName" MerchantLogoUrl="@entry.MerchantLogoUrl" />
                    <span class="gs-feed-copy">
                        <strong>@entry.Name</strong>
                        <span class="gs-muted">@PaidBy(entry)@if (Clock.TimeOf(entry.DateTime) is { } time) {<span> · @time.ToString("t")</span>}</span>
                        <span class="gs-muted">@(entry.GroupName ?? "Personal")@if (!string.IsNullOrWhiteSpace(entry.Category)) {<span> · @entry.Category</span>}</span>
                        @if (_view is not ExpenseView.PaidByYou && entry is ExpenseShareResponse share)
                        {
                            <span class="gs-muted">Your share @share.Share.ToMoney(entry.Currency)</span>
                        }
                    </span>
                    <Money Value="entry.Amount" Currency="@entry.Currency" Class="gs-feed-amount" />
                </button>
                @if (CanChange(entry))
                {
                    <MudMenu Icon="@Icons.Material.Rounded.MoreVert" aria-label="@($"Actions for {entry.Name}")" PopoverClass="gs-menu">
                        <MudMenuItem OnClick="@(() => EditAsync(entry))">Edit</MudMenuItem>
                        <MudMenuItem OnClick="@(() => DeleteAsync(entry))">Delete</MudMenuItem>
                    </MudMenu>
                }
            </ItemTemplate>
        </ActivityFeed>
        @* Keyed so a URL arriving from outside -- the nav link back to a bare page --
           rebuilds the grid on the page and sort it asks for: both are only read when a
           grid starts.

           The page size goes before the page, and the order matters: the grid takes its
           first page size by resetting to page one, which undid a page from the URL that
           had already been set. *@
        <MudDataGrid T="TransactionResponse"
                     @key="_gridGeneration"
                     @ref="_grid"
                     ServerData="LoadPageAsync"
                     @bind-RowsPerPage="_pageSize"
                     @bind-CurrentPage="_page"
                     SortMode="SortMode.Single"
                     Hover="true"
                     Bordered="false"
                     Elevation="0"
                     RowClick="@(args => ViewAsync(args.Item))"
                     RowClass="is-openable"
                     Class="gs-grid">
            <Columns>
                <PropertyColumn Property="x => x.DateTime" Title="When" InitialDirection="@Initially("dateTime")">
                    <CellTemplate>
                        <TransactionWhen Value="@context.Item.DateTime"/>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Name" Title="Expense" InitialDirection="@Initially("name")">
                    <CellTemplate>
                        <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap">
                            <MerchantMark PaidByUserName="@context.Item.PaidByUserName"
                                          MerchantName="@context.Item.MerchantName"
                                          MerchantLogoUrl="@context.Item.MerchantLogoUrl" />
                            <div style="min-width: 0">
                                @* A button, not a div. The row opens on a click, and a click
                                   is the one thing a keyboard cannot make here: a grid row
                                   carries no tabindex, so RowClick never hears Enter and the
                                   details dialog would be reachable by pointer alone. *@
                                <button type="button" class="gs-row-open"
                                        @onclick="@(() => ViewAsync(context.Item))"
                                        @onclick:stopPropagation="true">
                                    @context.Item.Name
                                </button>
                                <div class="gs-muted" style="font-size: .75rem">@PaidBy(context.Item)</div>
                            </div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>

                @* The group column earns its width here and only here: this is the listing
                   that spans them. No group renders as Personal -- a missing group is not
                   a missing value. *@
                @* HideSmall: a phone gives every column its own line, and the group and
                   the category are context rather than the point. *@
                <PropertyColumn Property="x => x.GroupName" Title="Group" HideSmall="true" InitialDirection="@Initially("group")">
                    <CellTemplate>
                        <span class="gs-tag neutral">@(context.Item.GroupName ?? "Personal")</span>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Category" Title="Category" HideSmall="true" InitialDirection="@Initially("category")">
                    <CellTemplate>
                        @if (!string.IsNullOrWhiteSpace(context.Item.Category))
                        {
                            <span class="gs-tag">@context.Item.Category</span>
                        }
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Amount" Title="Amount" HeaderClass="gs-right" CellClass="gs-right"
                                InitialDirection="@Initially("amount")">
                    <CellTemplate>
                        @* Under "your share" the share is the sort key and the amount is
                           the context, so the amount is the quieter of the two. *@
                        <Money Value="context.Item.Amount" Currency="@context.Item.Currency"
                               Class="@(_view is ExpenseView.PaidByYou ? "gs-grid-amount" : "gs-grid-share")" />
                    </CellTemplate>
                </PropertyColumn>

                @* Absent under "paid by you": you paid all of it, so a share column there
                   would be the amount repeated beside itself. *@
                @if (_view is not ExpenseView.PaidByYou)
                {
                    <TemplateColumn Title="Your share" SortBy="@(x => (x as ExpenseShareResponse)?.Share ?? 0m)"
                                    HeaderClass="gs-right" CellClass="gs-right" InitialDirection="@Initially("share")">
                        <CellTemplate>
                            @if (context.Item is ExpenseShareResponse row)
                            {
                                <Money Value="row.Share" Currency="@row.Currency" Class="gs-grid-amount" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                }

                @* Titled so the stacked layout a phone falls back to says which row these
                   belong to -- see the note on the ledger's. *@
                @*
                    Every row opens its details when clicked, while edit and delete only
                    appear for expenses in a group the caller still belongs to. The server
                    keeps leaver-owned expenses readable as personal history but refuses
                    writes against their former group, so showing those two controls only
                    teaches the person about the refusal after they click.
                *@
                <TemplateColumn Title="Actions" Sortable="false"
                                HeaderStyle="width: 96px" CellStyle="padding: 8px">
                    <CellTemplate>
                        <div class="gs-row-actions gs-inline" style="gap: 2px; justify-content: flex-end; flex-wrap: nowrap">
                            @* stopPropagation here and not on the container, because the row
                               underneath opens the expense: without it Edit opened the
                               details behind the editor, and with it on the container the
                               whole column swallowed the click that opens the row -- on an
                               expense from a group the caller has left, where nothing is
                               drawn in it at all. *@
                            <span class="gs-inline" style="gap: 2px; flex-wrap: nowrap"
                                  @onclick:stopPropagation="true">
                            @if (CanChange(context.Item))
                            {
                                <MudTooltip Text="Edit" ShowOnFocus="false">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                                   Size="Size.Small"
                                                   aria-label="@($"Edit {context.Item.Name}")"
                                                   OnClick="@(async () => await EditAsync(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete" ShowOnFocus="false">
                                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   aria-label="@($"Delete {context.Item.Name}")"
                                                   OnClick="@(async () => await DeleteAsync(context.Item))" />
                                </MudTooltip>
                            }
                            </span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="gs-empty">
                    <MudIcon Icon="@Icons.Material.Rounded.SearchOff" />
                    @* Turns on what the reader narrowed, not on what the page is narrowed
                       to -- the opening month is the page's own doing, and "Nothing
                       matches" over a filter nobody set tells a brand-new account it has
                       filtered its way into an empty list. *@
                    <h3>@(IsNarrowedByHand ? "Nothing matches" : "Nothing here yet")</h3>
                    @* Says whose rows are missing, not just that rows are. Under "You paid",
                       an empty list means nobody has recorded you paying for anything -- not
                       that the group is empty, which is what it reads as. *@
                    <span>@EmptyBlurb</span>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="TransactionResponse" PageSizeOptions="@(new[] { 10, 25, 50 })" />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

<ExtendedFab Label="Add expense" OnClick="@AddTransactionAsync" />

</LoadView>

@code {
    private string NotFiledLabel => $"Review {Inbox.NewCount} bank transaction{(Inbox.NewCount == 1 ? "" : "s")} waiting to be filed";

    /// <summary>Which of the three questions the page is answering.</summary>
    public enum ExpenseView
    {
        /// <summary>Rows where you are the payer. What the page used to be, and only that.</summary>
        PaidByYou,

        /// <summary>What other people's expenses cost you: shares on rows somebody else paid.</summary>
        YourShare,

        /// <summary>Every expense you have a share of, your own included.</summary>
        Everything
    }

    // Everything the reader can narrow is in the URL, so a refresh or a shared link shows
    // the same rows (#398). Strings rather than typed values: a typed one that does not
    // parse throws, and a mangled link should open the page on its defaults instead.
    [Parameter, SupplyParameterFromQuery(Name = "view")] public string? ViewParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? SearchParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "range")] public string? RangeParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? FromParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? ToParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "ledger")] public string? LedgerParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "page")] public string? PageParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "size")] public string? SizeParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "sort")] public string? SortParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "expense")] public string? ExpenseParameter { get; set; }

    /// <summary>
    /// Compact view labels with accessible descriptions and hover hints.
    /// </summary>
    private static readonly (string Label, string Detail, ExpenseView Value)[] Views =
    [
        ("You paid", "expenses you covered", ExpenseView.PaidByYou),
        ("You owe", "your share of what others paid", ExpenseView.YourShare),
        ("All yours", "your share of every expense", ExpenseView.Everything)
    ];

    /// <summary>
    /// The three answers that are not a group id. Kept as strings so one control can hold
    /// them and a group id in the same field -- which is what stops the two ever
    /// contradicting each other.
    /// </summary>
    private const string AllLedgers = "";
    private const string SharedOnly = "shared";
    private const string PersonalOnly = "personal";

    /// <summary>
    /// "All yours" opens the page: every expense the caller has a share of, their own
    /// included. "You paid" answers a narrower question than most people arrive with --
    /// somebody who is not the household's main payer opened this page and saw almost
    /// nothing, which is the same defect as the CLI's `--group`, one surface along.
    /// </summary>
    private ExpenseView _view = ExpenseView.Everything;
    private string _searchString = "";
    /// <summary>
    /// The span the page opens on: the current month, not all time. An all-time listing
    /// opens on a page of whatever is newest and totals a figure nobody asked about; a
    /// month is the span somebody actually reviews, and the range chip says which one.
    /// </summary>
    /// <remarks>
    /// Named rather than inlined because the empty state has to tell this span apart from
    /// one somebody picked. They can resolve to the same rows -- choosing "This month" off
    /// the menu lands back here -- and that is fine: the same set gets the same sentence.
    /// </remarks>
    private static readonly DateFilter OpensOn = new(DateFilterPreset.ThisMonth);

    private DateFilter _range = OpensOn;
    /// <summary>Which ledger the page is narrowed to: everything, shared, personal, or one group.</summary>
    private string _where = AllLedgers;

    private IReadOnlyList<TransactionResponse> _mobileEntries = [];
    private bool _entriesLoaded;
    private MudDataGrid<TransactionResponse>? _grid;
    private int _gridGeneration;
    private int _page;
    private int _pageSize = ListingQuery.DefaultPageSize;
    private (string Key, bool Descending) _sort = ListingQuery.DefaultSort;

    private TransactionSummaryResponse? _paidSummary;
    private ExpenseShareSummaryResponse? _shareSummary;

    /// <summary>
    /// Counts reads of the figures, so the answer to a narrowing that has since been left
    /// behind cannot land on the cards over the one in force. The group's ledger tab keeps
    /// the same guard, for the same reason.
    /// </summary>
    private int _figuresVersion;

    private bool IsSearching => !string.IsNullOrWhiteSpace(_searchString);

    private bool IsNarrowed => IsSearching || !_range.IsAllTime || _where != AllLedgers;

    /// <summary>
    /// Whether the reader narrowed this, as opposed to the page opening narrowed.
    /// </summary>
    /// <remarks>
    /// <see cref="IsNarrowed"/> asks whether the listing is a slice, which it is from the
    /// first frame now that the range starts at the current month -- so a heading keyed on
    /// it says "Nothing matches" to somebody who has touched nothing. This asks the other
    /// question: did anybody ask for this slice? The opening month does not count, and
    /// neither does all time, which is the widest the page goes rather than a narrowing.
    /// </remarks>
    private bool IsNarrowedByHand =>
        IsSearching || _where != AllLedgers || (!_range.IsAllTime && _range != OpensOn);

    /// <summary>The chosen group, when the choice is a group at all.</summary>
    private Guid? _groupId => Guid.TryParse(_where, out var id) ? id : null;

    /// <summary>
    /// Null keeps both, true keeps the expenses in the personal group, false keeps the ones
    /// in a shared group. Choosing a single group leaves it null: the group id has already said it.
    /// </summary>
    private bool? _personal => _where switch
    {
        PersonalOnly => true,
        SharedOnly => false,
        _ => null
    };

    private string? Search => IsSearching ? _searchString.Trim() : null;

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private Guid? Me => UserInfo?.Id;

    /// <summary>
    /// Whether this expense still belongs to a group the caller is in. Historical expenses
    /// remain readable after leaving, but the API refuses edits and deletes in that group.
    /// Keep the details action for that history and remove only the two controls that cannot
    /// succeed.
    /// </summary>
    private bool CanChange(TransactionResponse row) =>
        row.GroupId is null || GroupsService.Groups.Any(group => group.Id == row.GroupId);

    // ---------------------------------------------------------------- wording --

    private string ViewTitle => _view switch
    {
        ExpenseView.YourShare => "What you owe",
        ExpenseView.Everything => "All yours",
        _ => "What you paid"
    };

    /// <summary>
    /// One sentence, and it has to name the difference from the chip beside it.
    /// </summary>
    /// <remarks>
    /// The old blurbs each described their own view truthfully and none of them said what
    /// set it apart from its neighbour -- which is the only thing somebody choosing between
    /// two of them needs to read.
    /// <para>
    /// Kept to two clauses, because below 560px the chips drop their own detail lines and
    /// this is the only thing left explaining the difference. Four lines of it pushed the
    /// figures off a phone screen; what went was everything that was true of all three
    /// views -- the sort order, the paging -- and what stayed is the contrast.
    /// </para>
    /// </remarks>
    private string ViewBlurb => _view switch
    {
        ExpenseView.YourShare =>
            "Your share of expenses somebody else paid for. Your share of your own is left "
            + "out — that is money you already have.",
        ExpenseView.Everything =>
            "Your share of every expense you are in, your own included. Wider than what you "
            + "owe, and not a debt.",
        _ => "Expenses you paid for, whoever owes a share of them. What each one actually "
             + "cost you is under \"You owe\"."
    };

    /// <summary>
    /// The line above the heading. It reports the ledger rather than the view, so each of
    /// the two controls has exactly one place on the page that speaks for it.
    /// </summary>
    private string WhereEyebrow => _where switch
    {
        SharedOnly => "Shared expenses only",
        PersonalOnly => "Personal expenses only",
        AllLedgers => "Across every group",
        _ => _groupId is { } id ? GroupName(id) : "Across every group"
    };

    private string CountLabel => _view is ExpenseView.PaidByYou ? "Expenses you paid" : "Expenses you are in";

    /// <summary>
    /// What an empty list means, which is never simply "there is nothing".
    /// </summary>
    /// <remarks>
    /// Every view here is narrowed to the caller, and an empty answer under a narrowing
    /// nobody has restated reads as an empty world: the same mistake the CLI made when
    /// <c>--group</c> narrowed to the payer and a group of 1,411 expenses reported 2. When
    /// one group is picked the group's own ledger is where the whole of it is, so that is
    /// what this points at.
    /// </remarks>
    private string EmptyBlurb => (IsNarrowed, _view) switch
    {
        (true, _) when _groupId is { } id =>
            $"Nothing of yours in {GroupName(id)}{ForSpan}. The whole of what this group "
            + "has spent, whoever paid for it, is on the group's own ledger.",
        // The page opens on the current month, so this is the *default* empty state rather
        // than one somebody filtered their way into: it has to name the span and say how to
        // leave it, or a quiet month reads as an empty account. Only for the opening month,
        // though -- pointing at "All time" from a span somebody chose themselves is advice
        // about a control they have already found.
        (true, _) when !IsSearching && _where == AllLedgers && _range == OpensOn =>
            $"Nothing for {Span}. This page opens on the current month — pick "
            + "\"All time\" to see everything.",
        (true, _) => $"Nothing{ForSpan} matches. Try a different name, group, category or date.",
        (false, ExpenseView.PaidByYou) =>
            "Nothing recorded with you as the payer yet. Expenses somebody else paid for are "
            + "under \"You owe\".",
        _ => "Nothing you have a share of yet. Record an expense and it will show up here."
    };

    /// <summary>The span in words, for a sentence rather than a chip.</summary>
    private string Span => _range.IsAllTime ? "all time" : _range.Label.ToLowerInvariant();

    /// <summary>
    /// The span to hang on the end of a clause, or nothing at all when there is no span to
    /// name. "Nothing for all time matches" is not a sentence anybody writes; the sentence
    /// somebody writes about that set is "Nothing matches".
    /// </summary>
    private string ForSpan => _range.IsAllTime ? "" : $" for {Span}";

    private string TotalLabel => _view switch
    {
        ExpenseView.YourShare => "You owe",
        ExpenseView.Everything => "Your share",
        _ => "You paid"
    };

    private int Count => _view is ExpenseView.PaidByYou
        ? _paidSummary?.Count ?? 0
        : _shareSummary?.Count ?? 0;

    private decimal Total => _view switch
    {
        ExpenseView.YourShare => _shareSummary?.OwedToOthers ?? 0m,
        ExpenseView.Everything => _shareSummary?.Share ?? 0m,
        _ => _paidSummary?.Total ?? 0m
    };

    /// <summary>
    /// What the total is a part of. Under the two share views the money that moved is the
    /// larger figure and the caller's part of it is the smaller, and saying only one of
    /// them is what makes a share listing read as a spending listing.
    /// </summary>
    private string TotalSub => (_view is ExpenseView.PaidByYou
        ? "across every group"
        : $"of {(_shareSummary?.Total ?? 0m).ToMoney(TotalCurrency)} spent around you") + OtherCurrencies;

    /// <summary>The currency the total figure is in, which the API chooses.</summary>
    private string TotalCurrency => _view is ExpenseView.PaidByYou
        ? _paidSummary?.Currency ?? "USD"
        : _shareSummary?.Currency ?? "USD";

    /// <summary>
    /// What matched in any other currency, said beside the total and never added into it.
    /// </summary>
    /// <remarks>
    /// A personal expense can be in any currency and a total is in one, because there is
    /// no rate to add euros to dollars with. Leaving them out without a word would make the
    /// figure read as everything the list holds, so they are named -- the same figure the
    /// view is showing, in each of them.
    /// </remarks>
    private string OtherCurrencies
    {
        get
        {
            var others = _view switch
            {
                ExpenseView.YourShare => _shareSummary?.OtherCurrencies
                    .Where(other => other.OwedToOthers != 0m)
                    .Select(other => other.OwedToOthers.ToMoney(other.Currency)),
                ExpenseView.Everything => _shareSummary?.OtherCurrencies
                    .Select(other => other.Share.ToMoney(other.Currency)),
                _ => _paidSummary?.OtherCurrencies
                    .Select(other => other.Total.ToMoney(other.Currency))
            };

            var said = others?.ToList() ?? [];

            return said.Count == 0 ? "" : $", plus {string.Join(" and ", said)} not in this total";
        }
    }

    /// <summary>What the one ledger control currently says, as the button reads it.</summary>
    private string WhereLabel => _where switch
    {
        SharedOnly => "Shared only",
        PersonalOnly => "Personal only",
        AllLedgers => "All groups",
        _ => _groupId is { } id ? GroupName(id) : "All groups"
    };

    private string Describe()
    {
        var said = new List<string>(3)
        {
            _range.IsAllTime ? "all time" : _range.Label.ToLowerInvariant(),
            WhereLabel.ToLowerInvariant()
        };

        if (IsSearching)
            said.Add("matching your search");

        return string.Join(" · ", said);
    }

    private string GroupName(Guid id) =>
        GroupsService.Groups.FirstOrDefault(group => group.Id == id)?.Name ?? "one group";

    private string PaidBy(TransactionResponse row) =>
        row is ExpenseShareResponse { PaidByYou: true } || row.PaidByUserId == Me
            ? "You paid"
            : $"{row.PaidByUserName} paid";

    @* Whether the row was the caller's to change used to be worked out here, off the share
       flag or the payer. It is not the question the API asks -- membership of the group is
       -- so the rows it hid the buttons on were rows the server would have accepted. *@

    // ---------------------------------------------------------------- reading --

    private async Task<GridData<TransactionResponse>> LoadPageAsync(
        GridState<TransactionResponse> state, CancellationToken cancellationToken)
    {
        var sort = state.SortDefinitions.FirstOrDefault();

        await ForgetUnknownGroupAsync();

        // Every narrowing ends up here -- a filter goes back to the first page and reloads,
        // and the pager and the headers reload by themselves -- so this is where the URL
        // catches up with what the reader is looking at.
        _sort = sort is null ? ListingQuery.DefaultSort : (SortKey(sort), sort.Descending);
        WriteUrl();

        var bounds = _range.Bounds(Clock.Offset, Clock.Today);

        // Two listings behind three views: the expenses where you are the payer, and the
        // shares. Both answer with a page of rows the grid can hold, because a share row
        // *is* an expense row with the caller's part of it attached.
        var page = await ReadPageAsync(bounds, SortKey(sort), sort?.Descending ?? true,
            state.Page + 1, state.PageSize, cancellationToken);

        cancellationToken.ThrowIfCancellationRequested();
        _mobileEntries = page?.Items ?? [];
        _entriesLoaded = true;
        await InvokeAsync(StateHasChanged);
        return new GridData<TransactionResponse>
        {
            Items = _mobileEntries,
            TotalItems = page?.TotalCount ?? 0
        };
    }

    /// <summary>One page of a listing: its rows as the grid holds them, and how many there are.</summary>
    /// <remarks>
    /// The rows rather than the page object, because <c>PagedResponse&lt;T&gt;</c> is not
    /// covariant: a page of shares is not a page of expenses to the compiler, even though a
    /// share row is an expense row with the caller's part of it attached.
    /// </remarks>
    private readonly record struct Rows(IReadOnlyList<TransactionResponse> Items, int TotalCount);

    /// <summary>
    /// One page of whichever listing the view is showing.
    /// </summary>
    private async Task<Rows?> ReadPageAsync(
        DateBounds bounds, string sortBy, bool descending, int page, int pageSize,
        CancellationToken cancellationToken)
    {
        if (_view is ExpenseView.PaidByYou)
        {
            var paid = await ReadAsync(() => TransactionsClient.GetTransactionsAsync(
                from: bounds.From, to: bounds.To, groupId: _groupId, personal: _personal, search: Search,
                sortBy: sortBy, sortDescending: descending,
                page: page, pageSize: pageSize, cancellationToken: cancellationToken));

            return paid is null ? null : new Rows(paid.Items, paid.TotalCount);
        }

        var shares = await ReadAsync(() => TransactionsClient.GetTransactionSharesAsync(
            from: bounds.From, to: bounds.To, groupId: _groupId, personal: _personal, search: Search,
            sortBy: sortBy, sortDescending: descending,
            page: page, pageSize: pageSize,
            owedOnly: _view is ExpenseView.YourShare, cancellationToken: cancellationToken));

        return shares is null ? null : new Rows([.. shares.Items], shares.TotalCount);
    }

    /// <summary>
    /// The grid's sort key, or the view's own default. Under "your share" the default is
    /// the share itself: the whole point of that view is which of other people's expenses
    /// cost you the most.
    /// </summary>
    private string SortKey(SortDefinition<TransactionResponse>? sort) => sort switch
    {
        null => _view is ExpenseView.YourShare ? "share" : "dateTime",
        // The grid names a share column after the expression it sorts by, which is not a
        // key the server knows.
        { SortBy: var by } when by.Contains("Share", StringComparison.Ordinal) => "share",
        { SortBy: "GroupName" } => "group",
        { SortBy: var by } => Camel(by)
    };

    private static string Camel(string name) =>
        string.IsNullOrEmpty(name) ? name : char.ToLowerInvariant(name[0]) + name[1..];

    private async Task<T?> ReadAsync<T>(Func<Task<T>> read) where T : class
    {
        T? result = null;
        await Errors.TryAsync(async () => result = await read(), "Could not load your expenses.");
        return result;
    }

    /// <summary>
    /// The figures, over whatever the page is narrowed to. Both summaries are read
    /// whichever view is on, because the labels change with the view but the narrowing
    /// does not -- and switching view would otherwise show yesterday's figures for a frame.
    /// </summary>
    /// <remarks>
    /// There used to be a third read here, for a two-line chart of what the caller paid
    /// against what their share came to, captioned "the gap is how much you are fronting".
    /// The gap is not that: a settlement is a transfer rather than an expense, so the
    /// series never contained a repayment, and somebody who had settled up in full still
    /// read months of being owed hundreds. The chart is gone rather than relabelled --
    /// there is no honest caption for a difference between two numbers that are both
    /// missing the same third one. Where somebody stands is the balances, which the home
    /// page and the group's own tab already show.
    /// </remarks>
    private bool _figuresLoading;

    private async Task ReadFiguresAsync()
    {
        var version = ++_figuresVersion;
        _figuresLoading = true;
        await InvokeAsync(StateHasChanged);

        await ForgetUnknownGroupAsync();

        // Read once, here: both requests below have to describe one narrowing, and the
        // fields can move while they are in flight.
        var bounds = _range.Bounds(Clock.Offset, Clock.Today);
        var groupId = _groupId;
        var personal = _personal;
        var search = Search;
        var owedOnly = _view is ExpenseView.YourShare;

        var paid = await ReadAsync(() => TransactionsClient.GetTransactionsSummaryAsync(
            from: bounds.From, to: bounds.To, groupId: groupId, personal: personal, search: search));

        var shares = await ReadAsync(() => TransactionsClient.GetTransactionSharesSummaryAsync(
            from: bounds.From, to: bounds.To, groupId: groupId, personal: personal, search: search,
            owedOnly: owedOnly));

        // Something else has been asked for since. Its answer is the one the cards are
        // waiting for; this one is about a narrowing nobody is looking at any more.
        if (version != _figuresVersion)
            return;

        _figuresLoading = false;
        _paidSummary = paid;
        _shareSummary = shares;

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// A group from the URL that the reader is not in reads as every group, rather than as a
    /// request the server refuses. Waits for the groups, because both reads can start before
    /// they are in.
    /// </summary>
    private async Task ForgetUnknownGroupAsync()
    {
        await GroupsService.IsReadyTask;

        if (_groupId is { } id && GroupsService.Groups.All(group => group.Id != id))
            _where = AllLedgers;
    }

    // ---------------------------------------------------------------- filters --

    private async Task SetViewAsync(ExpenseView view)
    {
        if (_view == view) return;

        _view = view;

        // A personal expense has no other party to owe you. Keep the ledger selector and
        // the view answering a question that can actually have rows together.
        if (_view is ExpenseView.YourShare && _where == PersonalOnly)
            _where = AllLedgers;

        // In the URL, so a view is a place.
        WriteUrl();

        await ReadFiguresAsync();
        await BackToFirstPageAsync();
    }

    private async Task OnSearchChangedAsync(string _)
    {
        await ReadFiguresAsync();
        await BackToFirstPageAsync();
    }

    private async Task OnRangeChangedAsync(DateFilter range)
    {
        _range = range;
        await ReadFiguresAsync();
        await BackToFirstPageAsync();
    }

    /// <summary>
    /// Everything, shared, personal, or one group -- one field, so there is no second
    /// control to contradict and nothing to quietly turn off.
    /// </summary>
    /// <summary>
    /// Which ledger, as the menu sets it. Public so a test can drive it: the menu's items
    /// render into a Mud popover, outside the tree a component test puts on the page.
    /// </summary>
    public Task SetLedger(string where) => SetWhereAsync(where);

    private async Task SetWhereAsync(string where)
    {
        if (_view is ExpenseView.YourShare && where == PersonalOnly)
            return;

        if (_where == where) return;

        _where = where;

        await ReadFiguresAsync();
        await BackToFirstPageAsync();
    }

    private Task BackToFirstPageAsync()
    {
        if (_grid is null) return Task.CompletedTask;

        _grid.NavigateTo(MudBlazor.Page.First);
        return _grid.ReloadServerData();
    }

    // ---------------------------------------------------------------- writing --

    /// <summary>
    /// The one expense, and how it was divided. Reached by clicking its row.
    /// </summary>
    /// <remarks>
    /// Read-only, so nothing is announced when it closes and the grid is left alone. The
    /// dialog reads the expense itself rather than being handed this row: a listing row
    /// carries no splits, and the split is most of what somebody opens this for.
    /// <para>
    /// It was an eye in the actions column, which was the only way in and made opening an
    /// expense look like one more thing to do to it. The row is the way in now, as it is
    /// in the home page's lists.
    /// </para>
    /// </remarks>
    private Task ViewAsync(TransactionResponse row) => ShowExpenseAsync(row.Id);

    /// <summary>The expense whose details are open, which the URL names so it can be linked to.</summary>
    private Guid? _expense;

    private bool _showingExpense;

    /// <summary>
    /// Opens an expense's details and names it in the URL until they close, so a refresh
    /// keeps it open and the address can be sent to somebody.
    /// </summary>
    private async Task ShowExpenseAsync(Guid id)
    {
        _showingExpense = true;
        _expense = id;
        WriteUrl();

        var parameters = new DialogParameters<TransactionDetailsDialog> { { x => x.TransactionId, id } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        IDialogReference dialog;

        try
        {
            dialog = await DialogService.ShowAsync<TransactionDetailsDialog>("Transaction Details", parameters, options);
        }
        catch
        {
            ForgetExpense();
            throw;
        }

        // Not awaited: the click that opened it would stay unfinished for as long as the
        // details are open.
        _ = ForgetExpenseWhenClosedAsync(dialog);
    }

    private async Task ForgetExpenseWhenClosedAsync(IDialogReference dialog)
    {
        await dialog.Result;
        await InvokeAsync(ForgetExpense);
    }

    private void ForgetExpense()
    {
        _showingExpense = false;
        _expense = null;
        WriteUrl();
    }

    /// <summary>
    /// An expense named in the URL is opened once the page is interactive: a dialog needs a
    /// live page to open on, which a prerender is not.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_expense is { } id && !_showingExpense)
            await ShowExpenseAsync(id);
    }

    private async Task EditAsync(TransactionResponse row)
    {
        var parameters = new DialogParameters<UpdateTransactionDialog> { { x => x.Original, row } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<UpdateTransactionDialog>("Edit Transaction", parameters, options);

        var request = await dialog.GetReturnValueAsync<JsonPatchDocument<UpdateTransactionRequest>>();

        if (request is not null)
            await TransactionsService.UpdateAsync(row, request);
    }

    private async Task DeleteAsync(TransactionResponse row)
    {
        // Somebody on it has left the group, so the server would refuse: say why instead of
        // asking. See GroupLedgerTab, which does the same for a group's own list.
        if (await DeleteGuard.FirstLeaverOnAsync(row.Id, row.GroupId) is { } leaver)
        {
            await DialogService.ShowDepartedNoticeAsync(
                leaver, row.Kind is ActivityKind.Transfer ? "settlement" : "expense");

            return;
        }

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete \"{row.Name}\"?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete Transaction", parameters, options);

        if (await dialog.ConfirmedAsync())
            await TransactionsService.DeleteAsync(row);
    }

    private async Task AddTransactionAsync()
    {
        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.DisablePayingUserSelection, true }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<CreateTransactionDialog>("Add an expense", parameters, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled)
            return;

        if (result.Data is CreateTransactionDialog.Answer withReceipt)
        {
            await TransactionsService.CreateWithReceiptAsync(
                withReceipt.Request, withReceipt.File, withReceipt.Receipt, CancellationToken);
        }
        else if (result.Data is CreateTransactionRequest request)
        {
            await TransactionsService.CreateAsync(request, CancellationToken);
        }
    }

    // ---------------------------------------------------------------- plumbing --

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    /// <summary>
    /// A write landed, from this page or any other. The figures are this page's own read
    /// and the grid asks the server for its rows, so neither moves on a re-render alone:
    /// both are asked again.
    /// </summary>
    /// <remarks>
    /// This was written and never wired up. The page re-rendered when the state service
    /// announced, and a re-render of a grid fed by <c>ServerData</c> shows the rows it
    /// already has -- so an expense added from the button on this page did not appear in
    /// the list under it, and the count above stayed where it was, until the page was
    /// opened again.
    /// </remarks>
    private async Task OnDataChangedAsync()
    {
        await ReadFiguresAsync();

        if (_grid is not null)
            await InvokeAsync(() => _grid.ReloadServerData());
    }

    private void ReRender() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();

        Apply(Asked);

        TransactionsService.OnTransactionsChanged += ReRender;
        GroupsService.OnGroupsChanged += ReRender;
        Inbox.OnChanged += ReRender;

        // A group renamed changes the tag on every one of its rows, so that is a change to
        // this listing as much as an expense is.
        Changes.TransactionsChanged += OnDataChangedAsync;
        Changes.GroupsChanged += OnDataChangedAsync;
    }

    /// <summary>The page's narrowing as it is spelled in the query string.</summary>
    private sealed record Query(string? View, string? Search, string? Range, string? From, string? To,
        string? Ledger, string? Page, string? Size, string? Sort, string? Expense);

    /// <summary>
    /// The query this page last read or wrote. A parameter set that brings the same one back
    /// is the echo of the page's own write, and is not applied: what is typed in the search
    /// box between a keystroke and its debounce would be overwritten by it.
    /// </summary>
    private Query? _settled;

    private Query Asked => new(ViewParameter, SearchParameter, RangeParameter, FromParameter, ToParameter,
        LedgerParameter, PageParameter, SizeParameter, SortParameter, ExpenseParameter);

    /// <summary>
    /// What is on the page, spelled for the URL. Whatever the page opens on is left out, so
    /// an untouched page has no query string at all.
    /// </summary>
    private Query Current
    {
        get
        {
            var (range, from, to) = ListingQuery.FormatRange(_range, OpensOn);

            return new Query(
                _view switch
                {
                    ExpenseView.YourShare => "share",
                    ExpenseView.PaidByYou => "paid",
                    _ => null
                },
                Search, range, from, to,
                _where == AllLedgers ? null : _where,
                ListingQuery.FormatPage(_page),
                ListingQuery.FormatPageSize(_pageSize),
                ListingQuery.FormatSort(_sort),
                _expense?.ToString());
        }
    }

    /// <summary>
    /// Puts what is on the page into the URL. Replacing rather than pushing keeps the back
    /// button leaving the page instead of stepping back through every chip and keystroke.
    /// </summary>
    private void WriteUrl()
    {
        var query = Current;

        // Gone already: an expense's details can close after its page has been left, and
        // writing then would put this page's query on whatever page is open now.
        if (query == _settled || CancellationToken.IsCancellationRequested)
            return;

        _settled = query;

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["view"] = query.View,
            ["q"] = query.Search,
            ["range"] = query.Range,
            ["from"] = query.From,
            ["to"] = query.To,
            ["ledger"] = query.Ledger,
            ["page"] = query.Page,
            ["size"] = query.Size,
            ["sort"] = query.Sort,
            ["expense"] = query.Expense
        }), replace: true);
    }

    /// <summary>
    /// The view the URL asks for, or the default for anything it does not recognise. A stale
    /// bookmark is not a reason to answer nothing.
    /// </summary>
    /// <remarks>
    /// Read in <c>OnInitialized</c> rather than only on a parameter set, because the first
    /// read happens in <c>OnInitializedAsync</c> -- which runs before
    /// <c>OnParametersSet</c>. Reading it only there meant arriving straight at
    /// <c>?view=share</c> asked the server the default view's question and then rendered the
    /// answer under the share view's headings.
    /// </remarks>
    private void Apply(Query query)
    {
        _settled = query;

        _view = query.View?.ToLowerInvariant() switch
        {
            "share" or "yourshare" => ExpenseView.YourShare,
            "paid" or "paidbyyou" => ExpenseView.PaidByYou,
            // "everything" is what the default used to be reached by. Still honoured, and
            // still lands on the same view, so an old bookmark keeps working.
            _ => ExpenseView.Everything
        };

        _searchString = query.Search ?? "";
        _range = ListingQuery.ParseRange(query.Range, query.From, query.To, OpensOn);

        // A group id is checked against the reader's groups once they are in -- see
        // LoadPageAsync. Here it only has to be one.
        _where = query.Ledger?.ToLowerInvariant() switch
        {
            SharedOnly => SharedOnly,
            PersonalOnly => PersonalOnly,
            var other => Guid.TryParse(other, out var id) ? id.ToString() : AllLedgers
        };

        if (_view is ExpenseView.YourShare && _where == PersonalOnly)
            _where = AllLedgers;

        _page = ListingQuery.ParsePage(query.Page);
        _pageSize = ListingQuery.ParsePageSize(query.Size);
        _sort = ListingQuery.ParseSort(query.Sort, "dateTime", "name", "group", "category", "amount", "share");
        _expense = Guid.TryParse(query.Expense, out var expense) ? expense : null;
    }

    /// <summary>
    /// The direction a column starts sorted in: the one the URL asked for, or none. Only read
    /// when the grid starts, which is why the grid is rebuilt when a new URL arrives.
    /// </summary>
    private SortDirection Initially(string key) => _sort.Key != key
        ? SortDirection.None
        : _sort.Descending ? SortDirection.Descending : SortDirection.Ascending;

    /// <summary>
    /// A URL the page did not write -- the nav link back to a bare /transactions, say --
    /// replaces everything on it, and the figures and the rows are read again.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Asked == _settled)
            return;

        Apply(Asked);
        _gridGeneration++;

        await ReadFiguresAsync();
    }

    private bool _initializing = true;

    protected override Task OnInitializedAsync() => InitializeAsync();

    private async Task InitializeAsync()
    {
        _initializing = true;
        try
        {
            // The group filter lists the caller's groups, so the page waits for them before
            // reading anything -- a select with no options and a chip that says "all groups"
            // are the same picture for a moment otherwise.
            await Task.WhenAll(GroupsService.IsReadyTask, Inbox.EnsureLoadedAsync());

            await ReadFiguresAsync();
        }
        finally { _initializing = false; }
    }

    public async ValueTask DisposeAsync()
    {
        TransactionsService.OnTransactionsChanged -= ReRender;
        GroupsService.OnGroupsChanged -= ReRender;
        Inbox.OnChanged -= ReRender;

        Changes.TransactionsChanged -= OnDataChangedAsync;
        Changes.GroupsChanged -= OnDataChangedAsync;

        if (_loadCts is not null) await _loadCts.CancelAsync();
    }
}
