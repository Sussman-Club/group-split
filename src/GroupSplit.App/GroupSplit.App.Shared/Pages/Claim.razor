@page "/claim/{Token}"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@attribute [AllowAnonymous]
@inject IInvitationsClient Invitations
@inject IGroupCommands GroupCommands
@inject ApiErrorPresenter Errors
@inject IDialogService DialogService
@inject NavigationManager Nav

@*
    Where a guest's link lands.

    The difference from /join is what is on the other end of the button. That one lets
    somebody into a group as themselves, claiming nothing. This one hands them a position:
    the group has been keeping track of somebody as a guest, and whoever claims the link
    takes that guest's place -- their shares, what they paid, their places in split rules.
    So the page says whose place it is before anybody presses anything, and the link works
    once.

    Anonymous, because the person following one very often has no account yet -- that is
    the case guests' links exist for. Signing in is a round trip through the identity
    provider, so the URL they were going to is handed along as returnUrl and they come back
    here rather than to the home page, with the link still in hand.

    Every state wears the same card, so the page does not change shape as it resolves: one
    surface whose heading and body swap, rather than five different-looking screens.
*@

<PageTitle>@Loc["Join a group - Group Split"]</PageTitle>

@if (UserInfo is null)
{
    <AuthHandoff Title="@Loc["Someone sent you a link to a group"]"
                 Subtitle="@Loc["Sign in, or create an account, and we will bring you straight back here."]"
                 ActionLabel="@Loc["Continue"]" ReturnUrl="@($"/claim/{Token}")" />
}
else if (_loading)
{
    <LinkLanding Title="@Loc["Someone sent you a link to a group"]">
        <div class="gs-inline gs-muted" style="font-size: .875rem; padding: 4px 0">
            <MudProgressCircular Color="Color.Primary" Indeterminate Size="Size.Small" />
            <span>@Loc["Looking up the link…"]</span>
        </div>
    </LinkLanding>
}
else if (_declined is { } declined)
{
    @* The answer to "this isn't me", on the page rather than only in a snackbar: it is the
       last thing this person will see of the group, and the part worth leaving them with
       is that nothing happened to anybody -- the guest is still there, only the link is
       gone. *@
    <LinkLanding Title="@Loc["This link no longer works"]"
                 Subtitle="@(Loc["{0} still has {1} as a guest. Nothing recorded for them has changed.", declined.GroupName, declined.Name].Value)">
        <MudButton Variant="Variant.Text" Href="/"
                   StartIcon="@Icons.Material.Rounded.ArrowBack">@Loc["Back home"]</MudButton>
    </LinkLanding>
}
else if (_error is not null)
{
    @* Most often: somebody has already claimed it, a member stopped it, or it ran out. A
       guest's link works once and for a month, so a forwarded copy of one, or one found in
       an old chat, lands here -- and the message names each of those rather than implying
       the URL was mistyped. The API cannot say which: all of them are the same 404, so as
       not to tell whoever holds a link that it used to be good. *@
    <LinkLanding Title="@Loc["This link no longer works"]" Subtitle="@_error">
        <MudButton Variant="Variant.Text" Href="/"
                   StartIcon="@Icons.Material.Rounded.ArrowBack">@Loc["Back home"]</MudButton>
    </LinkLanding>
}
else if (_invitation is { } invitation)
{
    <LinkLanding Title="@invitation.GroupName" Subtitle="@Asked(invitation)">
        @* Said plainly, because it is the whole difference between this and a join link:
           somebody may be taking on months of shares. The amounts are deliberately not
           here -- the link can be forwarded, and what the group has recorded is theirs
           until this is claimed -- and the app says what moved the moment it is. *@
        @if (invitation.AlreadyAMember)
        {
            @* A member opening a guest's link, most often to check it works before sending
               it. Claiming is still allowed -- the group may have added them as a guest by
               mistake -- but it merges two people's money into one, so the page says that
               plainly and the button asks again before doing it. *@
            <MudAlert Severity="Severity.Warning" Dense="true" Class="w-100" Style="text-align: left">
                @MergeWarning(invitation)
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="w-100" Style="text-align: left">@Loc["{0} No amounts change: what was recorded for {1} simply becomes yours.", Sent(invitation), invitation.Name].Value</MudAlert>
        }

        <div class="gs-link-landing-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill"
                       FullWidth Size="Size.Large"
                       EndIcon="@Icons.Material.Rounded.ArrowForward"
                       Disabled="@_busy"
                       OnClick="@ClaimAsync">
                @(invitation.AlreadyAMember
                    ? Loc["This is me: merge {0} into my account", invitation.Name].Value
                    : Loc["Join as {0}", invitation.Name].Value)
            </MudButton>

            @if (invitation.AlreadyAMember)
            {
                @* Not "This isn't me" for a member. Declining stops the link, and a member
                   here is almost always checking a link a member made on purpose -- for
                   them the way out has to leave it working, or checking the link would be
                   what broke it. *@
                <MudButton Variant="Variant.Text" FullWidth Disabled="@_busy"
                           Href="@($"/groups/{invitation.GroupId}")">@Loc["Back to {0}", invitation.GroupName].Value</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" FullWidth Disabled="@_busy" OnClick="@DeclineAsync">@Loc["This isn't me"]</MudButton>
            }
        </div>
    </LinkLanding>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private InvitationClaimResponse? _invitation;
    private string? _error;
    private bool _loading;
    private bool _busy;

    /// <summary>
    /// The link this person just said was not for them, kept so the page can say what
    /// became of the guest once the link itself has stopped answering.
    /// </summary>
    private InvitationClaimResponse? _declined;

    /// <summary>The token the state below belongs to, so it is not re-read on every render.</summary>
    private string? _resolved;

    /// <summary>
    /// On every parameter set rather than only on initialise, because signing in is the
    /// step in the middle: the person arrives here with no account, comes back with one,
    /// and it is the cascading user changing that has to send this looking.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (UserInfo is null || _loading || _resolved == Token)
            return;

        _loading = true;
        _error = null;
        _declined = null;

        var failure = await Errors.CaptureAsync(async () =>
            _invitation = await Invitations.GetInvitationClaimAsync(Token));

        // Shown on the page rather than in a snackbar: this is the only thing on the page,
        // and a message that scrolls away would leave nothing behind it.
        if (failure is not null)
        {
            _invitation = null;
            _error = failure.Message;
        }

        _resolved = Token;
        _loading = false;
    }

    /// <summary>
    /// What the group has been doing and what claiming does, which is what somebody needs
    /// before they agree to it.
    /// </summary>
    private string Asked(InvitationClaimResponse invitation) =>
        invitation.AlreadyAMember
            ? Loc["You are already in {0}. This link is for {1}, a guest.", invitation.GroupName, invitation.Name].Value
            : Loc["{0} has been keeping track of {1} as a guest. ", invitation.GroupName, invitation.Name].Value +
              Loc["Join to take over: everything recorded for {0} becomes yours.", invitation.Name].Value;

    /// <summary>
    /// Who sent it, and how many people are on the other side. The sender is nullable -- an
    /// account that has since been deleted leaves its links behind -- so the sentence is
    /// built rather than interpolated blind.
    /// </summary>
    private string Sent(InvitationClaimResponse invitation) =>
        string.IsNullOrWhiteSpace(invitation.InvitedByUserName)
            ? Loc["{0} already.", Members(invitation.MemberCount)].Value
            : Loc["{0} sent you this link. {1} already.", invitation.InvitedByUserName, Members(invitation.MemberCount)].Value;

    /// <summary>
    /// What claiming does to somebody who is already a member, said before the button: it is
    /// the one claim that changes an existing balance. The confirmation after it asks rather
    /// than repeating this.
    /// </summary>
    private string MergeWarning(InvitationClaimResponse invitation) =>
        ParticipantCopy.MergeWarning(invitation.Name);

    private async Task ClaimAsync()
    {
        if (_invitation is null) return;

        if (_invitation.AlreadyAMember && !await ConfirmMergeAsync(_invitation))
            return;

        _busy = true;

        var claimed = await GroupCommands.ClaimInvitationAsync(Token);

        _busy = false;

        if (claimed is not null)
            Nav.NavigateTo($"/groups/{claimed.GroupId}");
    }

    /// <summary>
    /// Saying the link is not for this person, which is a real answer and not only a way off
    /// the page: it stops the link, so whoever forwarded it to the wrong chat finds out the
    /// next time they look, and nobody else can take the guest's place with it.
    /// </summary>
    /// <remarks>
    /// The guest is untouched. Declining used to hand their position to a member of the
    /// group; now it only ends the link, and the page says so before leaving them to it.
    /// </remarks>
    private async Task DeclineAsync()
    {
        if (_invitation is not { } invitation) return;

        _busy = true;

        var declined = await GroupCommands.DeclineInvitationAsync(Token, invitation.GroupName);

        _busy = false;

        if (declined)
            _declined = invitation;
    }

    private async Task<bool> ConfirmMergeAsync(InvitationClaimResponse invitation)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, ParticipantCopy.MergeQuestion(invitation.Name, invitation.GroupName) },
            { x => x.ButtonText, "Merge" },
            { x => x.Color, Color.Warning }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(
            Loc["Merge {0} into your account", invitation.Name].Value, parameters, options);

        return await dialog.ConfirmedAsync();
    }

    private string Members(int count) =>
        count == 1 ? Loc["One person is in it"].Value : Loc["{0} people are in it", count].Value;
}
