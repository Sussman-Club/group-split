@page "/inbox"
@page "/transactions/not-filed"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@inject IInboxStateService State
@inject IBankCommands Bank
@inject IReceiptCommands Receipts
@inject IDialogService DialogService
@inject LocalClock Clock
@inject ISnackbar Snackbar
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
@implements IDisposable

@*
    What the bank sent, waiting to be dealt with. Each row is one decision with three
    answers, and the whole page is that decision repeated -- so the row leads with who was
    paid and how much, and everything else is secondary.
*@

<PageTitle>Activity - Not filed - Group Split</PageTitle>

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">Activity</div>
        <h1>Not filed</h1>
        @if (Selectable)
        {
            <p role="status" aria-live="polite">@Counted(State.TotalCount) left to review in this range.</p>
        }
        @if (Headline is { Length: > 0 } headline)
        {
            <p>@headline</p>
        }
    </div>
</div>

<div class="gs-stack">
    @* Which rows, and over what span, on one line. They were two bands with the date
       control's own margins between them, which on a phone put most of a screen of empty
       cream between the tabs and the first row somebody came here to deal with.

       The spans are the same five the expense listings offer, so narrowing by date is the
       one control wherever you meet it. A bank sends months at a time and the answer to a
       backlog is to take one month of it. *@
    <div class="gs-inline" style="gap: 8px; flex-wrap: wrap">
        @foreach (var status in Filters)
        {
            var choice = status;
            <MudButton Variant="@(State.Filter == choice ? Variant.Filled : Variant.Text)"
                       Color="@(State.Filter == choice ? Color.Primary : Color.Default)"
                       Size="Size.Small" Class="gs-btn-pill"
                       OnClick="@(() => SetFilterAsync(choice))">
                @Label(choice)
            </MudButton>
        }

        <DateRangeFilter Value="@State.Range" ValueChanged="SetRangeAsync" />
    </div>

    @if (Selectable && State.Rows.Count > 0)
    {
        <nav class="gs-inline" aria-label="Review suggestions" style="gap: 8px; flex-wrap: wrap">
            @foreach (var review in Enum.GetValues<ReviewFilter>())
            {
                <MudButton Size="Size.Small" Class="gs-btn-pill"
                           Variant="@(_review == review ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" OnClick="@(() => SetReview(review))">
                    @ReviewLabel(review) (@State.Rows.Count(row => MatchesReview(row, review)))
                </MudButton>
            }
            <span class="note">Suggestions for the loaded charges</span>
        </nav>
        @if (!VisibleRows.Any())
        {
            <p role="status">No loaded charges in this view. Choose All charges or load more below.</p>
        }
    }

    @if (State.Connections is { Enabled: false })
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
            <h3>Bank sync is not switched on</h3>
            <span>This copy of the app has no bank provider configured, so there is nothing to import.</span>
        </div>
    }
    else if (State.Connections is { Connections.Count: 0 })
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
            <h3>No bank linked yet</h3>
            <span>Link a bank and your transactions will start arriving here.</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4"
                       Href="/account">Link a bank</MudButton>
        </div>
    }
    else if (State.Rows.Count == 0)
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.DoneAll" />
            <h3>@EmptyTitle</h3>
            <span>@EmptyHint</span>
        </div>
    }
    else
    {
        <div class="gs-card gs-card-pad gs-reveal" style="--i: 0">
            @* Selecting is only offered where it means anything. A row that has been added
               or ignored has had its decision made; the bulk actions here are that same
               decision, taken for several rows at once. *@
            @if (Selectable)
            {
                @* A header for the list rather than a control floating over it: it carries
                   the same padding as a row, so its box sits in the same column as theirs
                   and the ticks line up down the left edge. *@
                <div class="gs-list-head">
                    <label class="gs-list-head-select">
                        <MudCheckBox T="bool"
                                     Value="@AllSelected"
                                     ValueChanged="@SelectAll"
                                     UncheckedIcon="@(_selected.Count > 0 && !AllSelected
                                         ? Icons.Material.Filled.IndeterminateCheckBox
                                         : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                     Color="Color.Primary"
                                     Dense="true"
                                     Class="gs-row-check"
                                     aria-label="Select every row that can be" />
                        <span>@(_selected.Count > 0 ? $"{_selected.Count} selected" : "Select all")</span>
                    </label>

                    @* Said apart from the label rather than tacked onto it: select-all ticks
                       these like any other row, and what it cannot do is answer the question
                       hanging on them -- so adding them in bulk leaves them where they are. *@
                    @if (FlaggedCount > 0)
                    {
                        <span class="note">
                            @FlaggedCount may already be recorded, and @(FlaggedCount == 1 ? "needs" : "need") answering one by one
                        </span>
                    }
                </div>
            }

            @* gs-queue: a list whose rows are tasks rather than records. It is what earns
               the full-width primary action on a phone, and no other list in the app
               should have one. *@
            <div class="gs-list gs-queue">
                @{ var bundles = Selectable ? InboxBundle.Create(VisibleRows) : []; }
                @foreach (var item in VisibleRows)
                {
                    var row = item;
                    var bundle = bundles.FirstOrDefault(candidate => candidate.Rows.Any(member => member.Id == row.Id));
                    if (bundle is not null)
                    {
                        if (bundle.First.Id == row.Id)
                        {
                            <details class="gs-inbox-bundle" @key="row.Id">
                                <summary>
                                    <strong>@row.Title</strong>
                                    <span>@bundle.Rows.Count matching charges</span>
                                    @if (bundle.Rows.Any(member => _selected.Contains(member.Id)))
                                    {
                                        <span>@bundle.Rows.Count(member => _selected.Contains(member.Id)) selected</span>
                                    }
                                    <span>Suggested: @bundle.Suggestion.Destination</span>
                                    <Money Value="@bundle.Rows.Sum(member => member.Amount)" Currency="@row.Currency" />
                                </summary>
                                <p class="note">Same account and available context this month. Each charge has its own suggestion. Review before confirming.</p>
                                @foreach (var member in bundle.Rows)
                                {
                                    <div class="gs-inline gs-inbox-bundle-charge" @key="member.Id">
                                        <MudCheckBox T="bool" Value="@_selected.Contains(member.Id)"
                                                     ValueChanged="@((bool on) => Select(member.Id, on))"
                                                     Dense="true" aria-label="@($"Select {member.Title} on {member.SpentOn:d}")" />
                                        <span>@member.AccountName · @member.SpentOn.ToShortDateString()</span>
                                        <Money Value="@member.Amount" Currency="@member.Currency" />
                                        <MudButton Size="Size.Small" Disabled="@(_busy is not null || _bulkBusy)"
                                                   OnClick="@(() => AddToGroupAsync(member))"
                                                   aria-label="@($"Change destination for {member.Title} on {member.SpentOn:d}")">Change destination</MudButton>
                                        <MudButton Size="Size.Small" Disabled="@(_busy is not null || _bulkBusy)"
                                                   OnClick="@(() => KeepPersonalAsync(member))">Keep personal</MudButton>
                                        <MudButton Size="Size.Small" Disabled="@(_busy is not null || _bulkBusy)"
                                                   OnClick="@(() => IgnoreAsync(member))">Ignore</MudButton>
                                    </div>
                                }
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill"
                                           Disabled="@(_busy is not null || _bulkBusy)"
                                           OnClick="@(() => ConfirmBundleAsync(bundle))">Confirm @bundle.Rows.Count in @bundle.Suggestion.Destination</MudButton>
                            </details>
                        }
                        continue;
                    }
                    @* is-selectable, not just is-selected: the checkbox is a fourth child
                       of a three-column grid, and the row needs the column to put it in
                       whether or not it is ticked. *@
                    <div class="gs-row @(Selectable ? "is-selectable" : "") @(_selected.Contains(row.Id) ? "is-selected" : "")"
                         style="cursor: default" @key="row.Id">
                        @if (Selectable)
                        {
                            @* Every waiting row is tickable, a suggestion on it or not.
                               What must not be taken in bulk is the answer to "is this the
                               same payment?" -- so the guard is on the bulk add and not on
                               the tick. *@
                            <MudCheckBox T="bool"
                                         Value="@_selected.Contains(row.Id)"
                                         ValueChanged="@((bool on) => Select(row.Id, on))"
                                         Color="Color.Primary"
                                         Dense="true"
                                         Class="gs-row-check"
                                         aria-label="@($"Select {row.Title}")" />
                        }
                        @* The merchant's own logo where the bank sent one: a row reads as
                           the place it happened rather than as two initials. No payer to
                           show yet -- nobody has filed this -- so the logo takes the square
                           rather than badging an avatar, which is the same component's other
                           half. *@
                        <MerchantMark MerchantName="@row.Title" MerchantLogoUrl="@row.Mark" />
                        <div style="min-width: 0">
                            <div class="title">
                                <span>@row.Title</span>
                                @if (row.Pending)
                                {
                                    <span class="gs-tag neutral">Pending</span>
                                }
                                @if (row.RemovedAt is not null)
                                {
                                    <span class="gs-tag">Withdrawn by the bank</span>
                                }
                            </div>
                            <div class="meta">
                                @row.AccountName · @row.SpentOn.ToShortDateString()
                            </div>
                        </div>

                        <div class="gs-inline gs-inbox-row-actions" style="gap: 12px; flex-wrap: wrap">
                            @* Through the one money component, like every other figure in
                               the app. Money coming in is signed and toned rather than
                               shown as a negative expense, which it is not. *@
                            <Money Value="@row.Amount" Currency="@row.Currency"
                                   Signed="@row.IsCredit" Absolute="@row.IsCredit"
                                   Class="@(row.IsCredit ? "gs-muted" : "")" />

                            @* Shared and personal are both ordinary answers. *@
                            @if (row.Status == InboxStatus.New)
                            {
                                <div class="gs-inline gs-inbox-row-buttons" style="gap: 4px; flex-wrap: wrap">
                                    @if (row.IsCredit)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   Class="gs-btn-pill"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => AddToGroupAsync(row))">Add to group</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => IgnoreAsync(row))">Ignore</MudButton>
                                    }
                                    else
                                    {
                                        @if (row.Suggestion is { } suggestion)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       Class="gs-btn-pill gs-inbox-suggestion"
                                                       StartIcon="@Icons.Material.Rounded.AutoAwesome"
                                                       Disabled="@(_busy == row.Id)"
                                                       title="@($"File it in {suggestion.Destination}")"
                                                       aria-label="@($"File {row.Title} in {suggestion.Destination}")"
                                                       OnClick="@(() => AcceptSuggestionAsync(row, suggestion))">@suggestion.Destination</MudButton>
                                        }
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   Class="gs-btn-pill"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => AddToGroupAsync(row))">Add to group</MudButton>
                                        <MudMenu Icon="@Icons.Material.Rounded.MoreHoriz"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight"
                                                 Disabled="@(_busy == row.Id)"
                                                 aria-label="@($"Other answers for {row.Title}")">
                                            <MudMenuItem OnClick="@(() => IgnoreAsync(row))">Ignore</MudMenuItem>
                                        </MudMenu>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   Disabled="@(_busy == row.Id || _bulkBusy)"
                                                   OnClick="@(() => KeepPersonalAsync(row))">Keep personal</MudButton>
                                    }
                                </div>
                            }
                            else if (row.Status == InboxStatus.Ignored)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           Disabled="@(_busy == row.Id)"
                                           OnClick="@(() => RestoreAsync(row))">Put back</MudButton>
                            }
                        </div>
                    </div>

                    @* What is already in the ledger that this could be. Said on the row
                       itself, before anything is filed: a duplicate found afterwards is a
                       balance somebody has to notice is wrong and then undo by hand.

                       How loudly depends on the grade. The same money to the cent is worth a
                       warning; a figure within a quarter of it is worth a note and no more --
                       measured over real spending, the softer test passes on unrelated money
                       often enough that a warning for it teaches people to stop reading them.

                       Every candidate is listed, not just the best one. They are ranked, and
                       the ranking can be wrong: a coincidence a few cents nearer used to take
                       the one slot and keep the real duplicate off the screen entirely.

                       Both answers are on each of them, and neither happens on its own. *@
                    @if (row.Status == InboxStatus.New && row.PossibleDuplicates.Count > 0)
                    {
                        var sure = row.PossibleDuplicates.Any(candidate => candidate.IsConfident);

                        <MudAlert Severity="@(sure ? Severity.Warning : Severity.Normal)" Dense="true" Class="mb-2"
                                  Style="margin-top: -4px">
                            <div class="gs-match-lead">
                                @(sure
                                    ? "You may already have recorded this:"
                                    : row.PossibleDuplicates.Count == 1
                                        ? "This could be one you have already recorded:"
                                        : "These could be ones you have already recorded:")
                            </div>
                            @foreach (var match in row.PossibleDuplicates)
                            {
                                <div class="gs-inline gs-match-line"
                                     style="justify-content: space-between; gap: 12px; flex-wrap: wrap" @key="match.TransactionId">
                                    <span>
                                        <strong>@match.Name</strong>,
                                        <Money Value="@match.Amount" Currency="@match.Currency" />
                                        in @match.Where on @Clock.Day(match.DateTime).ToString("d")@(match.IsConfident ? "." : $" -- {Apart(match)}.")
                                    </span>
                                    <div class="gs-inline" style="gap: 4px; flex-wrap: nowrap">
                                        <MudButton Variant="@(match.IsConfident ? Variant.Filled : Variant.Text)"
                                                   Color="@(match.IsConfident ? Color.Primary : Color.Default)"
                                                   Size="Size.Small"
                                                   Class="@(match.IsConfident ? "gs-btn-pill" : null)"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => AttachAsync(row, match.TransactionId))">Same payment</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => DismissMatchAsync(row, match))">Not the same</MudButton>
                                    </div>
                                </div>
                            }
                        </MudAlert>
                    }
                }
            </div>

            @if (State.HasMore)
            {
                <div class="gs-inline" style="justify-content: center; margin-top: 12px">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_loadingMore"
                               OnClick="LoadMoreAsync">
                        Show more (@State.Rows.Count of @State.TotalCount)
                    </MudButton>
                </div>
            }
        </div>
    }
</div>

@*
    What is selected, and what can be done with it, over the list rather than beside it.

    Both actions need no target and neither creates a debt: ignoring is reversible from the
    Ignored filter, and keeping a payment personal files it in the personal group and owed to nobody.
    Adding to a group is deliberately not here -- it needs a group, a category and a split,
    and one answer applied to twenty rows is a guess about nineteen of them.
*@
@if (_selected.Count > 0)
{
    <div class="gs-selection-bar" role="status">
        <span class="count">@_selected.Count selected</span>

        <div class="gs-inline" style="gap: 6px; flex-wrap: nowrap">
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="gs-btn-pill"
                       Disabled="@_bulkBusy"
                       OnClick="@KeepSelectedPersonalAsync">Keep personal</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="gs-btn-pill"
                       Disabled="@_bulkBusy"
                       OnClick="@IgnoreSelectedAsync">Ignore</MudButton>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small"
                           aria-label="Clear the selection"
                           Disabled="@_bulkBusy"
                           OnClick="@(() => _selected.Clear())" />
        </div>
    </div>
}

@code {
    private static readonly InboxStatus[] Filters = [InboxStatus.New, InboxStatus.Filed, InboxStatus.Ignored];

    private Guid? _busy;
    private bool _loadingMore;

    /// <summary>
    /// The rows ticked for a bulk action. Ids rather than rows, because the list under them
    /// is re-read whenever anything is written and the row objects are replaced.
    /// </summary>
    private readonly HashSet<Guid> _selected = [];

    private bool _bulkBusy;

    private enum ReviewFilter { All, Shared, Personal, Uncertain }
    private ReviewFilter _review;
    private void SetReview(ReviewFilter review)
    {
        _selected.Clear();
        _review = review;
    }
    private IEnumerable<BankTransactionResponse> VisibleRows => State.Rows
        .Where(row => !Selectable || MatchesReview(row, _review));

    private static bool MatchesReview(BankTransactionResponse row, ReviewFilter filter) => filter switch
    {
        ReviewFilter.Shared => row.PossibleDuplicates.Count == 0 && row.Suggestion is { IsPersonal: false },
        ReviewFilter.Personal => row.PossibleDuplicates.Count == 0 && row.Suggestion is { IsPersonal: true },
        ReviewFilter.Uncertain => row.PossibleDuplicates.Count > 0 || row.Suggestion is null,
        _ => true
    };

    private static string ReviewLabel(ReviewFilter filter) => filter switch
    {
        ReviewFilter.Shared => "Likely shared",
        ReviewFilter.Personal => "Likely personal",
        ReviewFilter.Uncertain => "Needs a decision",
        _ => "All charges"
    };

    private async Task ConfirmBundleAsync(InboxBundle bundle)
    {
        if (_bulkBusy || _busy is not null)
            return;

        _bulkBusy = true;
        var completed = 0;
        try
        {
            // Keep the displayed snapshot. Refreshes may replace rows between writes;
            // never expand a click to newly arrived or newly suggested charges.
            foreach (var shown in bundle.Rows)
            {
                var current = State.Rows.FirstOrDefault(row => row.Id == shown.Id);
                if (current is null || current.Status != InboxStatus.New || current.Pending
                    || current.RemovedAt is not null || current.PossibleDuplicates.Count > 0
                    || current.Suggestion != shown.Suggestion
                    || current.AccountId != shown.AccountId || current.Amount != shown.Amount
                    || current.Currency != shown.Currency || current.MerchantName != shown.MerchantName
                    || current.SpentOn != shown.SpentOn || current.Context != shown.Context
                    || current.ProviderCategoryDetailed != shown.ProviderCategoryDetailed)
                    break;

                var suggestion = shown.Suggestion!;
                var expense = await FileAsync(current, new FileBankTransactionRequest
                {
                    GroupId = suggestion.IsPersonal ? null : suggestion.GroupId,
                    CategoryId = suggestion.CategoryId
                }, suggestion.Destination, allowDuringBatch: true);
                if (expense is null)
                    break;
                completed++;
            }
            Snackbar.Add(completed == bundle.Rows.Count
                ? $"All {completed} charges filed."
                : $"{completed} of {bundle.Rows.Count} charges filed. The remaining charges still need review.", Severity.Info);
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    /// <summary>
    /// Whether selecting is offered at all. Only over the rows still waiting: the other two
    /// filters show decisions already taken.
    /// </summary>
    private bool Selectable => State.Filter == InboxStatus.New;

    /// <summary>
    /// What select-all covers: every row still waiting, whether or not something is
    /// suggested against it.
    /// </summary>
    /// <remarks>
    /// A control called "select all" that quietly covers less than everything is worse than
    /// one that covers everything and says what it will not do with some of it. Ignoring a
    /// flagged row in bulk is fine -- it creates nothing, and filing it later is still
    /// checked -- and adding one is what has to wait for a person, which
    /// <see cref="KeepSelectedPersonalAsync"/> enforces where the writing happens.
    /// </remarks>
    private IEnumerable<BankTransactionResponse> Selectables =>
        VisibleRows.Where(row => row.Status == InboxStatus.New);

    private bool AllSelected =>
        Selectables.Any() && Selectables.All(row => _selected.Contains(row.Id));

    /// <summary>
    /// How many of the waiting rows carry a suggestion. Said on the header so somebody
    /// ticking everything knows some of it needs answering rather than adding.
    /// </summary>
    private int FlaggedCount => State.Rows.Count(row =>
        row.Status == InboxStatus.New && row.PossibleDuplicates.Count > 0);

    private void Select(Guid rowId, bool on)
    {
        if (on) _selected.Add(rowId); else _selected.Remove(rowId);
    }

    private void SelectAll(bool on)
    {
        _selected.Clear();

        if (!on) return;

        foreach (var row in Selectables)
            _selected.Add(row.Id);
    }

    /// <summary>The selected rows as they stand now, in the order they are on screen.</summary>
    private List<BankTransactionResponse> Selected =>
        [.. State.Rows.Where(row => _selected.Contains(row.Id))];

    private async Task IgnoreSelectedAsync()
    {
        _bulkBusy = true;

        try
        {
            await Bank.IgnoreManyAsync([.. Selected.Select(row => (row.Id, row.Title))]);
            _selected.Clear();
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    /// <summary>
    /// Files the selected rows as the person's own.
    /// </summary>
    /// <remarks>
    /// Two kinds of row are left alone rather than sent and refused one at a time. Money
    /// coming in is not an expense and there is no other kind of transaction to file it as.
    /// And a row carrying a suggestion is a question, which is the one thing on this page
    /// that must not be answered in bulk: sending it would either walk into the refusal or,
    /// worse, have to assert <c>FileAnyway</c> on somebody's behalf and record the same
    /// money twice. Both are counted and said, because silently doing less than was ticked
    /// is how somebody comes to believe the inbox is empty.
    /// </remarks>
    private async Task KeepSelectedPersonalAsync()
    {
        _bulkBusy = true;

        try
        {
            var rows = Selected
                .Where(row => !row.IsCredit && row.PossibleDuplicates.Count == 0)
                .ToList();

            var credits = Selected.Count(row => row.IsCredit);
            var asked = Selected.Count(row => !row.IsCredit && row.PossibleDuplicates.Count > 0);

            var done = await Bank.KeepPersonalManyAsync([.. rows.Select(row => (row.Id, row.Title))]);

            if (credits > 0)
            {
                Snackbar.Add(
                    $"{credits} left alone: review incoming money individually with Add to group.",
                    Severity.Info);
            }

            if (asked > 0)
            {
                Snackbar.Add(
                    $"{asked} left alone: each may already be recorded, so answer it on the row.",
                    Severity.Info);
            }

            if (done > 0 || rows.Count == 0)
                _selected.Clear();
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;

        try
        {
            await State.LoadMoreAsync();
            WriteUrl();
        }
        finally
        {
            _loadingMore = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnChanged;

        await State.EnsureLoadedAsync();
        await LoadAskedAsync();
    }

    // Which rows, over what span and how many pages of them, are in the URL, so a refresh
    // or a shared link shows the same list (#398). The ticks are not: they are a decision in
    // progress, not a place. Strings, so a value that does not parse opens the default.
    [Parameter, SupplyParameterFromQuery(Name = "status")] public string? StatusParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "range")] public string? RangeParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? FromParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? ToParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "pages")] public string? PagesParameter { get; set; }

    /// <summary>The list's narrowing as it is spelled in the query string.</summary>
    private sealed record Query(string? Status, string? Range, string? From, string? To, string? Pages);

    /// <summary>
    /// The query this page last read or wrote, so the echo of its own write is not read as a
    /// new address and the list is not asked for twice.
    /// </summary>
    private Query? _settled;

    private Query Asked => new(StatusParameter, RangeParameter, FromParameter, ToParameter, PagesParameter);

    /// <summary>
    /// What is on the page, spelled for the URL. What it opens on -- waiting rows, all time,
    /// one page -- is left out, so the link from the activity page stays bare.
    /// </summary>
    private Query Current
    {
        get
        {
            var (range, from, to) = ListingQuery.FormatRange(State.Range, DateFilter.AllTime);

            return new Query(
                State.Filter switch
                {
                    InboxStatus.Filed => "added",
                    InboxStatus.Ignored => "ignored",
                    _ => null
                },
                range, from, to,
                ListingQuery.FormatPage(State.Pages - 1));
        }
    }

    /// <summary>Reads the list the URL asks for, in one request.</summary>
    private Task LoadAskedAsync()
    {
        var asked = Asked;
        _settled = asked;

        var status = asked.Status?.ToLowerInvariant() switch
        {
            "added" or "filed" => InboxStatus.Filed,
            "ignored" => InboxStatus.Ignored,
            _ => InboxStatus.New
        };

        return State.LoadRowsAsync(status,
            ListingQuery.ParseRange(asked.Range, asked.From, asked.To, DateFilter.AllTime),
            ListingQuery.ParsePage(asked.Pages) + 1);
    }

    /// <summary>
    /// A URL the page did not write -- the activity page's link back to a bare inbox, say --
    /// replaces the list on it.
    /// </summary>
    protected override Task OnParametersSetAsync() =>
        _settled is not null && Asked != _settled ? LoadAskedAsync() : Task.CompletedTask;

    /// <summary>
    /// Puts the list's narrowing in the URL. Replacing rather than pushing keeps the back
    /// button leaving the page instead of stepping back through every filter.
    /// </summary>
    private void WriteUrl()
    {
        var query = Current;

        if (query == _settled)
            return;

        _settled = query;

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["status"] = query.Status,
            ["range"] = query.Range,
            ["from"] = query.From,
            ["to"] = query.To,
            ["pages"] = query.Pages
        }), replace: true);
    }

    private async Task SetFilterAsync(InboxStatus status)
    {
        await State.SetFilterAsync(status);
        WriteUrl();
    }

    private async Task SetRangeAsync(DateFilter range)
    {
        await State.SetRangeAsync(range);
        WriteUrl();
    }

    private void OnChanged()
    {
        // A tick names a row, and a different filter or span is a different set of rows --
        // a selection carried across would act on whatever happened to share an id.
        _selected.RemoveWhere(id => State.Rows.All(row => row.Id != id));

        InvokeAsync(StateHasChanged);
    }

    private static string Label(InboxStatus status) => status switch
    {
        InboxStatus.New => "Waiting",
        InboxStatus.Filed => "Added",
        _ => "Ignored"
    };

    /// <summary>
    /// What the page says it is showing, when that is not already on screen.
    /// </summary>
    /// <remarks>
    /// A chosen span is worth saying: the list under it holds that span and the badge beside
    /// the nav does not, so the heading says which. All time is not -- the badge counts
    /// everything waiting, and a line under the title counting it again was the same number
    /// twice. Nothing left to sort out still gets a sentence, because an empty page with no
    /// heading reads as one that failed to load.
    /// </remarks>
    private string? Headline
    {
        get
        {
            if (!State.Range.IsAllTime)
                return $"{Counted(State.TotalCount)} {State.Range.Label.ToLowerInvariant()}.";

            return State.NewCount > 0 ? null : "Everything your bank sent has been dealt with.";
        }
    }

    private static string Counted(int rows) => $"{rows} transaction{(rows == 1 ? "" : "s")}";

    /// <summary>
    /// Narrowed and empty is not the same as empty: the rows exist, they are just not in the
    /// span being asked for, and telling somebody their bank has sent nothing when it has
    /// sends them looking for a fault that is not there.
    /// </summary>
    private string EmptyTitle => !State.Range.IsAllTime
        ? "Nothing in this range"
        : State.Filter switch
        {
            InboxStatus.New => "Nothing waiting",
            InboxStatus.Filed => "Nothing added yet",
            _ => "Nothing ignored"
        };

    private string EmptyHint => !State.Range.IsAllTime
        ? $"Nothing {State.Range.Label.ToLowerInvariant()}. Widen the range to see more."
        : State.Filter switch
        {
            InboxStatus.New => "New transactions from your bank will show up here.",
            InboxStatus.Filed => "Transactions you add become expenses and appear here.",
            _ => "Transactions you ignore stay out of the way, and can be put back."
        };

    /// <summary>
    /// Keeps it personal. <c>FileAnyway</c> travels when the row is showing a suggestion,
    /// because pressing this with one on screen is the person saying it is a second payment
    /// -- and the API refuses to file over an unseen one, which is what that flag answers.
    /// </summary>
    private async Task KeepPersonalAsync(BankTransactionResponse row) =>
        await FileAsync(row, new FileBankTransactionRequest { FileAnyway = row.PossibleDuplicates.Count > 0 },
            "your own expenses");

    /// <summary>Files the row exactly as choosing this suggestion in the dialog would.</summary>
    private async Task AcceptSuggestionAsync(BankTransactionResponse row, FilingSuggestionResponse suggestion) =>
        await FileAsync(row, new FileBankTransactionRequest
            {
                GroupId = suggestion.IsPersonal ? null : suggestion.GroupId,
                CategoryId = suggestion.CategoryId
            },
            suggestion.IsPersonal ? "your own expenses" : suggestion.GroupName);

    private async Task<TransactionResponse?> AttachAsync(BankTransactionResponse row, Guid transactionId)
    {
        if (_busy is not null || _bulkBusy)
            return null;

        _busy = row.Id;
        TransactionResponse? expense = null;

        try
        {
            expense = await Bank.AttachAsync(row.Id, transactionId);
        }
        finally
        {
            _busy = null;
        }

        return expense;
    }

    /// <summary>
    /// Why a candidate whose amounts do not agree is being offered at all.
    /// </summary>
    /// <remarks>
    /// Said only for a possible match. A confident one is the same money to the cent, so
    /// there is nothing to explain -- and spelling out a difference of zero reads as though
    /// there were.
    /// </remarks>
    private static string Apart(ExpenseMatchResponse match)
    {
        var days = match.DaysApart switch
        {
            0 => "same day",
            1 => "1 day apart",
            var apart => $"{apart} days apart"
        };

        return $"{days}, {match.AmountDifference:N2} apart";
    }

    private async Task DismissMatchAsync(BankTransactionResponse row, ExpenseMatchResponse match)
    {
        if (_busy is not null || _bulkBusy)
            return;

        _busy = row.Id;

        try
        {
            await Bank.DismissMatchAsync(row.Id, match.TransactionId, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    /// <summary>
    /// Opens the ordinary expense dialog, filled in from the row. The amount and the date
    /// come from the bank and are not the person's to change here: correcting the bank is
    /// editing the expense afterwards, and the row keeps saying what the bank said.
    /// </summary>
    private async Task AddToGroupAsync(BankTransactionResponse row)
    {
        if (_busy is not null || _bulkBusy)
            return;

        var parameters = new DialogParameters<FileBankTransactionDialog>
        {
            { dialog => dialog.Row, row }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        // Not "Add to a group" any more: a group is one of the answers and Personal is the
        // other, and a title that names one of them is a title that is wrong half the time.
        var reference = await DialogService.ShowAsync<FileBankTransactionDialog>(
            row.PossibleDuplicates.Count > 0 ? "Which expense is this?" : "Record this payment",
            parameters, options);
        var answer = await reference.GetReturnValueAsync<FileBankTransactionDialog.Answer>();

        if (answer is null)
            return;

        // Two answers come back from that dialog, and only one of them records anything.
        if (answer.AttachTo is { } transactionId)
        {
            var expense = await AttachAsync(row, transactionId);
            await SaveReceiptAsync(expense, answer.Receipt);
            return;
        }

        if (answer.Request is { } request)
        {
            var expense = await FileAsync(row, request, answer.Destination);
            await SaveReceiptAsync(expense, answer.Receipt);
        }
    }

    private async Task<TransactionResponse?> FileAsync(BankTransactionResponse row, FileBankTransactionRequest request,
        string destination, bool allowDuringBatch = false)
    {
        if (_busy is not null || (_bulkBusy && !allowDuringBatch))
            return null;

        _busy = row.Id;
        TransactionResponse? expense = null;

        try
        {
            expense = await Bank.FileAsync(row.Id, request, destination);
        }
        finally
        {
            _busy = null;
        }

        return expense;
    }

    private async Task SaveReceiptAsync(TransactionResponse? expense, SaveReceiptRequest? receipt)
    {
        if (expense is null || receipt is null)
            return;

        await Errors.TryAsync(
            () => Receipts.SaveAsync(expense.Id, receipt),
            "Could not save the receipt.");
    }

    private async Task IgnoreAsync(BankTransactionResponse row)
    {
        if (_busy is not null || _bulkBusy)
            return;

        _busy = row.Id;

        try
        {
            await Bank.IgnoreAsync(row.Id, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task RestoreAsync(BankTransactionResponse row)
    {
        if (_busy is not null || _bulkBusy)
            return;

        _busy = row.Id;

        try
        {
            await Bank.RestoreAsync(row.Id, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    public void Dispose() => State.OnChanged -= OnChanged;
}
