@page "/inbox"
@page "/transactions/not-filed"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@inject IInboxStateService State
@inject IUsersClient UsersClient
@inject GroupSplit.App.Shared.Services.Users.IUserLogin Login
@inject IBankCommands Bank
@inject IReceiptCommands Receipts
@inject IDialogService DialogService
@inject LocalClock Clock
@inject ISnackbar Snackbar
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
@inject IBankLinkLauncher BankLink
@implements IDisposable

@*
    What the bank sent, waiting to be dealt with. Each row is one decision with three
    answers, and the whole page is that decision repeated -- so the row leads with who was
    paid and how much, and everything else is secondary.
*@

<PageTitle>@Loc["Inbox - Group Split"]</PageTitle>
<InboxHeader />
<div class="gs-inbox-context"><h2>@Loc["Bank transactions"]</h2><span class="gs-muted">@Loc["Review bank transactions and add them to a group or match an expense."]</span></div>
<div>
    <nav class="gs-inline gs-receipt-filters" aria-label="@Loc["Bank transaction status"]">
        @foreach (var status in Filters)
        {
            var choice = status;
            <MudButton Variant="@(State.Filter == choice ? Variant.Filled : Variant.Text)"
                       Color="@(State.Filter == choice ? Color.Primary : Color.Default)"
                       Size="Size.Small" Class="gs-btn-pill" Disabled="@(_busy is not null)" aria-pressed="@(State.Filter == choice)"
                       OnClick="@(() => SetFilterAsync(choice))">@Label(choice)</MudButton>
        }
    </nav>
    <div class="gs-receipt-search-bar">
        <MudTextField @bind-Value="_search" @bind-Value:after="SearchChangedAsync" T="string" Immediate="true" DebounceInterval="200" Clearable="true"
                      Placeholder="@Loc["Search merchants or accounts"]" aria-label="@Loc["Search merchants or accounts"]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gs-receipt-search" />
        <DateRangeFilter Value="@State.Range" ValueChanged="SetRangeAsync" />
    </div>

    @{ var showLoading = _initializing || (State.IsLoading && _busy is null); }
    <div class="gs-inbox-results" aria-busy="@(_initializing || State.IsLoading)">
    <div class="gs-inbox-results-content" @key="(State.Filter, showLoading)">
    <LoadView Skeleton="SkeletonLayout.Inbox" Loading="@showLoading" Failed="@(!State.RowsLoaded && _busy is null)" Retry="InitializeAsync">
    @if (State.Connections is { Enabled: false })
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
            <h3>@Loc["Bank sync is not switched on"]</h3>
            <span>@Loc["This copy of the app has no bank provider configured, so there is nothing to import."]</span>
        </div>
    }
    else if (State.Connections is { Connections.Count: 0 })
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
            <h3>@Loc["No bank linked yet"]</h3>
            @if (!BankLink.RequiresExternalBrowser)
            {
                <span>@Loc["Link a bank and your transactions will start arriving here."]</span>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4"
                           Href="/account">@Loc["Link a bank"]</MudButton>
            }
            else
            {
                <span>@Loc["Open Group Split in your browser to link a bank."]</span>
            }
        </div>
    }
    else if (State.Rows.Count == 0)
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.DoneAll" />
            <h3>@(State.Search is not null ? Loc["No transactions match your search"].Value : EmptyTitle)</h3>
            <span>@(State.Search is not null ? Loc["Try a different search."].Value : EmptyHint)</span>
        </div>
    }
    else
    {
        <div class="gs-card gs-receipt-inbox-list">
            <div class="gs-bank-inbox-list">
                @foreach (var item in VisibleRows)
                {
                    var row = item;
                    <div class="gs-bank-inbox-entry" @key="row.Id">
                        @* The merchant's own logo where the bank sent one: a row reads as
                           the place it happened rather than as two initials. No payer to
                           show yet -- nobody has filed this -- so the logo takes the square
                           rather than badging an avatar, which is the same component's other
                           half. *@
                        <MerchantMark MerchantName="@row.Title" MerchantLogoUrl="@row.Mark" />
                        <div class="gs-bank-inbox-copy">
                            <div class="title">
                                <span>@row.Title</span>
                                @if (row.Pending)
                                {
                                    <span class="gs-tag neutral">@Loc["Pending"]</span>
                                }
                                @if (row.RemovedAt is not null)
                                {
                                    <span class="gs-tag">@Loc["Withdrawn by the bank"]</span>
                                }
                            </div>
                            <div class="meta">
                                @row.AccountName · @row.SpentOn.ToShortDateString()
                            </div>
                        </div>

                        <div class="gs-bank-inbox-amount">
                            @* Through the one money component, like every other figure in
                               the app. Money coming in is signed and toned rather than
                               shown as a negative expense, which it is not. *@
                            <Money Value="@row.Amount" Currency="@row.Currency"
                                   Signed="@row.IsCredit" Absolute="@row.IsCredit"
                                   Class="@(row.IsCredit ? "gs-muted" : "")" />

                        </div>
                            @if (row.Status == InboxStatus.New)
                            {
                                <div class="gs-bank-inbox-actions">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary" Size="Size.Small" Class="gs-bank-inbox-suggestion"
                                               Disabled="@(_busy == row.Id)"
                                               OnClick="@(() => AddToGroupAsync(row))">@(row.Suggestion is { } suggestion ? Loc["Review: {0}", suggestion.Destination].Value : Loc["Add to group"].Value)</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small"
                                               Disabled="@(_busy == row.Id)"
                                               OnClick="@(() => IgnoreAsync(row))">@Loc["Ignore"]</MudButton>
                                </div>
                            }
                            else if (row.Status == InboxStatus.Ignored)
                            {
                                <div class="gs-bank-inbox-actions"><MudButton Variant="Variant.Text" Size="Size.Small"
                                           Disabled="@(_busy == row.Id)"
                                           OnClick="@(() => RestoreAsync(row))">@Loc["Restore"]</MudButton></div>
                            }
                            else if (row.Status == InboxStatus.Filed && row.TransactionId is { } expenseId)
                            {
                                <div class="gs-bank-inbox-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenExpenseAsync(expenseId))">@Loc["View expense"]</MudButton></div>
                            }
                    </div>

                    @* What is already in the ledger that this could be. Said on the row
                       itself, before anything is filed: a duplicate found afterwards is a
                       balance somebody has to notice is wrong and then undo by hand.

                       How loudly depends on the grade. The same money to the cent is worth a
                       warning; a figure within a quarter of it is worth a note and no more --
                       measured over real spending, the softer test passes on unrelated money
                       often enough that a warning for it teaches people to stop reading them.

                       Every candidate is listed, not just the best one. They are ranked, and
                       the ranking can be wrong: a coincidence a few cents nearer used to take
                       the one slot and keep the real duplicate off the screen entirely.

                       Both answers are on each of them, and neither happens on its own. *@
                    @if (row.Status == InboxStatus.New && row.PossibleDuplicates.Count > 0)
                    {
                        var sure = row.PossibleDuplicates.Any(candidate => candidate.IsConfident);

                        <MudAlert Severity="@(sure ? Severity.Warning : Severity.Normal)" Dense="true" Class="mb-2"
                                  Style="margin-top: -4px">
                            <div class="gs-match-lead">
                                @(sure
                                    ? Loc["You may already have recorded this:"].Value
                                    : row.PossibleDuplicates.Count == 1
                                        ? Loc["This could be one you have already recorded:"].Value
                                        : Loc["These could be ones you have already recorded:"].Value)
                            </div>
                            @foreach (var match in row.PossibleDuplicates)
                            {
                                <div class="gs-inline gs-match-line"
                                     style="justify-content: space-between; gap: 12px; flex-wrap: wrap" @key="match.TransactionId">
                                    <span>
                                        <strong>@match.Name</strong>,
                                        <Money Value="@match.Amount" Currency="@match.Currency" />
                                        in @match.Where on @Clock.Day(match.DateTime).ToString("d")@(match.IsConfident ? "." : $" -- {Apart(match)}.")
                                    </span>
                                    <div class="gs-inline" style="gap: 4px; flex-wrap: nowrap">
                                        <MudButton Variant="@(match.IsConfident ? Variant.Filled : Variant.Text)"
                                                   Color="@(match.IsConfident ? Color.Primary : Color.Default)"
                                                   Size="Size.Small"
                                                   Class="@(match.IsConfident ? "gs-btn-pill" : null)"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => AttachAsync(row, match.TransactionId))">@Loc["Same payment"]</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => DismissMatchAsync(row, match))">@Loc["Not the same"]</MudButton>
                                    </div>
                                </div>
                            }
                        </MudAlert>
                    }
                }
            </div>

            @if (State.HasMore)
            {
                <div class="gs-inbox-show-more">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_loadingMore"
                               OnClick="LoadMoreAsync">@Loc["Show more ({0} of {1})", State.Rows.Count, State.TotalCount].Value</MudButton>
                </div>
            }
        </div>
    }
</LoadView>
</div>
</div>
</div>

@code {
    private static readonly InboxStatus[] Filters = [InboxStatus.New, InboxStatus.Filed, InboxStatus.Ignored];

    private Guid? _busy;
    private Task OpenExpenseAsync(Guid id) => DialogService.ShowAsync<TransactionDetailsDialog>(Loc["Transaction Details"].Value,
        new DialogParameters<TransactionDetailsDialog> { { x => x.TransactionId, id } },
        new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
    private bool _loadingMore;
    private string? _search;

    private IEnumerable<BankTransactionResponse> VisibleRows => State.Rows;

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;

        try
        {
            await State.LoadMoreAsync();
            WriteUrl();
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private bool _initializing = true;

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnChanged;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        _initializing = true;
        try
        {
            await State.EnsureLoadedAsync();
            await LoadAskedAsync();
        }
        finally { _initializing = false; }
    }

    // Which rows, over what span and how many pages of them, are in the URL, so a refresh
    // or a shared link shows the same list (#398). The ticks are not: they are a decision in
    // progress, not a place. Strings, so a value that does not parse opens the default.
    [Parameter, SupplyParameterFromQuery(Name = "status")] public string? StatusParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "range")] public string? RangeParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? FromParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? ToParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "pages")] public string? PagesParameter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? SearchParameter { get; set; }

    /// <summary>The list's narrowing as it is spelled in the query string.</summary>
    private sealed record Query(string? Status, string? Range, string? From, string? To, string? Pages, string? Search);

    /// <summary>
    /// The query this page last read or wrote, so the echo of its own write is not read as a
    /// new address and the list is not asked for twice.
    /// </summary>
    private Query? _settled;

    private Query Asked => new(StatusParameter, RangeParameter, FromParameter, ToParameter, PagesParameter, SearchParameter);

    /// <summary>
    /// What is on the page, spelled for the URL. What it opens on -- waiting rows, all time,
    /// one page -- is left out, so the link from the activity page stays bare.
    /// </summary>
    private Query Current
    {
        get
        {
            var (range, from, to) = ListingQuery.FormatRange(State.Range, DateFilter.AllTime);

            return new Query(
                State.Filter switch
                {
                    InboxStatus.Filed => "added",
                    InboxStatus.Ignored => "ignored",
                    _ => null
                },
                range, from, to,
                ListingQuery.FormatPage(State.Pages - 1), State.Search);
        }
    }

    /// <summary>Reads the list the URL asks for, in one request.</summary>
    private Task LoadAskedAsync()
    {
        var asked = Asked;
        _settled = asked;

        var status = asked.Status?.ToLowerInvariant() switch
        {
            "added" or "filed" => InboxStatus.Filed,
            "ignored" => InboxStatus.Ignored,
            _ => InboxStatus.New
        };

        _search = asked.Search;
        return State.LoadRowsAsync(status,
            ListingQuery.ParseRange(asked.Range, asked.From, asked.To, DateFilter.AllTime),
            ListingQuery.ParsePage(asked.Pages) + 1, search: asked.Search);
    }

    /// <summary>
    /// A URL the page did not write -- the activity page's link back to a bare inbox, say --
    /// replaces the list on it.
    /// </summary>
    protected override Task OnParametersSetAsync() =>
        _settled is not null && Asked != _settled ? LoadAskedAsync() : Task.CompletedTask;

    /// <summary>
    /// Puts the list's narrowing in the URL. Replacing rather than pushing keeps the back
    /// button leaving the page instead of stepping back through every filter.
    /// </summary>
    private void WriteUrl()
    {
        var query = Current;

        if (query == _settled)
            return;

        _settled = query;

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["status"] = query.Status,
            ["range"] = query.Range,
            ["from"] = query.From,
            ["to"] = query.To,
            ["pages"] = query.Pages,
            ["q"] = query.Search
        }), replace: true);
    }

    private async Task SetFilterAsync(InboxStatus status)
    {
        await State.SetFilterAsync(status);
        WriteUrl();
    }

    private async Task SetRangeAsync(DateFilter range)
    {
        await State.SetRangeAsync(range);
        WriteUrl();
    }

    private async Task SearchChangedAsync()
    {
        await State.SetSearchAsync(_search);
        WriteUrl();
    }

    private void OnChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string Label(InboxStatus status) => status switch
    {
        InboxStatus.New => Loc["Waiting"].Value,
        InboxStatus.Filed => Loc["Added"],
        _ => Loc["Ignored"]
    };

    /// <summary>
    /// Narrowed and empty is not the same as empty: the rows exist, they are just not in the
    /// span being asked for, and telling somebody their bank has sent nothing when it has
    /// sends them looking for a fault that is not there.
    /// </summary>
    private string EmptyTitle => !State.Range.IsAllTime
        ? Loc["Nothing in this range"].Value
        : State.Filter switch
        {
            InboxStatus.New => Loc["Nothing waiting"].Value,
            InboxStatus.Filed => Loc["Nothing added yet"].Value,
            _ => Loc["Nothing ignored"].Value
        };

    private string EmptyHint => !State.Range.IsAllTime
        ? Loc["Nothing {0}. Widen the range to see more.", State.Range.Label.ToLowerInvariant()].Value
        : State.Filter switch
        {
            InboxStatus.New => Loc["New transactions from your bank will show up here."].Value,
            InboxStatus.Filed => Loc["Transactions you add become expenses and appear here."].Value,
            _ => Loc["Transactions you ignore stay out of the way, and can be put back."].Value
        };

    /// <summary>
    /// Keeps it personal. <c>FileAnyway</c> travels when the row is showing a suggestion,
    /// because pressing this with one on screen is the person saying it is a second payment
    /// -- and the API refuses to file over an unseen one, which is what that flag answers.
    /// </summary>
    private async Task<TransactionResponse?> AttachAsync(BankTransactionResponse row, Guid transactionId)
    {
        if (_busy is not null)
            return null;

        _busy = row.Id;
        TransactionResponse? expense = null;

        try
        {
            expense = await Bank.AttachAsync(row.Id, transactionId);
        }
        finally
        {
            _busy = null;
        }

        return expense;
    }

    /// <summary>
    /// Why a candidate whose amounts do not agree is being offered at all.
    /// </summary>
    /// <remarks>
    /// Said only for a possible match. A confident one is the same money to the cent, so
    /// there is nothing to explain -- and spelling out a difference of zero reads as though
    /// there were.
    /// </remarks>
    private string Apart(ExpenseMatchResponse match)
    {
        var days = match.DaysApart switch
        {
            0 => Loc["same day"].Value,
            1 => Loc["1 day apart"].Value,
            var apart => Loc["{0} days apart", apart].Value
        };

        return Loc["{0}, {1:N2} apart", days, match.AmountDifference].Value;
    }

    private async Task DismissMatchAsync(BankTransactionResponse row, ExpenseMatchResponse match)
    {
        if (_busy is not null)
            return;

        _busy = row.Id;

        try
        {
            await Bank.DismissMatchAsync(row.Id, match.TransactionId, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    /// <summary>
    /// Opens the ordinary expense dialog, filled in from the row. The amount and the date
    /// come from the bank and are not the person's to change here: correcting the bank is
    /// editing the expense afterwards, and the row keeps saying what the bank said.
    /// </summary>
    private async Task AddToGroupAsync(BankTransactionResponse row)
    {
        if (_busy is not null)
            return;

        var parameters = new DialogParameters<FileBankTransactionDialog>
        {
            { dialog => dialog.Row, row }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        // Not "Add to a group" any more: a group is one of the answers and Personal is the
        // other, and a title that names one of them is a title that is wrong half the time.
        var reference = await DialogService.ShowAsync<FileBankTransactionDialog>(
            row.PossibleDuplicates.Count > 0 ? Loc["Which expense is this?"].Value : Loc["Record this payment"].Value,
            parameters, options);
        var answer = await reference.GetReturnValueAsync<FileBankTransactionDialog.Answer>();

        if (answer is null)
            return;

        // Two answers come back from that dialog, and only one of them records anything.
        if (answer.AttachTo is { } transactionId)
        {
            var expense = await AttachAsync(row, transactionId);
            await SaveReceiptAsync(expense, answer.Receipt);
            if (expense is not null) await CompleteBankGuideAsync();
            return;
        }

        if (answer.Request is { } request)
        {
            var expense = await FileAsync(row, request, answer.Destination);
            await SaveReceiptAsync(expense, answer.Receipt);
            if (expense is not null) await CompleteBankGuideAsync();
        }
    }

    private async Task CompleteBankGuideAsync()
    {
        if (Login.User is not { Onboarding.BankDismissed: false }) return;
        if (await Errors.TryAsync(() => UsersClient.DismissOnboardingAsync("bank"), Loc["Could not save your preference."].Value))
            await Login.RefreshLoginAsync();
    }

    private async Task<TransactionResponse?> FileAsync(BankTransactionResponse row, FileBankTransactionRequest request,
        string destination)
    {
        if (_busy is not null)
            return null;

        _busy = row.Id;
        TransactionResponse? expense = null;

        try
        {
            expense = await Bank.FileAsync(row.Id, request, destination);
        }
        finally
        {
            _busy = null;
        }

        return expense;
    }

    private async Task SaveReceiptAsync(TransactionResponse? expense, SaveReceiptRequest? receipt)
    {
        if (expense is null || receipt is null)
            return;

        await Errors.TryAsync(
            () => Receipts.SaveAsync(expense.Id, receipt),
            Loc["Could not save the receipt."].Value);
    }

    private async Task IgnoreAsync(BankTransactionResponse row)
    {
        if (_busy is not null)
            return;

        _busy = row.Id;

        try
        {
            await Bank.IgnoreAsync(row.Id, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task RestoreAsync(BankTransactionResponse row)
    {
        if (_busy is not null)
            return;

        _busy = row.Id;

        try
        {
            await Bank.RestoreAsync(row.Id, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    public void Dispose() => State.OnChanged -= OnChanged;
}
