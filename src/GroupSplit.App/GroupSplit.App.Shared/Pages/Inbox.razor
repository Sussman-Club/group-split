@page "/inbox"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Extensions
@using GroupSplit.App.Shared.Services.Banking
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.Shared
@inject IInboxStateService State
@inject IBankCommands Bank
@inject IDialogService DialogService
@inject LocalClock Clock
@inject ISnackbar Snackbar
@implements IDisposable

@*
    What the bank sent, waiting to be dealt with. Each row is one decision with three
    answers, and the whole page is that decision repeated -- so the row leads with who was
    paid and how much, and everything else is secondary.
*@

<PageTitle>Inbox - Group Split</PageTitle>

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">Bank</div>
        <h1>Inbox</h1>
        @if (Headline is { Length: > 0 } headline)
        {
            <p>@headline</p>
        }
    </div>
</div>

<div class="gs-stack">
    @* Which rows, and over what span, on one line. They were two bands with the date
       control's own margins between them, which on a phone put most of a screen of empty
       cream between the tabs and the first row somebody came here to deal with.

       The spans are the same five the expense listings offer, so narrowing by date is the
       one control wherever you meet it. A bank sends months at a time and the answer to a
       backlog is to take one month of it. *@
    <div class="gs-inline" style="gap: 8px; flex-wrap: wrap">
        @foreach (var status in Filters)
        {
            var choice = status;
            <MudButton Variant="@(State.Filter == choice ? Variant.Filled : Variant.Text)"
                       Color="@(State.Filter == choice ? Color.Primary : Color.Default)"
                       Size="Size.Small" Class="gs-btn-pill"
                       OnClick="@(() => State.SetFilterAsync(choice))">
                @Label(choice)
            </MudButton>
        }

        <DateRangeFilter Value="@State.Range" ValueChanged="@(range => State.SetRangeAsync(range))" />
    </div>

    @if (State.Connections is { Enabled: false })
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
            <h3>Bank sync is not switched on</h3>
            <span>This copy of the app has no bank provider configured, so there is nothing to import.</span>
        </div>
    }
    else if (State.Connections is { Connections.Count: 0 })
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />
            <h3>No bank linked yet</h3>
            <span>Link a bank and your transactions will start arriving here.</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4"
                       Href="/account">Link a bank</MudButton>
        </div>
    }
    else if (State.Rows.Count == 0)
    {
        <div class="gs-card gs-empty" style="padding: 48px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.DoneAll" />
            <h3>@EmptyTitle</h3>
            <span>@EmptyHint</span>
        </div>
    }
    else
    {
        <div class="gs-card gs-card-pad gs-reveal" style="--i: 0">
            @* Selecting is only offered where it means anything. A row that has been added
               or ignored has had its decision made; the bulk actions here are that same
               decision, taken for several rows at once. *@
            @if (Selectable)
            {
                <label class="gs-select-all">
                    <MudCheckBox T="bool"
                                 Value="@AllSelected"
                                 ValueChanged="@((bool on) => SelectAll(on))"
                                 Indeterminate="@(_selected.Count > 0 && !AllSelected)"
                                 Color="Color.Primary"
                                 Dense="true" />
                    <span>@SelectAllLabel</span>
                </label>
            }

            <div class="gs-list">
                @foreach (var item in State.Rows)
                {
                    var row = item;
                    <div class="gs-row @(_selected.Contains(row.Id) ? "is-selected" : "")"
                         style="cursor: default" @key="row.Id">
                        @if (Selectable)
                        {
                            @* A row with a suggestion is selectable, but select-all leaves
                               it alone: answering "is this the same payment?" is the one
                               decision on this page that must not be taken in bulk. *@
                            <MudCheckBox T="bool"
                                         Value="@_selected.Contains(row.Id)"
                                         ValueChanged="@((bool on) => Select(row.Id, on))"
                                         Color="Color.Primary"
                                         Dense="true"
                                         Class="gs-row-check"
                                         aria-label="@($"Select {row.Title}")" />
                        }
                        @if (row.LogoUrl is { Length: > 0 } logo)
                        {
                            @* The merchant's own logo where the bank sent one: a row reads
                               as the place it happened rather than as two initials. *@
                            <img src="@logo" alt="" width="36" height="36"
                                 style="border-radius: 50%; object-fit: cover; flex: 0 0 auto" />
                        }
                        else
                        {
                            <Avatar Name="@row.Title" />
                        }
                        <div style="min-width: 0">
                            <div class="title">
                                <span>@row.Title</span>
                                @if (row.Pending)
                                {
                                    <span class="gs-tag neutral">Pending</span>
                                }
                                @if (row.RemovedAt is not null)
                                {
                                    <span class="gs-tag">Withdrawn by the bank</span>
                                }
                            </div>
                            <div class="meta">
                                @row.AccountName · @row.SpentOn.ToShortDateString()
                                @if ((row.DetailedCategoryLabel ?? row.CategoryLabel) is { Length: > 0 } category)
                                {
                                    @($" · {category}")
                                }
                                @if (row.Context is { Length: > 0 } context)
                                {
                                    @($" · {context}")
                                }
                            </div>
                        </div>

                        <div class="gs-inline" style="gap: 12px; flex-wrap: nowrap">
                            @* Through the one money component, like every other figure in
                               the app. Money coming in is signed and toned rather than
                               shown as a negative expense, which it is not. *@
                            <Money Value="@row.Amount" Currency="@row.Currency"
                                   Signed="@row.IsCredit" Absolute="@row.IsCredit"
                                   Class="@(row.IsCredit ? "gs-muted" : "")" />

                            @*
                                One primary action, and the rest one gesture away.

                                The row used to offer up to five buttons, and a page of
                                twenty-three of them was a hundred and fifteen ways to
                                mis-tap. Sharing is the answer this app exists for, so it
                                gets the button; keeping a payment personal and ignoring it
                                are neither common nor destructive -- ignoring is reversible
                                from the Ignored filter, which is exactly why it does not
                                need to be prominent.
                            *@
                            @if (row.Status == InboxStatus.New)
                            {
                                <div class="gs-inline" style="gap: 4px; flex-wrap: nowrap">
                                    @if (row.IsCredit)
                                    {
                                        @* Money coming in cannot become an expense, so the
                                           only answer it has is the quiet one, and it is
                                           the button. *@
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => IgnoreAsync(row))">Ignore</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   Class="gs-btn-pill"
                                                   Disabled="@(_busy == row.Id)"
                                                   OnClick="@(() => AddToGroupAsync(row))">Add to group</MudButton>
                                        <MudMenu Icon="@Icons.Material.Rounded.MoreHoriz"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight"
                                                 Disabled="@(_busy == row.Id)"
                                                 aria-label="@($"Other answers for {row.Title}")">
                                            <MudMenuItem OnClick="@(() => KeepPersonalAsync(row))">Keep personal</MudMenuItem>
                                            <MudMenuItem OnClick="@(() => IgnoreAsync(row))">Ignore</MudMenuItem>
                                        </MudMenu>
                                    }
                                </div>
                            }
                            else if (row.Status == InboxStatus.Ignored)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           Disabled="@(_busy == row.Id)"
                                           OnClick="@(() => RestoreAsync(row))">Put back</MudButton>
                            }
                        </div>
                    </div>

                    @* What is already in the ledger that this could be. Said on the row
                       itself, before anything is filed: a duplicate found afterwards is a
                       balance somebody has to notice is wrong and then undo by hand.

                       Both answers are here, and neither happens on its own. *@
                    @if (row.Status == InboxStatus.New && row.PossibleDuplicates.Count > 0)
                    {
                        var match = row.PossibleDuplicates[0];

                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2"
                                  Style="margin-top: -4px">
                            <div class="gs-inline" style="justify-content: space-between; gap: 12px; flex-wrap: wrap">
                                <span>
                                    You may already have recorded this:
                                    <strong>@match.Name</strong>,
                                    <Money Value="@match.Amount" Currency="@match.Currency" />
                                    in @match.Where on @Clock.Local(match.DateTime).ToString("d").
                                </span>
                                <div class="gs-inline" style="gap: 4px; flex-wrap: nowrap">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               Class="gs-btn-pill"
                                               Disabled="@(_busy == row.Id)"
                                               OnClick="@(() => AttachAsync(row, match.TransactionId))">Same payment</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small"
                                               Disabled="@(_busy == row.Id)"
                                               OnClick="@(() => DismissMatchAsync(row, match))">Not the same</MudButton>
                                </div>
                            </div>
                        </MudAlert>
                    }
                }
            </div>

            @if (State.HasMore)
            {
                <div class="gs-inline" style="justify-content: center; margin-top: 12px">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_loadingMore"
                               OnClick="LoadMoreAsync">
                        Show more (@State.Rows.Count of @State.TotalCount)
                    </MudButton>
                </div>
            }
        </div>
    }
</div>

@*
    What is selected, and what can be done with it, over the list rather than beside it.

    Both actions need no target and neither creates a debt: ignoring is reversible from the
    Ignored filter, and keeping a payment personal files it in no group and owed to nobody.
    Adding to a group is deliberately not here -- it needs a group, a category and a split,
    and one answer applied to twenty rows is a guess about nineteen of them.
*@
@if (_selected.Count > 0)
{
    <div class="gs-selection-bar" role="status">
        <span class="count">@_selected.Count selected</span>

        <div class="gs-inline" style="gap: 6px; flex-wrap: nowrap">
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="gs-btn-pill"
                       Disabled="@_bulkBusy"
                       OnClick="@KeepSelectedPersonalAsync">Keep personal</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="gs-btn-pill"
                       Disabled="@_bulkBusy"
                       OnClick="@IgnoreSelectedAsync">Ignore</MudButton>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small"
                           aria-label="Clear the selection"
                           Disabled="@_bulkBusy"
                           OnClick="@(() => _selected.Clear())" />
        </div>
    </div>
}

@code {
    private static readonly InboxStatus[] Filters = [InboxStatus.New, InboxStatus.Filed, InboxStatus.Ignored];

    private Guid? _busy;
    private bool _loadingMore;

    /// <summary>
    /// The rows ticked for a bulk action. Ids rather than rows, because the list under them
    /// is re-read whenever anything is written and the row objects are replaced.
    /// </summary>
    private readonly HashSet<Guid> _selected = [];

    private bool _bulkBusy;

    /// <summary>
    /// Whether selecting is offered at all. Only over the rows still waiting: the other two
    /// filters show decisions already taken.
    /// </summary>
    private bool Selectable => State.Filter == InboxStatus.New;

    /// <summary>
    /// What select-all covers. A row showing a possible duplicate is left out: the whole
    /// design of this page is that nothing is filed while that question is open, and a
    /// select-all that swept them in would answer it for somebody.
    /// </summary>
    private IEnumerable<BankTransactionResponse> Selectables =>
        State.Rows.Where(row => row.Status == InboxStatus.New && row.PossibleDuplicates.Count == 0);

    private bool AllSelected =>
        Selectables.Any() && Selectables.All(row => _selected.Contains(row.Id));

    private string SelectAllLabel
    {
        get
        {
            var flagged = State.Rows.Count(row =>
                row.Status == InboxStatus.New && row.PossibleDuplicates.Count > 0);

            return flagged == 0
                ? "Select all"
                : $"Select all · {flagged} with a possible duplicate left out";
        }
    }

    private void Select(Guid rowId, bool on)
    {
        if (on) _selected.Add(rowId); else _selected.Remove(rowId);
    }

    private void SelectAll(bool on)
    {
        _selected.Clear();

        if (!on) return;

        foreach (var row in Selectables)
            _selected.Add(row.Id);
    }

    /// <summary>The selected rows as they stand now, in the order they are on screen.</summary>
    private List<BankTransactionResponse> Selected =>
        [.. State.Rows.Where(row => _selected.Contains(row.Id))];

    private async Task IgnoreSelectedAsync()
    {
        _bulkBusy = true;

        try
        {
            await Bank.IgnoreManyAsync([.. Selected.Select(row => (row.Id, row.Title))]);
            _selected.Clear();
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    /// <summary>
    /// Files the selected rows as the person's own.
    /// </summary>
    /// <remarks>
    /// Money coming in is left out rather than refused one row at a time: a refund is not an
    /// expense, and there is no other kind of transaction to file it as. FileAnyway travels
    /// for a row showing a suggestion, because select-all never ticks one -- if it is in
    /// here, somebody ticked it themselves.
    /// </remarks>
    private async Task KeepSelectedPersonalAsync()
    {
        _bulkBusy = true;

        try
        {
            var rows = Selected.Where(row => !row.IsCredit).ToList();
            var credits = Selected.Count - rows.Count;

            var done = await Bank.KeepPersonalManyAsync(
                [.. rows.Select(row => (row.Id, row.Title, row.PossibleDuplicates.Count > 0))]);

            if (credits > 0)
            {
                Snackbar.Add(
                    $"{credits} left alone: money coming in is not an expense.",
                    Severity.Info);
            }

            if (done > 0 || credits == Selected.Count)
                _selected.Clear();
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;

        try
        {
            await State.LoadMoreAsync();
        }
        finally
        {
            _loadingMore = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnChanged;

        await State.EnsureLoadedAsync();
        await State.LoadRowsAsync();
    }

    private void OnChanged()
    {
        // A tick names a row, and a different filter or span is a different set of rows --
        // a selection carried across would act on whatever happened to share an id.
        _selected.RemoveWhere(id => State.Rows.All(row => row.Id != id));

        InvokeAsync(StateHasChanged);
    }

    private static string Label(InboxStatus status) => status switch
    {
        InboxStatus.New => "Waiting",
        InboxStatus.Filed => "Added",
        _ => "Ignored"
    };

    /// <summary>
    /// What the page says it is showing, when that is not already on screen.
    /// </summary>
    /// <remarks>
    /// A chosen span is worth saying: the list under it holds that span and the badge beside
    /// the nav does not, so the heading says which. All time is not -- the badge counts
    /// everything waiting, and a line under the title counting it again was the same number
    /// twice. Nothing left to sort out still gets a sentence, because an empty page with no
    /// heading reads as one that failed to load.
    /// </remarks>
    private string? Headline
    {
        get
        {
            if (!State.Range.IsAllTime)
                return $"{Counted(State.TotalCount)} {State.Range.Label.ToLowerInvariant()}.";

            return State.NewCount > 0 ? null : "Everything your bank sent has been dealt with.";
        }
    }

    private static string Counted(int rows) => $"{rows} transaction{(rows == 1 ? "" : "s")}";

    /// <summary>
    /// Narrowed and empty is not the same as empty: the rows exist, they are just not in the
    /// span being asked for, and telling somebody their bank has sent nothing when it has
    /// sends them looking for a fault that is not there.
    /// </summary>
    private string EmptyTitle => !State.Range.IsAllTime
        ? "Nothing in this range"
        : State.Filter switch
        {
            InboxStatus.New => "Nothing waiting",
            InboxStatus.Filed => "Nothing added yet",
            _ => "Nothing ignored"
        };

    private string EmptyHint => !State.Range.IsAllTime
        ? $"Nothing {State.Range.Label.ToLowerInvariant()}. Widen the range to see more."
        : State.Filter switch
        {
            InboxStatus.New => "New transactions from your bank will show up here.",
            InboxStatus.Filed => "Transactions you add become expenses and appear here.",
            _ => "Transactions you ignore stay out of the way, and can be put back."
        };

    /// <summary>
    /// Keeps it personal. <c>FileAnyway</c> travels when the row is showing a suggestion,
    /// because pressing this with one on screen is the person saying it is a second payment
    /// -- and the API refuses to file over an unseen one, which is what that flag answers.
    /// </summary>
    private Task KeepPersonalAsync(BankTransactionResponse row) =>
        FileAsync(row, new FileBankTransactionRequest { FileAnyway = row.PossibleDuplicates.Count > 0 },
            "your own expenses");

    private async Task AttachAsync(BankTransactionResponse row, Guid transactionId)
    {
        _busy = row.Id;

        try
        {
            await Bank.AttachAsync(row.Id, transactionId);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task DismissMatchAsync(BankTransactionResponse row, ExpenseMatchResponse match)
    {
        _busy = row.Id;

        try
        {
            await Bank.DismissMatchAsync(row.Id, match.TransactionId, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    /// <summary>
    /// Opens the ordinary expense dialog, filled in from the row. The amount and the date
    /// come from the bank and are not the person's to change here: correcting the bank is
    /// editing the expense afterwards, and the row keeps saying what the bank said.
    /// </summary>
    private async Task AddToGroupAsync(BankTransactionResponse row)
    {
        var parameters = new DialogParameters<FileBankTransactionDialog>
        {
            { dialog => dialog.Row, row }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var reference = await DialogService.ShowAsync<FileBankTransactionDialog>("Add to a group", parameters, options);
        var answer = await reference.GetReturnValueAsync<FileBankTransactionDialog.Answer>();

        if (answer is null)
            return;

        // Two answers come back from that dialog, and only one of them records anything.
        if (answer.AttachTo is { } transactionId)
        {
            await AttachAsync(row, transactionId);
            return;
        }

        if (answer.Request is { } request)
            await FileAsync(row, request, answer.Destination);
    }

    private async Task FileAsync(BankTransactionResponse row, FileBankTransactionRequest request, string destination)
    {
        _busy = row.Id;

        try
        {
            await Bank.FileAsync(row.Id, request, destination);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task IgnoreAsync(BankTransactionResponse row)
    {
        _busy = row.Id;

        try
        {
            await Bank.IgnoreAsync(row.Id, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task RestoreAsync(BankTransactionResponse row)
    {
        _busy = row.Id;

        try
        {
            await Bank.RestoreAsync(row.Id, row.Title);
        }
        finally
        {
            _busy = null;
        }
    }

    public void Dispose() => State.OnChanged -= OnChanged;
}
