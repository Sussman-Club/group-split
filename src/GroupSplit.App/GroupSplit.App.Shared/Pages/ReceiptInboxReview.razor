@page "/inbox/receipts/{Id:guid}"
@using GroupSplit.Shared
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Errors
@using Microsoft.AspNetCore.Components.Forms
@inject LocalClock Clock
@inject IReceiptsClient Client
@inject IDialogService Dialogs
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
@inject GroupSplit.App.Shared.Services.DataChangeNotifier Changes
@inject GroupSplit.App.Shared.Services.Commands.IReceiptCommands Receipts
@inject GroupSplit.App.Shared.Services.ReceiptSuggestionCache SuggestionCache

<PageTitle>@Loc["Review receipt - Group Split"]</PageTitle>
<div class="gs-receipt-review-back"><MudButton Href="@($"/inbox/receipts{new Uri(Nav.Uri).Query}")">@Loc["Back to receipts"]</MudButton></div>
@if (_row is { } row)
{
    <header class="gs-receipt-review-heading">
        <h1>@(row.MerchantDisplayName ?? row.Receipt.MerchantName ?? Loc["Review receipt"].Value)</h1>
        <p>@(row.ExpenseId is not null ? Loc["Added"].Value : row.IsIgnored ? Loc["Ignored"].Value : Loc["Needs review"].Value) · @row.Receipt.Total.ToString("0.00") @row.Currency</p>
    </header>
    @if (row.ExpenseId is null && row.PossibleDuplicates.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@Loc["Possible duplicate receipt: another receipt has the same merchant, date, total and currency. Check both before filing."]
            @foreach (var duplicate in row.PossibleDuplicates.Where(d => d.ExpenseId is null))
            {
                <MudButton Href="@($"/inbox/receipts/{duplicate.Id}")" Size="Size.Small">@Loc["Review matching receipt"]</MudButton>
            }
        </MudAlert>
    }
    @if (row.ExpenseId is { } expenseId)
    {
        <div class="gs-receipt-review-layout">
            <section class="gs-card gs-card-pad gs-receipt-review-section">
                <h2>@Loc["Receipt details"]</h2>
                @if (_bill is { Items.Count: > 0 } addedBill) { <BillSheet Receipt="addedBill" Title="@row.Receipt.MerchantName" /> }
                else { <p>@Loc["No itemized details"]</p> }
            </section>
            <div class="gs-stack gs-receipt-review-sidebar">
                <section class="gs-card gs-card-pad gs-receipt-review-section">
                    <h2>@Loc["Added to expense"]</h2>
                    @if (!string.IsNullOrWhiteSpace(row.ExpenseName)) { <p>@row.ExpenseName</p> }
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenExpense(expenseId))">@Loc["View expense"]</MudButton>
                </section>
                @if (row.Attachments.Count > 0)
                {
                    <details class="gs-receipt-review-original"><summary>@Loc["Original receipt"]</summary><div class="gs-stack">
                    @foreach (var file in row.Attachments)
                    {
                        <MudButton Href="@Source(file.Id)" Target="_blank">@Loc["Original receipt"]: @file.FileName</MudButton>
                        @if (file.ContentType.StartsWith("image/")) { <img src="@Source(file.Id)" alt="@Loc["Original receipt"]" style="max-width:100%" /> }
                        else { <PdfReceiptPreview @key="file.Id" Url="@Source(file.Id)" DownloadUrl="@Source(file.Id)" FileName="@file.FileName" /> }
                    }
                    </div></details>
                }
            </div>
        </div>
    }
    else
    {
    <div class="gs-receipt-review-layout">
        <div class="gs-stack gs-receipt-review-details">
            <section class="gs-card gs-card-pad gs-receipt-review-section">
            <h2>@Loc["Receipt details"]</h2>
            <MerchantPicker Label="@Loc["Merchant"].Value" Value="row.MerchantId" ValueChanged="SetMerchant" />
            <div class="gs-receipt-currency-row"><MudTextField @bind-Value="_currency" Label="@Loc["Currency"]" MaxLength="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton OnClick="SaveCurrency" Disabled="_busy" Variant="Variant.Outlined">@Loc["Save currency"]</MudButton></div>
            <MudButton OnClick="Edit" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">@Loc["Edit receipt details and items"]</MudButton>
            @if (_bill is { Items.Count: > 0 } bill)
            {
                <BillSheet Receipt="bill" Title="@row.Receipt.MerchantName" />
            }
            else
            {
                <p>@Loc["Read the original receipt or enter its details to see the itemized bill."]</p>
            }
            </section>
        </div>
        <div class="gs-stack gs-receipt-review-sidebar">
            <section class="gs-card gs-card-pad gs-receipt-review-section"><h2>@Loc["File receipt"]</h2>
            <p>@Loc["Attach to an existing expense to keep its current shares, or create an expense and choose who paid."]</p>
            @if (_suggestion is { } suggestion)
            {
                <div class="gs-receipt-suggestion">
                    <strong>@Loc["Suggested destination"]</strong>
                    <span>@suggestion.Destination</span>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="@(() => Create(suggestion.IsPersonal ? null : suggestion.GroupId))">@Loc["Review suggested group"]</MudButton>
                </div>
            }
            @if (_matches.Any(match => !match.HasReceipt)) { <strong>@Loc["Possible expense matches"]</strong> }
            @foreach (var match in _matches.Where(match => !match.HasReceipt))
            {
                <div class="gs-receipt-suggestion">
                    <strong>@match.Name</strong><span>@match.Amount.ToString("N2") @match.Currency · @Clock.Day(match.DateTime).ToString("d")</span>
                    <div class="gs-inline"><MudButton OnClick="@(() => Attach(match.Id))" Disabled="_busy">@Loc["Attach"]</MudButton><MudButton OnClick="@(() => Dismiss(match.Id))" Disabled="_busy">@Loc["Not the same"]</MudButton></div>
                </div>
            }
            <MudButton OnClick="AttachEntered" Disabled="_busy">@Loc["Find existing expense"]</MudButton>
            <MudButton OnClick="CreateDefault" Disabled="_busy">@Loc["Create expense"]</MudButton>
            </section>
            <section class="gs-card gs-card-pad gs-receipt-review-section">
                <h2>@Loc["Inbox status"]</h2>
                <p>@Loc["Ignored items can be restored later."]</p>
                <MudButton OnClick="SetIgnored" Disabled="_busy">@(row.IsIgnored ? Loc["Restore receipt"] : Loc["Ignore receipt"])</MudButton>
            </section>
            <MudButton OnClick="Delete" Disabled="_busy" Color="Color.Error">@Loc["Delete private receipt"]</MudButton>
        <details class="gs-receipt-review-original @(row.Receipt.Items.Count == 0 && row.Attachments.Count > 0 ? "is-unextracted" : null)" open="@(row.Receipt.Items.Count == 0 && row.Attachments.Count > 0)"><summary>@Loc["Original receipt"]</summary><div class="gs-stack">

            @if (row.Attachments.Count == 0)
            {
                <ReceiptFilePicker FileChanged="Upload" IsBusy="_busy" Title="@Loc["Add original receipt"]" Description="@Loc["Choose a photo or PDF to attach."]" />
            }
            @foreach (var file in row.Attachments)
            {
                <MudButton OnClick="@(() => Read(file.Id))" Disabled="_busy">@Loc["Read items from source"]</MudButton>
                <MudButton Href="@Source(file.Id)" Target="_blank">@Loc["Original receipt"]: @file.FileName</MudButton>
                @if (file.ContentType.StartsWith("image/")) { <img src="@Source(file.Id)" alt="@Loc["Original receipt"]" style="max-width:100%" /> }
                else { <PdfReceiptPreview @key="file.Id" Url="@Source(file.Id)" DownloadUrl="@Source(file.Id)" FileName="@file.FileName" /> }
            }
        </div></details>
        </div>
    </div>
    }
}
@if (_busy) { <MudProgressLinear Indeterminate="true" /> }
@code {
    [Parameter] public Guid Id { get; set; }
    private ReceiptInboxResponse? _row;
    private ReceiptResponse? _bill;
    private FilingDestinationSuggestion? _suggestion;
    private IReadOnlyList<ReceiptExpenseCandidate> _matches = [];
    private string _currency = "USD";
    private bool _busy;
    protected override Task OnParametersSetAsync() => Load();
    private async Task Load()
    {
        _suggestion = null;
        await Errors.TryAsync(async () => {
            _row = await Client.GetReceiptInboxAsync(Id);
            _bill = BillOf(_row);
            _currency = _row.Currency;
            _matches = _row.ExpenseId is null ? (await Client.MatchReceiptInboxAsync(Id)).ToList() : [];

        }, Loc["Could not load receipt."].Value);
        if (_row is { ExpenseId: null, Receipt.Items.Count: > 0 } receipt)
        {
            _suggestion = SuggestionCache.Get(receipt);
            var generation = SuggestionCache.Generation;
            var refreshed = await Receipts.SuggestFilingAsync(new SuggestReceiptFilingRequest { Receipt = receipt.Receipt, Currency = receipt.Currency });
            if (refreshed is not null)
            {
                SuggestionCache.Remember(receipt, refreshed, generation);
                _suggestion = refreshed;
            }
        }
    }
    private static ReceiptResponse BillOf(ReceiptInboxResponse row) =>
        new(row.Id, row.ExpenseId ?? Guid.Empty, row.Receipt.Subtotal, row.Receipt.Tax,
            row.Receipt.Tip, row.Receipt.Total, 0, false, false,
            row.Receipt.Items.Select(item => new ReceiptItemResponse(item.Id ?? Guid.NewGuid(),
                item.Name, item.UnitPrice, item.Quantity, item.TotalPrice, item.TaxAmount,
                null, null, null)
            {
                NormalizedName = item.NormalizedName ?? string.Empty,
                Description = item.Description, TaxRate = item.TaxRate, IsTaxable = item.IsTaxable
            }).ToList())
        { MerchantName = row.Receipt.MerchantName, PurchaseDate = row.Receipt.PurchaseDate };
    private Task OpenExpense(Guid id) => Dialogs.ShowAsync<TransactionDetailsDialog>(Loc["Transaction Details"].Value,
        new DialogParameters<TransactionDetailsDialog> { { x => x.TransactionId, id } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
    private Task SetIgnored() => Run(async () =>
    {
        if (_row is not { ExpenseId: null } row) return;
        if (row.IsIgnored) await Client.RestoreInboxReceiptAsync(Id);
        else await Client.IgnoreInboxReceiptAsync(Id);
        await Changes.NotifyReceiptsChangedAsync();
        Nav.NavigateTo(row.IsIgnored ? "/inbox/receipts" : "/inbox/receipts?status=ignored");
    });
    private string Source(Guid a) => _row?.ExpenseId is { } expenseId
        ? Nav.BaseUri + $"api/transactions/{expenseId}/receipt-attachments/{a}?inline=true"
        : Nav.BaseUri + $"api/receipts/inbox/{Id}/files/{a}";
    private async Task Run(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await Errors.TryAsync(action, Loc["Could not update receipt."].Value); }
        finally { _busy = false; }
    }
    private Task SetMerchant(Guid? merchantId) => Run(async () =>
    {
        await Client.SaveReceiptInboxAsync(Id, new() { Currency = _currency, UpdateMerchant = true, MerchantId = merchantId });
        await Changes.NotifyReceiptsChangedAsync();
        await Load();
    });
    private Task SaveCurrency() => Run(async () => { await Client.SaveReceiptInboxAsync(Id, new() { Currency = _currency }); await Load(); });
    private async Task Read(Guid attachmentId)
    {
        ReceiptDraftResponse? draft = null;
        await Run(async () => draft = await Client.TranscribeInboxReceiptAsync(Id, attachmentId));
        if (draft == null) return;
        var dialog = await Dialogs.ShowAsync<ReceiptDraftDialog>(Loc["Review extracted details"].Value, new DialogParameters<ReceiptDraftDialog>
        { { x => x.Currency, _currency }, { x => x.Transcription, new ReceiptTranscriptionResponse(attachmentId, draft.Provider, draft.Receipt) } });
        if (await dialog.Result is { Canceled: false, Data: SaveReceiptRequest details })
            await Run(async () => { await Client.SaveReceiptInboxAsync(Id, new() { Currency = _currency, Receipt = details }); await Load(); });
    }
    private async Task Edit()
    {
        var dialog = await Dialogs.ShowAsync<ReceiptDraftDialog>(Loc["Review receipt"].Value, new DialogParameters<ReceiptDraftDialog>
        {
            { x => x.Currency, _currency },
            { x => x.Transcription, new ReceiptTranscriptionResponse(Guid.Empty, "manual", _row!.Receipt) }
        }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
        if (await dialog.Result is { Canceled: false, Data: SaveReceiptRequest details })
            await Run(async () => { await Client.SaveReceiptInboxAsync(Id, new() { Currency = _currency, Receipt = details }); await Load(); });
    }
    private Task Upload(InputFileChangeEventArgs args) => Run(async () => {
        await using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
        await Client.UploadInboxReceiptFileAsync(Id, new FileParameter(stream, args.File.Name, args.File.ContentType)); await Load(); });
    private async Task Attach(Guid expense)
    {
        if (await Dialogs.ShowMessageBoxAsync(Loc["Attach receipt"].Value, Loc["Attach this receipt as evidence? The expense amount and existing shares will stay as recorded, even if this receipt has a different total."].Value, yesText: Loc["Attach receipt"].Value, cancelText: Loc["Cancel"].Value) == true)
            await File(new() { ExpenseId = expense });
    }
    private Task Dismiss(Guid expense) => Run(async () =>
    {
        await Client.DismissReceiptInboxMatchAsync(Id, expense);
        _matches = _matches.Where(match => match.Id != expense).ToList();
    });
    private async Task AttachEntered()
    {
        var dialog = await Dialogs.ShowAsync<FindExpenseDialog>(Loc["Find existing expense"].Value, new DialogParameters<FindExpenseDialog> { { x => x.RequireUnlinkedBank, false }, { x => x.Row, new BankTransactionResponse(Guid.Empty, _row!.Receipt.PurchaseDate ?? DateOnly.FromDateTime(DateTime.Today), _row.Receipt.Total, _currency, "Receipt", _row.Receipt.MerchantName, null, null, null, null, null, null, null, false, InboxStatus.New, null, null, "", "") } });
        if (await dialog.Result is { Canceled: false, Data: TransactionResponse expense }) await Attach(expense.Id);
    }
    private Task File(FileReceiptInboxRequest request) => Run(async () => { await Client.FileReceiptInboxAsync(Id, request); await Changes.NotifyReceiptsChangedAsync(); await Changes.NotifyTransactionsChangedAsync(); await Changes.NotifyBankDataChangedAsync(); Nav.NavigateTo("/inbox/receipts?status=added"); });
    private Task CreateDefault() => Create(null);
    private async Task Create(Guid? groupId)
    {
        var dialog = await Dialogs.ShowAsync<CreateTransactionDialog>(Loc["Create expense"].Value, new DialogParameters<CreateTransactionDialog>
        { { x => x.InboxReceipt, _row!.Receipt }, { x => x.InboxCurrency, _currency }, { x => x.InboxMerchantId, _row.MerchantId }, { x => x.SelectedGroupId, groupId }, { x => x.InboxSuggestion, _suggestion is { } suggestion && (suggestion.IsPersonal ? groupId is null : groupId == suggestion.GroupId) ? suggestion : null } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false, Data: CreateTransactionRequest request })
        {
            var anyway = _matches.Count > 0 && await Dialogs.ShowMessageBoxAsync(Loc["Possible duplicate"].Value, Loc["These matching expenses may already record this purchase. Create another expense?"].Value, yesText: Loc["Create another"].Value, cancelText: Loc["Cancel"].Value) == true;
            if (_matches.Count == 0 || anyway) await File(new() { NewExpense = request, CreateAnyway = anyway });
        }
    }
    private async Task Delete()
    {
        if (await Dialogs.ShowMessageBoxAsync(Loc["Delete receipt"].Value, Loc["Delete this private receipt and its source files?"].Value, yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value) == true)
            await Run(async () => { await Client.DeleteReceiptInboxAsync(Id); await Changes.NotifyReceiptsChangedAsync(); Nav.NavigateTo("/inbox/receipts"); });
    }
}
