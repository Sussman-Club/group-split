@page "/join/{Token}"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Commands
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@attribute [AllowAnonymous]
@inject IInvitationsClient Invitations
@inject IGroupCommands GroupCommands
@inject ApiErrorPresenter Errors
@inject IAuthService AuthService
@inject NavigationManager Nav

@*
    Where a shared link lands.

    Anonymous, because the person following one very often has no account yet -- that is the
    case invitations exist for. Signing in is a round trip through the identity provider, so
    the URL they were going to is handed along as returnUrl and they come back here rather
    than to the home page, with the link still in hand.

    The card is shared with /claim, which is the other page reached this way. They are not
    the same act -- this one lets somebody in as themselves, claiming nothing, where that
    one hands over a position in a ledger -- but they are the same kind of screen, and
    looking like two different products was doing nobody any favours.
*@

<PageTitle>Join a group - Group Split</PageTitle>

@if (UserInfo is null)
{
    <LinkLanding Title="You have been invited to a group"
                 Subtitle="Sign in, or create an account, and we will bring you straight back here to join.">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill"
                   FullWidth Size="Size.Large"
                   EndIcon="@Icons.Material.Rounded.ArrowForward"
                   OnClick="@(() => AuthService.Login($"/join/{Token}"))">Continue</MudButton>
    </LinkLanding>
}
else if (_loading)
{
    <LinkLanding Title="You have been invited to a group">
        <div class="gs-inline gs-muted" style="font-size: .875rem; padding: 4px 0">
            <MudProgressCircular Color="Color.Primary" Indeterminate Size="Size.Small" />
            <span>Looking up the group…</span>
        </div>
    </LinkLanding>
}
else if (_error is not null)
{
    @* A link that has run out and one the group withdrew are different things to have
       happened, and the message says which -- that is the whole reason the API keeps them
       apart instead of answering "not found" to both. *@
    <LinkLanding Title="This link will not let you in" Subtitle="@_error">
        <MudButton Variant="Variant.Text" Href="/"
                   StartIcon="@Icons.Material.Rounded.ArrowBack">Back home</MudButton>
    </LinkLanding>
}
else if (_link is { } link)
{
    <LinkLanding Title="@link.GroupName" Subtitle="@Shared(link)">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill"
                   FullWidth Size="Size.Large"
                   EndIcon="@Icons.Material.Rounded.ArrowForward"
                   Disabled="@_joining"
                   OnClick="@JoinAsync">
            @(link.AlreadyAMember ? $"Open {link.GroupName}" : $"Join {link.GroupName}")
        </MudButton>
    </LinkLanding>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private JoinLinkResponse? _link;
    private string? _error;
    private bool _loading;
    private bool _joining;

    /// <summary>The token the state below belongs to, so it is not re-read on every render.</summary>
    private string? _resolved;

    /// <summary>
    /// On every parameter set rather than only on initialise, because signing in is the
    /// step in the middle: the person arrives here with no account, comes back with one,
    /// and it is the cascading user changing that has to send this looking.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (UserInfo is null || _loading || _resolved == Token)
            return;

        _loading = true;
        _error = null;

        var failure = await Errors.CaptureAsync(async () =>
            _link = await Invitations.GetJoinLinkAsync(Token));

        // Shown on the page rather than in a snackbar: this is the only thing on the page,
        // and a message that scrolls away would leave nothing behind it.
        if (failure is not null)
        {
            _link = null;
            _error = failure.Message;
        }

        _resolved = Token;
        _loading = false;
    }

    private static string Shared(JoinLinkResponse link) =>
        link.AlreadyAMember
            ? "You are already in this group."
            : string.IsNullOrWhiteSpace(link.CreatedByUserName)
                ? $"{Members(link.MemberCount)} already. Join to start sharing expenses with them."
                : $"{link.CreatedByUserName} shared this group with you. {Members(link.MemberCount)} already.";

    private async Task JoinAsync()
    {
        if (_link is null) return;

        _joining = true;

        var joined = await GroupCommands.JoinByLinkAsync(Token);

        _joining = false;

        // Being in it already lands in the same place, because it is the same place they
        // were trying to get to.
        if (joined is not null)
            Nav.NavigateTo($"/groups/{joined.GroupId}");
    }

    private static string Members(int count) =>
        count == 1 ? "One person is in it" : $"{count} people are in it";
}
