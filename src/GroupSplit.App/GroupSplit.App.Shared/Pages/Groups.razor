@page "/groups"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject IDialogService DialogService
@inject IGroupsPageStateService GroupsService
@implements IAsyncDisposable

<PageTitle>Groups - Group Split</PageTitle>

<GroupSwitcher Groups="GroupsService.Groups"
               SelectedGroup="GroupsService.SelectedGroup"
               SelectedGroupChanged="@(g => GroupsService.SelectedGroup = g)"
               OnCreateClick="OpenCreateDialogAsync" />

@if (GroupsService.SelectedGroup is { } group)
{
    <div class="gs-page-head" @key="@($"head-{group.Id}")">
        <div class="gs-inline" style="gap: 16px">
            <Avatar Name="@group.Name" Size="lg" />
            <div>
                <div class="gs-eyebrow">@(group.IsArchive ? "Archived group" : "Group")</div>
                <h1 style="margin-top: 2px">@group.Name</h1>
                <p style="margin-top: 2px">@group.MemberCount member@(group.MemberCount == 1 ? "" : "s") · @GroupsService.Transactions.Count expense@(GroupsService.Transactions.Count == 1 ? "" : "s")</p>
            </div>
        </div>

        <div class="gs-toolbar" role="toolbar" aria-label="Group actions">
            <MudTooltip Text="Split rules">
                <MudIconButton Icon="@Icons.Material.Rounded.Rule" OnClick="@ManageRules" aria-label="Manage rules" />
            </MudTooltip>
            <MudTooltip Text="Rename group">
                <MudIconButton Icon="@Icons.Material.Rounded.Edit" OnClick="@OpenUpdateGroupDialog" aria-label="Edit group" />
            </MudTooltip>
            @if (!group.IsArchive)
            {
                <span class="sep"></span>
                <MudTooltip Text="Add member">
                    <MudIconButton Icon="@Icons.Material.Rounded.PersonAdd" Color="Color.Primary" OnClick="@OpenAddMemberDialogAsync" aria-label="Add member" />
                </MudTooltip>
                <MudTooltip Text="Remove member">
                    <MudIconButton Icon="@Icons.Material.Rounded.PersonRemove" Color="Color.Error" OnClick="@OpenRemoveMemberDialogAsync" aria-label="Remove member" />
                </MudTooltip>
            }
        </div>
    </div>

    <div class="gs-two-col" @key="@($"body-{group.Id}")">
        <div class="gs-stack">
            @if (GroupsService.Balance is { } balance)
            {
                <section class="gs-hero @HeroClass gs-reveal" style="--i: 0" aria-live="polite">
                    @if (UserBalance > 0)
                    {
                        <div class="gs-eyebrow">You are owed</div>
                        <div class="gs-hero-amount">@UserBalance.ToString("C")</div>
                        <div class="gs-hero-sub">by @balance.OwedToYou.Count() @(balance.OwedToYou.Count() == 1 ? "person" : "people") in @group.Name</div>
                        <div class="gs-hero-list">
                            @foreach (var debt in balance.OwedToYou)
                            {
                                var d = debt;
                                <div class="gs-hero-row">
                                    <Avatar Name="@d.UserName" Size="sm" />
                                    <div class="who">@d.UserName <small>owes you</small></div>
                                    <span class="gs-money">@d.Amount.ToString("C")</span>
                                    <MudButton Class="gs-btn-glass" Size="Size.Small" Variant="Variant.Text"
                                               OnClick="@(() => OpenSettleDialogAsync(d))">Settle</MudButton>
                                </div>
                            }
                        </div>
                    }
                    else if (UserBalance < 0)
                    {
                        <div class="gs-eyebrow">You owe</div>
                        <div class="gs-hero-amount">@Math.Abs(UserBalance).ToString("C")</div>
                        <div class="gs-hero-sub">to @balance.YouOwed.Count() @(balance.YouOwed.Count() == 1 ? "person" : "people") in @group.Name</div>
                        <div class="gs-hero-list">
                            @foreach (var debt in balance.YouOwed)
                            {
                                <div class="gs-hero-row">
                                    <Avatar Name="@debt.UserName" Size="sm" />
                                    <div class="who">@debt.UserName <small>is waiting on you</small></div>
                                    <span class="gs-money">@debt.Amount.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="gs-eyebrow">Your balance</div>
                        <div class="gs-hero-amount">All settled</div>
                        <div class="gs-hero-sub">Nothing owed either way in @group.Name. Nice.</div>
                    }
                </section>
            }

            <div class="gs-card gs-card-pad gs-reveal" style="--i: 1">
                <div class="gs-card-title">
                    <h2>Recent expenses</h2>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="/transactions"
                               EndIcon="@Icons.Material.Rounded.ArrowForward">All expenses</MudButton>
                </div>
                <TransactionsList Transactions="GroupsService.Transactions" Limit="8" />
            </div>
        </div>

        <div class="gs-stack">
            <div class="gs-card gs-card-pad gs-reveal" style="--i: 2">
                <div class="gs-card-title">
                    <h2>Members</h2>
                    <span class="gs-tag neutral">net balances</span>
                </div>
                @if (GroupsService.Balance is { } b && b.NetBalances.Any())
                {
                    var max = Math.Max(b.NetBalances.Max(m => Math.Abs(m.Balance)), 0.01m);
                    var i = 0;
                    <div class="gs-balances">
                        @foreach (var member in b.NetBalances.OrderByDescending(m => m.Balance))
                        {
                            var w = (double)(Math.Abs(member.Balance) / max);
                            <div class="gs-balance-row @(member.Balance < 0 ? "is-neg" : "")" style="--i: @(i++)">
                                <Avatar Name="@member.UserName" Size="sm" />
                                <div style="min-width: 0">
                                    <div class="name" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
                                        @member.UserName
                                        @if (member.UserId == UserInfo?.Id)
                                        {
                                            <span class="gs-muted" style="font-weight: 500"> (you)</span>
                                        }
                                    </div>
                                    <div class="bar"><span style="--w: @w.ToString(System.Globalization.CultureInfo.InvariantCulture)"></span></div>
                                </div>
                                <span class="gs-money @(member.Balance > 0 ? "gs-pos" : member.Balance < 0 ? "gs-neg" : "gs-muted")">
                                    @(member.Balance > 0 ? "+" : "")@member.Balance.ToString("C")
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="gs-empty" style="padding: 20px">
                        <MudIcon Icon="@Icons.Material.Rounded.Balance" />
                        <span>Balances appear once there is an expense.</span>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="gs-card gs-empty" style="padding: 64px 24px">
        <MudIcon Icon="@Icons.Material.Rounded.Groups" />
        <h3>No group yet</h3>
        <span>Create a group and invite the people you share costs with.</span>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4"
                   StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenCreateDialogAsync">Create a group</MudButton>
    </div>
}

@if (GroupsService.SelectedGroup is { IsArchive: false })
{
    <ExtendedFab Label="Add expense" AlwaysExtended="true" OnClick="@OpenAddTransactionDialog" />
}

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private decimal UserBalance => GroupsService.Balance?.NetBalances.FirstOrDefault(x => x.UserId == UserInfo?.Id)?.Balance ?? 0m;

    private string HeroClass => UserBalance switch
    {
        > 0 => "",
        < 0 => "is-neg",
        _ => "is-zero"
    };

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    private void ReRender()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();
        GroupsService.OnGroupsChanged += ReRender;
        GroupsService.OnTransactionsChanged += ReRender;
        GroupsService.OnGroupSelected += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        await GroupsService.IsReadyTask;
        await base.OnInitializedAsync();
    }

    private async Task ManageRules()
    {
        if (GroupsService.SelectedGroup is null) return;

        var parameters = new DialogParameters<ManageRulesDialog>
        {
            { x => x.GroupId, GroupsService.SelectedGroup.Id }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<ManageRulesDialog>("Manage Rules", parameters, options);
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<CreateGroupDialog>("Create a group", options);

        var dialogResult = await dialogReference.GetReturnValueAsync<CreateGroupRequest>();

        if (dialogResult is null)
            return;

        await GroupsService.CreateGroupAsync(dialogResult, CancellationToken);
    }

    private async Task OpenAddMemberDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var members = await GroupsService.GetGroupMembersAsync(CancellationToken).ToArrayAsync(CancellationToken);

        var parameters = new DialogParameters<AddGroupMemberDialog> { { x => x.CurrentUsers, members } };

        var dialogReference = await DialogService.ShowAsync<AddGroupMemberDialog>("Add new member", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<AddMemberRequest>();
        if (request is not null)
        {
            await GroupsService.AddGroupMemberAsync(request, CancellationToken);
        }
    }

    private async Task OpenRemoveMemberDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var members = await GroupsService.GetGroupMembersAsync(CancellationToken).ToArrayAsync(CancellationToken);

        var parameters = new DialogParameters<RemoveMemberDialog> { { x => x.Members, members } };

        var dialogReference = await DialogService.ShowAsync<RemoveMemberDialog>("Remove member", parameters, options);

        var removedUser = await dialogReference.GetReturnValueAsync<UserInfo>();

        if (removedUser is not null)
        {
            await GroupsService.RemoveGroupMemberAsync(removedUser.Id, CancellationToken);
        }
    }

    private async Task OpenUpdateGroupDialog()
    {
        if (GroupsService.SelectedGroup is null) return;

        var parameters = new DialogParameters
        {
            { "Group", GroupsService.SelectedGroup }
        };

        var dialog = await DialogService.ShowAsync<UpdateGroupDialog>(
            "Edit Group",
            parameters,
            new DialogOptions { FullWidth = true }
        );

        var request = await dialog.GetReturnValueAsync<JsonPatchDocument<CreateGroupRequest>>();

        if (request is not null)
        {
            await GroupsService.UpdateGroupAsync(request, CancellationToken);
        }
    }

    private async Task OpenAddTransactionDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.SelectedGroupId, GroupsService.SelectedGroup?.Id }
        };

        var dialogReference = await DialogService.ShowAsync<CreateTransactionDialog>("Create an expense", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<CreateTransactionRequest>();

        if (request is not null)
        {
            await GroupsService.CreateTransactionAsync(request, CancellationToken);
        }
    }

    private async Task OpenSettleDialogAsync(DebtInfo debtInfo)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        var parameters = new DialogParameters<SettleDialog>
        {
            { x => x.UserId, debtInfo.UserId },
            { x => x.Username, debtInfo.UserName },
            { x => x.TotalDebt, debtInfo.Amount }
        };

        var dialog = await DialogService.ShowAsync<SettleDialog>(
            $"Settle with {debtInfo.UserName}",
            parameters,
            options
        );

        var request = await dialog.GetReturnValueAsync<SettleRequest>();

        if (request is not null)
        {
            await GroupsService.SettleAsync(request, CancellationToken);
        }
    }

    public async ValueTask DisposeAsync()
    {
        GroupsService.OnGroupsChanged -= ReRender;
        GroupsService.OnTransactionsChanged -= ReRender;
        GroupsService.OnGroupSelected -= ReRender;
        if (_loadCts is not null) await _loadCts.CancelAsync();
    }

}
