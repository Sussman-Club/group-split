@page "/groups"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.Shared
@inject IDialogService DialogService
@inject IGroupsPageStateService GroupsService
@inject NavigationManager Nav
@implements IDisposable

@*
    The groups you are in, and the ones that have asked for you.

    This used to be the group page: a switcher along the top and one group's figures below
    it, so seeing a second group meant changing the subject of the whole page. A group has
    its own page now -- /groups/{id}, with tabs -- and this is the list they open from.
*@

<PageTitle>Groups - Group Split</PageTitle>

<div class="gs-page-head">
    <div>
        <div class="gs-eyebrow">Your groups</div>
        <h1>Groups</h1>
        <p>Everyone you share costs with, and where each of you stands.</p>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill"
               StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenCreateDialogAsync">
        New group
    </MudButton>
</div>

<div class="gs-stack">
    @if (Active.Count == 0 && Archived.Count == 0)
    {
        <div class="gs-card gs-empty" style="padding: 64px 24px">
            <MudIcon Icon="@Icons.Material.Rounded.Groups" />
            <h3>No group yet</h3>
            <span>Create a group and name the people you share costs with.</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4"
                       StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenCreateDialogAsync">Create a group</MudButton>
        </div>
    }
    else
    {
        <div class="gs-group-grid">
            @{ var i = 1; }
            @foreach (var group in Active)
            {
                @GroupCard(group, i++)
            }
        </div>

        @if (Archived.Count > 0)
        {
            <div class="gs-card gs-card-pad gs-reveal" style="--i: @(i + 1)">
                <div class="gs-card-title">
                    <h2>Archived</h2>
                    <span class="gs-tag neutral">only you see this</span>
                </div>
                <div class="gs-group-grid">
                    @foreach (var group in Archived)
                    {
                        @GroupCard(group, i++)
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private RenderFragment GroupCard(GroupResponse group, int index) =>
        @<button type="button" class="gs-card gs-card-hover gs-group-card gs-reveal" style="--i: @index"
                 @onclick="@(() => Open(group))">
            <Avatar Name="@group.Name" />
            <div class="head">
                <span class="name">@group.Name</span>
                <span class="go">Open <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Style="width:16px;height:16px" /></span>
            </div>
            <div class="people">
                <span>@group.MemberCount member@(group.MemberCount == 1 ? "" : "s")</span>
            </div>
            <div class="foot">
                <span class="gs-eyebrow">@Standing(group)</span>
                <Money Value="@(BalanceIn(group.Id))" Signed Animate />
            </div>
        </button>;

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private List<GroupResponse> Active =>
        [.. GroupsService.Groups.Where(group => !group.IsArchive).OrderBy(group => group.Name)];

    private List<GroupResponse> Archived =>
        [.. GroupsService.Groups.Where(group => group.IsArchive).OrderBy(group => group.Name)];

    /// <summary>
    /// What this person is owed or owes in one group. Read from the position endpoint,
    /// which answers for every group at once -- one call rather than one per card.
    /// </summary>
    private decimal BalanceIn(Guid groupId) =>
        GroupsService.Position?.Groups.FirstOrDefault(position => position.GroupId == groupId)?.Balance ?? 0m;

    private string Standing(GroupResponse group) => BalanceIn(group.Id) switch
    {
        > 0 => "You are owed",
        < 0 => "You owe",
        _ => "Settled up"
    };

    private void Open(GroupResponse group) => Nav.NavigateTo($"/groups/{group.Id}");

    private void ReRender() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        GroupsService.OnGroupsChanged += ReRender;
        GroupsService.OnTransactionsChanged += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        await GroupsService.IsReadyTask;
        await base.OnInitializedAsync();
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        var dialogReference = await DialogService.ShowAsync<CreateGroupDialog>("Create a group", options);

        var request = await dialogReference.GetReturnValueAsync<CreateGroupRequest>();

        if (request is null)
            return;

        if (!await GroupsService.CreateGroupAsync(request))
            return;

        // Straight into the group that was just made -- the state service selected it, so
        // this does not have to guess which of the list it was. There is nothing on its
        // card yet, and the first thing anybody does with a new group is invite somebody.
        if (GroupsService.SelectedGroup is { } created)
            Nav.NavigateTo($"/groups/{created.Id}");
    }

    public void Dispose()
    {
        GroupsService.OnGroupsChanged -= ReRender;
        GroupsService.OnTransactionsChanged -= ReRender;
    }
}
