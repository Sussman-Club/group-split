@page "/signup"
@using GroupSplit.App.Shared.Components
@layout FullScreenLayout
@attribute [AllowAnonymous]

<PageTitle>Create an account - Group Split</PageTitle>

<AuthHandoff Flow="AuthHandoff.AuthFlow.Register"
             Title="Create your account"
             Subtitle="Split costs with friends, housemates and anyone else you share expenses with."
             ActionLabel="Continue to sign up"
             AlternatePrompt="Already have an account?"
             AlternateLabel="Sign in"
             AlternateHref="/login" />
