<GroupNavigationMemory @key="Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath" />
@page "/groups/{GroupId:guid}"
@page "/groups/{GroupId:guid}/{Tab}"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.App.Shared.Services.Transactions
@using GroupSplit.Shared
@using Microsoft.JSInterop
@inject IDialogService DialogService
@inject IGroupsPageStateService GroupsService
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
@inject LocalClock Clock
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    One group, on its own page.

    Four questions people actually ask about a group, and each of them used to be answered
    somewhere else or not at all: where we stand (this page, under a switcher), what we have
    spent (a separate page behind a link), what has happened (nowhere -- settlements were
    invisible), and who is in it (a pair of icon buttons that opened dialogs). Tabs, and the
    tab is in the URL, so a group's members page is a place you can be sent to.
*@

<PageTitle>@(Group?.Name ?? Loc["Group"].Value) - Group Split</PageTitle>

<LoadView Loading="_initializing" Failed="@(Group is not null && (GroupsService.Balance is null || GroupsService.Transactions is null))" Retry="ReloadAsync">
@if (Group is { } group)
{
    <div class="gs-page-head gs-group-heading" @key="@($"head-{group.Id}")">
        @* One line: back, the group's mark, and who it is. It used to be a plain .gs-inline,
           which wraps -- and on a phone the thing it wrapped was the text, leaving a 56px
           avatar stranded on a line of its own beside the back arrow with the rest of the
           width empty. Four bands of chrome stacked up before any content.

           Nowrap here and min-width:0 on the text means the name wraps *inside* its own
           block instead of pushing itself onto the next line. *@
        <div class="gs-inline gs-identity">
            <MudTooltip Text="@Loc["All groups"]" ShowOnFocus="false">
                <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" aria-label="@Loc["All groups"]" Href="/groups" />
            </MudTooltip>
            <Avatar Name="@group.Name" Size="lg" />
            <div class="gs-identity-who">
                <div class="gs-eyebrow">@(group.IsPersonal ? Loc["Just you"].Value : group.IsArchive ? Loc["Archived group"].Value : Loc["Group"].Value)</div>
                <h1 style="margin-top: 2px">@group.Name</h1>
                @* An expense count told nobody whether the group is still live. When
                   something last happened does. *@
                <p style="margin-top: 2px">
                    @(group.IsPersonal ? Loc["Your own spending"].Value : Loc["{0} member{1}", group.MemberCount, (group.MemberCount == 1 ? "" : "s")].Value)@LastActivity
                </p>
            </div>
            @if (!group.IsPersonal && Current is "settings" or "people")
            {
                <MudButton Class="gs-group-header-archive" Variant="Variant.Outlined" Size="Size.Medium"
                           Disabled="@_archiveBusy" StartIcon="@(group.IsArchive ? Icons.Material.Outlined.Unarchive : Icons.Material.Outlined.Archive)"
                           OnClick="@ToggleArchiveAsync">
                    @(group.IsArchive ? Loc["Restore"].Value : Loc["Archive"].Value)
                </MudButton>
            }
        </div>

    </div>

    <nav class="gs-tabs" aria-label="@Loc["Group sections"]">
        @foreach (var (key, label) in group.IsPersonal ? PersonalSections : Sections)
        {
            <a class="gs-tab @(Current == key ? "is-current" : "")" href="@Href(key)" aria-current="@(Current == key ? "page" : null)">@label</a>
        }

        @* Keep Settings a text tab alongside Balances and Activity. *@
        <MudTooltip Text="@Loc["Settings"]" ShowOnFocus="false">
            <a class="gs-tab gs-settings-tab @(Current is "settings" or "people" ? "is-current" : "")"
               href="@Href("settings")"
               aria-label="@Loc["Settings"]"
               aria-current="@(Current is "settings" or "people" ? "page" : null)">
                <span>@Loc["Settings"]</span>
            </a>
        </MudTooltip>
    </nav>

    @if (Current is "settings" or "people")
    {
        <div class="gs-settings-content @(GroupsService.IsLoading ? "gs-loading" : "")" @key="@($"body-{group.Id}-{Tab}")">
            @if (Current == "settings" && SettingsSection == "overview")
            {
                <section class="gs-group-settings-overview" aria-labelledby="group-settings-title">
                    <div class="gs-settings-heading"><h2 id="group-settings-title">@Loc["Group settings"]</h2></div>
                    <nav class="gs-group-settings-choices" aria-label="@Loc["Settings sections"]">
                        <a href="@Href("details")"><MudIcon Icon="@Icons.Material.Rounded.Home" /><span><strong>@Loc["Group details"]</strong><small>@Loc["Name, description and defaults"]</small></span><MudIcon Icon="@Icons.Material.Rounded.ChevronRight" /></a>
                        @if (!group.IsPersonal)
                        {
                            <a href="@Href("people")"><MudIcon Icon="@Icons.Material.Rounded.People" /><span><strong>@Loc["People"]</strong><small>@Loc["Members, guests and invitations"]</small></span><MudIcon Icon="@Icons.Material.Rounded.ChevronRight" /></a>
                        }
                        <a href="@Href("categories")"><MudIcon Icon="@Icons.Material.Rounded.LocalOffer" /><span><strong>@Loc["Categories"]</strong><small>@Loc["Organise expenses"]</small></span><MudIcon Icon="@Icons.Material.Rounded.ChevronRight" /></a>
                        @if (!group.IsPersonal)
                        {
                            <a href="@Href("rules")"><MudIcon Icon="@Icons.Material.Rounded.PieChart" /><span><strong>@Loc["Split rules"]</strong><small>@Loc["Choose how expenses are shared"]</small></span><MudIcon Icon="@Icons.Material.Rounded.ChevronRight" /></a>
                        }
                    </nav>
                </section>
            }
            else
            {
                <div><a class="gs-settings-back" href="@Href("settings")"><MudIcon Icon="@Icons.Material.Rounded.ArrowBack" />@Loc["Back to group settings"]</a></div>
                @if (Current == "people")
                {
                    <section class="gs-settings-section" aria-labelledby="group-people-title">
                        <div class="gs-settings-heading"><h2 id="group-people-title">@Loc["People"]</h2></div>
                        <GroupMembersTab GroupId="@group.Id" UserInfo="@UserInfo" />
                    </section>
                }
                else
                {
                    <GroupSettingsTab Group="@group" Section="@SettingsSection" />
                }
            }
        </div>
    }
    else
    {
        <div class="gs-stack @(GroupsService.IsLoading ? "gs-loading" : "")" @key="@($"body-{group.Id}-{Current}")">
            @if (Current == "activity")
            {
                <GroupLedgerTab GroupId="@group.Id" Personal="@group.IsPersonal" DefaultPeriod="@group.DefaultPeriod"
                                Kind="@LedgerKind" QueryChanged="OnLedgerQueryChanged" />
            }
            else
            {
                <GroupOverviewTab GroupId="@group.Id" GroupName="@group.Name" UserId="@UserInfo?.Id"
                                  OnSettle="OnSettleAsync" OnRequestPayment="RequestPaymentAsync" />
            }
        </div>
    }

    @if (!group.IsArchive)
    {
        <ExtendedFab Label="@Loc["Add expense"]" AlwaysExtended="true" OnClick="@AddExpenseAsync" />
    }
}
else if (NotFound)
{
    <div class="gs-card gs-empty" style="padding: 64px 24px">
        <MudIcon Icon="@Icons.Material.Rounded.SearchOff" />
        <h3>@Loc["That group is not yours"]</h3>
        <span>@Loc["It may have been deleted, or you may have left it."]</span>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4" Href="/groups">@Loc["Back to your groups"]</MudButton>
    </div>
}

</LoadView>

@code {
    private bool _archiveBusy;

    private async Task ToggleArchiveAsync()
    {
        if (_archiveBusy || Group is not { IsPersonal: false } group) return;
        _archiveBusy = true;
        try
        {
            if (group.IsArchive) await GroupsService.UnarchiveGroupAsync();
            else await GroupsService.ArchiveGroupAsync();
        }
        finally { _archiveBusy = false; }
    }

    [Parameter] public Guid GroupId { get; set; }

    /// <summary>Which section is open, from the URL, so a tab is a place rather than a mode.</summary>
    [Parameter] public string? Tab { get; set; }

    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    /// <summary>
    /// Which kind the ledger is narrowed to, from the query string, so a filtered ledger is
    /// a link rather than a mode. It is what the Expenses and Activity tabs used to be.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "kind")]
    public string? KindParameter { get; set; }

    // The group questions, named for the decision somebody is about to make. Settings is
    // not among them -- it is the cog after them. The old paths still resolve below, so
    // renaming a section does not break a saved link.
    private (string Key, string Label)[] Sections =>
    [
        ("balances", Loc["Balances"].Value),
        ("activity", Loc["Activity"].Value)
    ];

    /// <summary>
    /// A personal group's sections. No balances and no people: it has nobody in it to owe,
    /// be owed or invite, so what is left is what was spent and what it was filed under.
    /// </summary>
    private (string Key, string Label)[] PersonalSections =>
    [
        ("activity", Loc["Activity"].Value)
    ];

    /// <summary>
    /// Whether the group in the URL is not one of this person's. Read off the list rather
    /// than remembered from the last parameter set, so a group that goes while the page is
    /// open -- left from the members tab, say -- turns into this rather than into a page
    /// with nothing on it.
    /// </summary>
    private bool NotFound =>
        GroupsService.IsReadyTask.IsCompleted && GroupsService.Groups.All(candidate => candidate.Id != GroupId);

    /// <summary>
    /// Which section the URL asks for. The retired names remain aliases: a bookmark to a
    /// group's expenses, members, categories or overview still lands in the same place.
    /// </summary>
    private string Current => Group is { IsPersonal: true } && Tab?.ToLowerInvariant() is not ("settings" or "details" or "rules" or "splits" or "categories")
        ? "activity"
        : Tab?.ToLowerInvariant() switch
    {
        "activity" or "ledger" or "expenses" => "activity",
        "people" or "members" => "people",
        // The older URLs remain useful links. Rules and categories are part of the group's
        // Settings now, under the group's own name and default, rather than a peer of its
        // day-to-day views.
        "rules" or "splits" or "categories" or "details" or "settings" => "settings",
        _ => "balances"
    };

    private ActivityKind? LedgerKind =>
        (KindParameter ?? (string.Equals(Tab, "expenses", StringComparison.OrdinalIgnoreCase)
            ? "expense"
            : null))?.ToLowerInvariant() switch
        {
            "expense" or "expenses" => ActivityKind.Expense,
            "settlement" or "settlements" or "transfer" => ActivityKind.Transfer,
            _ => null
        };

    /// <summary>
    /// Puts the ledger's narrowing in the URL without adding a history entry, so the browser's
    /// back button still leaves the group rather than stepping back through every chip.
    /// </summary>
    /// <remarks>
    /// Written onto the tab's own path rather than the one in the address bar: an old
    /// <c>/expenses</c> link implies a kind, and leaving it there would bring the kind back the
    /// moment somebody picked "Everything".
    /// </remarks>
    private void OnLedgerQueryChanged(IReadOnlyDictionary<string, object?> query) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri(Href("activity")).ToString(), query),
            replace: true);

    private string SettingsSection => Tab?.ToLowerInvariant() switch
    {
        "categories" => "categories",
        "rules" or "splits" when Group is not { IsPersonal: true } => "rules",
        "details" => "details",
        _ => "overview"
    };

    private string Href(string key) => key == "balances" || (key == "activity" && Group is { IsPersonal: true })
        ? $"/groups/{GroupId}"
        : $"/groups/{GroupId}/{key}";

    private GroupResponse? Group => GroupsService.SelectedGroup?.Id == GroupId ? GroupsService.SelectedGroup : null;

    /// <summary>
    /// When something last happened here, as a phrase to hang off the member count -- or
    /// nothing at all in a group where nothing has.
    /// </summary>
    /// <remarks>
    /// It replaces the expense count, which was in the header from the beginning and never
    /// answered the question somebody has when they open a group: whether it is still
    /// running. Eleven expenses is the same eleven whether the last one was yesterday or
    /// two years ago.
    /// </remarks>
    private string LastActivity => GroupsService.Transactions?.Items.Count > 0
        ? Loc[" · last activity "].Value + Relative(GroupsService.Transactions.Items.Max(item => Clock.Day(item.DateTime)))
        : "";

    // The row's day the way every transaction date is read (#252): a bank row's is the bank's.
    private string Relative(DateOnly day)
    {
        var days = Clock.TodayDay.DayNumber - day.DayNumber;

        return days switch
        {
            0 => Loc["Copy.Lower.today"].Value,
            1 => Loc["Copy.Lower.yesterday"].Value,
            < 7 => Loc["{0} days ago", days].Value,
            < 31 => Loc["{0} week{1} ago", days / 7, (days / 7 == 1 ? "" : "s")].Value,
            _ when day.Year == Clock.Today.Year => day.ToString("d MMM"),
            _ => day.ToString("d MMM yyyy")
        };
    }

    /// <summary>
    /// Settling with one person, from a line of the overview's plan or from the hero. The
    /// page owns it because it owns the dialog and the write; the tab knows only which line
    /// was pressed.
    /// </summary>
    private Task OnSettleAsync((DebtInfo Debt, SettlementDirection Direction) line) =>
        SettleAsync(line.Debt, line.Direction);

    private async Task RequestPaymentAsync(DebtInfo debt)
    {
        var parameters = new DialogParameters<RequestPaymentDialog>
        {
            { x => x.GroupId, GroupId }, { x => x.RecipientUserId, debt.UserId },
            { x => x.RecipientName, debt.UserName }, { x => x.CurrentDebt, debt.Amount }
        };
        await DialogService.ShowAsync<RequestPaymentDialog>(Loc["Request payment"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true });
    }

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    private void ReRender() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();
        GroupsService.OnGroupsChanged += ReRender;
        GroupsService.OnTransactionsChanged += ReRender;
        GroupsService.OnGroupSelected += ReRender;
    }

    /// <summary>
    /// The URL says which group; the state service holds one at a time and reads its
    /// figures when it changes. So the route selects, rather than a switcher doing it.
    /// </summary>
    /// <remarks>
    /// The figures are awaited as well as asked for, and asked for even when the selection
    /// already matches. A selection that matches is not proof the figures do: the prerender
    /// persists the two separately, and this used to take a matching selection as read and
    /// leave whatever figures came with it -- the previous group's -- on the page for good.
    /// Awaiting them also means the prerendered page carries them, so the interactive one
    /// has nothing to fetch. Keep the view in its loading state until all required
    /// figures describe the group in the current route.
    /// </remarks>
    private bool _initializing = true;
    private int _initializationVersion;

    private async Task ReloadAsync()
    {
        _initializing = true;
        await GroupsService.RefreshAsync();
        await OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _initializing = true;
        var version = ++_initializationVersion;
        await GroupsService.IsReadyTask;
        if (version != _initializationVersion) return;

        if (GroupsService.SelectedGroup?.Id != GroupId
            && GroupsService.Groups.FirstOrDefault(candidate => candidate.Id == GroupId) is { } group)
        {
            GroupsService.SelectedGroup = group;
        }

        if (GroupsService.SelectedGroup?.Id == GroupId)
            await GroupsService.EnsureSelectedLoadedAsync();

        if (version == _initializationVersion) _initializing = false;
    }

    private async Task SettleAsync(DebtInfo debt, SettlementDirection direction)
    {
        // The group the dialog is about, kept for its answer: the route can move on to
        // another group while it is open, and the repayment belongs to this one (#323).
        var groupId = GroupId;

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

        var parameters = new DialogParameters<SettleDialog>
        {
            { x => x.GroupId, groupId },
            { x => x.UserId, debt.UserId },
            { x => x.Username, debt.UserName },
            { x => x.TotalDebt, debt.Amount },
            { x => x.Direction, direction }
        };

        var dialog = await DialogService.ShowAsync<SettleDialog>(Loc["Settle with {0}", debt.UserName].Value, parameters, options);

        var request = await dialog.GetReturnValueAsync<SettleRequest>();

        if (request is not null)
            await GroupsService.SettleAsync(groupId, request, debt.UserName, CancellationToken);
    }

    private async Task AddExpenseAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.SelectedGroupId, GroupId },
            { x => x.SelectedGroupName, Group?.Name },
            { x => x.SelectedGroupCurrency, Group?.Currency }
        };

        var dialog = await DialogService.ShowAsync<CreateTransactionDialog>(Loc["Add an expense"].Value, parameters, options);

        var result = await dialog.Result;
        if (result is null || result.Canceled)
            return;

        if (result.Data is CreateTransactionDialog.Answer withReceipt)
        {
            await GroupsService.CreateTransactionWithReceiptAsync(
                withReceipt.Request, withReceipt.File, withReceipt.Receipt, CancellationToken);
        }
        else if (result.Data is CreateTransactionRequest request)
        {
            await GroupsService.CreateTransactionAsync(request, CancellationToken);
        }
    }

    public async ValueTask DisposeAsync()
    {
        GroupsService.OnGroupsChanged -= ReRender;
        GroupsService.OnTransactionsChanged -= ReRender;
        GroupsService.OnGroupSelected -= ReRender;
        if (_loadCts is not null) await _loadCts.CancelAsync();
    }
}
