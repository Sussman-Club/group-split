@page "/settlement-requests/{Token}"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@inject ISettlement_requestsClient Requests
@inject ApiErrorPresenter Errors

<PageTitle>Settlement request - Group Split</PageTitle>

@if (_request is null)
{
    <div class="gs-card gs-empty" style="padding: 48px 24px">Loading settlement request…</div>
}
else
{
    <section class="gs-card gs-card-pad gs-stack" style="max-width: 560px; margin: 32px auto">
        <div class="gs-eyebrow">Settlement request</div>
        <h1>@_request.RequesterName asked you to pay <Money Value="_request.Amount" /></h1>
        <p>@Groups</p>
        <p class="meta">Created @_request.CreatedAt.LocalDateTime.ToString("d MMM yyyy") · @_request.Currency</p>
        @switch (_request.Status)
        {
            case SettlementRequestStatus.Open:
                <MudText>Pay @_request.RequesterName using the method you both prefer, then record it here. Nothing is recorded automatically.</MudText>
                <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" OnClick="RecordAsync">Record repayment</MudButton>
                break;
            case SettlementRequestStatus.Paid:
                <MudText Color="Color.Success">This repayment has been recorded.</MudText>
                break;
            case SettlementRequestStatus.Cancelled:
                <MudText>This request was cancelled.</MudText>
                break;
            default:
                <MudText>This request is stale because the balance changed. Ask @_request.RequesterName for a new one.</MudText>
                break;
        }
    </section>
}

@code {
    [Parameter] public string Token { get; set; } = "";
    private SettlementRequestResponse? _request;
    private string Groups => _request is null ? "" : string.Join(" · ", _request.Groups.Select(group => group.GroupName));

    protected override async Task OnParametersSetAsync() => await Errors.TryAsync(async () =>
        _request = await Requests.GetSettlementRequestAsync(Token), "Could not open this settlement request.");

    private async Task RecordAsync() => await Errors.TryAsync(async () =>
        _request = await Requests.RecordSettlementRequestRepaymentAsync(Token), "Could not record this repayment.");
}
