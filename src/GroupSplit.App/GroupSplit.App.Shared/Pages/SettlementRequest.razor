@page "/settlement-requests/{Token}"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@inject ISettlement_requestsClient Requests
@inject ApiErrorPresenter Errors
@inject DataChangeNotifier Changes
@inject LocalClock Clock
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>@Loc["Settlement request - Group Split"]</PageTitle>

@if (_error is not null)
{
    <LinkLanding Title="@Loc["This request is unavailable"]" Subtitle="@_error" />
}
else if (_request is null)
{
    <LoadView Loading="true" />
}
else
{
    <section class="gs-card gs-card-pad gs-stack" style="max-width: 560px; margin: 32px auto">
        <div class="gs-eyebrow">@Loc["Settlement request"]</div>
        <h1>@Loc["{0} asked you to pay", _request.RequesterName].Value<Money Value="_request.Amount" Currency="@_request.Currency" /></h1>
        <p>@Loc["For {0}", _request.RecipientName].Value</p>
        @if (_request.Through is { } through)
        {
            <p>@Loc["For activity up to {0:d MMM yyyy}", through]</p>
        }
        <p>@Groups</p>
        <p class="meta">@Loc["Created {0:d MMM yyyy} · {1}", Clock.Day(_request.CreatedAt), _request.Currency]</p>
        @switch (_request.Status)
        {
            case SettlementRequestStatus.Open:
                <MudText>@Loc["Pay {0} using the method you both prefer, then record it here. Nothing is recorded automatically.", _request.RequesterName].Value</MudText>
                <MudTextField Value="@Message" Label="@Loc["Payment message"]" ReadOnly="true" Variant="Variant.Outlined" Lines="3" />
                <MudButton OnClick="CopyAsync">@Loc["Copy payment message"]</MudButton>
                <MudCheckBox T="bool" @bind-Value="_paid" Label="@Loc["I have paid this amount outside GroupSplit"]" />
                <MudButton Variant="Variant.Filled" Class="gs-btn-pill" Color="Color.Primary" Disabled="@(!_paid || _busy)" OnClick="RecordAsync">@Loc["Record repayment"]</MudButton>
                break;
            case SettlementRequestStatus.Paid:
                <MudText Color="Color.Success">@Loc["This repayment has been recorded."]</MudText>
                break;
            case SettlementRequestStatus.Cancelled:
                <MudText>@Loc["This request was cancelled."]</MudText>
                break;
            default:
                <MudText>@Loc["This request is stale because the balance changed. Ask {0} for a new one.", _request.RequesterName].Value</MudText>
                break;
        }
    </section>
}

@code {
    [Parameter] public string Token { get; set; } = "";
    private SettlementRequestResponse? _request;
    private string? _error;
    private bool _paid;
    private bool _busy;
    private string Groups => _request is null ? "" : string.Join(" · ", _request.Groups.Select(group => $"{group.GroupName}: {group.Amount.ToMoney(_request.Currency)}"));
    private string Message => _request is null ? "" : Loc["{0} pays {1} {2} for {3}", _request.RecipientName, _request.RequesterName, _request.Amount.ToMoney(_request.Currency), Groups].Value +
        (_request.Through is { } day ? Loc[", for activity up to {0:d MMM yyyy}.", day].Value : ".");

    protected override async Task OnParametersSetAsync()
    {
        _request = null;
        _paid = false;
        var error = await Errors.CaptureAsync(async () => _request = await Requests.GetSettlementRequestAsync(Token));
        if (error is { Kind: ApiErrorKind.Unauthenticated })
            await Errors.ShowAsync(error);
        _error = error?.Message;
    }

    private async Task RecordAsync()
    {
        if (_busy || !_paid) return;
        _busy = true;
        try
        {
            if (await Errors.TryAsync(async () => _request = await Requests.RecordSettlementRequestRepaymentAsync(Token),
                    Loc["Could not record this repayment."].Value))
                await Changes.NotifyTransactionsChangedAsync();
        }
        finally { _busy = false; }
    }

    private async Task CopyAsync()
    {
        var copied = false;
        try { copied = await JS.InvokeAsync<bool>("gs.copy", Message); }
        catch (JSException) { }
        Snackbar.Add(copied ? Loc["Payment message copied."].Value : Loc["Select the message above and copy it by hand."].Value,
            copied ? Severity.Success : Severity.Info);
    }
}
