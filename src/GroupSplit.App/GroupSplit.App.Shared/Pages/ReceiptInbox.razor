@layout InboxLayout
@page "/inbox/receipts"
@using GroupSplit.Shared
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Models
@using GroupSplit.App.Shared.Services.Errors
@using Microsoft.AspNetCore.Components.Forms
@inject IReceiptsClient Client
@inject IDialogService Dialogs
@inject ApiErrorPresenter Errors
@inject NavigationManager Nav
@inject GroupSplit.App.Shared.Services.InboxOverview Overview
@inject GroupSplit.App.Shared.Services.ReceiptSuggestionCache SuggestionCache
@inject GroupSplit.App.Shared.Services.DataChangeNotifier Changes
@inject GroupSplit.App.Shared.Services.LocalClock Clock
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@Loc["Receipts - Group Split"]</PageTitle>
<div class="gs-inbox-context gs-receipt-context">
    <h2>@Loc["Receipts"]</h2>
    <MudButton Class="gs-receipt-import-action" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.ShoppingBag" OnClick="OpenRetailerImport" Disabled="_busy">@Loc["Import from a store"]</MudButton>
    <span class="gs-muted">@Loc["Your receipts are private until you add them to an expense."]</span>
</div>
@if (_importHelp)
{
    <div class="gs-receipt-import-help" role="status">
        <MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Small" />
        <div>
            <strong>@Loc["We couldn’t open the receipt importer"]</strong>
            <p>@Loc["It may need to be installed, updated, enabled, or reloaded. Follow the steps for Chrome or Edge, then try again."]</p>
            <p><a href="/receipt-importer/install">@Loc["Install or update the receipt importer"]</a></p>
            <p>@Loc["You can still upload a photo or PDF using Add receipt."]</p>
        </div>
    </div>
}
<ExtendedFab Label="@Loc["Add receipt"]" AlwaysExtended="true" OnClick="OpenUpload" />
@if (!_uploading && _uploadProgress is not null) { <p role="status">@_uploadProgress</p> }
<nav class="gs-inline gs-receipt-filters" aria-label="@Loc["Receipt status"]">
    @foreach (var status in Enum.GetValues<ReceiptFilter>())
    {
        <MudButton Variant="@(_filter == status ? Variant.Filled : Variant.Text)" Color="@(_filter == status ? Color.Primary : Color.Default)"
                   Size="Size.Small" Class="gs-btn-pill" Disabled="_busy" aria-pressed="@(_filter == status)" OnClick="@(() => SetFilter(status))">@FilterLabel(status)</MudButton>
    }
</nav>
@if (_filter == ReceiptFilter.Waiting) { <p class="gs-muted">@Loc["Ignored items can be restored later."]</p> }
<div class="gs-receipt-search-bar">
    <MudTextField @bind-Value="_search" @bind-Value:after="SearchChanged" T="string" Immediate="true" DebounceInterval="200" Clearable="true"
                  Placeholder="@Loc["Search merchants or items"]" aria-label="@Loc["Search merchants or items"]"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gs-receipt-search" />
    <DateRangeFilter Value="_dateRange" ValueChanged="SetDateRange" />
</div>
@{ var showLoading = _loading && !_uploading; }
<div class="gs-inbox-results" aria-busy="@_loading">
<div class="gs-inbox-results-content" @key="(_filter, showLoading)">
<LoadView Skeleton="SkeletonLayout.Inbox" Loading="@showLoading" Failed="@(_rows is null && !_uploading)" Retry="Load">
@if (_rows is { Count: 0 })
{
    <div class="gs-card gs-empty gs-receipt-empty">
        <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" />
        <h3>@(_filter == ReceiptFilter.Waiting ? Loc["Your receipts start here"] : _filter == ReceiptFilter.Added ? Loc["Nothing added yet"] : Loc["Nothing ignored"])</h3>
        <p>@(_filter == ReceiptFilter.Waiting ? Loc["Keep a receipt now, then add it to an expense when you are ready."] : _filter == ReceiptFilter.Added ? Loc["Receipts attached to an expense appear here."] : Loc["Ignored receipts stay here until you restore or delete them."])</p>
        @if (_filter == ReceiptFilter.Waiting)
        {
            <div class="gs-receipt-empty-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="OpenUpload">@Loc["Upload a receipt"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="OpenRetailerImport">@Loc["Import from a store"]</MudButton>
            </div>
        }
    </div>
}
else if (_rows is not null && _visibleRows.Count == 0)
{
    <div class="gs-card gs-empty gs-receipt-empty" role="status"><MudIcon Icon="@Icons.Material.Rounded.SearchOff" /><h3>@Loc["No receipts match your filters."]</h3><MudButton OnClick="ClearFilters">@Loc["Clear filters"]</MudButton></div>
}
else if (_rows is not null)
{
    <div class="gs-card gs-receipt-inbox-list">
    @foreach (var row in _pageRows)
    {
        var source = row.Attachments.FirstOrDefault();
        <div class="gs-receipt-inbox-entry @(_filter == ReceiptFilter.Added ? "is-added" : null) @(_suggestions.ContainsKey(row.Id) || _expenseMatches.ContainsKey(row.Id) ? "has-suggestion" : null)" @key="row.Id">
        <a class="gs-receipt-inbox-row" href="@($"/inbox/receipts/{row.Id}{new Uri(Nav.Uri).Query}")">
            <div class="gs-receipt-inbox-thumb">
                <MerchantMark MerchantName="@(row.MerchantDisplayName ?? row.Receipt.MerchantName)" MerchantLogoUrl="@row.MerchantLogoUrl" />
            </div>
            <div class="gs-receipt-inbox-copy"><strong>@(row.MerchantDisplayName ?? row.Receipt.MerchantName ?? Loc["New receipt"].Value)</strong><span>@(row.Receipt.PurchaseDate?.ToString("MMM d, yyyy") ?? Loc["Add purchase date"].Value) · @(source is null ? Loc["Manual entry"].Value : source.ContentType == "application/pdf" ? "PDF" : Loc["Photo"].Value)</span>@if (_filter == ReceiptFilter.Added && row.ExpenseName is not null) { <span>@Loc["Added to: {0}", row.ExpenseName]</span> }@if (row.PossibleDuplicates.Count > 0) { <span class="gs-receipt-duplicate">@Loc["Possible duplicate receipt"]</span> }</div>
            <div class="gs-receipt-inbox-end"><Money Value="@row.Receipt.Total" Currency="@row.Currency" /></div>
        </a>
        @if (_filter == ReceiptFilter.Added && row.ExpenseId is { } expenseId)
        {
            <div class="gs-receipt-inbox-actions gs-inbox-added-actions"><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" aria-label="@Loc["View expense"]" OnClick="@(() => OpenExpense(expenseId))">@Loc["View expense"]</MudButton></div>
        }
        else if (_filter != ReceiptFilter.Added)
        {
            <div class="gs-receipt-inbox-actions">
                @if (_filter == ReceiptFilter.Waiting && row.SuggestedDuplicateOfId is not null)
                {
                    <div class="gs-receipt-inbox-shortcut">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy" OnClick="@(() => ReviewDuplicate(row))">@Loc["Review and delete duplicate"]</MudButton>
                    </div>
                }
                else if (_expenseMatches.TryGetValue(row.Id, out var match))
                {
                    <div class="gs-inbox-suggestion is-highlighted">
                        <div class="gs-inbox-suggestion-copy"><span class="gs-inbox-suggestion-label"><MudIcon Icon="@Icons.Material.Rounded.CompareArrows" Size="Size.Small" />@Loc["Possible match"]</span><strong>@match.Name</strong><small>@match.Amount.ToString("N2") @match.Currency · @match.DateTime.ToString("d")</small></div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" aria-label="@Loc["Review possible match: {0}", match.Name]" OnClick="@(() => AttachMatch(row, match))">@Loc["Review"]</MudButton>
                    </div>
                }
                else if (_suggestions.TryGetValue(row.Id, out var destination))
                {
                    <div class="gs-inbox-suggestion is-highlighted">
                        <div class="gs-inbox-suggestion-copy"><span class="gs-inbox-suggestion-label"><MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" />@Loc["Suggested destination"]</span><strong>@destination.Destination</strong></div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" aria-label="@Loc["Review suggested destination: {0}", destination.Destination]" OnClick="@(() => ReviewSuggestion(row, destination))">@Loc["Review"]</MudButton>
                    </div>
                }
                else if (_filter == ReceiptFilter.Waiting)
                {
                    <div class="gs-receipt-inbox-shortcut">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="@(() => ReviewSuggestion(row, null))">@Loc["Add to group"]</MudButton>
                    </div>
                }
                <div class="gs-receipt-inbox-state-action"><MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy" OnClick="@(() => SetIgnored(row, _filter == ReceiptFilter.Waiting))">@(_filter == ReceiptFilter.Waiting ? Loc["Ignore"] : Loc["Restore"])</MudButton></div>
            </div>
        }
        </div>
    }
    @if (_pageRows.Count < _visibleRows.Count)
    {
        <div class="gs-inbox-show-more">
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ShowMore">@Loc["Show more ({0} of {1})", _pageRows.Count, _visibleRows.Count]</MudButton>
        </div>
    }
    </div>
}
</LoadView>
</div>
</div>
@code {
    private List<ReceiptInboxResponse>? _rows;
    private List<ReceiptInboxResponse> _visibleRows = [];
    private List<ReceiptInboxResponse> _pageRows = [];
    private const int PageSize = 25;
    private int _shownCount = PageSize;
    private string? _search;
    private DateFilter _dateRange = DateFilter.AllTime;
    private enum ReceiptFilter { Waiting, Added, Ignored }
    private ReceiptFilter _filter;
    private bool _busy;
    private bool _uploading;
    private string? _uploadProgress;
    private bool _loading = true;
    private bool _importHelp;
    private IJSObjectReference? _importModule;
    private DotNetObjectReference<ReceiptInbox>? _importReference;
    private readonly Dictionary<Guid, FilingDestinationSuggestion> _suggestions = [];
    private readonly Dictionary<Guid, ReceiptExpenseCandidate> _expenseMatches = [];
    private CancellationTokenSource? _suggestionLoad;
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParameter { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchParameter { get; set; }
    [SupplyParameterFromQuery(Name = "range")] public string? RangeParameter { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromParameter { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToParameter { get; set; }
    private sealed record FilterQuery(string? Status, string? Search, string? Range, string? From, string? To);
    private FilterQuery? _settled;
    private FilterQuery Asked => new(StatusParameter, SearchParameter, RangeParameter, FromParameter, ToParameter);
    protected override async Task OnParametersSetAsync()
    {
        var asked = Asked;
        if (asked == _settled) return;
        var previous = _filter;
        var first = _settled is null;
        _settled = asked;
        _filter = asked.Status?.ToLowerInvariant() switch { "added" or "filed" => ReceiptFilter.Added, "ignored" => ReceiptFilter.Ignored, _ => ReceiptFilter.Waiting };
        _search = asked.Search;
        _dateRange = ListingQuery.ParseRange(asked.Range, asked.From, asked.To, DateFilter.AllTime);
        if (first || previous != _filter) { _shownCount = PageSize; _rows = null; await Load(); }
        else { _shownCount = PageSize; ApplyFilters(); }
    }
    private void WriteUrl()
    {
        var (range, from, to) = ListingQuery.FormatRange(_dateRange, DateFilter.AllTime);
        var current = new FilterQuery(_filter switch { ReceiptFilter.Added => "added", ReceiptFilter.Ignored => "ignored", _ => null },
            string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(), range, from, to);
        if (current == _settled) return;
        _settled = current;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["status"] = current.Status, ["q"] = current.Search, ["range"] = current.Range, ["from"] = current.From, ["to"] = current.To }), replace: true);
    }
    private void ApplyFilters()
    {
        var search = _search?.Trim();
        var bounds = _dateRange.Days(Clock.Today);
        _visibleRows = (_rows ?? []).Where(row =>
        {
            if (!string.IsNullOrEmpty(search) && !(row.MerchantDisplayName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                row.Receipt.MerchantName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                row.Receipt.Items.Any(item => item.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))) return false;
            if (bounds.From is null && bounds.To is null) return true;
            return row.Receipt.PurchaseDate is { } date && (bounds.From is null || date >= bounds.From) && (bounds.To is null || date <= bounds.To);
        }).ToList();
        _pageRows = _visibleRows.Take(_shownCount).ToList();
    }
    private void ShowMore() { _shownCount += PageSize; ApplyFilters(); }
    private void SearchChanged() { _shownCount = PageSize; ApplyFilters(); WriteUrl(); }
    private void SetDateRange(DateFilter range) { _shownCount = PageSize; _dateRange = range; ApplyFilters(); WriteUrl(); }
    private void ClearFilters() { _shownCount = PageSize; _search = null; _dateRange = DateFilter.AllTime; ApplyFilters(); WriteUrl(); }
    private string FilterLabel(ReceiptFilter status) => status switch { ReceiptFilter.Waiting => Loc["Waiting"], ReceiptFilter.Added => Loc["Added"], _ => Loc["Ignored"] };
    private async Task SetFilter(ReceiptFilter status) { if (_filter == status) return; _filter = status; _shownCount = PageSize; _rows = null; WriteUrl(); await Load(); }
    private Task OpenExpense(Guid id) => Dialogs.ShowAsync<TransactionDetailsDialog>(Loc["Transaction Details"].Value,
        new DialogParameters<TransactionDetailsDialog> { { x => x.TransactionId, id } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
    private async Task SetIgnored(ReceiptInboxResponse row, bool ignored)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (await Errors.TryAsync(async () => { if (ignored) await Client.IgnoreInboxReceiptAsync(row.Id); else await Client.RestoreInboxReceiptAsync(row.Id); }, Loc["Could not update receipt."].Value))
            {
                await Changes.NotifyReceiptsChangedAsync();
                await Load();
            }
        }
        finally { _busy = false; }
    }
    private async Task OpenRetailerImport()
    {
        try
        {
            _importModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GroupSplit.App.Shared/js/receipt-importer.js");
            if (_importReference is null)
            {
                _importReference = DotNetObjectReference.Create(this);
                await _importModule.InvokeVoidAsync("watchReceipts", _importReference);
            }
            _importHelp = !await _importModule.InvokeAsync<bool>("openReceiptImporter");
        }
        catch (JSException) { _importHelp = true; }
    }
    private async Task ReviewDuplicate(ReceiptInboxResponse row)
    {
        if (_busy || row.SuggestedDuplicateOfId is null) return;
        if (await Dialogs.ShowMessageBoxAsync(Loc["Delete possible duplicate?"].Value,
            Loc["This receipt appears to describe the same purchase as another receipt. Check both before deleting. Deleting this receipt also deletes its original files and cannot be undone."].Value,
            yesText: Loc["Delete receipt"].Value, cancelText: Loc["Cancel"].Value) != true) return;
        _busy = true;
        try
        {
            if (await Errors.TryAsync(() => Client.DeleteReceiptInboxAsync(row.Id), Loc["Could not update receipt."].Value))
            {
                await Changes.NotifyReceiptsChangedAsync();
                await Load();
            }
        }
        finally { _busy = false; }
    }
    private async Task Load()
    {
        _loading = true;
        _suggestionLoad?.Cancel();
        _suggestionLoad?.Dispose();
        _suggestionLoad = new CancellationTokenSource();
        var token = _suggestionLoad.Token;
        _suggestions.Clear();
        _expenseMatches.Clear();
        try { await Errors.TryAsync(async () => {
            var loaded = (await (_filter switch { ReceiptFilter.Added => Client.ListAddedReceiptInboxAsync(token), ReceiptFilter.Ignored => Client.ListIgnoredReceiptInboxAsync(token), _ => Client.ListReceiptInboxAsync(token) })).ToList();
            if (token.IsCancellationRequested) return;
            _rows = loaded;
            ApplyFilters();
            if (_filter == ReceiptFilter.Waiting)
            {
                SuggestionCache.Retain(_rows);
                foreach (var row in _rows)
                    if (SuggestionCache.Get(row) is { } cached) _suggestions[row.Id] = cached;
                Overview.SetReceiptCount(_rows.Count);
                await Task.WhenAll(LoadExpenseMatches(_rows, token),
                    LoadSuggestions(_rows, SuggestionCache.Generation, token));
            }
        }, Loc["Could not load receipts."].Value); }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }
    private async Task LoadExpenseMatches(IReadOnlyList<ReceiptInboxResponse> rows, CancellationToken ct)
    {
        try
        {
            foreach (var batch in rows.Where(row => row.Receipt.PurchaseDate.HasValue && row.Receipt.Total != 0).Chunk(4))
            {
                var results = await Task.WhenAll(batch.Select(async row =>
                {
                    try
                    {
                        var day = row.Receipt.PurchaseDate!.Value.DayNumber;
                        var matches = await Client.MatchReceiptInboxAsync(row.Id, ct);
                        var match = matches.Where(match => !match.HasReceipt).OrderBy(match =>
                            Math.Abs(DateOnly.FromDateTime(match.DateTime.UtcDateTime).DayNumber - day)).FirstOrDefault();
                        return (row.Id, Match: match);
                    }
                    catch (Exception exception) when (ApiErrors.IsApiFailure(exception)) { return (row.Id, Match: (ReceiptExpenseCandidate?)null); }
                }));
                if (ct.IsCancellationRequested) return;
                await InvokeAsync(() =>
                {
                    if (ct.IsCancellationRequested) return;
                    foreach (var (id, match) in results)
                    {
                        if (match is not null) _expenseMatches[id] = match;
                    }
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    private async Task LoadSuggestions(IReadOnlyList<ReceiptInboxResponse> rows, long generation, CancellationToken ct)
    {
        try
        {
            foreach (var batch in rows.Where(row => row.Receipt.Items.Count > 0 && !_suggestions.ContainsKey(row.Id)).Chunk(ReceiptInboxSuggestionsRequest.MaxRows))
            {
                IReadOnlyCollection<ReceiptInboxSuggestion> suggestions;
                try
                {
                    suggestions = (await Client.SuggestReceiptInboxFilingsAsync(new ReceiptInboxSuggestionsRequest { ReceiptIds = batch.Select(row => row.Id).ToArray() }, ct)).ToArray();
                }
                catch (Exception exception) when (ApiErrors.IsApiFailure(exception)) { continue; }
                if (ct.IsCancellationRequested) return;
                await InvokeAsync(() => {
                    if (ct.IsCancellationRequested || generation != SuggestionCache.Generation) return;
                    var byId = batch.ToDictionary(row => row.Id);
                    foreach (var suggestion in suggestions)
                        if (byId.TryGetValue(suggestion.ReceiptId, out var row))
                        {
                            SuggestionCache.Remember(row, suggestion.Destination, generation);
                            _suggestions[row.Id] = suggestion.Destination;
                        }
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    [JSInvokable] public async Task RefreshImportedReceipts() => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
    public async ValueTask DisposeAsync()
    {
        _suggestionLoad?.Cancel(); _suggestionLoad?.Dispose();
        if (_importModule is not null)
        {
            try { await _importModule.InvokeVoidAsync("stopWatching"); await _importModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _importReference?.Dispose();
    }
    private string Source(Guid r, Guid a) => Nav.BaseUri + $"api/receipts/inbox/{r}/files/{a}";
    private async Task OpenUpload()
    {
        if (_busy) return;
        await Dialogs.ShowAsync<ReceiptUploadDialog>(Loc["Add receipt"].Value,
            new DialogParameters<ReceiptUploadDialog> { { dialog => dialog.FileChanged, EventCallback.Factory.Create<InputFileChangeEventArgs>(this, Upload) } },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = false, BackdropClick = false });
    }
    private async Task AttachMatch(ReceiptInboxResponse row, ReceiptExpenseCandidate match)
    {
        if (_busy) return;
        IReadOnlyList<ReceiptExpenseCandidate>? matches = null;
        if (!await Errors.TryAsync(async () => matches = (await Client.MatchReceiptInboxAsync(row.Id)).Where(candidate => !candidate.HasReceipt).ToList(), Loc["Could not check for matching expenses."].Value)) return;
        var dialog = await Dialogs.ShowAsync<ReceiptMatchDialog>(Loc["Review receipt match"].Value,
            new DialogParameters<ReceiptMatchDialog> { { x => x.Row, row }, { x => x.Matches, matches! }, { x => x.InitialId, match.Id } },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true });
        if (await dialog.Result is not { Canceled: false, Data: ReceiptMatchDialog.Answer answer }) return;
        if (answer.Action == ReceiptMatchDialog.Action.Create)
        {
            await ReviewSuggestion(row, _suggestions.GetValueOrDefault(row.Id), true);
            return;
        }
        if (answer.ExpenseId is not { } expenseId) return;
        _busy = true;
        try
        {
            if (answer.Action == ReceiptMatchDialog.Action.Dismiss)
            {
                if (await Errors.TryAsync(() => Client.DismissReceiptInboxMatchAsync(row.Id, expenseId), Loc["Could not dismiss match."].Value)) await Load();
                return;
            }
            if (await Errors.TryAsync(async () => await Client.FileReceiptInboxAsync(row.Id,
                    new FileReceiptInboxRequest { ExpenseId = expenseId }), Loc["Could not file receipt."].Value))
            {
                await Changes.NotifyReceiptsChangedAsync();
                await Changes.NotifyTransactionsChangedAsync();
                await Load();
            }
        }
        finally { _busy = false; }
    }
    private async Task ReviewSuggestion(ReceiptInboxResponse row, FilingDestinationSuggestion? suggestion, bool confirmedNew = false)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            IReadOnlyList<ReceiptExpenseCandidate>? matches = null;
            if (!await Errors.TryAsync(async () => matches = (await Client.MatchReceiptInboxAsync(row.Id)).ToList(), Loc["Could not check for matching expenses."].Value)) return;
            var dialog = await Dialogs.ShowAsync<CreateTransactionDialog>(Loc["Create expense"].Value,
                new DialogParameters<CreateTransactionDialog>
                {
                    { x => x.InboxReceipt, row.Receipt }, { x => x.InboxCurrency, row.Currency }, { x => x.InboxMerchantId, row.MerchantId },
                    { x => x.SelectedGroupId, suggestion is { IsPersonal: false } ? suggestion.GroupId : null },
                    { x => x.InboxSuggestion, suggestion }
                }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
            if (await dialog.Result is not { Canceled: false, Data: CreateTransactionRequest request }) return;
            var createAnyway = confirmedNew || matches!.Count > 0 && await Dialogs.ShowMessageBoxAsync(Loc["Possible duplicate"].Value,
                Loc["These matching expenses may already record this purchase. Create another expense?"].Value,
                yesText: Loc["Create another"].Value, cancelText: Loc["Cancel"].Value) == true;
            if (matches.Count > 0 && !createAnyway) return;
            if (await Errors.TryAsync(async () => await Client.FileReceiptInboxAsync(row.Id,
                    new FileReceiptInboxRequest { NewExpense = request, CreateAnyway = createAnyway }), Loc["Could not file receipt."].Value))
            {
                await Changes.NotifyReceiptsChangedAsync();
                await Changes.NotifyTransactionsChangedAsync();
                await Load();
            }
        }
        finally { _busy = false; }
    }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        const int maximumFiles = 100;
        if (args.FileCount > maximumFiles)
        {
            _uploadProgress = Loc["Choose no more than 100 receipts at a time."].Value;
            return;
        }
        _busy = true;
        _uploading = true;
        _uploadProgress = null;
        try
        {
            var files = args.GetMultipleFiles(maximumFiles);
            var completed = 0;
            var failed = 0;
            var alreadyImported = 0;
            Guid? singleReceiptId = null;
            foreach (var file in files)
            {
                _uploadProgress = Loc["Importing receipt {0} of {1}…", completed + failed + alreadyImported + 1, files.Count].Value;
                await InvokeAsync(StateHasChanged);
                var alreadyExists = false;
                var succeeded = await Errors.TryAsync(async () =>
                {
                    var id = Guid.NewGuid();
                    await using var stream = file.OpenReadStream(10 * 1024 * 1024);
                    var uploaded = await Client.UploadInboxReceiptFileAsync(id, new FileParameter(stream, file.Name, file.ContentType));
                    singleReceiptId = uploaded.ReceiptId ?? id;
                    alreadyExists = singleReceiptId != id;
                    if (!alreadyExists)
                    {
                        _uploadProgress = Loc["Reading receipt…"].Value;
                        await InvokeAsync(StateHasChanged);
                        await Errors.TryAsync(async () =>
                        {
                            var draft = await Client.TranscribeInboxReceiptAsync(singleReceiptId.Value, uploaded.Id);
                            await Client.SaveExtractedInboxReceiptAsync(singleReceiptId.Value, draft.Receipt);
                        }, Loc["Could not read the receipt. You can review it and enter the details manually."].Value);
                    }
                }, Loc["Could not upload receipt: {0}", file.Name].Value);
                if (!succeeded) failed++;
                else if (alreadyExists) alreadyImported++;
                else completed++;
            }
            if (files.Count == 1 && failed == 0 && singleReceiptId is { } receiptId)
            {
                Nav.NavigateTo($"/inbox/receipts/{receiptId}");
                return;
            }
            _uploadProgress = Loc["Finished: {0} uploaded, {1} already in your inbox, {2} failed.", completed, alreadyImported, failed].Value;
            _filter = ReceiptFilter.Waiting;
            await Load();
        }
        finally { _busy = false; _uploading = false; }
    }
}
