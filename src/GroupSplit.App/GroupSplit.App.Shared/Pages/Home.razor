@page "/"
@using GroupSplit.Shared
@attribute [AllowAnonymous]

<PageTitle>Group Split</PageTitle>

<MudStack Spacing="6">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4" Class="font-weight-bold">
            @(UserInfo is null ? "Welcome to Group Split" : $"Welcome back, {UserInfo.FirstName}")
        </MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary">
            Track what your group spends, split it by the rules you choose, and settle up.
        </MudText>
    </MudStack>

    @if (UserInfo is null)
    {
        <MudPaper Elevation="0" Class="gs-surface-card pa-6">
            <MudStack Spacing="4" AlignItems="AlignItems.Start">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Sign in to see your groups and balances.
                </MudText>
                <MudStack Row Spacing="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">Sign in</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/signup">Create an account</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="4">
            @Shortcut("Groups", "Everyone you split with", Icons.Material.Filled.Groups, "/groups")
            @Shortcut("Transactions", "What has been spent", Icons.Material.Filled.Receipt, "/transactions")
            @Shortcut("Account", "Your profile and security", Icons.Material.Filled.AccountCircle, "/account")
        </MudGrid>
    }
</MudStack>

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private RenderFragment Shortcut(string title, string description, string icon, string href) =>
        @<MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0" Class="gs-surface-card gs-shortcut pa-5" Style="height: 100%">
                <MudLink Href="@href" Underline="Underline.None">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@icon" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@title</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@description</MudText>
                    </MudStack>
                </MudLink>
            </MudPaper>
        </MudItem>;
}
