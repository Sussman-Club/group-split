@page "/account"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject IUsersClient Users
@inject IDialogService DialogService

<PageTitle>Account - Group Split</PageTitle>

<MudStack Spacing="6">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h5" Class="font-weight-bold">Account</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Your profile details, as held by the Group Split identity provider.
        </MudText>
    </MudStack>

    @if (UserInfo is null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            You are not signed in. <MudLink Href="/login">Sign in</MudLink> to see your account.
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Class="gs-surface-card pa-6">
            <MudStack Spacing="5">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large">@Initials</MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@UserInfo.FullName</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@UserInfo.Email</MudText>
                    </MudStack>
                </MudStack>

                <MudDivider />

                <MudStack Spacing="3">
                    @Field("First name", UserInfo.FirstName)
                    @Field("Last name", UserInfo.LastName)
                    @Field("Email", UserInfo.Email)
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Class="gs-surface-card pa-6">
            <MudStack Spacing="4">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Security</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Passwords, two-factor authentication and active sessions are managed by the
                        identity provider.
                    </MudText>
                </MudStack>
                <MudStack Row Spacing="3" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ManageAccounts"
                               OnClick="OpenAccountConsole">
                        Manage account
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Logout"
                               OnClick="LogoutAsync">
                        Sign out
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Class="gs-surface-card pa-6">
            <MudStack Spacing="4">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Delete account</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Removes your name and email address, and unlinks your sign-in. Expenses you
                        recorded stay in their groups, because they are what everyone else's share
                        was worked out from. You have to settle up in every group first.
                    </MudText>
                </MudStack>

                @if (_blocking is { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Class="font-weight-medium">
                                Settle up in these groups first:
                            </MudText>
                            @foreach (var group in _blocking)
                            {
                                <MudText Typo="Typo.body2">
                                    @group.GroupName &mdash; @group.Balance.ToString("C")
                                </MudText>
                            }
                        </MudStack>
                    </MudAlert>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
                }

                <MudStack Row Spacing="3" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               Disabled="@_deleting"
                               OnClick="ConfirmDeleteAsync">
                        Delete my account
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private string Initials => string.Concat(
        (UserInfo?.FullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]));

    private IReadOnlyList<OutstandingBalance>? _blocking;

    private string? _error;

    private bool _deleting;

    private Task LogoutAsync() => AuthService.Logout();

    private async Task ConfirmDeleteAsync()
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, "Delete your account? Your name and email address are removed and your sign-in is unlinked. This cannot be undone." },
            { x => x.ButtonText, "Delete account" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete account", parameters);

        if (await dialog.GetReturnValueAsync<bool>())
        {
            await DeleteAsync();
        }
    }

    private async Task DeleteAsync()
    {
        _deleting = true;
        _blocking = null;
        _error = null;

        try
        {
            await Users.DeleteCurrentUserAsync();

            // The account no longer exists, so the session points at nothing. Signing out
            // is what clears it -- and without it the next request would provision a
            // fresh, empty account under the same sign-in.
            await AuthService.Logout();
        }
        catch (ApiException<ICollection<OutstandingBalance>> conflict)
        {
            // The groups come back named so the reason is actionable rather than a refusal.
            _blocking = conflict.Result.ToList();
        }
        catch (ApiException)
        {
            _error = "We could not delete your account. Please try again in a moment.";
        }
        finally
        {
            _deleting = false;
        }
    }

    // A BFF endpoint, not a Blazor route: the router would otherwise intercept
    // the navigation and fail to match it.
    private void OpenAccountConsole() => Nav.NavigateTo("/auth/account", forceLoad: true);

    private RenderFragment Field(string label, string? value) =>
        @<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="4">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@label</MudText>
            <MudText Typo="Typo.body2" Class="font-weight-medium">@(string.IsNullOrWhiteSpace(value) ? "Not set" : value)</MudText>
        </MudStack>;
}
