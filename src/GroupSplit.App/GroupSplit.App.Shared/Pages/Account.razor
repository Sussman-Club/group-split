@using GroupSplit.App.Shared.Localization
@using Microsoft.Extensions.Localization
@page "/account"
@page "/settings"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@using GroupSplit.Shared.Errors
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject IUsersClient Users
@inject IDialogService DialogService
@inject ApiErrorPresenter Errors
@inject AppLinks AppLinks
@inject IJSRuntime JS

<PageTitle>@Loc["Settings - Group Split"]</PageTitle>

@if (UserInfo is null)
{
    <div class="gs-card gs-empty" style="padding: 64px 24px">
        <MudIcon Icon="@Icons.Material.Rounded.AccountCircle" />
        <h3>@Loc["You are not signed in"]</h3>
        <span>@Loc["Sign in to manage your settings."]</span>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4" Href="/login">@Loc["Sign in"]</MudButton>
    </div>
}
else
{
    <div class="gs-page-head">
        <div>
            <h1>@Loc["Settings"]</h1>
            <p>@Loc["Your profile, preferences, and connected accounts."]</p>
        </div>
    </div>

    <div class="gs-settings-identity">
        <div class="gs-inline" style="gap: 20px">
            <span class="gs-avatar-ring">
                <Avatar Name="@UserInfo.FullName" Size="xl" />
            </span>
            <div>
                <h2>@UserInfo.FullName</h2>
                <p>@UserInfo.Email</p>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="gs-btn-pill"
                   StartIcon="@Icons.Material.Rounded.Logout" OnClick="LogoutAsync">@Loc["Sign out"]</MudButton>
    </div>

    <div class="gs-settings-layout">
        <nav class="gs-settings-nav" aria-label="@Loc["Settings sections"]">
            <a href="@SectionHref("settings-profile")" @onclick='() => ScrollToSectionAsync("settings-profile")' @onclick:preventDefault><MudIcon Icon="@Icons.Material.Rounded.PersonOutline" />@Loc["Profile & security"]</a>
            <a href="@SectionHref("settings-preferences")" @onclick='() => ScrollToSectionAsync("settings-preferences")' @onclick:preventDefault><MudIcon Icon="@Icons.Material.Rounded.Tune" />@Loc["Preferences"]</a>
            <a href="@SectionHref("settings-banks")" @onclick='() => ScrollToSectionAsync("settings-banks")' @onclick:preventDefault><MudIcon Icon="@Icons.Material.Rounded.AccountBalance" />@Loc["Connected banks"]</a>
            <a href="@SectionHref("settings-data")" @onclick='() => ScrollToSectionAsync("settings-data")' @onclick:preventDefault><MudIcon Icon="@Icons.Material.Rounded.FolderOpen" />@Loc["Data & privacy"]</a>
        </nav>
        <div class="gs-settings-content">
        <section id="settings-profile" class="gs-settings-section" aria-labelledby="settings-profile-title">
            <div class="gs-settings-heading"><h2 id="settings-profile-title">@Loc["Profile & security"]</h2><p>@Loc["Your personal details and sign-in options."]</p></div>
            <div class="gs-card gs-card-pad">
                <div class="gs-card-title">
                    <h2>@Loc["Profile"]</h2>
                    <span class="gs-tag neutral">@Loc["Read only"]</span>
                </div>
                <dl class="gs-kv">
                    @Field(Loc["First name"], UserInfo.FirstName)
                    @Field(Loc["Last name"], UserInfo.LastName)
                    @Field(Loc["Email"], UserInfo.Email)
                </dl>
                <p class="gs-muted">@Loc["Update these details with Manage account below."]</p>
            </div>

            <div class="gs-card gs-card-pad">
                <div class="gs-card-title">
                    <h2>@Loc["Security"]</h2>
                </div>
                <p class="gs-muted" style="margin: 0; font-size: .875rem">@Loc["Passwords, two-factor authentication and active sessions are managed by the identity provider."]</p>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="gs-account-action"
                           StartIcon="@Icons.Material.Rounded.ManageAccounts"
                           EndIcon="@Icons.Material.Rounded.OpenInNew"
                           OnClick="OpenAccountConsole">@Loc["Manage account"]</MudButton>
            </div>
        </section>

        <section id="settings-preferences" class="gs-settings-section" aria-labelledby="settings-preferences-title">
            <div class="gs-settings-heading"><h2 id="settings-preferences-title">@Loc["Preferences"]</h2><p>@Loc["Make Group Split feel right on this device."]</p></div>
            <div class="gs-card gs-card-pad gs-settings-appearance">
                <div><h3>@Loc["Appearance"]</h3><p class="gs-muted">@Loc["Choose light, dark, or follow your device."]</p></div>
                <ThemeModeMenu />
            </div>
            <LanguagePicker Language="@UserInfo.PreferredLanguage" />
            <PushNotificationsCard />
        </section>

        <section id="settings-banks" class="gs-settings-section" aria-labelledby="settings-banks-title">
            <div class="gs-settings-heading"><h2 id="settings-banks-title">@Loc["Connected banks"]</h2><p>@Loc["Manage the bank connections used to import your expenses."]</p></div>
            <LinkedBanksCard />
        </section>

        <section id="settings-data" class="gs-settings-section" aria-labelledby="settings-data-title">
            <div class="gs-settings-heading"><h2 id="settings-data-title">@Loc["Data & privacy"]</h2><p>@Loc["Keep a copy of your records or manage your account's future."]</p></div>
            <div class="gs-card gs-card-pad">
                <div class="gs-card-title"><h2>@Loc["Your records"]</h2></div>
                <p class="gs-muted">@Loc["Download your records and original receipts as a ZIP."]</p>
                @if (AppLinks.IsNative)
                {
                    <p>@Loc["To download your records and receipt files, sign in on the website."]</p>
                    <MudButton Href="@AppLinks.PublicUrl(Nav.BaseUri, "account")" Target="_blank"
                               Class="gs-account-action" StartIcon="@Icons.Material.Rounded.OpenInNew"
                               Variant="Variant.Outlined">@Loc["Open account on website"]</MudButton>
                }
                else
                {
                    <MudButton OnClick="ExportAsync" Disabled="_exporting" Variant="Variant.Outlined"
                               Class="gs-account-action" aria-label="@Loc["Download my records and receipt files (ZIP)"]"
                               StartIcon="@Icons.Material.Rounded.Download">
                        @(_exporting ? Loc["Preparing ZIP…"].Value : Loc["Download ZIP"].Value)
                    </MudButton>
                    @if (_exportError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3" role="alert">@_exportError</MudAlert>
                    }
                }
            </div>

            <div class="gs-card gs-card-pad gs-danger-zone">
                <div class="gs-card-title">
                    <h2>@Loc["Delete account"]</h2>
                </div>
                <p class="gs-muted">@Loc["Settle up in every group first. Deletes your profile, sign-in, bank connections and personal receipts. Shared expenses and anonymised ledger records remain."]</p>
                <details class="gs-settings-data-details">
                    <summary>@Loc["What happens to your data"]</summary>
                    <p class="gs-muted" style="margin: 0 0 16px; font-size: .875rem">@Loc["Removes your name and email address, and deletes your sign-in: your password, any linked Google account and every session you have open. Expenses you recorded stay in their groups, because they are what everyone else's share was worked out from. You have to settle up in every group first."]</p>
                    <p class="gs-muted">@Loc["Linked banks and imported bank rows are removed. A bank provider failure may leave deletion unfinished; retry after the bank service recovers. Items whose access cannot be read are recorded for administrator cleanup. Personal receipt files are deleted; shared expenses, their receipts, settlements and anonymised personal ledger records are retained. Failed receipt or sign-in cleanup is recorded for retry. Backups may retain older data until the operator's configured backup expiry; there is no application-enforced expiry period."]</p>
                </details>

                @if (_blocking is { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                        <div style="font-weight: 700; font-size: .875rem; margin-bottom: 4px">@Loc["Settle up in these groups first:"]</div>
                        @foreach (var group in _blocking)
                        {
                            <div class="gs-inline" style="justify-content: space-between; font-size: .875rem">
                                <span>@group.GroupName</span>
                                <Money Value="group.Balance" />
                            </div>
                        }
                    </MudAlert>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Class="gs-account-action gs-btn-danger"
                           StartIcon="@Icons.Material.Rounded.DeleteForever"
                           Disabled="@_deleting"
                           OnClick="ConfirmDeleteAsync">@Loc["Delete my account"]</MudButton>
            </div>
        </section>
        </div>
    </div>
}

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private IReadOnlyList<OutstandingBalance>? _blocking;

    private string? _error;

    private bool _deleting;
    private bool _exporting;
    private string? _exportError;

    // Fragment-only links resolve against the app's <base href="/">, not this page.
    // Keep the current route (including /account) and replace only its fragment.
    private string SectionHref(string section) => $"{Nav.Uri.Split('#')[0]}#{section}";

    private Task ScrollToSectionAsync(string section) => JS.InvokeVoidAsync("gs.scrollToSection", section).AsTask();

    private async Task ExportAsync()
    {
        _exporting = true;
        _exportError = null;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromMinutes(10));
            var exportError = await JS.InvokeAsync<string?>("gs.downloadPersonalData", timeout.Token);
            _exportError = exportError is null ? null : Loc[exportError];
            if (_exportError is not null) _exportError = Loc[_exportError].Value;
        }
        catch (JSException)
        {
            _exportError = Loc["Your records could not be downloaded. Please retry."].Value;
        }
        catch (OperationCanceledException)
        {
            _exportError = Loc["Preparing your archive took too long. Please retry."].Value;
        }
        finally
        {
            _exporting = false;
        }
    }

    private Task LogoutAsync() => AuthService.Logout();

    private async Task ConfirmDeleteAsync()
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, Loc["Delete your account? Your name and email are removed, your sign-in is deleted, your banks are disconnected, and personal receipt files are deleted. Anonymised ledger records and shared receipts remain. Cleanup failures are recorded for retry; backups expire under the operator's retention policy. This cannot be undone."].Value },
            { x => x.ButtonText, Loc["Delete account"].Value },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(Loc["Delete account"].Value, parameters);

        if (await dialog.ConfirmedAsync())
        {
            await DeleteAsync();
        }
    }

    private async Task DeleteAsync()
    {
        _deleting = true;
        _blocking = null;
        _error = null;

        try
        {
            await Users.DeleteCurrentUserAsync();

            // The account no longer exists, so the session points at nothing, and every
            // request it made from here on would be refused as a deleted account. Only the
            // app's own session is left to end: the login, and its Keycloak sessions, went
            // with the account.
            await AuthService.SignOutDeletedAccount();
        }
        catch (Exception exception) when (ApiErrors.IsApiFailure(exception))
        {
            var error = ApiErrors.Read(exception);

            if (error.Code == ErrorCodes.AccountNotSettled)
            {
                // The groups come back named, on the problem, so the reason is actionable
                // rather than a refusal. Branching on the code rather than the body's shape
                // is what lets the API change the wording without breaking this.
                _blocking = error.Extension<List<OutstandingBalance>>(
                    ProblemDetails.OutstandingBalancesExtension) ?? [];
            }
            else if (error.Kind == ApiErrorKind.Unauthenticated)
            {
                await Errors.ShowAsync(error);
            }
            else
            {
                _error = Loc["Your account was not deleted. {0}", error.Message].Value;
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    // A BFF endpoint, not a Blazor route: the router would otherwise intercept
    // the navigation and fail to match it.
    private void OpenAccountConsole() => Nav.NavigateTo("/auth/account", forceLoad: true);

    private RenderFragment Field(string label, string? value) =>
        @<div class="gs-kv-row">
            <dt>@label</dt>
            <dd>@(string.IsNullOrWhiteSpace(value) ? Loc["Not set"].Value : value)</dd>
        </div>;
}
