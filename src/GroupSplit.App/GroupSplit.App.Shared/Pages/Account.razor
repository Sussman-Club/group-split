@page "/account"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.App.Shared.Services.Errors
@using GroupSplit.Shared
@using GroupSplit.Shared.Errors
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject IUsersClient Users
@inject IDialogService DialogService
@inject ApiErrorPresenter Errors
@inject AppLinks AppLinks
@inject IJSRuntime JS

<PageTitle>Account - Group Split</PageTitle>

@if (UserInfo is null)
{
    <div class="gs-card gs-empty" style="padding: 64px 24px">
        <MudIcon Icon="@Icons.Material.Rounded.AccountCircle" />
        <h3>You are not signed in</h3>
        <span>Sign in to see your account.</span>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4" Href="/login">Sign in</MudButton>
    </div>
}
else
{
    <div class="gs-page-head">
        <div class="gs-inline" style="gap: 20px">
            <span class="gs-avatar-ring">
                <Avatar Name="@UserInfo.FullName" Size="xl" />
            </span>
            <div>
                <div class="gs-eyebrow">Account</div>
                <h1 style="margin-top: 2px">@UserInfo.FullName</h1>
                <p style="margin-top: 2px">@UserInfo.Email</p>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="gs-btn-pill"
                   StartIcon="@Icons.Material.Rounded.Logout" OnClick="LogoutAsync">
            Sign out
        </MudButton>
    </div>

    <div class="gs-two-col">
        <div class="gs-stack">
            <div class="gs-card gs-card-pad gs-reveal" style="--i: 0">
                <div class="gs-card-title">
                    <h2>Profile</h2>
                    <span class="gs-tag neutral">from identity provider</span>
                </div>
                <dl class="gs-kv">
                    @Field("First name", UserInfo.FirstName)
                    @Field("Last name", UserInfo.LastName)
                    @Field("Email", UserInfo.Email)
                </dl>
            </div>

            <div class="gs-card gs-card-pad gs-reveal" style="--i: 1">
                <div class="gs-card-title">
                    <h2>Security</h2>
                </div>
                <p class="gs-muted" style="margin: 0 0 16px; font-size: .875rem">
                    Passwords, two-factor authentication and active sessions are managed by the
                    identity provider.
                </p>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="gs-btn-pill"
                           StartIcon="@Icons.Material.Rounded.ManageAccounts"
                           EndIcon="@Icons.Material.Rounded.OpenInNew"
                           OnClick="OpenAccountConsole">
                    Manage account
                </MudButton>
            </div>
        </div>

        <div class="gs-stack">
            <LinkedBanksCard Reveal="2" />
            <PushNotificationsCard />

            <div class="gs-card gs-card-pad gs-reveal" style="--i: 3">
                <div class="gs-card-title"><h2>Your records</h2></div>
                <p class="gs-muted">Download a ZIP with your records in JSON, spreadsheet-ready
                    ledger tables, and original receipt files. Includes a format guide and checksums.</p>
                @if (AppLinks.IsNative)
                {
                    <p>To download your records and receipt files, sign in on the website.</p>
                    <MudButton Href="@AppLinks.PublicUrl(Nav.BaseUri, "account")" Target="_blank"
                               Variant="Variant.Outlined">Open account on website</MudButton>
                }
                else
                {
                    <MudButton OnClick="ExportAsync" Disabled="_exporting" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Rounded.Download">
                        @(_exporting ? "Preparing your archive…" : "Download my records and receipt files (ZIP)")
                    </MudButton>
                    @if (_exportError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3" role="alert">@_exportError</MudAlert>
                    }
                }
            </div>

            <div class="gs-card gs-card-pad gs-danger-zone gs-reveal" style="--i: 4">
                <div class="gs-card-title">
                    <h2>Delete account</h2>
                </div>
                <p class="gs-muted" style="margin: 0 0 16px; font-size: .875rem">
                    Removes your name and email address, and deletes your sign-in: your password,
                    any linked Google account and every session you have open. Expenses you
                    recorded stay in their groups, because they are what everyone else's share
                    was worked out from. You have to settle up in every group first.
                </p>
                <p class="gs-muted">
                    Linked banks and imported bank rows are removed. A bank provider failure may
                    leave deletion unfinished; retry after the bank service recovers. Items whose
                    access cannot be read are recorded for administrator cleanup. Personal receipt
                    files are deleted; shared expenses, their receipts, settlements and anonymised
                    personal ledger records are retained. Failed receipt or sign-in cleanup is
                    recorded for retry. Backups may retain older data until the operator's configured
                    backup expiry; there is no application-enforced expiry period.
                </p>

                @if (_blocking is { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                        <div style="font-weight: 700; font-size: .875rem; margin-bottom: 4px">Settle up in these groups first:</div>
                        @foreach (var group in _blocking)
                        {
                            <div class="gs-inline" style="justify-content: space-between; font-size: .875rem">
                                <span>@group.GroupName</span>
                                <Money Value="group.Balance" />
                            </div>
                        }
                    </MudAlert>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Class="gs-btn-pill"
                           StartIcon="@Icons.Material.Rounded.DeleteForever"
                           Disabled="@_deleting"
                           OnClick="ConfirmDeleteAsync">
                    Delete my account
                </MudButton>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private IReadOnlyList<OutstandingBalance>? _blocking;

    private string? _error;

    private bool _deleting;
    private bool _exporting;
    private string? _exportError;

    private async Task ExportAsync()
    {
        _exporting = true;
        _exportError = null;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromMinutes(10));
            _exportError = await JS.InvokeAsync<string?>("gs.downloadPersonalData", timeout.Token);
        }
        catch (JSException)
        {
            _exportError = "Your records could not be downloaded. Please retry.";
        }
        catch (OperationCanceledException)
        {
            _exportError = "Preparing your archive took too long. Please retry.";
        }
        finally
        {
            _exporting = false;
        }
    }

    private Task LogoutAsync() => AuthService.Logout();

    private async Task ConfirmDeleteAsync()
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, "Delete your account? Your name and email are removed, your sign-in is deleted, your banks are disconnected, and personal receipt files are deleted. Anonymised ledger records and shared receipts remain. Cleanup failures are recorded for retry; backups expire under the operator's retention policy. This cannot be undone." },
            { x => x.ButtonText, "Delete account" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete account", parameters);

        if (await dialog.ConfirmedAsync())
        {
            await DeleteAsync();
        }
    }

    private async Task DeleteAsync()
    {
        _deleting = true;
        _blocking = null;
        _error = null;

        try
        {
            await Users.DeleteCurrentUserAsync();

            // The account no longer exists, so the session points at nothing, and every
            // request it made from here on would be refused as a deleted account. Only the
            // app's own session is left to end: the login, and its Keycloak sessions, went
            // with the account.
            await AuthService.SignOutDeletedAccount();
        }
        catch (Exception exception) when (ApiErrors.IsApiFailure(exception))
        {
            var error = ApiErrors.Read(exception);

            if (error.Code == ErrorCodes.AccountNotSettled)
            {
                // The groups come back named, on the problem, so the reason is actionable
                // rather than a refusal. Branching on the code rather than the body's shape
                // is what lets the API change the wording without breaking this.
                _blocking = error.Extension<List<OutstandingBalance>>(
                    ProblemDetails.OutstandingBalancesExtension) ?? [];
            }
            else if (error.Kind == ApiErrorKind.Unauthenticated)
            {
                await Errors.ShowAsync(error);
            }
            else
            {
                _error = $"Your account was not deleted. {error.Message}";
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    // A BFF endpoint, not a Blazor route: the router would otherwise intercept
    // the navigation and fail to match it.
    private void OpenAccountConsole() => Nav.NavigateTo("/auth/account", forceLoad: true);

    private RenderFragment Field(string label, string? value) =>
        @<div class="gs-kv-row">
            <dt>@label</dt>
            <dd>@(string.IsNullOrWhiteSpace(value) ? "Not set" : value)</dd>
        </div>;
}
