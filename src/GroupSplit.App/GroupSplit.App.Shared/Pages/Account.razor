@page "/account"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject IUsersClient Users
@inject IDialogService DialogService

<PageTitle>Account - Group Split</PageTitle>

@if (UserInfo is null)
{
    <div class="gs-card gs-empty" style="padding: 64px 24px">
        <MudIcon Icon="@Icons.Material.Rounded.AccountCircle" />
        <h3>You are not signed in</h3>
        <span>Sign in to see your account.</span>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4" Href="/login">Sign in</MudButton>
    </div>
}
else
{
    <div class="gs-page-head">
        <div class="gs-inline" style="gap: 20px">
            <span class="gs-avatar-ring">
                <Avatar Name="@UserInfo.FullName" Size="xl" />
            </span>
            <div>
                <div class="gs-eyebrow">Account</div>
                <h1 style="margin-top: 2px">@UserInfo.FullName</h1>
                <p style="margin-top: 2px">@UserInfo.Email</p>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Class="gs-btn-pill"
                   StartIcon="@Icons.Material.Rounded.Logout" OnClick="LogoutAsync">
            Sign out
        </MudButton>
    </div>

    <div class="gs-two-col">
        <div class="gs-stack">
            <div class="gs-card gs-card-pad gs-reveal" style="--i: 0">
                <div class="gs-card-title">
                    <h2>Profile</h2>
                    <span class="gs-tag neutral">from identity provider</span>
                </div>
                <dl class="gs-kv">
                    @Field("First name", UserInfo.FirstName)
                    @Field("Last name", UserInfo.LastName)
                    @Field("Email", UserInfo.Email)
                </dl>
            </div>

            <div class="gs-card gs-card-pad gs-reveal" style="--i: 1">
                <div class="gs-card-title">
                    <h2>Security</h2>
                </div>
                <p class="gs-muted" style="margin: 0 0 16px; font-size: .875rem">
                    Passwords, two-factor authentication and active sessions are managed by the
                    identity provider.
                </p>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="gs-btn-pill"
                           StartIcon="@Icons.Material.Rounded.ManageAccounts"
                           EndIcon="@Icons.Material.Rounded.OpenInNew"
                           OnClick="OpenAccountConsole">
                    Manage account
                </MudButton>
            </div>
        </div>

        <div class="gs-stack">
            <div class="gs-card gs-card-pad gs-danger-zone gs-reveal" style="--i: 2">
                <div class="gs-card-title">
                    <h2>Delete account</h2>
                </div>
                <p class="gs-muted" style="margin: 0 0 16px; font-size: .875rem">
                    Removes your name and email address, and unlinks your sign-in. Expenses you
                    recorded stay in their groups, because they are what everyone else's share
                    was worked out from. You have to settle up in every group first.
                </p>

                @if (_blocking is { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                        <div style="font-weight: 700; font-size: .875rem; margin-bottom: 4px">Settle up in these groups first:</div>
                        @foreach (var group in _blocking)
                        {
                            <div class="gs-inline" style="justify-content: space-between; font-size: .875rem">
                                <span>@group.GroupName</span>
                                <Money Value="group.Balance" />
                            </div>
                        }
                    </MudAlert>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Class="gs-btn-pill"
                           StartIcon="@Icons.Material.Rounded.DeleteForever"
                           Disabled="@_deleting"
                           OnClick="ConfirmDeleteAsync">
                    Delete my account
                </MudButton>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }

    private IReadOnlyList<OutstandingBalance>? _blocking;

    private string? _error;

    private bool _deleting;

    private Task LogoutAsync() => AuthService.Logout();

    private async Task ConfirmDeleteAsync()
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, "Delete your account? Your name and email address are removed and your sign-in is unlinked. This cannot be undone." },
            { x => x.ButtonText, "Delete account" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete account", parameters);

        if (await dialog.GetReturnValueAsync<bool>())
        {
            await DeleteAsync();
        }
    }

    private async Task DeleteAsync()
    {
        _deleting = true;
        _blocking = null;
        _error = null;

        try
        {
            await Users.DeleteCurrentUserAsync();

            // The account no longer exists, so the session points at nothing. Signing out
            // is what clears it -- and without it the next request would provision a
            // fresh, empty account under the same sign-in.
            await AuthService.Logout();
        }
        catch (ApiException<ICollection<OutstandingBalance>> conflict)
        {
            // The groups come back named so the reason is actionable rather than a refusal.
            _blocking = conflict.Result.ToList();
        }
        catch (ApiException)
        {
            _error = "We could not delete your account. Please try again in a moment.";
        }
        finally
        {
            _deleting = false;
        }
    }

    // A BFF endpoint, not a Blazor route: the router would otherwise intercept
    // the navigation and fail to match it.
    private void OpenAccountConsole() => Nav.NavigateTo("/auth/account", forceLoad: true);

    private RenderFragment Field(string label, string? value) =>
        @<div class="gs-kv-row">
            <dt>@label</dt>
            <dd>@(string.IsNullOrWhiteSpace(value) ? "Not set" : value)</dd>
        </div>;
}
