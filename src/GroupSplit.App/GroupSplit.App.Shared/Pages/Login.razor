@page "/login"
@using GroupSplit.App.Shared.Components
@layout FullScreenLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in - Group Split</PageTitle>

<AuthHandoff Flow="AuthHandoff.AuthFlow.Login"
             Title="Welcome back"
             Subtitle="Sign in to pick up your groups, expenses and balances."
             ActionLabel="Continue to sign in"
             AlternatePrompt="New to Group Split?"
             AlternateLabel="Create an account"
             AlternateHref="/signup" />
