@page "/android"
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using GroupSplit.App.Shared.Components
@inject IHttpClientFactory Clients
@inject NavigationManager Nav
@inject AppLinks AppLinks

<PageTitle>@Loc["Android app - Group Split"]</PageTitle>

<div class="gs-android-page">
    <section class="gs-android-hero" aria-labelledby="android-title">
        <div class="gs-android-app-icon"><BrandMark Size="64" /></div>
        <p class="gs-android-platform"><MudIcon Icon="@Icons.Material.Rounded.Android" Size="Size.Small" />@Loc["Group Split for Android"]</p>
        <h1 id="android-title">@Loc["Your groups,"]<br />@Loc["in your pocket."]</h1>
        <p class="gs-android-intro">@Loc["From the first shared bill to the last settled balance. Keep your expenses together, wherever the group goes."]</p>

        <div class="gs-android-download" aria-live="polite" aria-busy="@_loading.ToString().ToLowerInvariant()">
            @if (AppLinks.IsNative)
            {
                <h2>@Loc["You're all set."]</h2>
                <p>@Loc["You are already using the Android app. Get future updates from the website."]</p>
                <MudButton Href="@AppLinks.PublicUrl(Nav.BaseUri, "android")" Target="_blank" Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill">@Loc["Open download page"]</MudButton>
            }
            else if (_loading)
            {
                <p role="status">@Loc["Checking the latest Android version…"]</p>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Loc["Checking for an Android release"]" />
            }
            else if (_release is { } release)
            {
                <MudButton Href="@release.DownloadUrl" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           Class="gs-btn-pill gs-android-cta" StartIcon="@Icons.Material.Rounded.Download" data-enhance-nav="false">@Loc["Download for Android"]</MudButton>
                <p class="gs-android-compatibility">@Loc["Android 7.0 or newer"]</p>
                <dl class="gs-android-release">
                    <div><dt>@Loc["Version"]</dt><dd>@release.Version</dd></div>
                    <div><dt>@Loc["Download size"]</dt><dd>@((release.Size / 1048576d).ToString("0")) MB</dd></div>
                    <div><dt>@Loc["File type"]</dt><dd>@Loc["Android APK"]</dd></div>
                </dl>
                <a class="gs-android-checksum" href="@release.ChecksumUrl" data-enhance-nav="false">@Loc["Download checksum"]</a>
            }
            else
            {
                <h2>@Loc["Check back in a moment."]</h2>
                <p role="status">@Loc["The Android download is not available right now. You can keep using Group Split in your browser."]</p>
                <MudButton OnClick="LoadAsync" Variant="Variant.Outlined" Color="Color.Primary" Class="gs-btn-pill">@Loc["Check again"]</MudButton>
            }
        </div>
        <a class="gs-android-web-link" href="/">@Loc["Continue on the website"]</a>
    </section>

    <section class="gs-android-install" aria-labelledby="android-install-title">
        <div class="gs-android-install-heading">
            <MudIcon Icon="@Icons.Material.Rounded.InstallMobile" Size="Size.Large" />
            <h2 id="android-install-title">@Loc["A few steps."]<br />@Loc["Then you're in."]</h2>
            <p>@Loc["Install on your phone directly from this page."]</p>
        </div>
        <ol class="gs-android-steps">
            <li><div><h3>@Loc["Download the app"]</h3><p>@Loc["Download the APK on your Android phone."]</p></div></li>
            <li><div><h3>@Loc["Allow the install"]</h3><p>@Loc["Open the download. If Android asks, allow this browser to install apps. You can turn off this permission afterward."]</p></div></li>
            <li><div><h3>@Loc["Pick up where you left off"]</h3><p>@Loc["Install Group Split, then open it and sign in with your usual account."]</p></div></li>
        </ol>
        <div class="gs-android-update-note">
            <MudIcon Icon="@Icons.Material.Rounded.SystemUpdate" Size="Size.Small" />
            <div><h3>@Loc["When it's time to update"]</h3><p>@Loc["Download the new APK here and install it over the existing app."]</p></div>
        </div>
    </section>
</div>

@code {
    private AndroidReleaseInfo? _release;
    private bool _loading = true;

    // Both interactive web modes can read the public endpoint without server-only services.
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;
        if (!AppLinks.IsNative) return LoadAsync();
        _loading = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            using var client = Clients.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15);
            _release = await client.GetFromJsonAsync(Nav.ToAbsoluteUri("/downloads/android/latest"), AndroidDownloadJsonContext.Default.AndroidReleaseInfo);
        }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _release = null;
        }
        finally { _loading = false; }
        StateHasChanged();
    }
}
