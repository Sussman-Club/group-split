@page "/not-found"
@layout MainLayout

<PageTitle>Not found - Group Split</PageTitle>

<div class="gs-empty" style="padding-top: 80px">
    <div class="gs-money gs-display" style="font-size: clamp(4rem, 12vw, 7rem); line-height: 1; color: var(--gs-line-strong)">404</div>
    <h3 style="font-size: 1.375rem">That page isn't in the ledger</h3>
    <span>The link may be old, or the address has a typo.</span>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gs-btn-pill mt-4" Href="/"
               StartIcon="@Icons.Material.Rounded.ArrowBack">Back home</MudButton>
</div>
