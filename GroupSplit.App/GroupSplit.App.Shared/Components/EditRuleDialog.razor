@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@namespace GroupSplit.App.Shared.Components

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">Edit Rule</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Configure how this category should be split in the group.
        </MudText>
        <RuleEditorForm
            @ref="_form"
            GroupId="GroupId"
            @bind-Category="_category"
            @bind-RuleVersion="_ruleVersionDto"
        />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@Submit">Edit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid GroupId { get; set; }
    [Parameter] public UpdateRuleRequest OriginalModel { get; set; } = null!;

    private RuleEditorForm _form = null!;
    private string _category = string.Empty;
    private RuleVersionDto _ruleVersionDto = null!;


    protected override void OnInitialized()
    {
        _ruleVersionDto = OriginalModel.Version;
        _category = OriginalModel.Category;
    }

    private async Task Submit()
    {
        if (!await _form.Validate())
            return;

        var patch = new JsonPatchDocument<UpdateRuleRequest>();

        // Track category changes
        if (!string.Equals(_category, OriginalModel.Category, StringComparison.Ordinal))
        {
            patch.Replace(x => x.Category, _category);
        }

        // Track version changes
        switch (_ruleVersionDto)
        {
            case PersonalRuleVersionDto when OriginalModel.Version is not PersonalRuleVersionDto:
                patch.Replace(x => x.Version, new PersonalRuleVersionDto());
                break;
            case PercentRuleVersionDto percentRule when OriginalModel.Version is not PercentRuleVersionDto percentRuleVersionDto ||
                                                        DictionariesAreDifferent(percentRule.Percentages, percentRuleVersionDto.Percentages):
                patch.Replace(x => x.Version,
                    new PercentRuleVersionDto
                    {
                        Percentages = new Dictionary<Guid, decimal>(percentRule.Percentages)
                    });
                break;
            case SharesRuleVersionDto sharesRule when OriginalModel.Version is not SharesRuleVersionDto sharesRuleVersionDto ||
                                                      DictionariesAreDifferent(sharesRule.Shares, sharesRuleVersionDto.Shares):
                patch.Replace(x => x.Version,
                    new SharesRuleVersionDto
                    {
                        Shares = new Dictionary<Guid, int>(sharesRule.Shares)
                    });
                break;
        }

        MudDialog.Close(DialogResult.Ok(patch));
    }

    private void Cancel() => MudDialog.Cancel();

    private static bool DictionariesAreDifferent<T>(
        IDictionary<Guid, T> current,
        IDictionary<Guid, T> original)
    {
        if (current.Count != original.Count)
            return true;

        foreach (var kv in current)
        {
            if (!original.TryGetValue(kv.Key, out var originalValue))
                return true;

            if (!EqualityComparer<T>.Default.Equals(kv.Value, originalValue))
                return true;
        }

        return false;
    }

}