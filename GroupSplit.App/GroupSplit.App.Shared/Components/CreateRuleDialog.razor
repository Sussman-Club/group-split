@using GroupSplit.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">Create Rule</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Configure how this category should be split in the group.
        </MudText>
        <RuleEditorForm
            @ref="_form"
            GroupId="GroupId"
            @bind-Category="_category"
            @bind-RuleVersion="_ruleVersionDto"
        />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid GroupId { get; set; }

    private RuleEditorForm _form = null!;
    private string _category = string.Empty;
    private RuleVersionDto _ruleVersionDto = new PersonalRuleVersionDto();

    private async Task Submit()
    {
        if (!await _form.Validate())
            return;

        var request = _ruleVersionDto switch
        {
            PersonalRuleVersionDto => new CreateRuleRequest
            {
                GroupId = GroupId,
                Category = _category,
                Version = new PersonalRuleVersionDto()
            },
            PercentRuleVersionDto percentRule => new CreateRuleRequest
            {
                GroupId = GroupId,
                Category = _category,
                Version = new PercentRuleVersionDto
                {
                    Percentages = new Dictionary<Guid, decimal>(percentRule.Percentages)
                }
            },
            SharesRuleVersionDto sharesRule => new CreateRuleRequest
            {
                GroupId = GroupId,
                Category = _category,
                Version = new SharesRuleVersionDto
                {
                    Shares = new Dictionary<Guid, int>(sharesRule.Shares)
                }
            },
            _ => throw new ArgumentOutOfRangeException()
        };

        MudDialog.Close(request);
    }

    private void Cancel() => MudDialog.Cancel();
}