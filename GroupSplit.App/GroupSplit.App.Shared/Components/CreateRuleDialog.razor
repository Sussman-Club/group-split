@using GroupSplit.App.Shared.Models
@using GroupSplit.Shared
@inject IGroupsClient GroupsClient

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold">Create Rule</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_category"
                              Label="Category"
                              Variant="Variant.Outlined"
                              Immediate="true"/>

                <MudSelect T="RuleType" Label="Rule Type" @bind-Value="_ruleType" Variant="Variant.Outlined">
                    <MudSelectItem T="RuleType" Value="RuleType.Personal">
                        Personal (payer owes full amount)
                    </MudSelectItem>

                    <MudSelectItem T="RuleType" Value="RuleType.Percent">
                        Percent split
                    </MudSelectItem>

                    <MudSelectItem T="RuleType" Value="RuleType.Shares">
                        Shares split
                    </MudSelectItem>
                </MudSelect>

                @if (_ruleType is RuleType.Percent)
                {
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Enter percentages per member (must total 100)
                        </MudText>

                        <MudGrid>
                            @foreach (var m in _members)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudNumericField T="decimal"
                                                     @bind-Value="@_percentages[m.Id]"
                                                     Label="@($"{m.FirstName} {m.LastName}")"
                                                     Variant="Variant.Outlined"
                                                     Adornment="Adornment.End"
                                                     AdornmentText="%"
                                                     HideSpinButtons="true"
                                                     Min="0" Max="100" Immediate="true"
                                                     Class="small-num-field no-spinners"/>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudText Typo="Typo.caption"
                                 Color="@(PercentTotal == 100 ? Color.Success : Color.Error)">
                            Total: @PercentTotal%
                        </MudText>
                    </MudPaper>
                }
                else if (_ruleType is RuleType.Shares)
                {
                    <MudPaper Class="pa-4" Elevation="0">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Enter share units per member (non-negative)
                        </MudText>

                        <MudGrid>
                            @foreach (var m in _members)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudNumericField T="int"
                                                     @bind-Value="@_shares[m.Id]"
                                                     Label="@($"{m.FirstName} {m.LastName}")"
                                                     Variant="Variant.Outlined"
                                                     HideSpinButtons="true"
                                                     Min="0" Immediate="true"
                                                     Class="small-num-field no-spinners"/>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudText Typo="Typo.caption" Color="@(SharesTotal > 0 ? Color.Success : Color.Error)">
                            Total shares: @SharesTotal
                        </MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Disabled="@(!CanSubmit)"
                   OnClick="@Submit">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid GroupId { get; set; }

    private MudForm _form;
    private string _category = string.Empty;
    private RuleType _ruleType = RuleType.Personal;

    private ICollection<UserInfo> _members = [];
    private readonly Dictionary<Guid, decimal> _percentages = new();
    private readonly Dictionary<Guid, int> _shares = new();

    protected override async Task OnInitializedAsync()
    {
        _members = await GroupsClient.GetGroupMembersAsync(GroupId);

        foreach (var m in _members)
            _percentages[m.Id] = 0m;

        foreach (var m in _members)
            _shares[m.Id] = 0;
    }

    private int PercentTotal => (int)Math.Round(_percentages.Values.Sum());
    private int SharesTotal => _shares.Values.Sum();

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_category) &&
        (_ruleType is RuleType.Personal ||
         (_ruleType is RuleType.Percent && PercentTotal == 100) ||
         (_ruleType is RuleType.Shares && SharesTotal > 0));

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        var request = _ruleType switch
        {
            RuleType.Personal => new CreateRuleRequest
            {
                GroupId = GroupId,
                Category = _category,
                Version = new PersonalRuleVersionDto()
            },
            RuleType.Percent => new CreateRuleRequest
            {
                GroupId = GroupId,
                Category = _category,
                Version = new PercentRuleVersionDto
                {
                    Percentages = new Dictionary<Guid, decimal>(_percentages)
                }
            },
            RuleType.Shares => new CreateRuleRequest
            {
                GroupId = GroupId,
                Category = _category,
                Version = new SharesRuleVersionDto
                {
                    Shares = new Dictionary<Guid, int>(_shares)
                }
            },
            _ => throw new ArgumentOutOfRangeException()
        };

        MudDialog.Close(request);
    }

    private void Cancel() => MudDialog.Cancel();

}