@page "/weather"
@using GroupSplit.Shared
@using GroupSplit.App.Shared.ApiClient
@inject IClient ApiClient

<PageTitle>Weather</PageTitle>

<MudPaper Elevation="4" Class="pa-6">
    <MudStack Spacing="2">
        <MudStack AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Cloud" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="fw-bold">Weather Forecast</MudText>
        </MudStack>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Demonstration of dynamic data loading</MudText>
        <MudDivider />

        @if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="my-4">
                <MudText Typo="Typo.body2">@errorMessage</MudText>
            </MudAlert>
        }
        else if (forecasts == null)
        {
            <MudStack AlignItems="AlignItems.Center" JustifyContent="Center" Class="my-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-2" />
                <MudText><em>Loading forecast...</em></MudText>
            </MudStack>
        }
        else
        {
            <MudTable Items="forecasts" Hover="true" Dense="true" Bordered="true" Elevation="0" Class="mt-2">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh aria-label="Temperature in Celsius">Temp. (C)</MudTh>
                    <MudTh aria-label="Temperature in Fahrenheit">Temp. (F)</MudTh>
                    <MudTh>Summary</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
                    <MudTd DataLabel="Temp. (C)">@context.TemperatureC</MudTd>
                    <MudTd DataLabel="Temp. (F)">@context.TemperatureF</MudTd>
                    <MudTd DataLabel="Summary">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">@context.Summary</MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudPaper>

@code {
    private ICollection<WeatherForecast>? forecasts;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            forecasts = await ApiClient.GetWeatherForecastAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading weather forecast: {ex.Message}";
            Console.WriteLine($"Full error: {ex}");
        }
    }
}
