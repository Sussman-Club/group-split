    {
        // Only showing current user's (John Doe) transactions
        new TransactionViewModel { Id = Guid.NewGuid(), Date = DateTime.Now.AddDays(-1), GroupName = "Vacation 2024", UserName = CurrentUserName, Amount = 125.50m },
        new TransactionViewModel { Id = Guid.NewGuid(), Date = DateTime.Now.AddDays(-7), GroupName = "Weekend Trip", UserName = CurrentUserName, Amount = 89.25m },
        new TransactionViewModel { Id = Guid.NewGuid(), Date = DateTime.Now.AddDays(-10), GroupName = "Office Lunch", UserName = CurrentUserName, Amount = 32.75m },
        new TransactionViewModel { Id = Guid.NewGuid(), Date = DateTime.Now.AddDays(-14), GroupName = "Vacation 2024", UserName = CurrentUserName, Amount = 200.00m },
        new TransactionViewModel { Id = Guid.NewGuid(), Date = DateTime.Now.AddDays(-20), GroupName = "Roommates", UserName = CurrentUserName, Amount = 156.80m },
        new TransactionViewModel { Id = Guid.NewGuid(), Date = DateTime.Now.AddDays(-25), GroupName = "Weekend Trip", UserName = CurrentUserName, Amount = 45.00m }
    };

    private IEnumerable<TransactionViewModel> FilteredTransactions =>
        _transactions.Where(t =>
        {
            var matchesSearch = string.IsNullOrWhiteSpace(_searchString) ||
                                t.GroupName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                                t.Amount.ToString().Contains(_searchString);

            return matchesSearch;
        }).OrderByDescending(t => t.Date);

