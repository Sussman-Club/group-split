@page "/transactions"

<PageTitle>Transactions</PageTitle>


<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudStack Spacing="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Receipt" Color="Color.Primary" Size="Size.Large"/>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Transactions</MudText>
        </MudStack>
    </MudStack>
</MudStack>

<MudTextField @bind-Value="_searchString"
              Placeholder="Search transactions..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Outlined.Search"
              IconSize="Size.Medium"
              Immediate="true"
              Variant="Variant.Outlined"
              Class="flex-grow-1 pa-6"/>

<MudDataGrid T="TransactionViewModel"
             Items="@FilteredTransactions"
             Filterable="true"
             FilterMode="DataGridFilterMode.Simple"
             Hover="true"
             Dense="false"
             Bordered="false"
             Class="ma-6"
             Striped="true">
    <Columns>
        <PropertyColumn Property="x => x.Date" Title="Date" Filterable="false">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.Item.Date.ToShortDateString()</MudText>
                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">@context.Item.Date.ToShortTimeString()</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.GroupName" Title="Group" Filterable="true">
            <CellTemplate>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                    @context.Item.GroupName
                </MudChip>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Amount" Title="Amount" Filterable="false">
            <CellTemplate>
                <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Success">
                    $@context.Item.Amount.ToString("N2")
                </MudText>
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn Title="Actions" Filterable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => EditTransaction(context.Item)"/>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => DeleteTransaction(context.Item)"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
            <MudText Typo="Typo.body1" Color="Color.Secondary">No transactions found</MudText>
        </MudStack>
    </NoRecordsContent>
</MudDataGrid>

<div class="fab-extended" style="position: fixed; bottom: 24px; right: 24px; z-index: 1000;">
    <MudIconButton Icon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   Style="color: var(--mud-palette-primary-text)"
                   aria-label="Add Transaction"
                   Class="fab-button"/>
    <span class="fab-text">Transaction</span>
</div>


<style>
    .fab-extended {
        display: inline-flex;
        align-items: center;
        background-color: var(--mud-palette-primary);
        border-radius: 28px;
        padding: 0;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 3px 5px -1px rgba(0, 0, 0, .2), 0 6px 10px 0 rgba(0, 0, 0, .14), 0 1px 18px 0 rgba(0, 0, 0, .12);
    }

    .fab-extended:hover {
        box-shadow: 0 5px 5px -3px rgba(0, 0, 0, .2), 0 8px 10px 1px rgba(0, 0, 0, .14), 0 3px 14px 2px rgba(0, 0, 0, .12);
    }

    .fab-extended .fab-button {
        border-radius: 50%;
        flex-shrink: 0;
    }

    .fab-extended .fab-text {
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        white-space: nowrap;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
        padding-right: 0;
    }

    .fab-extended:hover .fab-text {
        max-width: 200px;
        opacity: 1;
        padding-right: 20px;
        padding-left: 8px;
    }
</style>

