    }


    private class TransactionViewModel
    {
        public Guid Id { get; set; }
        public DateTime Date { get; set; }
        public string GroupName { get; set; } = "";
        public string UserName { get; set; } = "";
        public decimal Amount { get; set; }
    }

}
