@page "/transactions"
@using GroupSplit.App.Shared.Components
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject ITransactionsClient TransactionsClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MudTheme Theme

<PageTitle>Transactions</PageTitle>


<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudStack Spacing="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Receipt" Color="Color.Primary" Size="Size.Large"/>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Transactions</MudText>
        </MudStack>
    </MudStack>
</MudStack>


<MudTextField @bind-Value="_searchString"
              Placeholder="Search transactions..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Outlined.Search"
              IconSize="Size.Medium"
              Immediate="true"
              Style="@Theme.PaletteLight.Surface.BackgroundColorStyle"
              Variant="Variant.Outlined"
              Class="flex-grow-1 pa-6"/>

<MudDataGrid T="TransactionResponse"
             Items="@UserTransactions"
             Filterable="true"
             FilterMode="DataGridFilterMode.Simple"
             Hover="true"
             Dense="false"
             Bordered="false"
             Class="ma-6"
             Striped="true">
    <Columns>
        <PropertyColumn Property="x => x.DateTime" Title="Date" Filterable="false">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.Item.DateTime.DateTime.ToShortDateString()</MudText>
                    <MudText Typo="Typo.caption">@context.Item.DateTime.DateTime.ToShortTimeString()</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Name" Title="Name" Filterable="true">
            <CellTemplate>
                <MudText Typo="Typo.body2">@context.Item.Name</MudText>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.GroupName" Title="Group" Filterable="true">
            <CellTemplate>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                    @context.Item.GroupName
                </MudChip>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Amount" Title="Amount" Filterable="false">
            <CellTemplate>
                <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Success">
                    $@context.Item.Amount.ToString("N2")
                </MudText>
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn Title="Actions" Filterable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => EditTransaction(context.Item)"/>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(async () => await OpenDeleteTransactionDialog(context.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary"/>
            <MudText Typo="Typo.body1" Color="Color.Secondary">No transactions found</MudText>
        </MudStack>
    </NoRecordsContent>
</MudDataGrid>

<ExtendedFab Label="Transaction" OnClick="@OpenAddTransactionDialog"/>

@code {
    private string _searchString = "";

    [PersistentState] public ICollection<TransactionResponse> UserTransactions { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        UserTransactions ??= await TransactionsClient.GetTransactionsAsync();
        await base.OnInitializedAsync();
    }

    private async Task OpenAddTransactionDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.DisablePayingUserSelection, true }
        };

        var dialogReference = await DialogService.ShowAsync<CreateTransactionDialog>("Create a transaction", parameters, options);

        var dialogResult = await dialogReference.Result;

        if (dialogResult is null || dialogResult.Canceled)
            return;

        if (dialogResult.Data is not CreateTransactionRequest request)
        {
            Snackbar.Add("Dialog did not return a valid transaction. Please try again.", Severity.Error);
            return;
        }

        await TransactionsClient.CreateTransactionAsync(request);

        UserTransactions = await TransactionsClient.GetTransactionsAsync();
        StateHasChanged();
    }

    private async Task EditTransaction(TransactionResponse transaction)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<UpdateTransactionDialog>(
            "Edit Transaction",
            new DialogParameters { ["Original"] = transaction },
            options);

        var dialogResult = await dialogReference.Result;

        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not JsonPatchDocument<UpdateTransactionRequest> jsonPatch)
            return;

        await TransactionsClient.UpdateTransactionAsync(transaction.Id, jsonPatch);
        
        UserTransactions = await TransactionsClient.GetTransactionsAsync();
        StateHasChanged();
    }

    private async Task OpenDeleteTransactionDialog(TransactionResponse transaction)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            {
                x => x.ContentText,
                $"Are you sure you want to delete the transaction \"{transaction.Name}\"? This action cannot be undone."
            },
            { x => x.ButtonText, "Delete Transaction" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialogReference = await DialogService.ShowAsync<ConfirmationDialog>("Delete", parameters, options);

        var dialogResult = await dialogReference.Result;

        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not true)
            return;

        await TransactionsClient.DeleteTransactionAsync(transaction.Id);

        UserTransactions.Remove(transaction);
        StateHasChanged();
    }

}
