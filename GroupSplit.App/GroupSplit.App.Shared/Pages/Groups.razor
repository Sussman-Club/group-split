@page "/groups"
@using GroupSplit.App.Shared.Components
@using GroupSplit.Shared
@inject ITransactionsClient TransactionsClient
@inject IGroupsClient GroupsClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MudTheme Theme

<PageTitle>Groups</PageTitle>

@if (SelectedGroup != null)
{
    <!-- Group Header -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Color="Color.Primary" Size="Size.Large"/>
                <MudText Typo="Typo.h4" Class="font-weight-bold">@SelectedGroup.Name</MudText>
            </MudStack>
            <MudText Typo="Typo.body2">
                @SelectedGroup.MemberCount members · @Transactions.Count expenses
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Settings"
                       OnClick="ManageRules">
                Manage Rules
            </MudButton>
            @if (!SelectedGroup.IsArchive)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.PersonAdd"
                           OnClick="AddMember">
                    Add Member
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Tertiary"
                           StartIcon="@Icons.Material.Outlined.Archive"
                           OnClick="ArchiveGroup">
                    Archive
                </MudButton>
            }
        </MudStack>
    </MudStack>
}

<MudStack Spacing="4" Class="mb-10">
    @if (SelectedGroup != null)
    {
        <!-- Balance Row -->
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
            <!-- Your Balance -->
            <MudPaper Elevation="2" Class="pa-6 flex-grow-1">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Your Balance</MudText>

                    @if (_userBalance > 0)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="py-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">You are owed
                                    $@_userBalance.ToString("N2")</MudText>
                                <MudText Typo="Typo.body2">
                                    @foreach (var debt in _owedToYou)
                                    {
                                        <div>@debt.Name owes you <strong>$@debt.Amount.ToString("N2")</strong></div>
                                    }
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    }
                    else if (_userBalance < 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="py-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">You owe
                                    $@(Math.Abs(_userBalance).ToString("N2"))</MudText>
                                <MudText Typo="Typo.body2">
                                    @foreach (var debt in _youOwe)
                                    {
                                        <div>You owe @debt.Name <strong>$@debt.Amount.ToString("N2")</strong></div>
                                    }
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            <MudText Typo="Typo.body1">You're all settled up! 🎉</MudText>
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>

            <!-- Group Balances -->
            <MudPaper Elevation="2" Class="pa-6" Style="min-width: 280px; max-width: 320px;">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Group Balances</MudText>
                    <MudStack Spacing="2">
                        @foreach (var member in _members)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">@member.Name[0]</MudAvatar>
                                    <MudText Typo="Typo.body2">@member.Name</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="font-weight-medium"
                                         Color="@(member.Balance > 0 ? Color.Success : member.Balance < 0 ? Color.Error : Color.Default)">
                                    @(member.Balance >= 0 ? "+" : "")$@member.Balance.ToString("N2")
                                </MudText>
                            </MudStack>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>

        <!-- Expenses Row -->
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
            <!-- Expenses List -->
            <MudPaper Elevation="2" Class="pa-6 flex-grow-1">
                <TransactionsList Title="Recent Expenses" Transactions="Transactions"/>
            </MudPaper>
            <!-- My Groups -->
            <MudStack Spacing="4">
                <GroupsList Title="My Groups"
                            Icon="@Icons.Material.Outlined.Groups"
                            Groups="UserGroups"
                            @bind-SelectedGroup="SelectedGroup"
                            @bind-SelectedGroup:after="@OnSelectedGroupChanged"
                            ShowCreateButton="true"
                            OnCreateClick="OpenCreateDialogAsync"/>

                <GroupsList Title="Archived Groups"
                            Icon="@Icons.Material.Outlined.Archive"
                            Groups="_archivedGroups"
                            @bind-SelectedGroup="SelectedGroup"
                            @bind-SelectedGroup:after="@OnSelectedGroupChanged"
                            ShowCreateButton="false"/>
            </MudStack>
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-10">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Large"/>
                <MudText Typo="Typo.h6">Select a group to view details</MudText>
            </MudStack>
        </MudPaper>
    }
</MudStack>


@if (SelectedGroup is { IsArchive: false })
{
    <ExtendedFab Label="Expense" AlwaysExtended="true" OnClick="@OpenAddTransactionDialog"/>
}

@code {
    [PersistentState] public ICollection<GroupResponse> UserGroups { get; set; } = null!;
    [PersistentState] public GroupResponse? SelectedGroup { get; set; }
    [PersistentState] public List<TransactionResponse> Transactions { get; set; } = null!;

    private readonly List<GroupResponse> _archivedGroups = [];

    private decimal _userBalance;
    private List<DebtInfo> _owedToYou = new();
    private List<DebtInfo> _youOwe = new();
    private List<MemberBalance> _members = new();

    private CancellationTokenSource? _loadCts;


    protected override async Task OnInitializedAsync()
    {
        UserGroups ??= await GroupsClient.GetGroupsAsync();
        if (SelectedGroup is null)
        {
            SelectedGroup = UserGroups.FirstOrDefault();
            await OnSelectedGroupChanged();
        }

        await base.OnInitializedAsync();
    }

    private async Task OnSelectedGroupChanged()
    {
        if (SelectedGroup is null) return;

        var apiTransactions = await GroupsClient.GetGroupTransactionsAsync(SelectedGroup.Id, null, null);

        Transactions = apiTransactions.OrderByDescending(t => t.DateTime).ToList();

        // TODO: Replace with real balances once API provides endpoints
        // For now, keep placeholders minimal and neutral
        _userBalance = 0m;
        _owedToYou = new List<DebtInfo>();
        _youOwe = new List<DebtInfo>();
        _members = new List<MemberBalance>();
    }

    private void ManageRules()
    {
        // TODO: Implement manage rules dialog/page
        // Allow user to create, edit, and delete splitting rules
    }

    private void AddMember()
    {
        // TODO: Implement add member dialog
        // Allow user to add new members to the group
    }

    private void ArchiveGroup()
    {
        // TODO: Implement archive group dialog
        // Allow user to archive the selected group
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<CreateGroupDialog>("Create a group", options);

        var dialogResult = await dialogReference.Result;

        if (dialogResult is null || dialogResult.Canceled)
            return;

        if (dialogResult.Data is not CreateGroupRequest request)
        {
            Snackbar.Add("Dialog did not return a valid group. Please try again.", Severity.Error);
            return;
        }

        var group = await GroupsClient.CreateGroupAsync(request);
        UserGroups.Add(group);
    }

    private async Task OpenAddTransactionDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.SelectedGroupId, SelectedGroup?.Id }
        };

        var dialogReference = await DialogService.ShowAsync<CreateTransactionDialog>("Create an expense", parameters, options);

        var dialogResult = await dialogReference.Result;

        if (dialogResult is null || dialogResult.Canceled)
            return;

        if (dialogResult.Data is not CreateTransactionRequest request)
        {
            Snackbar.Add("Dialog did not return a valid transaction. Please try again.", Severity.Error);
            return;
        }

        await TransactionsClient.CreateTransactionAsync(request);

        if (SelectedGroup is null) return;

        var apiTransactions = await GroupsClient.GetGroupTransactionsAsync(SelectedGroup.Id, null, null);
        Transactions = apiTransactions.OrderByDescending(t => t.DateTime).ToList();
        StateHasChanged();
    }

    private class DebtInfo
    {
        public string Name { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private class MemberBalance
    {
        public string Name { get; set; } = "";
        public decimal Balance { get; set; }
    }

}
