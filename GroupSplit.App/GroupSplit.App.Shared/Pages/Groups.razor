@page "/groups"
@using GroupSplit.App.Shared.Components
@using GroupSplit.Shared
@using System.Threading.Tasks
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject IGroupsClient GroupsClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MudTheme Theme

<PageTitle>Groups</PageTitle>

@if (_selectedGroupId != Guid.Empty && _selectedGroupName != null)
{
    <!-- Group Header -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Color="Color.Primary" Size="Size.Large"/>
                <MudText Typo="Typo.h4" Class="font-weight-bold">@_selectedGroupName</MudText>
            </MudStack>
            <MudText Typo="Typo.body2">
                @_members.Count members · @_transactions.Count expenses
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Settings"
                       OnClick="ManageRules">
                Manage Rules
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Edit"
                       OnClick="@OpenUpdateGroupDialog">
                Edit Group
            </MudButton>
            @if (!_isSelectedGroupArchived)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.PersonAdd"
                           OnClick="AddMember">
                    Add Member
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.PersonRemove"
                           OnClick="RemoveMember">
                    Remove Member
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Tertiary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Archive"
                           OnClick="ArchiveGroup">
                    Archive
                </MudButton>
            }
        </MudStack>
    </MudStack>
}

<MudStack Spacing="4" Class="mb-10">
    @if (_selectedGroupId != Guid.Empty && _selectedGroupName != null)
    {
        <!-- Balance Row -->
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
            <!-- Your Balance -->
            <MudPaper Elevation="2" Class="pa-6 flex-grow-1">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Your Balance</MudText>

                    @if (_userBalance > 0)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="py-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">You are owed
                                    $@_userBalance.ToString("N2")</MudText>
                                <MudText Typo="Typo.body2">
                                    @foreach (var debt in _owedToYou)
                                    {
                                        <div>@debt.Name owes you <strong>$@debt.Amount.ToString("N2")</strong></div>
                                    }
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    }
                    else if (_userBalance < 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="py-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h5" Class="font-weight-bold">You owe
                                    $@(Math.Abs(_userBalance).ToString("N2"))</MudText>
                                <MudText Typo="Typo.body2">
                                    @foreach (var debt in _youOwe)
                                    {
                                        <div>You owe @debt.Name <strong>$@debt.Amount.ToString("N2")</strong></div>
                                    }
                                </MudText>
                            </MudStack>
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            <MudText Typo="Typo.body1">You're all settled up! 🎉</MudText>
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>

            <!-- Group Balances -->
            <MudPaper Elevation="2" Class="pa-6" Style="min-width: 280px; max-width: 320px;">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Group Balances</MudText>
                    <MudStack Spacing="2">
                        @foreach (var member in _members)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">@member.Name[0]</MudAvatar>
                                    <MudText Typo="Typo.body2">@member.Name</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="font-weight-medium"
                                         Color="@(member.Balance > 0 ? Color.Success : member.Balance < 0 ? Color.Error : Color.Default)">
                                    @(member.Balance >= 0 ? "+" : "")$@member.Balance.ToString("N2")
                                </MudText>
                            </MudStack>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>

        <!-- Expenses Row -->
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
            <!-- Expenses List -->
            <MudPaper Elevation="2" Class="pa-6 flex-grow-1">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Recent Expenses</MudText>

                    <MudStack Spacing="2">
                        @foreach (var transaction in _transactions)
                        {
                            <MudCard Elevation="0" Outlined="true" Class="hover-slide-right"
                                     @onclick="() => ViewExpenseDetails(transaction)">
                                <MudCardContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudStack Spacing="0" Class="flex-grow-1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudAvatar Color="Color.Primary"
                                                           Size="Size.Small">@transaction.PaidByName[0]</MudAvatar>
                                                <MudText Typo="Typo.body2"
                                                         Class="font-weight-medium">@transaction.Name</MudText>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                         Color="Color.Primary">@transaction.Category</MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Class="ml-10">
                                                Paid by <strong>@transaction.PaidByName</strong>
                                                on @transaction.Date.ToShortDateString()
                                            </MudText>
                                        </MudStack>
                                        <MudStack AlignItems="AlignItems.End" Spacing="0">
                                            <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
                                                $@transaction.Amount.ToString("N2")
                                            </MudText>
                                            <MudText Typo="Typo.caption">@transaction.RuleName</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
            <!-- My Groups -->
            <MudStack Spacing="4">
                <GroupsList Title="My Groups"
                            Icon="@Icons.Material.Outlined.Groups"
                            Groups="UserGroups"
                            SelectedGroupId="_selectedGroupId"
                            OnGroupSelect="SelectGroup"
                            ShowCreateButton="true"
                            OnCreateClick="OpenCreateDialogAsync"/>

                <GroupsList Title="Archived Groups"
                            Icon="@Icons.Material.Outlined.Archive"
                            Groups="_archivedGroups"
                            SelectedGroupId="_selectedGroupId"
                            OnGroupSelect="SelectGroup"
                            ShowCreateButton="false"/>
            </MudStack>
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-10">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Large"/>
                <MudText Typo="Typo.h6">Select a group to view details</MudText>
            </MudStack>
        </MudPaper>
    }
</MudStack>


@if (_selectedGroupId != Guid.Empty && !_isSelectedGroupArchived)
{
    <ExtendedFab Label="Expense" AlwaysExtended="true"/>
}

@code {
    private const string CurrentUserName = "John Doe";
    private Guid _selectedGroupId = Guid.Empty;
    private string? _selectedGroupName;
    private bool _isSelectedGroupArchived;
    private decimal _userBalance;

    [PersistentState] public ICollection<GroupResponse> UserGroups { get; set; } = null!;

    private readonly List<GroupResponse> _archivedGroups = [];

    private List<DebtInfo> _owedToYou = new();
    private List<DebtInfo> _youOwe = new();
    private List<MemberBalance> _members = new();
    private List<TransactionInfo> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        UserGroups ??= await GroupsClient.GetGroupsAsync();
        if (UserGroups.Any())
        {
            SelectGroup(UserGroups.First().Id);
        }

        await base.OnInitializedAsync();
    }

    private void SelectGroup(Guid groupId)
    {
        _selectedGroupId = groupId;

        // Check if it's in active groups
        var group = UserGroups.FirstOrDefault(g => g.Id == groupId);
        if (group != null)
        {
            _selectedGroupName = group.Name;
            _isSelectedGroupArchived = false;
        }
        else
        {
            // Check if it's in archived groups
            group = _archivedGroups.FirstOrDefault(g => g.Id == groupId);
            if (group != null)
            {
                _selectedGroupName = group.Name;
                _isSelectedGroupArchived = true;
            }
        }

        LoadGroupData();
    }

    private void LoadGroupData()
    {
        // TODO: Load from API - these are mock calculations
        // In reality, you'd fetch transactions and calculate balances

        // Mock: Calculate user's balance
        _userBalance = 45.50m;

        _owedToYou = new List<DebtInfo>
        {
            new() { Name = "Jane Smith", Amount = 25.00m },
            new() { Name = "Bob Wilson", Amount = 20.50m }
        };

        _youOwe = new List<DebtInfo>();

        // Mock: Group member balances
        _members = new List<MemberBalance>
        {
            new() { Name = CurrentUserName, Balance = 45.50m },
            new() { Name = "Jane Smith", Balance = -25.00m },
            new() { Name = "Bob Wilson", Balance = -20.50m },
            new() { Name = "Alice Johnson", Balance = 0.00m }
        };

        // Mock: Recent transactions
        _transactions = new List<TransactionInfo>
        {
            new() { Id = Guid.NewGuid(), Name = "Dinner at Italian Restaurant", Amount = 120.00m, PaidByName = CurrentUserName, Category = "Food", Date = DateTime.Now.AddDays(-1), RuleName = "Split Equally" },
            new() { Id = Guid.NewGuid(), Name = "Taxi to Airport", Amount = 45.50m, PaidByName = "Jane Smith", Category = "Transport", Date = DateTime.Now.AddDays(-2), RuleName = "Split Equally" },
            new() { Id = Guid.NewGuid(), Name = "Hotel Booking", Amount = 320.00m, PaidByName = CurrentUserName, Category = "Accommodation", Date = DateTime.Now.AddDays(-5), RuleName = "Split by Percentage" },
            new() { Id = Guid.NewGuid(), Name = "Concert Tickets", Amount = 85.20m, PaidByName = "Bob Wilson", Category = "Entertainment", Date = DateTime.Now.AddDays(-7), RuleName = "Split Equally" }
        };
    }

    private void ViewExpenseDetails(TransactionInfo transaction)
    {
        // TODO: Implement expense details dialog/modal
        // Show expense details: description, amount, who paid, date, how it was split, etc.
    }

    private void ManageRules()
    {
        // TODO: Implement manage rules dialog/page
        // Allow user to create, edit, and delete splitting rules
    }

    private async Task AddMember()
    {
        await OpenAddMemberDialogAsync();
    }

    private async Task RemoveMember()
    {
        await OpenRemoveMemberDialogAsync();
    }

    private void ArchiveGroup()
    {
        if (_selectedGroupId == Guid.Empty || _isSelectedGroupArchived)
            return;

        // Find the group in active groups
        var group = UserGroups.FirstOrDefault(g => g.Id == _selectedGroupId);
        if (group != null)
        {
            // Move to archived groups
            UserGroups.Remove(group);
            _archivedGroups.Add(group);

            // Select first available group or clear selection
            if (UserGroups.Any())
            {
                SelectGroup(UserGroups.First().Id);
            }
            else
            {
                _selectedGroupId = Guid.Empty;
                _selectedGroupName = null;
                _isSelectedGroupArchived = false;
            }
        }
    }

    private void UpdateGroupInList(GroupResponse updatedGroup)
    {
        // This method probably needs to be updated after transactions merge
        var groupList = UserGroups.ToList();
        var index = groupList.FindIndex(g => g.Id == updatedGroup.Id);
        if (index >= 0)
        {
            groupList[index] = updatedGroup;
            UserGroups = groupList;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<CreateGroupDialog>("Create a group", options);

        try
        {
            var dialogResult = await dialogReference.GetResult<CreateGroupRequest>();
            if (dialogReference is not null)
            {
                var group = await GroupsClient.CreateGroupAsync(dialogResult);
                UserGroups.Add(group);
            }
        } catch (InvalidCastException)
        {
            Snackbar.Add("Dialog did not return a valid group. Please try again.", Severity.Error);
            return;
        }
    }

    private async Task OpenAddMemberDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var users = from user in await GroupsClient.GetGroupMembersAsync(_selectedGroupId)
                    where user.Email is not null
                    select new UserIdentifier { Email = user.Email! };
        var parameters = new DialogParameters<AddGroupMemberDialog> { { x => x.CurrentUsers, users.ToArray() } };

        var dialogReference = await DialogService.ShowAsync<AddGroupMemberDialog>("Add new member", parameters, options);

        try
        {
            var request = await dialogReference.GetResult<AddMemberRequest>();
            if (request is not null)
            {
                var updatedGroup = await GroupsClient.AddGroupMemberAsync(_selectedGroupId, request);
                UpdateGroupInList(updatedGroup);
                Snackbar.Add("Member added successfully.", Severity.Success);
            }
        }
        catch (InvalidCastException)
        {
            Snackbar.Add("Dialog did not return a valid user ID. Please try again.", Severity.Error);
        }
    }

    private async Task OpenRemoveMemberDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var members = await GroupsClient.GetGroupMembersAsync(_selectedGroupId);
        var parameters = new DialogParameters<RemoveMemberDialog> { { x => x.Members, members } };

        var dialogReference = await DialogService.ShowAsync<RemoveMemberDialog>("Remove member", parameters, options);

        UserInfo? removedUser;
        try
        {
            removedUser = await dialogReference.GetResult<UserInfo>();
        } catch (InvalidCastException)
        {
            Snackbar.Add("Dialog did not return a valid user ID. Please try again.", Severity.Error);
            return;
        }
        if (removedUser is not null)
        {
            await GroupsClient.RemoveGroupMemberAsync(_selectedGroupId, removedUser.Id);
            var updatedGroup = await GroupsClient.GetGroupAsync(_selectedGroupId);
            UpdateGroupInList(updatedGroup);
            Snackbar.Add("Member removed successfully.", Severity.Success);
        }

    }
    
    private async Task OpenUpdateGroupDialog()
    {
        var parameters = new DialogParameters
        {
            { "Group", UserGroups.First(x => x.Id == _selectedGroupId) }
        };

        var dialog = await DialogService.ShowAsync<UpdateGroupDialog>(
            "Edit Group",
            parameters,
            new DialogOptions { FullWidth = true }
        );

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;
        
        if (result.Data is JsonPatchDocument<CreateGroupRequest> patch)
        {
            await GroupsClient.UpdateGroupAsync(_selectedGroupId, patch);
        }
    }

    private class DebtInfo
    {
        public string Name { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private class MemberBalance
    {
        public string Name { get; set; } = "";
        public decimal Balance { get; set; }
    }

    private class TransactionInfo
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public decimal Amount { get; set; }
        public string PaidByName { get; set; } = "";
        public string Category { get; set; } = "";
        public DateTime Date { get; set; }
        public string RuleName { get; set; } = "";
    }

}
