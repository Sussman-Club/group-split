}

<style>
    .cursor-pointer {
        transition: all 0.2s ease;
    }

    .cursor-pointer:hover {
        background-color: var(--mud-palette-primary-hover) !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
</style>
