@page "/groups"
@using GroupSplit.App.Shared.Components
@using GroupSplit.App.Shared.Services.Groups
@using GroupSplit.Shared
@using Microsoft.AspNetCore.JsonPatch.SystemTextJson
@inject IDialogService DialogService
@inject IGroupsPageStateService GroupsService
@implements IAsyncDisposable

<PageTitle>Groups</PageTitle>

@if (GroupsService.SelectedGroup != null)
{
    <!-- Group Header -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="font-weight-bold">@GroupsService.SelectedGroup.Name</MudText>
            </MudStack>
            <MudText Typo="Typo.body2">
                @GroupsService.SelectedGroup.MemberCount members · @GroupsService.Transactions.Count expenses
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Settings"
                       OnClick="@ManageRules">
                Manage Rules
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Edit"
                       OnClick="@OpenUpdateGroupDialog">
                Edit Group
            </MudButton>
            @if (!GroupsService.SelectedGroup.IsArchive)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.PersonAdd"
                           OnClick="@OpenAddMemberDialogAsync">
                    Add Member
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.PersonRemove"
                           OnClick="@OpenRemoveMemberDialogAsync">
                    Remove Member
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Tertiary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Archive"
                           OnClick="@ArchiveGroup">
                    Archive
                </MudButton>
            }
        </MudStack>
    </MudStack>
}

<MudStack Spacing="4" Class="mb-10">
    @if (GroupsService.SelectedGroup != null)
    {
        <!-- Balance Row -->
        @if (GroupsService.Balance is { } balance)
        {
            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
                <!-- Your Balance -->
                <MudPaper Elevation="2" Class="pa-6 flex-grow-1">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Your Balance</MudText>


                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="py-4">
                            <MudStack Spacing="2">
                                @if (UserBalance > 0)
                                {
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                                        You are owed
                                        @UserBalance.ToString("C")
                                    </MudText>
                                    <MudStack Spacing="3">
                                        @foreach (var debt in balance.OwedToYou)
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body2">
                                                    @debt.UserName owes you <strong>@debt.Amount.ToString("C")</strong>
                                                </MudText>

                                                <MudButton 
                                                    Color="Color.Primary"
                                                    Size="Size.Small"
                                                    Variant="Variant.Outlined"
                                                    OnClick="@(async() => await OpenSettleDialogAsync(debt))">
                                                    Settle
                                                </MudButton>
                                            </MudStack>
                                        }
                                    </MudStack>
                                }
                                else if (UserBalance < 0)
                                {
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                                        You owe
                                        @(Math.Abs(UserBalance).ToString("C"))
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        @foreach (var debt in balance.YouOwed)
                                        {
                                            <div>You owe @debt.UserName <strong>@debt.Amount.ToString("C")</strong></div>
                                        }
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">You're all settled up! 🎉</MudText>
                                }
                            </MudStack>
                        </MudAlert>

                    </MudStack>
                </MudPaper>

                <!-- Group Balances -->
                <MudPaper Elevation="2" Class="pa-6" Style="min-width: 280px; max-width: 320px;">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Group Balances</MudText>
                        <MudStack Spacing="2">
                            @foreach (var member in balance.NetBalances)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Color="Color.Primary" Size="Size.Small">@member.UserName[0]</MudAvatar>
                                        <MudText Typo="Typo.body2">@member.UserName</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium"
                                             Color="@(member.Balance > 0 ? Color.Success : member.Balance < 0 ? Color.Error : Color.Default)">
                                        @(member.Balance >= 0 ? "+" : "")@member.Balance.ToString("C")
                                    </MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudStack>
        }

        <!-- Expenses Row -->
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
            <!-- Expenses List -->
            <MudPaper Elevation="2" Class="pa-6 flex-grow-1">
                <TransactionsList Title="Recent Expenses" Transactions="GroupsService.Transactions" />
            </MudPaper>
            <!-- My Groups -->
            <MudStack Spacing="4">
                <GroupsList Title="My Groups"
                            Icon="@Icons.Material.Outlined.Groups"
                            Groups="GroupsService.Groups"
                            @bind-SelectedGroup="GroupsService.SelectedGroup"
                            ShowCreateButton="true"
                            OnCreateClick="OpenCreateDialogAsync" />

                <GroupsList Title="Archived Groups"
                            Icon="@Icons.Material.Outlined.Archive"
                            Groups="_archivedGroups"
                            @bind-SelectedGroup="GroupsService.SelectedGroup"
                            ShowCreateButton="false" />
            </MudStack>
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-10">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Large" />
                <MudText Typo="Typo.h6">Select a group to view details</MudText>
            </MudStack>
        </MudPaper>
    }
</MudStack>


@if (GroupsService.SelectedGroup is { IsArchive: false })
{
    <ExtendedFab Label="Expense" AlwaysExtended="true" OnClick="@OpenAddTransactionDialog" />
}

@code {
    [CascadingParameter] public UserInfo? UserInfo { get; set; }
    private readonly List<GroupResponse> _archivedGroups = [];

    private decimal UserBalance => GroupsService.Balance?.NetBalances.FirstOrDefault(x => x.UserId == UserInfo?.Id)?.Balance ?? 0m;

    private CancellationTokenSource? _loadCts;
    private CancellationToken CancellationToken => _loadCts?.Token ?? CancellationToken.None;

    private void ReRender()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        _loadCts = new CancellationTokenSource();
        GroupsService.OnGroupsChanged += ReRender;
        GroupsService.OnTransactionsChanged += ReRender;
        GroupsService.OnGroupSelected += ReRender;
    }

    protected override async Task OnInitializedAsync()
    {
        await GroupsService.IsReadyTask;
        await base.OnInitializedAsync();
    }

    private async Task ManageRules()
    {
        if (GroupsService.SelectedGroup is null) return;

        var parameters = new DialogParameters<ManageRulesDialog>
        {
            { x => x.GroupId, GroupsService.SelectedGroup.Id }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        await DialogService.ShowAsync<ManageRulesDialog>("Manage Rules", parameters, options);
    }

    private void ArchiveGroup()
    {
        // TODO: Implement archive group dialog
        // Allow user to archive the selected group
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<CreateGroupDialog>("Create a group", options);

        var dialogResult = await dialogReference.GetReturnValueAsync<CreateGroupRequest>();

        if (dialogResult is null)
            return;

        await GroupsService.CreateGroupAsync(dialogResult, CancellationToken);
    }

    private async Task OpenAddMemberDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var members = await GroupsService.GetGroupMembersAsync(CancellationToken).ToArrayAsync(CancellationToken);

        var parameters = new DialogParameters<AddGroupMemberDialog> { { x => x.CurrentUsers, members } };

        var dialogReference = await DialogService.ShowAsync<AddGroupMemberDialog>("Add new member", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<AddMemberRequest>();
        if (request is not null)
        {
            await GroupsService.AddGroupMemberAsync(request, CancellationToken);
        }
    }

    private async Task OpenRemoveMemberDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var members = await GroupsService.GetGroupMembersAsync(CancellationToken).ToArrayAsync(CancellationToken);

        var parameters = new DialogParameters<RemoveMemberDialog> { { x => x.Members, members } };

        var dialogReference = await DialogService.ShowAsync<RemoveMemberDialog>("Remove member", parameters, options);

        var removedUser = await dialogReference.GetReturnValueAsync<UserInfo>();

        if (removedUser is not null)
        {
            await GroupsService.RemoveGroupMemberAsync(removedUser.Id, CancellationToken);
        }
    }

    private async Task OpenUpdateGroupDialog()
    {
        if (GroupsService.SelectedGroup is null) return;

        var parameters = new DialogParameters
        {
            { "Group", GroupsService.SelectedGroup }
        };

        var dialog = await DialogService.ShowAsync<UpdateGroupDialog>(
            "Edit Group",
            parameters,
            new DialogOptions { FullWidth = true }
        );

        var request = await dialog.GetReturnValueAsync<JsonPatchDocument<CreateGroupRequest>>();

        if (request is not null)
        {
            await GroupsService.UpdateGroupAsync(request, CancellationToken);
        }
    }

    private async Task OpenAddTransactionDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<CreateTransactionDialog>
        {
            { x => x.SelectedGroupId, GroupsService.SelectedGroup?.Id }
        };

        var dialogReference = await DialogService.ShowAsync<CreateTransactionDialog>("Create an expense", parameters, options);

        var request = await dialogReference.GetReturnValueAsync<CreateTransactionRequest>();

        if (request is not null)
        {
            await GroupsService.CreateTransactionAsync(request, CancellationToken);
        }
    }

    private async Task OpenSettleDialogAsync(DebtInfo debtInfo)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true
        };

        var parameters = new DialogParameters<SettleDialog>
        {
            { x => x.UserId, debtInfo.UserId },
            { x => x.Username, debtInfo.UserName },
            { x => x.TotalDebt, debtInfo.Amount }
        };

        var dialog = await DialogService.ShowAsync<SettleDialog>(
            $"Settle with {debtInfo.UserName}",
            parameters,
            options
        );

        var request = await dialog.GetReturnValueAsync<SettleRequest>();

        if (request is not null)
        {
            await GroupsService.SettleAsync(request, CancellationToken);
        }
    }

    public async ValueTask DisposeAsync()
    {
        GroupsService.OnGroupsChanged -= ReRender;
        GroupsService.OnTransactionsChanged -= ReRender;
        GroupsService.OnGroupSelected -= ReRender;
        if (_loadCts is not null) await _loadCts.CancelAsync();
    }

}
