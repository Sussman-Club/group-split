    private Guid _selectedGroupId = Guid.Empty;
    private string? _selectedGroupName;
    private decimal _userBalance;

    // Mock data - replace with API calls
    private readonly List<GroupListItem> _userGroups = new()
    {
        new GroupListItem { Id = Guid.NewGuid(), Name = "Vacation 2024", MemberCount = 4 },
        new GroupListItem { Id = Guid.NewGuid(), Name = "Roommates", MemberCount = 3 },
        new GroupListItem { Id = Guid.NewGuid(), Name = "Office Lunch", MemberCount = 5 },
