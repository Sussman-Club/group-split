@page "/login"
@using GroupSplit.App.Shared.ApiClient
@using System.Text.RegularExpressions
@using GroupSplit.App.Shared.Services
@using GroupSplit.Shared
@layout Layout.FullScreenLayout
@inject IAuthService AuthService
@inject NavigationManager Nav


<MudStack Row Class="mud-height-full mud-width-full d-flex"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceAround"
          Style="background-color:var(--mud-palette-background-gray);">

    <MudPaper Square MaxWidth="440px" MinWidth="440px">
        <MudStack Class="pa-8" Spacing="5">
            <MudText Typo="Typo.subtitle2">
                Group Split
            </MudText>
            <MudText Typo="Typo.h5">
                Sign In
            </MudText>
            <MudForm @ref="LoginForm" @bind-IsValid="success">
                <MudStack Spacing="5">
                    <MudTextField @bind-Value="Username"
                                  Placeholder="Email"
                                  OnlyValidateIfDirty>
                    </MudTextField>
                    <MudTextField @bind-Value="Password"
                                  InputType="InputType.Password"
                                  Placeholder="Password"
                                  OnlyValidateIfDirty>
                    </MudTextField>
                    <MudText Typo="Typo.subtitle2">
                        No account? <MudLink Typo="Typo.subtitle2" Href="/signup">Create One!</MudLink>
                    </MudText>
                    <MudLink Typo="Typo.subtitle2">
                        Can't access your account?
                    </MudLink>
                    <MudStack Row>
                        <MudSpacer />
                        <MudButton Color="Color.Primary" Class="rounded-0" Variant="Variant.Filled" Disabled="!success" OnClick="TryLogin">
                            Sign In
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudForm>
        </MudStack>
    </MudPaper>
</MudStack>


@code {
    private string? Username { get; set; }
    private string? Password { get; set; }
    private bool success { get; set; } = false;

    MudForm? LoginForm { get; set; }

    public async Task TryLogin()
    {
        if (LoginForm is null)
            return;
        await LoginForm.Validate();
        if (!success)
            return;
        await AuthService.Login(new LoginRequest() { Email = Username!, Password = Password! }, CancellationToken.None);
        Nav.NavigateTo("/");
    }
}
