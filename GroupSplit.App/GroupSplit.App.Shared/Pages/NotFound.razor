@page "/not-found"
@layout MainLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudAlert Severity="Severity.Error" Elevation="6" Variant="Variant.Filled" Dense="false" Icon="@Icons.Material.Filled.ReportProblem">
        <MudText Typo="Typo.h6" Class="fw-bold">Not Found</MudText>
        <MudText>The content you are looking for does not exist.</MudText>
        <MudDivider Class="my-2" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Filled.ArrowBack">Go Home</MudButton>
    </MudAlert>
</MudContainer>
