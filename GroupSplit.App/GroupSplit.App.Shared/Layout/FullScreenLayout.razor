@inherits LayoutComponentBase
@inject MudTheme Theme

@* Minimal layout for standalone pages like Login. Includes Mud providers so Mud components work without MainLayout. *@
<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="d-flex" Style="min-height: 100dvh">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column flex-1" Style="min-height: 100%">
        @Body
    </MudContainer>
</MudLayout>
