@using GroupSplit.App.Shared.Models
@* MudBlazor navigation menu replacing legacy Bootstrap markup *@
<MudNavMenu Class="pa-2">
    @for (var i = 0; i < _menuSections.Count; i++)
    {
        var menuSection = _menuSections[i];

        // Add divider for all sections except the first one
        if (i > 0)
        {
            <MudDivider Class="my-4"/>
        }

        @if (!string.IsNullOrWhiteSpace(menuSection.Title))
        {
            <MudText Typo="Typo.subtitle2"
                     Class="px-4 py-2 text-uppercase"
                     Color="Color.Primary"
                     Style="letter-spacing: 0.5px; font-weight: 600; text-transform: uppercase;">
                @menuSection.Title
            </MudText>
        }


        @foreach (var item in menuSection.Items)
        {
            <MudNavLink Href="@item.Href"
                        Match="@item.Match"
                        Icon="@item.Icon"
                        IconColor="Color.Primary"
                        Class="rounded-lg my-1 nav-link-custom">
                <MudText Typo="Typo.body2" Class="font-weight-medium">@item.Text</MudText>
            </MudNavLink>
        }
    }
</MudNavMenu>

@code {

    private readonly List<MenuSection> _menuSections = new()
    {
        new MenuSection
        {
            // No title
            Items =
            {
                new MenuItem { Href = "/", Text = "Dashboard", Icon = Icons.Material.Filled.Dashboard, Match = NavLinkMatch.All },
                new MenuItem { Href = "/transactions", Text = "Transactions", Icon = Icons.Material.Filled.Receipt },
                new MenuItem { Href = "/groups", Text = "Groups", Icon = Icons.Material.Filled.Groups },
                new MenuItem { Href = "/spending", Text = "Spending", Icon = Icons.Material.Filled.TrendingUp }
            }
        },

        new MenuSection
        {
            Title = "Testing",
            Items =
            {
                new MenuItem { Href = "/weather", Text = "Weather", Icon = Icons.Material.Filled.Cloud },
                new MenuItem { Href = "/counter", Text = "Counter", Icon = Icons.Material.Filled.AddBox }
            }
        }
    };

}

<style>
    .nav-link-custom {
        transition: all 0.2s ease;
    }

    .nav-link-custom:hover {
        background-color: var(--mud-palette-primary-hover) !important;
        transform: translateX(4px);
    }
</style>
